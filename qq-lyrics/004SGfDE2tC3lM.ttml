<tt xmlns="http://www.w3.org/ns/ttml" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xmlns:amll="http://www.example.com/ns/amll"><head><metadata><ttm:agent type="person" xml:id="v1"/><amll:meta key="musicName" value="直到大地变成一颗酸橙"/><amll:meta key="artists" value="Earthists."/><amll:meta key="artists" value="Earthists. (アーシスツ.)"/><amll:meta key="artists" value="Monster Siren Records"/><amll:meta key="artists" value="塞壬唱片-MSR"/><amll:meta key="artists" value="平林佑人"/><amll:meta key="artists" value="星熊南巫"/><amll:meta key="album" value="直到大地变成一颗酸橙OST"/><amll:meta key="ncmMusicId" value="3413072220"/><amll:meta key="qqMusicId" value="004SGfDE2tC3lM"/><amll:meta key="qqMusicId" value="711805355"/><amll:meta key="ttmlAuthorGithub" value="174598250"/><amll:meta key="ttmlAuthorGithubLogin" value="ASyunagi"/></metadata></head><body dur="3:37.040"><div begin="29.350" end="3:37.040"><p begin="29.350" end="30.830" itunes:key="L1" ttm:agent="v1"><span begin="29.350" end="29.550">Be</span><span begin="29.550" end="29.760">yond</span> <span begin="29.840" end="30.190">si</span><span begin="30.190" end="30.290">lent</span> <span begin="30.290" end="30.420">s</span><span begin="30.420" end="30.750">kie</span><span begin="30.750" end="30.830">s</span><span ttm:role="x-translation" xml:lang="zh-Hans">越过寂静的天空</span><span ttm:role="x-translation" xml:lang="zh-Hant">越過寂靜的天空</span><span ttm:role="x-translation" xml:lang="ja">静かな空の彼方から</span><span ttm:role="x-translation" xml:lang="ko">고요한 하늘 너머</span><span ttm:role="x-translation" xml:lang="fr">Au-delà des cieux silencieux</span><span ttm:role="x-translation" xml:lang="es">Más allá de los cielos silenciosos</span><span ttm:role="x-translation" xml:lang="de">Jenseits stiller Himmel</span><span ttm:role="x-translation" xml:lang="pt">Além dos céus silenciosos</span><span ttm:role="x-translation" xml:lang="ru">За безмолвными небесами</span><span ttm:role="x-translation" xml:lang="it">Oltre cieli silenziosi</span></p><p begin="31.050" end="32.990" itunes:key="L2" ttm:agent="v1"><span begin="31.050" end="31.310">Cal</span><span begin="31.310" end="31.510">ling</span> <span begin="31.610" end="31.950">out</span> <span begin="31.950" end="32.100">to</span> <span begin="32.190" end="32.990">you</span><span ttm:role="x-translation" xml:lang="zh-Hans">呼唤着你</span><span ttm:role="x-translation" xml:lang="zh-Hant">呼喚著你</span><span ttm:role="x-translation" xml:lang="ja">君へと呼びかける</span><span ttm:role="x-translation" xml:lang="ko">너를 향해 부르고 있어</span><span ttm:role="x-translation" xml:lang="fr">Je t’appelle</span><span ttm:role="x-translation" xml:lang="es">Llamándote</span><span ttm:role="x-translation" xml:lang="de">Rufe ich nach dir</span><span ttm:role="x-translation" xml:lang="pt">Chamando por você</span><span ttm:role="x-translation" xml:lang="ru">Я зову тебя</span><span ttm:role="x-translation" xml:lang="it">Chiamando te</span></p><p begin="36.210" end="37.570" itunes:key="L3" ttm:agent="v1"><span begin="36.210" end="36.330">Through</span> <span begin="36.420" end="36.740">the</span> <span begin="36.740" end="36.950">en</span><span begin="37.040" end="37.070">d</span><span begin="37.070" end="37.160">le</span><span begin="37.160" end="37.290">ss</span> <span begin="37.290" end="37.570">blue</span><span ttm:role="x-translation" xml:lang="zh-Hans">穿过无尽的蔚蓝</span><span ttm:role="x-translation" xml:lang="zh-Hant">穿過無盡的蔚藍</span><span ttm:role="x-translation" xml:lang="ja">果てしない青を越えて</span><span ttm:role="x-translation" xml:lang="ko">끝없이 펼쳐진 푸름을 지나</span><span ttm:role="x-translation" xml:lang="fr">À travers l’azur sans fin</span><span ttm:role="x-translation" xml:lang="es">A través del azul infinito</span><span ttm:role="x-translation" xml:lang="de">Durch das endlose Blau</span><span ttm:role="x-translation" xml:lang="pt">Através do azul sem fim</span><span ttm:role="x-translation" xml:lang="ru">Сквозь бескрайнюю синеву</span><span ttm:role="x-translation" xml:lang="it">Attraverso l&apos;azzurro infinito</span></p><p begin="37.900" end="39.940" itunes:key="L4" ttm:agent="v1"><span begin="37.900" end="38.170">Car</span><span begin="38.170" end="38.370">rying</span> <span begin="38.460" end="38.780">what</span> <span begin="38.780" end="38.880">is</span> <span begin="39.010" end="39.940">true</span><span ttm:role="x-translation" xml:lang="zh-Hans">带着那份真实</span><span ttm:role="x-translation" xml:lang="zh-Hant">帶著那份真實</span><span ttm:role="x-translation" xml:lang="ja">確かな想いを携えて</span><span ttm:role="x-translation" xml:lang="ko">진실한 마음을 품고</span><span ttm:role="x-translation" xml:lang="fr">Emportant avec moi ce qui est vrai</span><span ttm:role="x-translation" xml:lang="es">Llevando conmigo lo que es verdad</span><span ttm:role="x-translation" xml:lang="de">Trage ich was wahr ist</span><span ttm:role="x-translation" xml:lang="pt">Levando aquilo que é verdadeiro</span><span ttm:role="x-translation" xml:lang="ru">Неся с собой то что истинно</span><span ttm:role="x-translation" xml:lang="it">Portando con me ciò che è vero</span></p><p begin="43.060" end="44.580" itunes:key="L5" ttm:agent="v1"><span begin="43.060" end="43.130">A</span><span begin="43.230" end="43.460">cro</span><span begin="43.460" end="43.610">ss</span> <span begin="43.610" end="43.930">qui</span><span begin="43.930" end="44.020">et</span> <span begin="44.150" end="44.510">nigh</span><span begin="44.510" end="44.580">ts</span><span ttm:role="x-translation" xml:lang="zh-Hans">越过静谧的夜晚</span><span ttm:role="x-translation" xml:lang="zh-Hant">越過靜謐的夜晚</span><span ttm:role="x-translation" xml:lang="ja">静かな夜を越えて</span><span ttm:role="x-translation" xml:lang="ko">고요한 밤들을 건너</span><span ttm:role="x-translation" xml:lang="fr">À travers les nuits paisibles</span><span ttm:role="x-translation" xml:lang="es">A través de noches serenas</span><span ttm:role="x-translation" xml:lang="de">Durch stille Nächte</span><span ttm:role="x-translation" xml:lang="pt">Através das noites tranquilas</span><span ttm:role="x-translation" xml:lang="ru">Сквозь тихие ночи</span><span ttm:role="x-translation" xml:lang="it">Attraverso notti tranquille</span></p><p begin="44.750" end="46.500" itunes:key="L6" ttm:agent="v1"><span begin="44.750" end="44.990">Hol</span><span begin="44.990" end="45.150">ding</span> <span begin="45.280" end="45.570">e</span><span begin="45.570" end="45.640">ve</span><span begin="45.640" end="45.770">ry</span> <span begin="45.850" end="46.500">word</span><span ttm:role="x-translation" xml:lang="zh-Hans">珍藏着每一句话</span><span ttm:role="x-translation" xml:lang="zh-Hant">珍藏著每一句話</span><span ttm:role="x-translation" xml:lang="ja">一つ一つの言葉を抱いて</span><span ttm:role="x-translation" xml:lang="ko">모든 말을 품은 채</span><span ttm:role="x-translation" xml:lang="fr">Gardant précieusement chaque mot</span><span ttm:role="x-translation" xml:lang="es">Guardando cada palabra</span><span ttm:role="x-translation" xml:lang="de">Bewahre ich jedes Wort</span><span ttm:role="x-translation" xml:lang="pt">Guardando cada palavra</span><span ttm:role="x-translation" xml:lang="ru">Храня каждое слово</span><span ttm:role="x-translation" xml:lang="it">Custodendo ogni parola</span></p><p begin="49.880" end="51.400" itunes:key="L7" ttm:agent="v1"><span begin="49.880" end="49.990">Through</span> <span begin="50.120" end="50.320">the</span> <span begin="50.440" end="50.800">fa</span><span begin="50.800" end="50.920">ding</span> <span begin="51.010" end="51.360">dar</span><span begin="51.360" end="51.400">k</span><span ttm:role="x-translation" xml:lang="zh-Hans">穿过渐渐消退的黑暗</span><span ttm:role="x-translation" xml:lang="zh-Hant">穿過漸漸消退的黑暗</span><span ttm:role="x-translation" xml:lang="ja">薄れゆく闇の中でも</span><span ttm:role="x-translation" xml:lang="ko">희미해지는 어둠을 지나</span><span ttm:role="x-translation" xml:lang="fr">À travers l’obscurité qui s’efface</span><span ttm:role="x-translation" xml:lang="es">A través de la oscuridad que se desvanece</span><span ttm:role="x-translation" xml:lang="de">Durch die schwindende Dunkelheit</span><span ttm:role="x-translation" xml:lang="pt">Através da escuridão que se desfaz</span><span ttm:role="x-translation" xml:lang="ru">Сквозь угасающую тьму</span><span ttm:role="x-translation" xml:lang="it">Attraverso l&apos;oscurità che svanisce</span></p><p begin="51.570" end="55.270" itunes:key="L8" ttm:agent="v1"><span begin="51.570" end="51.640">S</span><span begin="51.640" end="51.860">till</span> <span begin="51.860" end="52.090">rea</span><span begin="52.180" end="52.430">ching</span> <span begin="52.710" end="53.370">out</span> <span begin="53.760" end="54.120">to</span> <span begin="54.200" end="55.270">you</span><span ttm:role="x-translation" xml:lang="zh-Hans">依然向你伸出手</span><span ttm:role="x-translation" xml:lang="zh-Hant">依然向你伸出手</span><span ttm:role="x-translation" xml:lang="ja">今も君へと手を伸ばしている</span><span ttm:role="x-translation" xml:lang="ko">여전히 너에게 손을 뻗고 있어</span><span ttm:role="x-translation" xml:lang="fr">Je tends encore la main vers toi</span><span ttm:role="x-translation" xml:lang="es">Aún intentando llegar hasta ti</span><span ttm:role="x-translation" xml:lang="de">Strecke ich noch immer die Hand nach dir aus</span><span ttm:role="x-translation" xml:lang="pt">Ainda estendendo a mão até você</span><span ttm:role="x-translation" xml:lang="ru">Я всё ещё тянусь к тебе</span><span ttm:role="x-translation" xml:lang="it">Continuando a tendere la mano verso di te</span></p><p begin="56.940" end="59.420" itunes:key="L9" ttm:agent="v1"><span begin="56.940" end="57.660">Hear</span><span begin="57.660" end="57.760">ts</span> <span begin="57.850" end="58.320">un</span><span begin="58.450" end="59.420">tied</span><span ttm:role="x-translation" xml:lang="zh-Hans">心结已解</span><span ttm:role="x-translation" xml:lang="zh-Hant">心結已解</span><span ttm:role="x-translation" xml:lang="ja">心は解き放たれ</span><span ttm:role="x-translation" xml:lang="ko">마음은 자유로워지고</span><span ttm:role="x-translation" xml:lang="fr">Les cœurs libérés</span><span ttm:role="x-translation" xml:lang="es">Corazones liberados</span><span ttm:role="x-translation" xml:lang="de">Die Herzen sind befreit</span><span ttm:role="x-translation" xml:lang="pt">Corações enfim livres</span><span ttm:role="x-translation" xml:lang="ru">Сердца освободились</span><span ttm:role="x-translation" xml:lang="it">Cuori ormai liberi</span></p><p begin="1:00.220" end="1:02.810" itunes:key="L10" ttm:agent="v1"><span begin="1:00.220" end="1:00.410">S</span><span begin="1:00.410" end="1:01.060">car</span><span begin="1:01.060" end="1:01.260">s</span> <span begin="1:01.260" end="1:01.770">run</span> <span begin="1:01.880" end="1:02.810">dry</span><span ttm:role="x-translation" xml:lang="zh-Hans">伤口不再流血</span><span ttm:role="x-translation" xml:lang="zh-Hant">傷口不再流血</span><span ttm:role="x-translation" xml:lang="ja">傷痕も乾いてゆく</span><span ttm:role="x-translation" xml:lang="ko">상처도 이제 말라 가</span><span ttm:role="x-translation" xml:lang="fr">Les cicatrices ne saignent plus</span><span ttm:role="x-translation" xml:lang="es">Las heridas ya se han secado</span><span ttm:role="x-translation" xml:lang="de">Die Narben bluten nicht mehr</span><span ttm:role="x-translation" xml:lang="pt">As cicatrizes já secaram</span><span ttm:role="x-translation" xml:lang="ru">Шрамы больше не кровоточат</span><span ttm:role="x-translation" xml:lang="it">Le ferite non sanguinano più</span></p><p begin="1:03.810" end="1:06.610" itunes:key="L11" ttm:agent="v1"><span begin="1:03.810" end="1:04.510">Now</span> <span begin="1:04.680" end="1:05.220">I</span> <span begin="1:05.320" end="1:05.770">can</span> <span begin="1:05.960" end="1:06.610">say</span><span ttm:role="x-translation" xml:lang="zh-Hans">如今我终于能够说出</span><span ttm:role="x-translation" xml:lang="zh-Hant">如今我終於能夠說出</span><span ttm:role="x-translation" xml:lang="ja">今なら言える</span><span ttm:role="x-translation" xml:lang="ko">이제는 말할 수 있어</span><span ttm:role="x-translation" xml:lang="fr">Maintenant je peux le dire</span><span ttm:role="x-translation" xml:lang="es">Ahora puedo decirlo</span><span ttm:role="x-translation" xml:lang="de">Jetzt kann ich sagen</span><span ttm:role="x-translation" xml:lang="pt">Agora posso dizer</span><span ttm:role="x-translation" xml:lang="ru">Теперь я могу сказать</span><span ttm:role="x-translation" xml:lang="it">Ora posso dirlo</span></p><p begin="1:07.280" end="1:09.790" itunes:key="L12" ttm:agent="v1"><span begin="1:07.280" end="1:07.560">No</span><span begin="1:07.690" end="1:07.940">thing</span> <span begin="1:08.120" end="1:08.750">pull</span><span begin="1:08.750" end="1:08.800">s</span> <span begin="1:08.800" end="1:08.920">u</span><span begin="1:08.920" end="1:09.020">s a</span><span begin="1:09.020" end="1:09.790">way</span><span ttm:role="x-translation" xml:lang="zh-Hans">再没有什么能将我们分开</span><span ttm:role="x-translation" xml:lang="zh-Hant">再沒有什麼能將我們分開</span><span ttm:role="x-translation" xml:lang="ja">もう何も僕らを引き離せない</span><span ttm:role="x-translation" xml:lang="ko">그 무엇도 우리를 떼어 놓을 수 없어</span><span ttm:role="x-translation" xml:lang="fr">Plus rien ne peut nous éloigner</span><span ttm:role="x-translation" xml:lang="es">Nada puede separarnos</span><span ttm:role="x-translation" xml:lang="de">Nichts reißt uns auseinander</span><span ttm:role="x-translation" xml:lang="pt">Nada pode nos afastar</span><span ttm:role="x-translation" xml:lang="ru">Ничто нас не разлучит</span><span ttm:role="x-translation" xml:lang="it">Nulla può separarci</span></p><p begin="1:10.260" end="1:13.190" itunes:key="L13" ttm:agent="v1"><span begin="1:10.260" end="1:10.690">We</span> <span begin="1:10.690" end="1:11.340">will</span> <span begin="1:11.340" end="1:12.000">let</span> <span begin="1:12.000" end="1:12.090">it</span> <span begin="1:12.190" end="1:13.190">go</span><span ttm:role="x-translation" xml:lang="zh-Hans">就让它离去吧</span><span ttm:role="x-translation" xml:lang="zh-Hant">就讓它離去吧</span><span ttm:role="x-translation" xml:lang="ja">僕らは手放してゆく</span><span ttm:role="x-translation" xml:lang="ko">우린 이제 놓아줄 거야</span><span ttm:role="x-translation" xml:lang="fr">Nous laisserons tout partir</span><span ttm:role="x-translation" xml:lang="es">Lo dejaremos ir</span><span ttm:role="x-translation" xml:lang="de">Wir werden es loslassen</span><span ttm:role="x-translation" xml:lang="pt">Vamos deixar tudo ir</span><span ttm:role="x-translation" xml:lang="ru">Мы отпустим всё</span><span ttm:role="x-translation" xml:lang="it">Lasceremo andare tutto</span></p><p begin="1:13.660" end="1:16.550" itunes:key="L14" ttm:agent="v1"><span begin="1:13.660" end="1:14.110">We</span> <span begin="1:14.110" end="1:14.650">will</span> <span begin="1:14.760" end="1:15.280">dri</span><span begin="1:15.280" end="1:15.430">f</span><span begin="1:15.430" end="1:15.640">t a</span><span begin="1:15.640" end="1:16.550">way</span><span ttm:role="x-translation" xml:lang="zh-Hans">就这样漂向远方</span><span ttm:role="x-translation" xml:lang="zh-Hant">就這樣漂向遠方</span><span ttm:role="x-translation" xml:lang="ja">僕らは漂ってゆく</span><span ttm:role="x-translation" xml:lang="ko">우린 흘러가겠지</span><span ttm:role="x-translation" xml:lang="fr">Nous nous laisserons dériver</span><span ttm:role="x-translation" xml:lang="es">Nos dejaremos llevar</span><span ttm:role="x-translation" xml:lang="de">Wir werden davontreiben</span><span ttm:role="x-translation" xml:lang="pt">Vamos nos deixar levar</span><span ttm:role="x-translation" xml:lang="ru">Мы уплывём вдаль</span><span ttm:role="x-translation" xml:lang="it">Ci lasceremo trasportare</span></p><p begin="1:17.520" end="1:23.520" itunes:key="L15" ttm:agent="v1"><span begin="1:17.520" end="1:19.220">空</span><span begin="1:19.220" end="1:20.010">へ</span><span begin="1:20.120" end="1:20.910">と</span><span begin="1:21.600" end="1:21.910">溶</span><span begin="1:22.040" end="1:22.320">け</span><span begin="1:22.460" end="1:22.740">て</span><span begin="1:22.740" end="1:22.810">い</span><span begin="1:22.910" end="1:23.520">く</span><span ttm:role="x-translation" xml:lang="zh-Hans">渐渐融入天空</span><span ttm:role="x-translation" xml:lang="zh-Hant">漸漸融入天空</span><span ttm:role="x-translation" xml:lang="en">Melting into the sky</span><span ttm:role="x-translation" xml:lang="ko">하늘로 녹아들어 가</span><span ttm:role="x-translation" xml:lang="fr">Nous nous fondrons dans le ciel</span><span ttm:role="x-translation" xml:lang="es">Nos fundiremos con el cielo</span><span ttm:role="x-translation" xml:lang="de">Und uns im Himmel auflösen</span><span ttm:role="x-translation" xml:lang="pt">Dissolvendo-nos no céu</span><span ttm:role="x-translation" xml:lang="ru">Растворяясь в небе</span><span ttm:role="x-translation" xml:lang="it">Sciogliendoci nel cielo</span><span ttm:role="x-roman">Sora e to tokete iku</span></p><p begin="1:23.960" end="1:26.870" itunes:key="L16" ttm:agent="v1"><span begin="1:23.960" end="1:24.420">We</span> <span begin="1:24.420" end="1:25.070">will</span> <span begin="1:25.070" end="1:25.730">let</span> <span begin="1:25.730" end="1:25.830">it</span> <span begin="1:25.940" end="1:26.870">go</span><span ttm:role="x-translation" xml:lang="zh-Hans">就让它离去吧</span><span ttm:role="x-translation" xml:lang="zh-Hant">就讓它離去吧</span><span ttm:role="x-translation" xml:lang="ja">僕らは手放してゆく</span><span ttm:role="x-translation" xml:lang="ko">우린 이제 놓아줄 거야</span><span ttm:role="x-translation" xml:lang="fr">Nous laisserons tout partir</span><span ttm:role="x-translation" xml:lang="es">Lo dejaremos ir</span><span ttm:role="x-translation" xml:lang="de">Wir werden es loslassen</span><span ttm:role="x-translation" xml:lang="pt">Vamos deixar tudo ir</span><span ttm:role="x-translation" xml:lang="ru">Мы отпустим всё</span><span ttm:role="x-translation" xml:lang="it">Lasceremo andare tutto</span></p><p begin="1:27.380" end="1:30.730" itunes:key="L17" ttm:agent="v1"><span begin="1:27.380" end="1:27.840">We</span> <span begin="1:27.840" end="1:28.360">will</span> <span begin="1:28.460" end="1:28.790">dri</span