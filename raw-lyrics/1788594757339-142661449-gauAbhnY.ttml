<tt xmlns="http://www.w3.org/ns/ttml" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xmlns:amll="http://www.example.com/ns/amll"><head><metadata><ttm:agent type="person" xml:id="v1"/><ttm:agent type="person" xml:id="v2"/><amll:meta key="musicName" value="Blackwater"/><amll:meta key="artists" value="RIOT"/><amll:meta key="album" value="Dogma Resistance"/><amll:meta key="album" value="Blackwater - Single"/><amll:meta key="album" value="Blackwater"/><amll:meta key="album" value="Monstercat - Best of 2019"/><amll:meta key="album" value="Monstercat Uncaged Vol. 8"/><amll:meta key="isrc" value="CA6D21900351"/><amll:meta key="ncmMusicId" value="1401182405"/><amll:meta key="qqMusicId" value="002529Xt1jnWxl"/><amll:meta key="qqMusicId" value="003PLI2e3MtmK8"/><amll:meta key="qqMusicId" value="003jT2g73FBmqN"/><amll:meta key="qqMusicId" value="244398917"/><amll:meta key="qqMusicId" value="247236055"/><amll:meta key="qqMusicId" value="247649827"/><amll:meta key="spotifyId" value="4lE6N1E0L8CssgKEUCgdbA"/><amll:meta key="appleMusicId" value="1483853741"/><amll:meta key="ttmlAuthorGithub" value="142661449"/><amll:meta key="ttmlAuthorGithubLogin" value="fywmjj"/><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal"><songwriters><songwriter>Tom Davidson</songwriter><songwriter>Daniel Magid</songwriter></songwriters></iTunesMetadata></metadata></head><body dur="4:16.012"><div begin="1.130" end="4:16.012"><p begin="1.130" end="3.899" itunes:key="L1" ttm:agent="v1"><span begin="1.130" end="1.205">In</span> <span begin="1.205" end="1.430">a</span> <span begin="1.430" end="1.910">time</span> <span begin="1.910" end="2.067">when</span> <span begin="2.067" end="2.832">lawmen</span> <span begin="2.832" end="2.937">were</span> <span begin="2.937" end="3.349">out</span><span begin="3.349" end="3.899">laws</span><span ttm:role="x-translation" xml:lang="zh-Hans">在那个执法者沦为法外之徒的时代</span></p><p begin="4.559" end="7.605" itunes:key="L2" ttm:agent="v1"><span begin="4.559" end="4.731">A</span> <span begin="4.731" end="5.155">thief,</span> <span begin="5.406" end="5.598">a</span> <span begin="5.598" end="6.000">cutthroat,</span> <span begin="6.572" end="6.700">and</span> <span begin="6.700" end="6.924">a</span> <span begin="6.924" end="7.160">bounty</span> <span begin="7.160" end="7.605">hunter</span><span ttm:role="x-translation" xml:lang="zh-Hans">盗贼、杀手与赏金猎人</span></p><p begin="7.605" end="9.298" itunes:key="L3" ttm:agent="v1"><span begin="7.605" end="7.759">Face</span> <span begin="7.759" end="7.867">an</span> <span begin="7.867" end="8.193">enemy</span> <span begin="8.193" end="8.327">of</span> <span begin="8.327" end="8.403">a</span> <span begin="8.403" end="8.767">new</span> <span begin="8.767" end="9.298">kind</span><span ttm:role="x-translation" xml:lang="zh-Hans">共同面对前所未有的强敌</span></p><p begin="10.705" end="12.717" itunes:key="L4" ttm:agent="v1"><span begin="10.705" end="10.908">Through</span> <span begin="10.908" end="11.019">the</span> <span begin="11.019" end="11.580">uncharted</span> <span begin="11.580" end="11.968">lands</span> <span begin="11.968" end="12.090">of</span> <span begin="12.090" end="12.242">the</span> <span begin="12.242" end="12.717">West</span><span ttm:role="x-translation" xml:lang="zh-Hans">穿越西部那片未被开拓的蛮荒之地</span></p><p begin="12.983" end="16.229" itunes:key="L5" ttm:agent="v1"><span begin="12.983" end="13.119">A</span> <span begin="13.119" end="13.263">fist</span><span begin="13.263" end="13.422">ful</span> <span begin="13.422" end="13.739">of</span> <span begin="13.739" end="13.929">men</span> <span begin="13.929" end="14.852">ride</span> <span begin="14.852" end="15.105">for</span> <span begin="15.105" end="15.272">the</span> <span begin="15.272" end="15.541">Black</span><span begin="15.541" end="16.229">water</span><span ttm:role="x-translation" xml:lang="zh-Hans">几名硬汉策马奔向黑水镇</span></p><p begin="1:10.461" end="1:14.617" itunes:key="L6" ttm:agent="v1"><span begin="1:10.461" end="1:10.652">To</span><span begin="1:10.652" end="1:11.090">night,</span> <span begin="1:11.489" end="1:11.596">an</span> <span begin="1:11.596" end="1:11.840">un</span><span begin="1:11.840" end="1:12.591">settling</span> <span begin="1:12.591" end="1:13.287">tone</span> <span begin="1:13.287" end="1:13.852">lingers</span> <span begin="1:13.852" end="1:13.986">in</span> <span begin="1:13.986" end="1:14.183">the</span> <span begin="1:14.183" end="1:14.617">air</span><span ttm:role="x-translation" xml:lang="zh-Hans">今夜，空气中弥漫着不安的气息</span></p><p begin="1:15.613" end="1:19.866" itunes:key="L7" ttm:agent="v1"><span begin="1:15.613" end="1:15.731">The</span> <span begin="1:15.731" end="1:16.646">sound</span> <span begin="1:17.198" end="1:17.562">makes</span> <span begin="1:17.562" end="1:17.724">the</span> <span begin="1:17.724" end="1:18.512">horses</span> <span begin="1:18.512" end="1:18.880">shrie</span><span begin="1:18.880" end="1:18.954">k</span> <span begin="1:18.954" end="1:19.222">in</span> <span begin="1:19.222" end="1:19.866">fear</span><span ttm:role="x-translation" xml:lang="zh-Hans">异样的声响让马匹惊恐嘶鸣</span></p><p begin="1:20.811" end="1:24.228" itunes:key="L8" ttm:agent="v1"><span begin="1:20.811" end="1:21.094">From</span> <span begin="1:21.094" end="1:21.614">above,</span> <span begin="1:22.639" end="1:22.933">pier</span><span begin="1:23.006" end="1:23.291">cing</span> <span begin="1:23.291" end="1:23.736">thunder</span> <span begin="1:23.736" end="1:24.228">roars</span><span ttm:role="x-translation" xml:lang="zh-Hans">穹顶之上，惊雷滚滚破空而来</span></p><p begin="1:25.131" end="1:27.522" itunes:key="L9" ttm:agent="v1"><span begin="1:25.131" end="1:25.400">The</span> <span begin="1:25.400" end="1:26.304">earth</span> <span begin="1:26.304" end="1:26.599">has</span> <span begin="1:26.599" end="1:27.522">visitors</span><span ttm:role="x-translation" xml:lang="zh-Hans">不速之客已悄然降临人间</span></p><p begin="1:27.932" end="1:30.472" itunes:key="L10" ttm:agent="v1"><span begin="1:27.932" end="1:28.076">This</span> <span begin="1:28.076" end="1:28.252">is</span> <span begin="1:28.252" end="1:28.441">the</span> <span begin="1:28.441" end="1:29.462">sound</span> <span begin="1:29.462" end="1:29.682">of</span> <span begin="1:29.682" end="1:29.768">the</span> <span begin="1:29.768" end="1:30.472">machine</span><span ttm:role="x-translation" xml:lang="zh-Hans">那是钢铁巨兽的轰鸣</span></p><p begin="1:42.015" end="1:44.449" itunes:key="L11" ttm:agent="v1"><span begin="1:42.015" end="1:42.326">Now</span> <span begin="1:42.326" end="1:43.087">staring</span> <span begin="1:43.087" end="1:43.311">in</span><span begin="1:43.311" end="1:43.535">to</span> <span begin="1:43.535" end="1:43.624">the</span> <span begin="1:43.624" end="1:43.899">s</span><span begin="1:43.899" end="1:44.449">ky</span><span ttm:role="x-translation" xml:lang="zh-Hans">抬头仰望夜空</span></p><p begin="1:44.536" end="1:47.091" itunes:key="L12" ttm:agent="v1"><span begin="1:44.536" end="1:44.667">The</span> <span begin="1:44.667" end="1:45.412">stars</span> <span begin="1:45.412" end="1:45.827">dissi</span><span begin="1:45.827" end="1:46.159">pate</span> <span begin="1:46.159" end="1:46.342">to</span> <span begin="1:46.342" end="1:46.710">make</span> <span begin="1:46.710" end="1:47.091">way</span><span ttm:role="x-translation" xml:lang="zh-Hans">群星黯然退散 为其让道</span></p><p begin="1:47.309" end="1:52.131" itunes:key="L13" ttm:agent="v1"><span begin="1:47.309" end="1:47.530">As</span> <span begin="1:47.530" end="1:47.701">the</span> <span begin="1:47.701" end="1:48.529">mechanical</span> <span begin="1:48.529" end="1:49.098">beast</span> <span begin="1:49.098" end="1:49.464">makes</span> <span begin="1:49.464" end="1:49.907">its</span> <span begin="1:49.907" end="1:50.610">descent</span> <span begin="1:50.610" end="1:51.362">towards</span> <span begin="1:51.362" end="1:51.537">the</span> <span begin="1:51.537" end="1:52.131">earth</span><span ttm:role="x-translation" xml:lang="zh-Hans">钢铁巨兽正向人间降临</span></p><p begin="1:52.285" end="1:56.387" itunes:key="L14" ttm:agent="v1"><span begin="1:52.285" end="1:52.683">Through</span> <span begin="1:52.683" end="1:53.383">galaxies</span> <span begin="1:53.383" end="1:53.551">in</span> <span begin="1:53.551" end="1:54.396">space</span> <span begin="1:54.396" end="1:54.649">and</span> <span begin="1:54.649" end="1:55.086">tales</span> <span begin="1:55.086" end="1:55.561">old</span> <span begin="1:55.561" end="1:55.841">as</span> <span begin="1:55.841" end="1:56.387">time</span><span ttm:role="x-translation" xml:lang="zh-Hans">穿越浩瀚星系与亘古流传的传说</span></p><p begin="1:57.257" end="2:03.945" itunes:key="L15" ttm:agent="v1"><span begin="1:57.257" end="1:57.726">Fear</span> <span begin="1:57.726" end="1:58.249">finds</span> <span begin="1:58.249" end="1:58.430">a</span> <span begin="1:58.430" end="1:59.322">way</span> <span begin="1:59.322" end="1:59.603">into</span> <span begin="1:59.603" end="1:59.873">the</span> <span begin="1:59.873" end="2:00.454">heart</span> <span begin="2:00.454" end="2:00.645">of</span> <span begin="2:00.645" end="2:01.138">every</span> <span begin="2:01.138" end="2:01.994">man</span> <span begin="2:01.994" end="2:02.430">of</span> <span begin="2:02.430" end="2:02.750">the</span> <span begin="2:02.750" end="2:03.348">Black</span><span begin="2:03.348" end="2:03.945">water</span><span ttm:role="x-translation" xml:lang="zh-Hans">恐惧悄然侵蚀着黑水镇每个人的心房</span></p><p begin="2:04.686" end="2:05.328" itunes:key="L16" ttm:agent="v2"><span begin="2:04.686" end="2:05.007">Black</span><span begin="2:05.007" end="2:05.328">water</span><span ttm:role="x-translation" xml:lang="zh-Hans">黑水镇</span></p><p begin="2:09.992" end="2:10.676" itunes:key="L17" ttm:agent="v2"><span begin="2:09.992" end="2:10.334">Black</span><span begin="2:10.334" end="2:10.676">water</span><span ttm:role="x-translation" xml:lang="zh-Hans">黑水镇</span></p><p begin="2:31.311" end="2:31.998" itu