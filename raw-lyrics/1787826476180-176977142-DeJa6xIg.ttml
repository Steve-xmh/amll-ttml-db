7.137">も</span><span begin="2:07.137" end="2:07.324">な</span><span begin="2:07.324" end="2:07.473">い</span><span begin="2:07.473" end="2:07.629">も</span> <span begin="2:07.629" end="2:08.130">そん</span><span begin="2:08.130" end="2:08.244">な</span><span begin="2:08.244" end="2:08.353">の</span><span begin="2:08.353" end="2:08.437">ど</span><span begin="2:08.437" end="2:08.557">う</span><span begin="2:08.557" end="2:08.633">で</span><span begin="2:08.633" end="2:08.739">も</span><span begin="2:08.739" end="2:08.910">い</span><span begin="2:08.910" end="2:09.004">い</span><span begin="2:09.004" end="2:09.134">よ</span><span ttm:role="x-translation" xml:lang="zh-CN">左思右想的烦恼 那都是无关紧要的</span></p><p begin="2:09.344" end="2:11.830" itunes:key="L23" ttm:agent="v1"><span begin="2:09.344" end="2:09.504">や</span><span begin="2:09.504" end="2:09.672">り</span><span begin="2:09.672" end="2:09.861">た</span><span begin="2:09.861" end="2:10.053">い</span><span begin="2:10.053" end="2:10.227">よ</span><span begin="2:10.227" end="2:10.470">う</span><span begin="2:10.470" end="2:10.674">に</span><span begin="2:10.674" end="2:10.869">や</span><span begin="2:10.869" end="2:11.007">ろ</span><span begin="2:11.007" end="2:11.830">う</span><span ttm:role="x-translation" xml:lang="zh-CN">让我们尽情舞动</span></p><p begin="2:12.506" end="2:15.292" itunes:key="L24" ttm:agent="v1"><span begin="2:12.506" end="2:12.602">飛</span><span begin="2:12.602" end="2:12.683">び</span><span begin="2:12.683" end="2:12.968">込ん</span><span begin="2:12.968" end="2:13.173">で</span><span begin="2:13.173" end="2:13.279">い</span><span begin="2:13.279" end="2:13.392">こ</span><span begin="2:13.392" end="2:13.683">う</span> <span begin="2:13.683" end="2:14.052">僕</span><span begin="2:14.052" end="2:14.208">ら</span><span begin="2:14.208" end="2:14.395">の</span><span begin="2:14.395" end="2:14.544">セ</span><span begin="2:14.544" end="2:14.655">カ</span><span begin="2:14.655" end="2:14.840">イ</span><span begin="2:14.840" end="2:15.292">が</span><span ttm:role="x-translation" xml:lang="zh-CN">勇敢飞入 属于我们自己的世界</span></p><p begin="2:15.646" end="2:18.341" itunes:key="L25" ttm:agent="v1"><span begin="2:15.646" end="2:15.836">正</span><span begin="2:15.836" end="2:16.103">解</span><span begin="2:16.103" end="2:16.301">か</span><span begin="2:16.301" end="2:16.412">不</span><span begin="2:16.412" end="2:16.619">正</span><span begin="2:16.619" end="2:16.886">解</span><span begin="2:16.886" end="2:17.157">か</span><span begin="2:17.157" end="2:17.296">わ</span><span begin="2:17.296" end="2:17.422">か</span><span begin="2:17.422" end="2:17.613">ら</span><span begin="2:17.613" end="2:17.726">な</span><span begin="2:17.726" end="2:17.900">く</span><span begin="2:17.900" end="2:18.005">て</span><span begin="2:18.005" end="2:18.341">も</span><span ttm:role="x-translation" xml:lang="zh-CN">尽管你不知是非对错</span></p><p begin="2:18.423" end="2:21.552" itunes:key="L26" ttm:agent="v1"><span begin="2:18.423" end="2:18.763">僕</span><span begin="2:18.763" end="2:18.970">に</span><span begin="2:18.970" end="2:19.294">あ</span><span begin="2:19.294" end="2:19.390">る</span><span begin="2:19.390" end="2:19.636">想</span><span begin="2:19.636" end="2:19.786">い</span><span begin="2:19.786" end="2:19.951">も</span> <span begin="2:19.951" end="2:20.326">君</span><span begin="2:20.326" end="2:20.545">に</span><span begin="2:20.545" end="2:20.791">あ</span><span begin="2:20.791" end="2:20.880">る</span><span begin="2:20.880" end="2:21.223">願</span><span begin="2:21.223" end="2:21.367">い</span><span begin="2:21.367" end="2:21.552">も</span><span ttm:role="x-translation" xml:lang="zh-CN">你怀抱的思念和珍藏已久的心愿</span></p><p begin="2:21.559" end="2:25.347" itunes:key="L27" ttm:agent="v1"><span begin="2:21.559" end="2:21.742">きっ</span><span begin="2:21.742" end="2:21.925">と</span><span begin="2:21.925" end="2:22.126">消</span><span begin="2:22.126" end="2:22.340">え</span><span begin="2:22.340" end="2:22.568">な</span><span begin="2:22.568" end="2:22.832">いん</span><span begin="2:22.832" end="2:22.928">だ</span><span begin="2:22.928" end="2:23.099">よ</span> <span begin="2:23.099" end="2:23.313">ずっ</span><span begin="2:23.313" end="2:23.510">と</span><span begin="2:23.510" end="2:23.699">セ</span><span begin="2:23.699" end="2:23.918">カ</span><span begin="2:23.918" end="2:24.034">イ</span><span begin="2:24.034" end="2:24.208">は</span><span begin="2:24.208" end="2:24.382">終</span><span begin="2:24.382" end="2:24.524">わ</span><span begin="2:24.524" end="2:24.693">ら</span><span begin="2:24.693" end="2:24.811">な</span><span begin="2:24.811" end="2:24.935">い</span><span begin="2:24.935" end="2:25.347">よ</span><span ttm:role="x-translation" xml:lang="zh-CN">都绝不会因此消散</span></p><p begin="2:25.736" end="2:30.967" itunes:key="L28" ttm:agent="v1"><span begin="2:25.736" end="2:26.109">今</span><span begin="2:26.699" end="2:26.889">繋</span><span begin="2:26.889" end="2:27.234">が</span><span begin="2:27.234" end="2:27.442">る</span><span begin="2:27.442" end="2:27.723">よ</span> <span begin="2:28.878" end="2:29.242">今</span><span begin="2:29.880" end="2:30.205">重</span><span begin="2:30.205" end="2:30.391">な</span><span begin="2:30.391" end="2:30.601">る</span><span begin="2:30.601" end="2:30.967">よ</span><span ttm:role="x-translation" xml:lang="zh-CN">此刻相互连结 终于重叠</span></p><p begin="2:32.049" end="2:37.930" itunes:key="L29" ttm:agent="v1"><span begin="2:32.049" end="2:32.203">ほ</span><span begin="2:32.203" end="2:32.461">ら</span><span begin="2:33.036" end="2:33.169">聞</span><span begin="2:33.169" end="2:33.364">こ</span><span begin="2:33.364" end="2:33.550">え</span><span begin="2:33.550" end="2:33.742">る</span><span begin="2:33.742" end="2:34.042">よ</span> <span begin="2:35.205" end="2:35.359">ほ</span><span begin="2:35.359" end="2:35.647">ら</span><span begin="2:36.171" end="2:36.544">伝</span><span begin="2:36.544" end="2:36.741">わ</span><span begin="2:36.741" end="2:36.916">る</span><span begin="2:36.916" end="2:37.345">よ</span><span begin="2:37.345" end="2:37.675">僕</span><span begin="2:37.675" end="2:37.930">ら</span><span ttm:role="x-translation" xml:lang="zh-CN">看 这世间如你所愿</span></p></div></body></tt>