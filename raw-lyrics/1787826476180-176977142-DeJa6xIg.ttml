an><span begin="2:37.645" end="2:37.975">boku</span><span begin="2:37.975" end="2:38.230">ra</span></text></transliteration></transliterations><songwriters><songwriter>DECO*27</songwriter></songwriters></iTunesMetadata></metadata></head><body dur="2:37.930"><div begin="0.391" end="2:37.930"><p begin="0.391" end="9.081" itunes:key="L1" ttm:agent="v1"><span begin="0.391" end="0.706">きっ</span><span begin="0.706" end="1.093">と</span><span begin="2.221" end="2.682">届</span><span begin="2.682" end="2.970">く</span><span begin="2.970" end="3.394">は</span><span begin="3.394" end="3.832">ず</span> <span begin="5.725" end="6.027">きっ</span><span begin="6.027" end="6.459">と</span><span begin="7.545" end="7.693">見</span><span begin="7.693" end="7.972">え</span><span begin="7.972" end="8.287">る</span><span begin="8.287" end="8.669">は</span><span begin="8.669" end="9.081">ず</span><span ttm:role="x-translation" xml:lang="zh-CN">我坚信 你一定能看到</span></p><p begin="9.676" end="15.132" itunes:key="L2" ttm:agent="v1"><span begin="9.676" end="9.979">そん</span><span begin="9.979" end="10.441">な</span><span begin="10.756" end="11.197">会っ</span><span begin="11.197" end="11.263">て</span><span begin="11.263" end="11.416">み</span><span begin="11.416" end="11.548">た</span><span begin="11.548" end="11.709">い</span><span begin="11.709" end="11.891">未</span><span begin="11.891" end="12.182">来</span><span begin="12.182" end="12.452">を</span> <span begin="12.452" end="12.836">僕</span><span begin="12.836" end="13.196">は</span><span begin="13.352" end="13.523">ひ</span><span begin="13.523" end="13.671">と</span><span begin="13.671" end="13.844">り</span><span begin="13.844" end="14.033">き</span><span begin="14.033" end="14.207">り</span><span begin="14.207" end="14.319">の</span><span begin="14.319" end="14.480">セ</span><span begin="14.480" end="14.648">カ</span><span begin="14.648" end="14.891">イ</span><span begin="14.891" end="15.132">で</span><span ttm:role="x-translation" xml:lang="zh-CN">我想在这个世界上独自看到这样的未来</span></p><p begin="15.368" end="19.861" itunes:key="L3" ttm:agent="v1"><span begin="15.368" end="15.627">ずっ</span><span begin="15.627" end="16.027">と</span><span begin="16.390" end="16.609">そ</span><span begin="16.609" end="16.894">う</span><span begin="16.894" end="17.185">歌</span><span begin="17.185" end="17.366">う</span><span begin="17.366" end="17.707">たっ</span><span begin="17.707" end="17.869">て</span><span begin="17.869" end="18.040">い</span><span begin="18.040" end="19.861">た</span><span ttm:role="x-translation" xml:lang="zh-CN">我自始至终歌唱着</span></p><p begin="27.967" end="33.213" itunes:key="L4" ttm:agent="v1"><span begin="27.967" end="28.370">今</span><span begin="28.967" end="29.127">聞</span><span begin="29.127" end="29.333">こ</span><span begin="29.333" end="29.492">え</span><span begin="29.492" end="29.693">た</span><span begin="29.693" end="29.981">よ</span> <span begin="31.193" end="31.350">ほ</span><span begin="31.350" end="31.712">ら</span><span begin="32.210" end="32.517">少</span><span begin="32.517" end="32.739">し</span><span begin="32.739" end="32.922">だ</span><span begin="32.922" end="33.213">け</span><span ttm:role="x-translation" xml:lang="zh-CN">我现在可以隐隐约约听到 你的存在</span></p><p begin="34.040" end="38.937" itunes:key="L5" ttm:agent="v1"><span begin="34.040" end="34.398">君</span><span begin="34.398" end="34.559">を</span><span begin="34.559" end="34.983">感</span><span begin="34.983" end="35.159">じ</span><span begin="35.159" end="35.348">た</span><span begin="35.348" end="35.693">よ</span> <span begin="36.899" end="37.001">メ</span><span begin="37.001" end="37.209">ロ</span><span begin="37.209" end="37.646">ディー</span><span begin="37.646" end="37.811">が</span><span begin="37.811" end="38.253">リン</span><span begin="38.253" end="38.433">ク</span><span begin="38.433" end="38.601">す</span><span begin="38.601" end="38.937">る</span><span ttm:role="x-translation" xml:lang="zh-CN">我感受到了我们的旋律在共鸣</span></p><p begin="40.948" end="46.221" itunes:key="L6" ttm:agent="v1"><span begin="40.948" end="41.320">今</span><span begin="41.908" end="42.291">繋</span><span begin="42.291" end="42.462">が</span><span begin="42.462" end="42.675">る</span><span begin="42.675" end="42.978">よ</span> <span begin="44.204" end="44.648">今</span><span begin="45.212" end="45.504">重</span><span begin="45.504" end="45.699">な</span><span begin="45.699" end="45.912">る</span><span begin="45.912" end="46.221">よ</span><span ttm:role="x-translation" xml:lang="zh-CN">此刻相互连结 终于重叠</span></p><p begin="46.791" end="56.688" itunes:key="L7" ttm:agent="v1"><span begin="46.791" end="47.175">伝</span><span begin="47.175" end="47.331">え</span><span begin="47.331" end="47.523">た</span><span begin="47.523" end="48.010">かっ</span><span begin="48.010" end="48.149">た</span><span begin="48.149" end="48.310">こ</span><span begin="48.310" end="48.662">と</span> <span begin="49.834" end="50.170">山</span><span begin="50.170" end="50.380">ほ</span><span begin="50.380" end="50.584">ど</span><span begin="50.584" end="50.767">あ</span><span begin="50.767" end="51.230">るん</span><span begin="51.230" end="51.424">だ</span><span begin="51.424" end="51.602">け</span><span begin="51.602" end="51.974">ど</span><span begin="52.501" end="52.649">ど</span><span begin="52.649" end="52.819">う</span><span begin="52.819" end="53.021">し</span><span begin="53.021" end="53.170">よ</span><span begin="53.170" end="53.646">う</span> <span begin="55.173" end="56.688">あぁ</span><span ttm:role="x-translation" xml:lang="zh-CN">想说的话堆积如山却不知如何讲起</span></p><p begin="56.281" end="1:02.350" itunes:key="L8" ttm:agent="v1"><span begin="57.731" end="57.896">見</span><span begin="57.896" end="58.055">た</span><span begin="58.055" end="58.445">こ</span><span begin="58.445" end="58.667">と</span><span begin="58.667" end="58.859">も</span><span begin="58.859" end="59.009">な</span><span begin="59.009" end="59.294">い</span><span begin="59.294" end="59.701">顔</span><span begin="59.701" end="59.839">で</span> <span begin="59.839" end="1:00.178">君</span><span begin="1:00.178" end="1:00.367">は</span><span begin="1:00.367" end="1:00.733">君</span><span begin="1:00.733" end="1:00.910">を</span><span begin="1:00.910" end="1:01.087">ダ</span><span begin="1:01.087" end="1:01.291">メ</span><span begin="1:01.291" end="1:01.498">と</span><span begin="1:01.498" end="1:01.743">言</span><span begin="1:01.743" end="1:01.875">う</span><span begin="1:01.875" end="1:02.083">け</span><span begin="1:02.083" end="1:02.350">ど</span><span ttm:role="x-translation" xml:lang="zh-CN">你总用着素未谋面的表情 否定现在的自我</span><span ttm:role="x-bg" begin="56.281" end="57.518"><span begin="56.281" end="56.702">(Say,</span> <span begin="56.702" end="57.272">woh-</span><span begin="57.272" end="57.518">oh)</span></span></p><p begin="1:02.923" end="1:08.739" itunes:key="L9" ttm:agent="v1"><span begin="1:02.923" end="1:03.139">未</span><span begin="1:03.139" end="1:03.481">来</span><span begin="1:03.481" end="1:03.643">に</span><span begin="1:03.643" end="1:03.844">い</span><span begin="1:03.844" end="1:04.048">る</span><span begin="1:04.048" end="1:04.234">理</span><span begin="1:04.234" end="1:04.642">想</span><span begin="1:04.642" end="1:04.876">の</span><span begin="1:04.876" end="1:05.266">君</span><span begin="1:05.266" end="1:05.510">を</span> <span begin="1:05.750" end="1:06.068">今</span><span begin="1:06.068" end="1:06.272">の</span><span begin="1:06.272" end="1:06.674">君</span><span begin="1:06.674" end="1:06.878">に</span><span begin="1:06.878" end="1:07.046">押</span><span begin="1:07.046" end="1:07.250">し</span><span begin="1:07.250" end="1:07.460">付</span><span begin="1:07.460" end="1:07.661">け</span><span begin="1:07.661" end="1:07.862">過</span><span begin="1:07.862" end="1:08.057">ぎ</span><span begin="1:08.057" end="1:08.343">な</span><span begin="1:08.343" end="1:08.508">い</span><span begin="1:08.508" end="1:08.739">で</span><span ttm:role="x-translation" xml:lang="zh-CN">请不要将未来的理想 一股脑地强加给自己</span></p><p begin="1:09.132" end="1:15.046" itunes:key="L10" ttm:agent="v1"><span begin="1:10.530" end="1:10.693">見</span><span begin="1:10.693" end="1:10.867">た</span><span begin="1:10.867" end="1:11.269">こ</span><span begin="1:11.269" end="1:11.467">と</span><span begin="1:11.467" end="1:11.635">も</span><span begin="1:11.635" end="1:11.839">な</span><span begin="1:11.839" end="1:12.013">い</span><span begin="1:12.013" end="1:12.310">景</span><span begin="1:12.310" end="1:12.607">色</span> <span begin="1:12.607" end="1:12.796">見</span><span begin="1:12.796" end="1:13.003">せ</span><span begin="1:13.003" end="1:13.207">合</span><span begin="1:13.207" end="1:13.390">う</span><span begin="1:13.390" end="1:13.582">い</span><span begin="1:13.582" end="1:13.810">つ</span><span begin="1:13.810" end="1:13.990">か</span><span begin="1:13.990" end="1:14.188">が</span><span begin="1:14.188" end="1:14.380">来</span><span begin="1:14.380" end="1:14.602">る</span><span begin="1:14.602" end="1:14.799">ま</span><span begin="1:14.799" end="1:15.046">で</span><span ttm:role="x-translation" xml:lang="zh-CN">那些心碎的瞬间 直到能一起看到新风景的那天来临</span><span ttm:role="x-bg" begin="1:09.132" end="1:10.321"><span begin="1:09.132" end="1:09.520">(Say,</span> <span begin="1:09.520" end="1:10.102">woh-</span><span begin="1:10.102" end="1:10.321">oh)</span></span></p><p begin="1:15.665" end="1:21.277" itunes:key="L11" ttm:agent="v1"><span begin="1:15.665" end="1:15.831">つ</span><span begin="1:15.831" end="1:16.041">ら</span><span begin="1:16.041" end="1:16.185">い</span><span begin="1:16.185" end="1:16.377">こ</span><span begin="1:16.377" end="1:16.578">と</span> <span begin="1:16.578" end="1:16.761">泣</span><span begin="1:16.761" end="1:16.950">き</span><span begin="1:16.950" end="1:17.142">た</span><span begin="1:17.142" end="1:17.349">く</span><span begin="1:17.349" end="1:17.556">な</span><span begin="1:17.556" end="1:17.769">る</span><span begin="1:17.769" end="1:17.952">こ</span><span begin="1:17.952" end="1:18.291">と</span> <span begin="1:18.821" end="1:18.969">た</span><span begin="1:18.969" end="1:19.158">ま</span><span begin="1:19.158" end="1:19.362">に</span><span begin="1:19.362" end="1:19.587">は</span><span begin="1:19.587" end="1:19.979">預</span><span begin="1:19.979" end="1:20.180">け</span><span begin="1:20.180" end="1:20.336">会</span><span begin="1:20.336" end="1:20.509">お</span><span begin="1:20.509" end="1:21.277">う</span><span ttm:role="x-translation" xml:lang="zh-CN">那些让人想哭的瞬间 就让我们互相分担吧</span></p><p begin="1:21.795" end="1:28.017" itunes:key="L12" ttm:agent="v1"><span begin="1:21.795" end="1:21.910">ハ</span><span begin="1:21.910" end="1:23.146">ロー、</span><span begin="1:23.343" end="1:23.473">セ</span><span begin="1:23.473" end="1:23.651">カ</span><span begin="1:23.651" end="1:24.505">イ</span> <span begin="1:24.754" end="1:25.075">僕</span><span begin="1:25.075" end="1:25.249">の</span><span begin="1:25.249" end="1:25.705">声</span><span begin="1:25.705" end="1:25.849">は</span><span begin="1:25.849" end="1:26.281">ちゃん</span><span begin="1:26.281" end="1:26.495">と</span><span begin="1:26.495" end="1:26.984">届</span><span begin="1:26.984" end="1:27.095">い</span><span begin="1:27.095" end="1:27.254">て</span><span begin="1:27.254" end="1:27.455">る</span><span begin="1:27.455" end="1:27.676">か</span><span begin="1:27.676" end="1:28.017">い</span><span ttm:role="x-translation" xml:lang="zh-CN">你好世界 我的声音是否可以真切传达</span></p><p begin="1:28.316" end="1:34.091" itunes:key="L13" ttm:agent="v1"><span begin="1:28.316" end="1:28.901">思っ</span><span begin="1:28.901" end="1:29.039">た</span><span begin="1:29.039" end="1:29.231">よ</span><span begin="1:29.231" end="1:29.420">り</span><span begin="1:29.420" end="1:29.762">も</span><span begin="1:29.888" end="1:30.211">大</span><span begin="1:30.211" end="1:30.658">丈</span><span begin="1:30.658" end="1:31.001">夫</span> <span begin="1:31.001" end="1:31.391">君</span><span begin="1:31.391" end="1:31.556">は</span><span begin="1:31.556" end="1:31.763">ひ</span><span begin="1:31.763" end="1:31.961">と</span><span begin="1:31.961" end="1:32.171">り</spa