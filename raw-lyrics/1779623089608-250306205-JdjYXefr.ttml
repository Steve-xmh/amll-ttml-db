<tt xmlns="http://www.w3.org/ns/ttml" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xmlns:amll="http://www.example.com/ns/amll" itunes:timing="Word" xml:lang="en"><head><metadata><ttm:agent type="person" xml:id="v1"/><amll:meta key="musicName" value="Blade Of Grass (Apple Music Live)"/><amll:meta key="artists" value="Lady Gaga"/><amll:meta key="artists" value="レディー・ガガ"/><amll:meta key="album" value="Apple Music Live: MAYHEM Requiem"/><amll:meta key="isrc" value="USUM72603845"/><amll:meta key="appleMusicId" value="6768201934"/><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal"><songwriters><songwriter>Andrew Watt</songwriter><songwriter>Lady Gaga</songwriter><songwriter>Michael Polansky</songwriter><songwriter>Mike Levy</songwriter></songwriters></iTunesMetadata></metadata></head><body dur="4:00.506"><div begin="0.200" end="15.371" itunes:songPart="Verse"><p begin="0.200" end="6.523" itunes:key="L1" ttm:agent="v1"><span begin="0.200" end="1.352">Lovers</span> <span begin="1.352" end="1.885">kiss</span> <span begin="1.885" end="2.101">in</span> <span begin="2.101" end="2.333">a</span> <span begin="2.333" end="3.288">garden</span> <span begin="3.288" end="3.885">made</span> <span begin="3.885" end="4.403">of</span> <span begin="4.403" end="6.523">thorns</span><span ttm:role="x-translation" xml:lang="zh-Hans">恋人在荆棘丛生的花园中相拥亲吻</span></p><p begin="8.821" end="15.371" itunes:key="L2" ttm:agent="v1"><span begin="8.821" end="9.725">Traces</span> <span begin="9.725" end="9.992">of</span> <span begin="9.992" end="10.858">lonely</span> <span begin="10.858" end="11.658">words,</span> <span begin="11.658" end="13.706">illusions</span> <span begin="13.706" end="15.371">torn</span><span ttm:role="x-translation" xml:lang="zh-Hans">落寞低语余痕犹在 种种幻象皆已破碎</span></p></div><div begin="16.472" end="33.021" itunes:songPart="PreChorus"><p begin="16.472" end="24.621" itunes:key="L3" ttm:agent="v1"><span begin="16.472" end="16.981">You</span> <span begin="16.981" end="17.715">said,</span> <span begin="17.715" end="18.165">&quot;How</span> <span begin="18.165" end="18.480">does</span> <span begin="18.480" end="18.749">a</span> <span begin="18.749" end="19.331">man</span> <span begin="19.331" end="19.848">like</span> <span begin="19.848" end="20.331">me</span> <span begin="20.331" end="20.648">love</span> <span begin="20.648" end="21.296">a</span> <span begin="21.296" end="21.851">wo</span><span begin="21.851" end="22.464">man</span> <span begin="22.464" end="23.016">like</span> <span begin="23.016" end="24.621">you?&quot;</span><span ttm:role="x-translation" xml:lang="zh-Hans">你说 “像我这样的男人 怎配爱你这样的女人”</span></p><p begin="25.272" end="33.021" itunes:key="L4" ttm:agent="v1"><span begin="25.272" end="25.768">I</span> <span begin="25.768" end="26.467">said,</span> <span begin="26.467" end="26.933">&quot;Hold</span> <span begin="26.933" end="27.235">me</span> <span begin="27.235" end="28.051">until</span> <span begin="28.051" end="28.667">I</span> <span begin="28.667" end="29.200">die,</span> <span begin="29.200" end="29.451">and</span> <span begin="29.451" end="30.032">I&apos;ll</span> <span begin="30.032" end="30.667">make</span> <span begin="30.667" end="31.186">you</span> <span begin="31.235" end="31.752">brand</span> <span begin="31.752" end="33.021">new&quot;</span><span ttm:role="x-translation" xml:lang="zh-Hans">我说 “抱紧我 直至生命尽头 我会让你重获新生”</span></p></div><div begin="33.421" end="1:06.555" itunes:songPart="Chorus"><p begin="33.421" end="37.937" itunes:key="L5" ttm:agent="v1"><span begin="33.421" end="33.778">Come</span> <span begin="33.778" end="34.344">on</span> <span begin="34.344" end="34.954">and</span> <span begin="35.224" end="35.706">wrap</span> <span begin="35.706" end="36.224">that</span> <span begin="36.224" end="36.792">blade</span> <span begin="36.792" end="37.074">of</span> <span begin="37.074" end="37.937">grass</span><span ttm:role="x-translation" xml:lang="zh-Hans">来吧 取一叶青草</span></p><p begin="37.937" end="42.208" itunes:key="L6" ttm:agent="v1"><span begin="37.937" end="38.782">Around</span> <span begin="38.782" end="39.294">my</span> <span begin="39.564" end="40.513">finger</span> <span begin="40.513" end="41.062">like</span> <span begin="41.062" end="41.329">a</span> <span begin="41.329" end="42.208">cast</span><span ttm:role="x-translation" xml:lang="zh-Hans">绕在我的指间</span></p><p begin="42.208" end="46.604" itunes:key="L7" ttm:agent="v1"><span begin="42.208" end="42.528">&apos;Cause</span> <span begin="42.528" end="43.664">even</span> <span begin="43.785" end="44.361">though</span> <span begin="44.361" end="44.660">the</span> <span begin="44.660" end="45.244">church</span> <span begin="45.244" end="45.777">burned</span> <span begin="45.777" end="46.604">down</span><span ttm:role="x-translation" xml:lang="zh-Hans">纵使教堂夷为废墟</span></p><p begin="46.604" end="50.907" itunes:key="L8" ttm:agent="v1"><span begin="46.604" end="46.900">I&apos;ll</span> <span begin="46.900" end="47.468">be</span> <span begin="47.468" end="47.927">your</span> <span begin="48.095" end="48.751">queen</span> <span begin="48.751" end="49.849">without</span> <span begin="49.849" end="50.100">a</span> <span begin="50.100" end="50.907">crown</span><span ttm:role="x-translation" xml:lang="zh-Hans">我也愿做你的无冕女王</span></p><p begin="50.907" end="55.123" itunes:key="L9" ttm:agent="v1"><span begin="50.907" end="51.291">I&apos;ve</span> <span begin="51.291" end="51.598">been</span> <span begin="51.598" end="52.425">so</span> <span begin="52.667" end="53.483">lonely</span> <span begin="53.483" end="53.992">in</span> <span begin="53.992" end="54.475">this</span> <span begin="54.475" end="55.123">field</span><span ttm:role="x-translation" xml:lang="zh-Hans">我在这片荒野独自游荡</span></p><p begin="55.253" end="59.371" itunes:key="L10" ttm:agent="v1"><span begin="55.253" end="56.336">Fighting</span> <span begin="56.336" end="56.821">a</span> <span begin="56.821" end="57.704">battle</span> <span begin="57.704" end="58.253">with</span> <span begin="58.253" end="58.672">no</span> <span begin="58.672" end="59.371">shield</span><span ttm:role="x-translation" xml:lang="zh-Hans">奔赴没有盾牌可挡的战场</span></p><p begin="59.504" end="1:04.104" itunes:key="L11" ttm:agent="v1"><span begin="59.504" end="59.888">Come</span> <span begin="59.888" end="1:00.488">on</span> <span begin="1:00.488" end="1:01.067">and</span> <span begin="1:01.325" end="1:01.875">wrap</span> <span begin="1:01.875" end="1:02.357">that</span> <span begin="1:02.357" end="1:02.893">blade</span> <span begin="1:02.893" end="1:03.125">of</span> <span begin="1:03.125" end="1:04.104">grass</span><span ttm:role="x-translation" xml:lang="zh-Hans">来吧 取一叶青草</span></p><p begin="1:04.104" end="1:06.555" itunes:key="L12" ttm:agent="v1"><span begin="1:04.104" end="1:04.341">And</span> <span begin="1:04.341" end="1:04.525">we&apos;ll</span> <span begin="1:04.525" end="1:04.827">make</span> <span begin="1:04.827" end="1:05.043">it</span> <span begin="1:05.043" end="1:06.555">last</span><span ttm:role="x-translation" xml:lang="zh-Hans">我们会让这份情意永恒</span></p></div><div begin="1:09.955" end="1:25.605" itunes:songPart="Verse"><p begin="1:09.955" end="1:17.056" itunes:key="L13" ttm:agent="v1"><span begin="1:09.955" end="1:10.568">This</span> <span begin="1:10.568" end="1:10.819">is</span> <span begin="1:10.819" end="1:11.054">the</span> <span begin="1:11.054" end="1:11.736">lawn</span> <span begin="1:11.736" end="1:12.054">of</span> <span begin="1:12.054" end="1:13.518">memories</span> <span begin="1:13.518" end="1:13.971">I</span> <span begin="1:13.971" end="1:17.056">mourn</span><span ttm:role="x-translation" xml:lang="zh-Hans">这片草坪承载着我追忆的过往</span></p><p begin="1:18.721" end="1:25.605" itunes:key="L14" ttm:agent="v1"><span begin="1:18.721" end="1:19.340">I</span> <span begin="1:19.340" end="1:19.708">fall</span> <span begin="1:19.708" end="1:20.142">into</span> <span begin="1:20.142" end="1:20.657">your</span> <span begin="1:20.657" end="1:21.457">eyes,</span> <span begin="1:21.457" end="1:22.156">shelter</span> <span begin="1:22.156" end="1:22.758">from</span> <span begin="1:22.758" end="1:25.605">storm</span><span ttm:role="x-translation" xml:lang="zh-Hans">我沦陷在你的眼眸 那是风暴中的避风港</span></p></div><div begin="1:26.307" end="1:42.821" itunes:songPart="PreChorus"><p begin="1:26.307" end="1:33.923" itunes:key="L15" ttm:agent="v1"><span begin="1:26.307" end="1:26.875">You</span> <span begin="1:26.875" end="1:27.459">said,</span> <span begin="1:27.459" end="1:28.043">&quot;How</span> <span begin="1:28.043" end="1:28.243">does</span> <span begin="1:28.243" end="1:28.475">a</span> <span begin="1:28.475" end="1:29.142">man</span> <span begin="1:29.142" end="1:29.643">like</span> <span begin="1:29.643" end="1:30.192">me</span> <span begin="1:30.192" end="1:30.542">love</span> <span begin="1:30.542" end="1:31.126">a</span> <span begin="1:31.126" end="1:32.160">woman</span> <span begin="1:32.160" end="1:32.742">like</span> <span begin="1:32.742" end="1:33.923">you?&quot;</span><span ttm:role="x-translation" xml:lang="zh-Hans">你说 “像我这样的男人 怎配爱你这样的女人”</span></p><p begin="1:34.956" end="1:42.821" itunes:key="L16" ttm:agent="v1"><span begin="1:34.956" end="1:35.615">I</span> <span begin="1:35.615" end="1:36.164">said,</span> <span begin="1:36.164" end="1:36.615">&quot;Hold</span> <span begin="1:36.615" end="1:36.980">me</span> <span begin="1:36.980" end="1:37.799">until</span> <span begin="1:37.799" end="1:38.383">I</span> <span begin="1:38.383" end="1:38.799">die,</span> <span begin="1:38.825" end="1:39.164">and</span> <span begin="1:39.164" end="1:39.732">I&apos;ll</span> <span begin="1:39.732" end="1:40.316">make</span> <span begin="1:40.316" end="1:40.897">you</span> <span begin="1:40.897" end="1:41.449">brand</span> <span begin="1:41.449" end="1:42.821">new&quot;</span><span ttm:role="x-translation" xml:lang="zh-Hans">我说 “抱紧我 直至生命尽头 我会让你重获新生”</span></p></div><div begin="1:43.221" end="2:25.189" itunes:songPart="Chorus"><p begin="1:43.221" end="1:47.704" itunes:key="L17" ttm:agent="v1"><span begin="1:43.221" end="1:43.640">Come</span> <span begin="1:43.640" end="1:44.224">on</span> <span begin="1:44.224" end="1:44.704">and</span> <span begin="1:44.872" end="1:45.445">wrap</span> <span begin="1:45.445" end="1:45.994">that</span> <span begin="1:45.994" end="1:46.560">blade</span> <span begin="1:46.560" end="1:46.794">of</span> <span begin="1:46.794" end="1:47.704">grass</span><span ttm:role="x-translation" xml:lang="zh-Hans">来吧 取一叶青草</span></p><p begin="1:47.704" end="1:52.004" itunes:key="L18" ttm:agent="v1"><span begin="1:47.704" end="1:48.507">Around</span> <span begin="1:48.507" end="1:49.077">my</span> <span begin="1:49.301" end="1:50.395">finger</span> <span begin="1:50.395" end="1:50.941">like</span> <span begin="1:50.941" end="1:51.221">a</span> <span begin="1:51.221" end="1:52.004">cast</span><span ttm:role="x-translation" xml:lang="zh-Hans">绕在我的指间</span></p><p begin="1:52.004" end="1:56.323" itunes:key="L19" ttm:agent="v1"><span begin="1:52.004" end="1:52.393">&apos;Cause</span> <span begin="1:52.393" end="1:53.308">even</span> <span begin="1:53.671" end="1:54.113">though</span> <span begin="1:54.113" end="1:54.361">the</span> <span begin="1:54.361" end="1:54.980">church</span> <span begin="1:54.980" end="1:55.561">burned</span> <span begin="1:55.561" end="1:56.323">down</span><span ttm:role="x-translation" xml:lang="zh-Hans">纵使教堂夷为废墟</span></p><p begin="1:56.323" end="2:00.704" itunes:key="L20" ttm:agent="v1"><span begin="1:56.323" end="1:56.688">I&apos;ll</span> <span begin="1:56.688" end="1:57.187">be</span> <span begin="1:57.187" end="1:57.752">your</span> <span begin="1:58.027" end="1:58.560">queen</span> <span begin="1:58.560" end="1:59.659">without</span> <span begin="1:59.659" end="1:59.926">a</span> <span begin="1:59.926" end="2:00.704">crown</span><span ttm:role="x-translation" xml:lang="zh-Ha