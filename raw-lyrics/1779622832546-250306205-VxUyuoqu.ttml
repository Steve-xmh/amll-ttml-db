<tt xmlns="http://www.w3.org/ns/ttml" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xmlns:amll="http://www.example.com/ns/amll" itunes:timing="Word" xml:lang="en"><head><metadata><ttm:agent type="person" xml:id="v1"/><amll:meta key="musicName" value="How Bad Do U Want Me (Apple Music Live)"/><amll:meta key="artists" value="Lady Gaga"/><amll:meta key="artists" value="レディー・ガガ"/><amll:meta key="album" value="Apple Music Live: MAYHEM Requiem"/><amll:meta key="isrc" value="USUM72603839"/><amll:meta key="appleMusicId" value="6768201920"/><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal"><songwriters><songwriter>Andrew Watt</songwriter><songwriter>Henry Russell Walter</songwriter><songwriter>Lady Gaga</songwriter><songwriter>Michael Polansky</songwriter></songwriters></iTunesMetadata></metadata></head><body dur="4:32.642"><div begin="1.882" end="21.624" itunes:songPart="Verse"><p begin="1.882" end="7.379" itunes:key="L1" ttm:agent="v1"><span begin="1.882" end="2.043">The</span> <span begin="2.043" end="2.427">good</span> <span begin="2.427" end="3.139">girl</span> <span begin="3.139" end="3.779">in</span> <span begin="3.779" end="4.779">your</span> <span begin="4.779" end="7.379">dreams</span><span ttm:role="x-translation" xml:lang="zh-Hans">你梦里的那个乖女孩</span></p><p begin="8.040" end="12.875" itunes:key="L2" ttm:agent="v1"><span begin="8.040" end="8.448">Is</span> <span begin="8.448" end="8.832">mad</span> <span begin="8.832" end="9.565">you&apos;re</span> <span begin="9.565" end="11.048">loving</span> <span begin="11.048" end="12.875">me</span><span ttm:role="x-translation" xml:lang="zh-Hans">因你爱上我而怒火中烧</span></p><p begin="13.456" end="17.830" itunes:key="L3" ttm:agent="v1"><span begin="13.456" end="13.730">I</span> <span begin="13.730" end="14.082">know</span> <span begin="14.082" end="14.448">you</span> <span begin="14.448" end="15.077">wish</span> <span begin="15.077" end="15.709">that</span> <span begin="15.709" end="16.343">she</span> <span begin="16.343" end="17.159">was</span> <span begin="17.159" end="17.830">me</span><span ttm:role="x-translation" xml:lang="zh-Hans">我知道你多希望她是我</span></p><p begin="17.942" end="21.624" itunes:key="L4" ttm:agent="v1"><span begin="17.942" end="18.355">How</span> <span begin="18.355" end="18.947">bad,</span> <span begin="19.171" end="19.489">bad</span> <span begin="19.489" end="19.705">do</span> <span begin="19.705" end="19.955">you</span> <span begin="19.955" end="20.339">want</span> <span begin="20.339" end="21.624">me?</span><span ttm:role="x-translation" xml:lang="zh-Hans">你到底有多渴望我 渴望我</span></p></div><div begin="26.169" end="43.758" itunes:songPart="Verse"><p begin="26.169" end="31.086" itunes:key="L5" ttm:agent="v1"><span begin="26.169" end="26.308">You&apos;re</span> <span begin="26.308" end="26.756">not</span> <span begin="26.756" end="27.374">the</span> <span begin="27.374" end="28.073">guy</span> <span begin="28.073" end="28.774">that</span> <span begin="28.774" end="31.086">cheats</span><span ttm:role="x-translation" xml:lang="zh-Hans">你不是玩弄真心的渣男</span></p><p begin="31.270" end="36.187" itunes:key="L6" ttm:agent="v1"><span begin="31.270" end="31.464">And</span> <span begin="31.464" end="31.632">you&apos;re</span> <span begin="31.632" end="32.149">afraid</span> <span begin="32.149" end="32.733">that</span> <span begin="32.733" end="33.503">she</span> <span begin="33.503" end="34.250">might</span> <span begin="34.250" end="36.187">leave</span><span ttm:role="x-translation" xml:lang="zh-Hans">可你害怕她转身离开</span></p><p begin="36.315" end="40.806" itunes:key="L7" ttm:agent="v1"><span begin="36.315" end="36.656">&apos;Cause</span> <span begin="36.656" end="37.022">if</span> <span begin="37.022" end="37.488">I</span> <span begin="37.488" end="37.923">get</span> <span begin="37.923" end="38.571">too</span> <span begin="38.571" end="39.238">close,</span> <span begin="39.238" end="39.920">she</span> <span begin="39.920" end="40.806">screams</span><span ttm:role="x-translation" xml:lang="zh-Hans">如果我靠太近 她就会尖叫</span></p><p begin="40.875" end="43.758" itunes:key="L8" ttm:agent="v1"><span begin="40.875" end="41.238">How</span> <span begin="41.238" end="41.718">bad,</span> <span begin="41.987" end="42.286">bad</span> <span begin="42.286" end="42.470">do</span> <span begin="42.470" end="42.654">you</span> <span begin="42.654" end="42.987">want</span> <span begin="42.987" end="43.758">me?</span><span ttm:role="x-translation" xml:lang="zh-Hans">你到底有多渴望我 渴望我</span></p></div><div begin="48.901" end="1:28.923" itunes:songPart="Chorus"><p begin="48.901" end="52.002" itunes:key="L9" ttm:agent="v1"><span begin="48.901" end="49.037">&apos;Cause</span> <span begin="49.037" end="49.370">you</span> <span begin="49.370" end="49.769">like</span> <span begin="49.769" end="50.036">my</span> <span begin="50.036" end="50.370">hair</span> <span begin="50.370" end="50.637">and</span> <span begin="50.637" end="50.876">my</span> <span begin="50.876" end="51.077">ripped</span> <span begin="51.077" end="51.422">up</span> <span begin="51.422" end="52.002">jeans</span><span ttm:role="x-translation" xml:lang="zh-Hans">因为你喜欢我的发型和我的破洞牛仔裤</span></p><p begin="52.002" end="54.673" itunes:key="L10" ttm:agent="v1"><span begin="52.002" end="52.145">You</span> <span begin="52.145" end="52.452">like</span> <span begin="52.452" end="52.807">the</span> <span begin="52.868" end="53.211">bad</span> <span begin="53.211" end="53.506">girl</span> <span begin="53.506" end="53.732">I</span> <span begin="53.732" end="53.958">got</span> <span begin="53.958" end="54.348">in</span> <span begin="54.348" end="54.673">me</span><span ttm:role="x-translation" xml:lang="zh-Hans">你喜欢我骨子里那股坏女孩的劲儿</span></p><p begin="54.673" end="57.304" itunes:key="L11" ttm:agent="v1"><span begin="54.673" end="54.944">She&apos;s</span> <span begin="54.944" end="55.358">on</span> <span begin="55.358" end="55.584">your</span> <span begin="55.584" end="55.932">mind</span> <span begin="55.932" end="56.384">like</span> <span begin="56.384" end="56.729">all</span> <span begin="56.729" end="56.958">the</span> <span begin="56.958" end="57.304">time</span><span ttm:role="x-translation" xml:lang="zh-Hans">她在你的脑海中挥之不去</span></p><p begin="57.304" end="1:00.171" itunes:key="L12" ttm:agent="v1"><span begin="57.304" end="57.471">But</span> <span begin="57.471" end="57.765">I</span> <span begin="57.765" end="58.098">got</span> <span begin="58.098" end="58.324">a</span> <span begin="58.324" end="58.898">tattoo</span> <span begin="58.898" end="59.139">for</span> <span begin="59.139" end="59.419">us</span> <span begin="59.419" end="59.792">last</span> <span begin="59.792" end="1:00.171">week</span><span ttm:role="x-translation" xml:lang="zh-Hans">而我上周去画了一个属于咱俩的印记</span></p><p begin="1:00.171" end="1:02.969" itunes:key="L13" ttm:agent="v1"><span begin="1:00.171" end="1:00.874">Even</span> <span begin="1:00.874" end="1:01.410">good</span> <span begin="1:01.539" end="1:02.138">boys</span> <span begin="1:02.220" end="1:02.969">bleed</span><span ttm:role="x-translation" xml:lang="zh-Hans">就算是好男孩也会为爱受伤</span></p><p begin="1:02.969" end="1:07.141" itunes:key="L14" ttm:agent="v1"><span begin="1:02.969" end="1:03.287">How</span> <span begin="1:03.287" end="1:03.809">bad,</span> <span begin="1:03.968" end="1:04.288">bad</span> <span begin="1:04.288" end="1:04.448">do</span> <span begin="1:04.448" end="1:04.661">you</span> <span begin="1:04.661" end="1:05.034">want</span> <span begin="1:05.034" end="1:07.141">me?</span><span ttm:role="x-translation" xml:lang="zh-Hans">你到底有多渴望我 渴望我</span></p><p begin="1:10.892" end="1:13.789" itunes:key="L15" ttm:agent="v1"><span begin="1:10.892" end="1:11.043">&apos;Cause</span> <span begin="1:11.043" end="1:11.498">you</span> <span begin="1:11.498" end="1:11.818">hate</span> <span begin="1:11.818" end="1:12.003">the</span> <span begin="1:12.003" end="1:12.270">crash,</span> <span begin="1:12.270" end="1:12.430">but</span> <span begin="1:12.430" end="1:12.778">you</span> <span begin="1:12.778" end="1:13.123">love</span> <span begin="1:13.123" end="1:13.311">the</span> <span begin="1:13.311" end="1:13.789">rush</span><span ttm:role="x-translation" xml:lang="zh-Hans">因为你讨厌感情破裂的痛苦 却又痴迷于激情碰撞的快感</span></p><p begin="1:13.789" end="1:17.773" itunes:key="L16" ttm:agent="v1"><span begin="1:13.789" end="1:13.903">And</span> <span begin="1:13.903" end="1:14.210">I&apos;ll</span> <span begin="1:14.210" end="1:14.517">make</span> <span begin="1:14.517" end="1:14.717">your</span> <span begin="1:14.717" end="1:15.076">heart</span> <span begin="1:15.076" end="1:15.442">weak</span> <span begin="1:15.442" end="1:16.015">every</span> <span begin="1:16.015" end="1:16.370">time</span> <span begin="1:16.482" end="1:16.869">you</span> <span begin="1:16.869" end="1:17.189">hear</span> <span begin="1:17.189" end="1:17.402">my</span> <span begin="1:17.402" end="1:17.773">name</span><span ttm:role="x-translation" xml:lang="zh-Hans">每一次听到我的名字 你的心都会不由自主地柔软</span></p><p begin="1:17.773" end="1:21.888" itunes:key="L17" ttm:agent="v1"><span begin="1:17.773" end="1:17.883">&apos;Cause</span> <span begin="1:17.883" end="1:18.188">she&apos;s</span> <span begin="1:18.284" end="1:18.591">in</span> <span begin="1:18.591" end="1:18.789">your</span> <span begin="1:18.789" end="1:19.150">brain,</span> <span begin="1:19.150" end="1:19.323">and</span> <span begin="1:19.323" end="1:19.530">I&apos;m</span> <span begin="1:19.602" end="1:19.937">here</span> <span begin="1:19.937" end="1:20.163">to</span> <span begin="1:20.163" end="1:20.430">kiss</span> <span begin="1:20.430" end="1:20.777">you</span> <span begin="1:20.777" end="1:21.084">in</span> <span begin="1:21.084" end="1:21.483">real</span> <span begin="1:21.483" end="1:21.888">life</span><span ttm:role="x-translation" xml:lang="zh-Hans">因为她的影子还在你脑海里 而我此刻就在你面前 要与你真实相吻</span></p><p begin="1:21.963" end="1:24.515" itunes:key="L18" ttm:agent="v1"><span begin="1:21.963" end="1:22.292">&apos;Bout</span> <span begin="1:22.292" end="1:22.691">to</span> <span begin="1:22.691" end="1:23.265">cause</span> <span begin="1:23.265" end="1:23.892">a</span> <span begin="1:23.892" end="1:24.515">scene</span><span ttm:role="x-translation" xml:lang="zh-Hans">一场风波即将上演</span></p><p begin="1:24.640" end="1:28.923" itunes:key="L19" ttm:agent="v1"><span begin="1:24.640" end="1:25.043">How</span> <span begin="1:25.043" end="1:25.709">bad,</span> <span begin="1:25.709" end="1:26.069">bad</span> <span begin="1:26.069" end="1:26.229">do</span> <span begin="1:26.229" end="1:26.468">you</span> <span begin="1:26.468" end="1:26.803">want</span> <span begin="1:26.803" end="1:28.923">me?</span><span ttm:role="x-translation" xml:lang="zh-Hans">你到底有多渴望我 渴望我</span></p></div><div begin="2:03.973" end="2:19.887" itunes:songPart="Verse"><p begin="2:03.973" end="2:10.195" itunes:key="L20" ttm:agent="v1"><span begin="2:03.973" end="2:04.132">You</span> <span begin="2:04.132" end="2:05.024">panic</span> <span begin="2:05.050" end="2:05.624">in</span> <span begin="2:05.624" end="2:06.211">your</span> <span begin="2:06.211" end="2:08.283">sleep</span><span ttm:role="x-translation" xml:lang="zh-Hans">你在睡梦中惊慌失措</span><span ttm:role="x-bg" begin="2:06.600" end="2:10.195"><span begin="2:06.600" end="2:07.635">(Panic</span> <span begin="2:07.635" end="2:08.402">in</span> <span begin="2:08.402" end="2:08.806">your</span> <span begin="2:08.806" end="2:10.195">sleep)</span><span ttm:role="x-translation" xml:lang="zh-Hans">在睡梦中惊慌失措</span></span></p><p begin="2:08.805" end="2:15.835" itunes:key="L21" ttm:agent="v1"><span begin="2:08.805" end="2:08.977">And</span> <span begin="2:08.977" end="2:09.190">you</span> <span begin="2:09.190" end="2:09.523">feel</span> <span begin="2:09.523" end="2:10.150">like</span> <span begin="2:10.150" end="2:10.790">such</span> <span begin="2:10.790" end="2:11.430">a</span> <span begin="2:11.430" end="2:13.069"