<tt xmlns="http://www.w3.org/ns/ttml" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xmlns:amll="http://www.example.com/ns/amll" itunes:timing="Word"><head><metadata><ttm:agent type="person" xml:id="v1"/><amll:meta key="musicName" value="Sealed with a Kiss"/><amll:meta key="artists" value="Bobby Vinton"/><amll:meta key="album" value="Sealed With A Kiss"/><amll:meta key="isrc" value="MXF551258248"/><amll:meta key="isrc" value="GBHQC0586386"/><amll:meta key="appleMusicId" value="1404501535"/><amll:meta key="ncmMusicId" value="1116127"/><amll:meta key="ncmMusicId" value="1116087"/><amll:meta key="ncmMusicId" value="1298967681"/><amll:meta key="ncmMusicId" value="1849549845"/><amll:meta key="ncmMusicId" value="484104351"/><amll:meta key="ncmMusicId" value="562313154"/><amll:meta key="ncmMusicId" value="16604274"/><amll:meta key="ncmMusicId" value="509851441"/><amll:meta key="ncmMusicId" value="3375550100"/><amll:meta key="ncmMusicId" value="1298919577"/><amll:meta key="ncmMusicId" value="1902978708"/><amll:meta key="ncmMusicId" value="493046836"/><amll:meta key="ncmMusicId" value="1398274521"/><amll:meta key="ncmMusicId" value="28124323"/><amll:meta key="ncmMusicId" value="1392824026"/><amll:meta key="ncmMusicId" value="1308903502"/><amll:meta key="qqMusicId" value="002KenA83pvHHk"/><amll:meta key="qqMusicId" value="000NDPFo1BQaRb"/><amll:meta key="qqMusicId" value="003d7Puf0hZN2B"/><amll:meta key="qqMusicId" value="003Qcfqm22JAth"/><amll:meta key="ttmlAuthorGithub" value="85813508"/><amll:meta key="ttmlAuthorGithubLogin" value="dontknowhy"/><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal"><songwriters><songwriter>Bobby Vinton</songwriter><songwriter>Peter Udell</songwriter><songwriter>Gary Geld</songwriter></songwriters></iTunesMetadata></metadata></head><body dur="2:44.937"><div begin="15.783" end="2:44.937"><p begin="15.783" end="23.138" itunes:key="L1" ttm:agent="v1"><span begin="15.783" end="16.244">Though</span> <span begin="16.244" end="16.489">we&apos;ve</span> <span begin="16.489" end="16.998">got</span><span begin="16.998" end="17.155">ta</span> <span begin="17.155" end="17.782">say</span> <span begin="17.782" end="18.088">good</span><span begin="18.088" end="20.213">bye</span> <span begin="20.213" end="20.632">for</span> <span begin="20.632" end="20.797">the</span> <span begin="20.797" end="21.358">sum</span><span begin="21.358" end="23.138">mer</span><span ttm:role="x-translation" xml:lang="zh-CN">虽然我们不得不在这个夏天告别</span></p><p begin="23.709" end="27.417" itunes:key="L2" ttm:agent="v1"><span begin="23.709" end="24.887">Baby,</span> <span begin="24.887" end="25.247">I</span> <span begin="25.247" end="26.282">promise</span> <span begin="26.282" end="26.677">you</span> <span begin="26.677" end="27.417">this</span><span ttm:role="x-translation" xml:lang="zh-CN">宝贝，我向你保证</span></p><p begin="27.715" end="35.870" itunes:key="L3" ttm:agent="v1"><span begin="27.715" end="27.982">I&apos;ll</span> <span begin="27.982" end="28.417">send</span> <span begin="28.417" end="28.754">you</span> <span begin="28.754" end="29.152">all</span> <span begin="29.152" end="29.507">my</span> <span begin="29.507" end="31.199">love</span> <span begin="31.596" end="32.302">every</span> <span begin="32.302" end="33.023">day</span> <span begin="33.023" end="33.400">in</span> <span begin="33.400" end="33.755">a</span> <span begin="33.755" end="34.460">let</span><span begin="34.460" end="35.870">ter</span><span ttm:role="x-translation" xml:lang="zh-CN">我会每天在信里寄去我所有的爱</span></p><p begin="36.317" end="38.521" itunes:key="L4" ttm:agent="v1"><span begin="36.317" end="37.222">Sealed</span> <span begin="37.222" end="37.571">with</span> <span begin="37.571" end="37.926">a</span> <span begin="37.926" end="38.521">kiss</span><span ttm:role="x-translation" xml:lang="zh-CN">以吻封缄</span></p><p begin="38.552" end="45.414" itunes:key="L5" ttm:agent="v1"><span begin="38.552" end="39.022">Yes,</span> <span begin="39.022" end="39.327">it&apos;s</span> <span begin="39.327" end="40.032">gonna</span> <span begin="40.032" end="40.422">be</span> <span begin="40.422" end="40.712">a</span> <span begin="40.712" end="42.741">cold,</span> <span begin="42.741" end="43.163">lone</span><span begin="43.163" end="43.418">ly</span> <span begin="43.418" end="43.936">sum</span><span begin="43.936" end="45.414">mer</span><span ttm:role="x-translation" xml:lang="zh-CN">是的，这将是一个寒冷而寂寞的夏天</span></p><p begin="46.079" end="49.783" itunes:key="L6" ttm:agent="v1"><span begin="46.079" end="46.372">But</span> <span begin="46.372" end="47.060">I&apos;ll</span> <span begin="47.060" end="47.505">fill</span> <span begin="47.505" end="47.853">the</span> <span begin="47.853" end="49.133">empti</span><span begin="49.133" end="49.783">ness</span><span ttm:role="x-translation" xml:lang="zh-CN">但我会填补那份空虚</span></p><p begin="50.130" end="58.259" itunes:key="L7" ttm:agent="v1"><span begin="50.130" end="50.410">I&apos;ll</span> <span begin="50.410" end="50.831">send</span> <span begin="50.831" end="51.208">you</span> <span begin="51.208" end="51.627">all</span> <span begin="51.627" end="51.928">my</span> <span begin="51.928" end="53.658">dreams</span> <span begin="53.992" end="54.807">every</span> <span begin="54.807" end="55.429">day</span> <span begin="55.429" end="55.774">in</span> <span begin="55.774" end="56.145">a</span> <span begin="56.145" end="56.869">let</span><span begin="56.869" end="58.259">ter</span><span ttm:role="x-translation" xml:lang="zh-CN">我会每天在信里寄去我所有的梦</span></p><p begin="58.769" end="1:02.337" itunes:key="L8" ttm:agent="v1"><span begin="58.769" end="59.684">Sealed</span> <span begin="59.684" end="59.994">with</span> <span begin="59.994" end="1:00.260">a</span> <span begin="1:00.260" end="1:02.337">kiss</span><span ttm:role="x-translation" xml:lang="zh-CN">以吻封缄</span></p><p begin="1:02.771" end="1:08.101" itunes:key="L9" ttm:agent="v1"><span begin="1:02.771" end="1:03.026">I&apos;ll</span> <span begin="1:03.026" end="1:03.896">see</span> <span begin="1:03.896" end="1:05.251">you</span> <span begin="1:05.251" end="1:05.586">in</span> <span begin="1:05.586" end="1:05.741">the</span> <span begin="1:05.741" end="1:06.664">sun</span><span begin="1:06.664" end="1:08.101">light</span><span ttm:role="x-translation" xml:lang="zh-CN">我会在阳光里看见你</span></p><p begin="1:08.422" end="1:13.505" itunes:key="L10" ttm:agent="v1"><span begin="1:08.422" end="1:08.751">I&apos;ll</span> <span begin="1:08.751" end="1:09.422">hear</span> <span begin="1:09.422" end="1:10.062">your</span> <span begin="1:10.062" end="1:10.775">voice</span> <span begin="1:10.775" end="1:11.480">every</span><span begin="1:11.480" end="1:13.505">where</span><span ttm:role="x-translation" xml:lang="zh-CN">我会在四处听见你的声音</span></p><p begin="1:13.865" end="1:19.002" itunes:key="L11" ttm:agent="v1"><span begin="1:13.865" end="1:14.216">I&apos;ll</span> <span begin="1:14.216" end="1:15.201">run</span> <span begin="1:15.201" end="1:15.564">to</span> <span begin="1:15.564" end="1:16.242">ten</span><span begin="1:16.242" end="1:16.553">der</span><span begin="1:16.553" end="1:16.973">ly</span> <span begin="1:16.973" end="1:17.667">hold</span> <span begin="1:17.667" end="1:19.002">you</span><span ttm:role="x-translation" xml:lang="zh-CN">我会飞奔过去温柔地拥抱你</span></p><p begin="1:19.402" end="1:23.052" itunes:key="L12" ttm:agent="v1"><span begin="1:19.402" end="1:19.757">But</span> <span begin="1:19.757" end="1:21.208">baby,</span> <span begin="1:21.208" end="1:21.538">you</span> <span begin="1:21.538" end="1:22.072">won&apos;t</span> <span begin="1:22.072" end="1:22.485">be</span> <span begin="1:22.485" end="1:23.052">there</span><span ttm:role="x-translation" xml:lang="zh-CN">可是宝贝，你却不在那里</span></p><p begin="1:23.170" end="1:29.651" itunes:key="L13" ttm:agent="v1"><span begin="1:23.170" end="1:23.537">I</span> <span begin="1:23.537" end="1:23.908">don&apos;t</span> <span begin="1:23.908" end="1:24.294">wan</span><span begin="1:24.294" end="1:24.469">na</span> <span begin="1:24.469" end="1:25.015">say</span> <span begin="1:25.015" end="1:25.320">good</span><span begin="1:25.320" end="1:27.305">bye</span> <span begin="1:27.305" end="1:27.790">for</span> <span begin="1:27.790" end="1:27.965">the</span> <span begin="1:27.965" end="1:28.581">sum</span><span begin="1:28.581" end="1:29.651">mer</span><span ttm:role="x-translation" xml:lang="zh-CN">我不想在这个夏天说再见</span></p><p begin="1:30.671" end="1:34.202" itunes:key="L14" ttm:agent="v1"><span begin="1:30.671" end="1:31.571">Know</span><span begin="1:31.571" end="1:31.928">ing</span> <span begin="1:31.928" end="1:32.298">the</span> <span begin="1:32.298" end="1:33.306">love</span> <span begin="1:33.306" end="1:33.672">we&apos;ll</span> <span begin="1:33.672" end="1:34.202">miss</span><span ttm:role="x-translation" xml:lang="zh-CN">明知我们会错过这份爱</span></p><p begin="1:34.552" end="1:42.284" itunes:key="L15" ttm:agent="v1"><span begin="1:34.552" end="1:35.052">So</span> <span begin="1:35.052" end="1:35.397">let</span> <span begin="1:35.397" end="1:35.692">us</span> <span begin="1:35.692" end="1:36.057">make</span> <span begin="1:36.057" end="1:36.332">a</span> <span begin="1:36.332" end="1:37.421">pledge</span> <span begin="1:37.421" end="1:37.790">to</span> <span begin="1:37.790" end="1:38.472">meet</span> <span begin="1:38.472" end="1:38.712">in</span> <span begin="1:38.712" end="1:39.174">Sep</span><span begin="1:39.174" end="1:39.594">tem</span><span begin="1:39.594" end="1:42.284">ber</span><span ttm:role="x-translation" xml:lang="zh-CN">所以让我们约定在九月重逢</span></p><p begin="1:42.882" end="1:46.808" itunes:key="L16" ttm:agent="v1"><span begin="1:42.882" end="1:43.137">And</span> <span begin="1:43.137" end="1:43.657">seal</span> <span begin="1:43.657" end="1:43.921">it</span> <span begin="1:43.921" end="1:44.301">with</span> <span begin="1:44.301" end="1:44.549">a</span> <span begin="1:44.549" end="1:46.808">kiss</span><span ttm:role="x-translation" xml:lang="zh-CN">并以吻封缄</span></p><p begin="2:09.741" end="2:16.816" itunes:key="L17" ttm:agent="v1"><span begin="2:09.741" end="2:10.299">Yes,</span> <span begin="2:10.299" end="2:10.644">it&apos;s</span> <span begin="2:10.644" end="2:11.312">gonna</span> <span begin="2:11.312" end="2:11.677">be</span> <span begin="2:11.677" end="2:11.997">a</span> <span begin="2:11.997" end="2:14.082">cold,</span> <span begin="2:14.082" end="2:14.342">lone</span><span begin="2:14.342" end="2:14.582">ly</span> <span begin="2:14.582" end="2:15.131">sum</span><span begin="2:15.131" end="2:16.816">mer</span><span ttm:role="x-translation" xml:lang="zh-CN">是的，这将是一个寒冷而寂寞的夏天</span></p><p begin="2:17.162" end="2:20.928" itunes:key="L18" ttm:agent="v1"><span begin="2:17.162" end="2:17.473">But</span> <span begin="2:17.473" end="2:18.198">I&apos;ll</span> <span begin="2:18.198" end="2:18.548">fill</span> <span begin="2:18.548" end="2:18.898">the</span> <span begin="2:18.898" end="2:20.243">empti</span><span begin="2:20.243" end="2:20.928">ness</span><span ttm:role="x-translation" xml:lang="zh-CN">但我会填补那份空虚</span></p><p begin="2:21.223" end="2:29.578" itunes:key="L19" ttm:agent="v1"><span begin="2:21.223" end="2:21.458">I&apos;ll</span> <span begin="2:21.458" end="2:21.873">send</span> <span begin="2:21.873" end="2:22.220">you</span> <span begin="2:22.220" end="2:22.626">all</span> <span begin="2:22.626" end="2:22.964">my</span> <span begin="2:22.964" end="2:25.050">love</span> <span begin="2:25.050" end="2:25.750">every</span> <span begin="2:25.750" end="2:26.423">day</span> <span begin="2:26.423" end="2:26.718">in</span> <span begin="2:26.718" end="2:27.083">a</span> <span begin="2:27.083" end="2:27.478">let</span><span begin="2:27.478" end="2:29.578">ter</span><span ttm:role="x-translation" xml:lang="zh-CN">我会每天在信里寄去我所有的爱</span></p><p begin="2:29.632" end="2:33.922" itunes:key="L20" ttm:agent="v1"><span begin="2:29.632" end="2:30.527">Sealed</span> <span begin="2:30.527" end="2:30.847">with</span> <span begin="2:30.847" end="2:31.122">a</span> <span begin="2:31.122" end="2:33.922">kiss</span><span ttm:role="x-translation" xml:lang="zh-CN">以吻封缄</span></p><p begin="2:35.027" end="2:39.407" itunes:key="L21" ttm:agent="v1"><span begin="2:35.027" end="2:35.987">Sealed</span> <span begin="2:35.987" end="2:36.322">with</span> <span begin="2:36.322" end="2:36.632">a</span> <span begin="2:36.632" end="2:39.407">kiss</span><span ttm:role="x-translation" xml:lang="zh-CN">以吻封缄</span></p><p begin="2:40.507" end="2:44.937" itunes:key="L22" ttm:agent="v1"><span begin="2:40.507" end="2:41.507">Sealed</span> <span begin="2:41.507" end="2:41.817">with</span> <span begin="2:41.817" end="2:42.127">a</span> <span begin="2:42.127" end="2:44.937">kiss</span><span ttm:role="x-translation" xml:lang="zh-CN">以吻封缄</span></p></div></body></tt>