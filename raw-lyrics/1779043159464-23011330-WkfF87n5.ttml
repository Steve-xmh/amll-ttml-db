<tt xmlns="http://www.w3.org/ns/ttml" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xmlns:amll="http://www.example.com/ns/amll" itunes:timing="Word"><head><metadata><ttm:agent type="person" xml:id="v1"><ttm:name>yukina</ttm:name></ttm:agent><ttm:agent type="person" xml:id="v2"><ttm:name>みぃ</ttm:name></ttm:agent><ttm:agent type="other" xml:id="v3"/><amll:meta key="musicName" value="現夢 -genmu-"/><amll:meta key="artists" value="みぃ"/><amll:meta key="artists" value="yukina"/><amll:meta key="artists" value="TUMENECO"/><amll:meta key="album" value="現夢"/><amll:meta key="ncmMusicId" value="852226"/><amll:meta key="ttmlAuthorGithub" value="23011330"/><amll:meta key="ttmlAuthorGithubLogin" value="Shirasagi0012"/></metadata></head><body dur="4:50.134"><div begin="1.276" end="26.359" itunes:songPart="Intro"><p begin="1.276" end="7.121" itunes:key="L1" ttm:agent="v1"><span begin="1.276" end="1.996">君</span><span begin="1.996" end="3.194">と</span><span begin="3.194" end="3.438">出</span><span begin="3.438" end="3.614">会</span><span begin="3.614" end="4.376">い</span> <span begin="4.376" end="4.951">夢</span><span begin="4.951" end="5.133">を</span><span begin="5.133" end="5.642">視</span><span begin="5.642" end="5.941">て</span><span begin="5.941" end="7.121">た</span><span ttm:role="x-translation" xml:lang="zh-CN">做了与你相会的梦</span><span ttm:role="x-roman">kimi to deai yume o miteta</span></p><p begin="7.495" end="13.668" itunes:key="L2" ttm:agent="v1"><span begin="7.495" end="8.246">あ</span><span begin="8.246" end="8.548">の</span><span begin="8.548" end="8.810">日</span><span begin="8.810" end="9.036">々</span><span begin="9.036" end="9.483">を</span> <span begin="9.792" end="10.381">忘</span><span begin="10.381" end="10.582">れ</span><span begin="10.582" end="10.843">る</span><span begin="10.843" end="11.115">こ</span><span begin="11.115" end="11.358">と</span><span begin="11.358" end="11.668">な</span><span begin="11.668" end="11.923">ん</span><span begin="11.923" end="12.148">て</span><span begin="12.148" end="12.363">で</span><span begin="12.363" end="12.693">き</span><span begin="12.693" end="12.963">な</span><span begin="12.963" end="13.668">い</span><span ttm:role="x-translation" xml:lang="zh-CN">我无法将那些日子给遗忘掉</span><span ttm:role="x-roman">ano hibi o wasureru koto nante dekinai</span></p><p begin="14.080" end="19.500" itunes:key="L3" ttm:agent="v1"><span begin="14.080" end="15.221">今</span><span begin="15.221" end="15.473">も</span> <span begin="15.473" end="15.979">月</span><span begin="15.979" end="16.731">と</span> <span begin="16.731" end="17.346">星</span><span begin="17.346" end="17.493">の</span><span begin="17.493" end="18.320">下</span><span begin="18.320" end="19.500">で</span><span ttm:role="x-translation" xml:lang="zh-CN">现在也于月亮和星星下</span><span ttm:role="x-roman">ima mo tsuki to hoshi no shita de</span></p><p begin="19.874" end="26.359" itunes:key="L4" ttm:agent="v1"><span begin="19.874" end="20.633">僕</span><span begin="20.633" end="20.924">は</span> <span begin="20.924" end="21.428">夢</span><span begin="21.428" end="21.825">を</span><span begin="22.205" end="22.478">視</span><span begin="22.478" end="22.952">続</span><span begin="22.952" end="23.364">け</span><span begin="23.364" end="23.766">る</span> <span begin="23.766" end="24.061">醒</span><span begin="24.061" end="24.322">め</span><span begin="24.322" end="24.533">な</span><span begin="24.533" end="24.803">い</span><span begin="24.803" end="25.248">夢</span><span begin="25.248" end="26.359">を</span><span ttm:role="x-translation" xml:lang="zh-CN">我继续做着梦 不会醒来的梦</span><span ttm:role="x-roman">boku wa yume o mitsuzukeru samenai yume o</span></p></div><div begin="39.200" end="1:03.213" itunes:songPart="Verse"><p begin="39.200" end="44.963" itunes:key="L5" ttm:agent="v1"><span begin="39.200" end="40.605">出口</span><span begin="40.605" end="40.816">の</span><span begin="40.816" end="41.353">判</span><span begin="41.353" end="41.545">ら</span><span begin="41.545" end="41.931">な</span><span begin="41.931" end="42.273">い</span> <span begin="42.323" end="42.902">箱</span><span begin="42.902" end="43.396">庭</span><span begin="43.396" end="43.663">が</span><span begin="43.663" end="44.062">隠</span><span begin="44.062" end="44.464">す</span><span begin="44.464" end="44.685">の</span><span begin="44.685" end="44.963">は</span><span ttm:role="x-translation" xml:lang="zh-CN">不知出口 隐藏在庭影中的是</span><span ttm:role="x-roman">deguchi no wakaranai hakoniwa ga kakusu no wa</span></p><p begin="45.441" end="50.892" itunes:key="L6" ttm:agent="v1"><span begin="45.441" end="46.779">諦</span><span begin="46.779" end="46.992">め</span><span begin="46.992" end="47.196">が</span><span begin="47.196" end="47.501">閉</span><span begin="47.501" end="47.654">ざ</span><span begin="47.654" end="48.053">す</span> <span begin="48.114" end="48.718">小</span><span begin="48.718" end="49.099">さ</span><span begin="49.099" end="49.293">な</span><span begin="49.293" end="49.786">灯</span><span begin="49.786" end="50.061">し</span><span begin="50.061" end="50.892">火</span><span ttm:role="x-translation" xml:lang="zh-CN">阴郁心灵的微小灯火</span><span ttm:role="x-roman">akirame ga tozasu chiisana tomoshibi</span></p><p begin="51.231" end="57.396" itunes:key="L7" ttm:agent="v2"><span begin="51.231" end="52.348">雁</span><span begin="52.348" end="52.749">字</span><span begin="52.749" end="53.196">搦</span><span begin="53.196" end="53.516">め</span><span begin="53.516" end="53.769">に</span><span begin="53.769" end="54.202">な</span><span begin="54.202" end="54.340">っ</span><span begin="54.340" end="54.706">た</span> <span begin="54.706" end="55.305">箱</span><span begin="55.305" end="55.787">庭</span><span begin="55.787" end="56.035">を</span><span begin="56.035" end="56.478">壊</span><span begin="56.478" end="56.886">す</span><span begin="56.886" end="57.065">の</span><span begin="57.065" end="57.396">は</span><span ttm:role="x-translation" xml:lang="zh-CN">捆绑起来的书信 将这庭影给毁坏的</span><span ttm:role="x-roman">ganjigarame ni natta hakoniwa o kowasu no wa</span></p><p begin="57.697" end="1:03.213" itunes:key="L8" ttm:agent="v2"><span begin="57.697" end="58.595">信</span><span begin="58.595" end="58.915">じ</span><span begin="58.915" end="59.106">る</span><span begin="59.106" end="59.411">そ</span><span begin="59.411" end="59.665">れ</span><span begin="59.665" end="59.933">だ</span><span begin="59.933" end="1:00.148">け</span><span begin="1:00.148" end="1:00.344">の</span> <span begin="1:00.520" end="1:01.128">小</span><span begin="1:01.128" end="1:01.504">さ</span><span begin="1:01.504" end="1:01.701">な</span><span begin="1:01.701" end="1:02.281">思</span><span begin="1:02.281" end="1:02.497">い</span><span begin="1:02.497" end="1:03.213">出</span><span ttm:role="x-translation" xml:lang="zh-CN">相信只有那些的渺小的回忆</span><span ttm:role="x-roman">shinjiru sore dake no chiisana omoide</span></p></div><div begin="1:03.243" end="1:41.254" itunes:songPart="Chorus"><p begin="1:03.243" end="1:09.062" itunes:key="L9" ttm:agent="v1"><span begin="1:03.243" end="1:03.990">君</span><span begin="1:03.990" end="1:04.786">と</span><span begin="1:04.786" end="1:05.539">二人</span><span begin="1:05.539" end="1:06.256">で</span> <span begin="1:06.310" end="1:06.612">手</span><span begin="1:06.612" end="1:06.857">を</span><span begin="1:06.857" end="1:07.696">繋</span><span begin="1:07.696" end="1:07.885">い</span><span begin="1:07.885" end="1:09.062">だ</span><span ttm:role="x-translation" xml:lang="zh-CN">与你两人手牵手</span><span ttm:role="x-roman">kimi to futari de te o tsunaida</span><span ttm:role="x-bg" begin="1:04.214" end="1:08.168"><span begin="1:04.214" end="1:05.181">(——I</span> <span begin="1:05.181" end="1:06.282">walk</span> <span begin="1:06.282" end="1:08.168">alone)</span><span ttm:role="x-translation" xml:lang="zh-CN">我独自行走</span></span></p><p begin="1:07.086" end="1:09.436" itunes:key="L10" ttm:agent="v2"><span begin="1:07.086" end="1:07.496">君</span><span begin="1:07.496" end="1:07.722">の</span><span begin="1:07.920" end="1:08.117">視</span><span begin="1:08.117" end="1:08.290">て</span><span begin="1:08.290" end="1:08.542">た</span><span begin="1:08.542" end="1:08.992">夢</span><span begin="1:08.992" end="1:09.436">を</span><span ttm:role="x-translation" xml:lang="zh-CN">你所看见的梦</span><span ttm:role="x-roman">kimi no miteta yume o</span></p><p begin="1:09.436" end="1:15.747" itunes:key="L11" ttm:agent="v1"><span begin="1:09.436" end="1:10.202">あ</span><span begin="1:10.202" end="1:10.494">の</span><span begin="1:10.494" end="1:11.012">夜</span><span begin="1:11.012" end="1:11.356">を</span> <span begin="1:11.745" end="1:12.306">忘</span><span begin="1:12.306" end="1:12.550">れ</span><span begin="1:12.550" end="1:12.787">る</span><span begin="1:12.787" end="1:13.039">こ</span><span begin="1:13.039" end="1:13.281">と</span><span begin="1:13.281" end="1:13.550">な</span><span begin="1:13.550" end="1:13.839">ん</span><span begin="1:13.839" end="1:14.043">て</span><span begin="1:14.043" end="1:14.319">で</span><span begin="1:14.319" end="1:14.613">き</span><span begin="1:14.613" end="1:14.856">な</span><span begin="1:14.856" end="1:15.747">い</span><span ttm:role="x-translation" xml:lang="zh-CN">我无法将那些日子给遗忘掉</span><span ttm:role="x-roman">ano yoru o wasureru koto nante dekinai</span><span ttm:role="x-bg" begin="1:10.229" end="1:15.747"><span begin="1:10.229" end="1:11.367">(——Time</span> <span begin="1:11.367" end="1:11.759">to</span> <span begin="1:11.759" end="1:12.545">go</span> <span begin="1:12.545" end="1:13.301">my</span> <span begin="1:13.301" end="1:15.048">own</span> <span begin="1:15.048" end="1:15.747">way)</span><span ttm:role="x-translation" xml:lang="zh-CN">已是时候启程</span></span></p><p begin="1:13.312" end="1:18.090" itunes:key="L12" ttm:agent="v2"><span begin="1:13.312" end="1:14.868">忘</span><span begin="1:14.868" end="1:15.740">れ</span><span begin="1:15.740" end="1:16.504">な</span><span begin="1:16.504" end="1:18.090">い</span><span ttm:role="x-translation" xml:lang="zh-CN">不会忘记</span><span ttm:role="x-roman">wasurenai</span></p><p begin="1:15.946" end="1:21.520" itunes:key="L13" ttm:agent="v1"><span begin="1:15.946" end="1:16.367">終</span><span begin="1:16.367" end="1:17.193">わ</span><span begin="1:17.193" end="1:17.437">り</span><span begin="1:17.437" end="1:17.733">の</span><span begin="1:17.733" end="1:17.996">な</span><span begin="1:17.996" end="1:18.704">い</span> <span begin="1:18.704" end="1:19.015">夜</span><span begin="1:19.015" end="1:19.319">が</span><span begin="1:19.319" end="1:19.515">明</span><span begin="1:19.515" end="1:20.023">け</span><span begin="1:20.023" end="1:20.248">て</span><span begin="1:20.248" end="1:21.520">も</span><span ttm:role="x-translation" xml:lang="zh-CN">永无止尽 即使夜尽天明</span><span ttm:role="x-roman">owari no nai yoru ga aketemo</span><span ttm:role="x-bg" begin="1:16.505" end="1:21.520"><span begin="1:16.505" end="1:17.945">(——Night&apos;s</span> <span begin="1:17.945" end="1:19.503">falling</span> <span begin="1:19.503" end="1:21.520">down)</span><span ttm:role="x-translation" xml:lang="zh-CN">夜幕低垂</span></span></p><p begin="1:19.509" end="1:21.520" itunes:key="L14" ttm:agent="v2"><span begin="1:19.509" end="1:19.798">朝</span><span begin="1:19.798" end="1:20.269">も、</span><span begin="1:20.269" end="1:20.524">夜</span><span begin="1:20.524" end="1:21.007">も、</span><span begin="1:21.007" end="1:21.197">越</span><span begin="1:21.197" end="1:21.327">え</span><span begin="1:21.327" end="1:21.520">て</span><span ttm:role="x-translation" xml:lang="zh-CN">超越早晨与夜晚</span><span ttm:role="x-roman">asa mo, yoru mo, koete</span></p><p begin="1:21.789" end="1:27.124" itunes:key="L15" ttm:agent="v1"><span begin="1:21.789" end="1:22.570">僕</span><span begin="1:22.570" end="1:22.869">は</span> <span begin="1:22.869" end="1:23.371">夢</span><span begin="1:23.371" end="1:23.746">を</span><span begin="1:24.125" end="1:24.411">視</span><span begin="1:24.411" end="1:24.898">続</span><span begin="1:24.898" end="1:25.200">け</span><span begin="1:25.200" end="1:25.436">る</span><span begin="1:25.436" end="1:25.685">だ</span><span begin="1:25.685" end="1:26.454">ろ</span><span begin="1:26.454" end="1:27.124">う</span><span ttm:role="x-translation" xml:lang="zh-CN">我继续做着梦 不会醒来的梦</span><span ttm:role="x-roman">boku wa yume o mitsuzukeru darou</span><span ttm:role="x-bg" begin="1:22.598" end="1:25.708"><span begin="1:22.598" end="1:23.373">(——No</span> <span begin="1:23.373" end="1:24.142">one</span> <span begin="1:24.142" end="1:24.944">can</span> <span begin="1:24.944" end="1:25.708">see)</span><span ttm:role="x-translation" xml:lang="zh-CN">无人能视</span></span></p><p begin="1:25.672" end="1:28.820" itunes:key="L16" ttm:agent="v2"><span begin="1:25.672" end="1:26.280">紅</span><span begin="1:26.280" end="1:26.460">い</span><span begin="1:26.460" end="1:27.023">月</span><span begin="1:27.023" end="1:27.193">が</span><span begin="1:27.215" end="1:27.547">地</span><span begin="1:27.547" end="1:27.812">に</span><span begin="1:27.812" end="1:27.978">落</span><span begin="1:27.978" end="1:28.295">ち</span><span begin="1:28.295" end="1:28.659">て</span><span begin="1:28.659" end="1:28.820">も</span><span ttm:role="x-translation" xml:lang="zh-CN">即使红月坠落地面</span><span ttm:role="x-roman">akai tsuki ga chi ni ochitemo</span><span ttm:role="x-bg" begin="1:25.839" end="1:28.820"><span begin="1:25.839" end="1:26.193">(——We</span> <span begin="1:26.193" end="1:26.464">still</span> <span begin="1:26.464" end="1:26.795">search</span> <span begin="1:26.795" end="1:27.219">the</span> <span begin="1:27.219" end="1:28.820">starlights)</span><span ttm:role="x-translation" xml:lang="zh-CN">我们仍试图冀索星光</span></span></p><p begin="1:28.820" end="1:31.904" itunes:key="L17" ttm:agent="v2"><span begin="1:28.820" end="1:29.096">咲</span><span begin="1:29.096" end="1:29.383">か</span><span begin="1:29.383" end="1:29.593">ぬ</span><span begin="1:29.593" end="1:30.138">花</span><span begin="1:30.138" end="1:30.298">が</span><span begin="1:30.345" end="1:30.653">枯</span><span begin="1:30.653" end="1:30.895">れ</span><span begin="1:30.895" end="1:31.117">果</span><span begin="1:31.117" end="1:31.359">て</span><span begin="1:31.359" end="1:31.698">て</span><span begin="1:31.698" end="1:31.904">も</span><span ttm:role="x-translation" xml:lang="zh-CN">即使未开之花是枯落的结果</span><span ttm:role="x-roman">sakanu hana ga karehatetemo</span><span ttm:role="x-bg" begin="1:29.216" end="1:31.904"><span begin="1:29.216" end="1:29.939">(——Despite</span> <span begin="1:29.939" end="1:30.331">there&apos;s</span> <span begin="1:30.331" end="1:30.715">no</span> <span begin="1:30.715" end="1:31.133">hope</span> <span begin="1:31.133" end="1:31.904">inside)</span><span ttm:role="x-translation" xml:lang="zh-CN">即使当中已无希望</span></span></p><p begin="1:31.904" end="1:34.979" itunes:key="L18" ttm:agent="v2"><span begin="1:31.904" end="1:32.466">永</span><span begin="1:32.466" end="1:32.671">い</span><span begin="1:32.671" end="1:33.255">夜</span><span begin="1:33.255" end="1:33.418">が</span><span begin="1:33.464" end="1:33.736">燃</span><span begin="1:33.736" end="1:33.998">え</span><span begin="1:33.998" end="1:34.241">尽</span><span begin="1:34.241" end="1:34.506">き</span><span begin="1:34.506" end="1:34.807">て</span><span begin="1:34.807" end="1:34.979">も</span><span ttm:role="x-translation" xml:lang="zh-CN">即使漫长的夜晚燃烧殆尽</span><span ttm:role="x-roman">nagai yoru ga moetsukitemo</span><span ttm:role="x-bg" begin="1:32.383" end="1:34.979"><span begin="1:32.383" end="1:32.672">(——Fill</span> <span begin="1:32.672" end="1:32.986">my</span> <span begin="1:32.986" end="1:33.435">heart</span> <span begin="1:33.435" end="1:33.788">with</span> <span begin="1:33.788" end="1:34.979">shine)</span><span ttm:role="x-translation" xml:lang="zh-CN">让光芒填塞内心</span></span></p><p begin="1:34.979" end="1:41.254" itunes:key="L19" ttm:agent="v2"><span begin="1:34.979" end="1:35.566">君</span><span begin="1:35.566" end="1:35.775">の</span><span begin="1:35.775" end="1:36.353">声</span><span begin="1:36.353" end="1:36.494">は</span><span begin="1:36.544" end="1:37.126">届</span><span begin="1:37.126" end="1:37.297">い</span><span begin="1:37.297" end="1:37.597">て</span><span begin="1:37.597" end="1:37.849">い</span><span begin="1:37.849" end="1:38.080">る</span><span begin="1:38.080" end="1:39.629">か</span><span begin="1:39.629" end="1:41.254">ら</span><span ttm:role="x-translation" xml:lang="zh-CN">因为你的声音在传达着</span><span ttm:role="x-roman">kimi no koe wa todoite iru kara</span><span ttm:role="x-bg" begin="1:35.381" end="1:40.802"><span begin="1:35.381" end="1:35.791">(——To</span> <span begin="1:35.791" end="1:36.170">find</span> <span begin="1:36.170" end="1:36.506">the</span> <span begin="1:36.506" end="1:36.886">truth</span> <span begin="1:36.886" end="1:37.278">of</span> <span begin="1:37.278" end="1:37.696">this</span> <span begin="1:37.696" end="1:38.052">world&apos;s</span> <span begin="1:38.052" end="1:40.802">end)</span><span ttm:role="x-translation" xml:lang="zh-CN">找到世界终结时仅存的真实</span></span></p></div><div begin="1:53.515" end="2:17.528" itunes:songPart="Verse"><p begin="1:53.515" end="1:59.297" itunes:key="L20" ttm:agent="v1"><span begin="1:53.515" end="1:54.902">儚</span><span begin="1:54.902" end="1:55.046">い</span><span begin="1:55.046" end="1:55.237">と</span><span begin="1:55.237" end="1:55.630">知</span><span begin="1:55.630" end="1:55.840">っ</span><span begin="1:55.840" end="1:56.266">て</span><span begin="1:56.266" end="1:56.593">も</span> <span begin="1:56.644" end="1:56.967">繰</span><span begin="1:56.967" end="1:57.206">り</span><span begin="1:57.206" end="1:57.642">返</span><span begin="1:57.642" end="1:58.017">し</span><span begin="1:58.017" end="1:58.544">願</span><span begin="1:58.544" end="1:58.781">う</span><span begin="1:58.781" end="1:58.995">の</span><span begin="1:58.995" end="1:59.297">は</span><span ttm:role="x-translation" xml:lang="zh-CN">化为虚幻 却反复祈愿的是</span><span ttm:role="x-roman">hakanai to shittemo kurikaeshi negau no wa</span></p><p begin="1:59.754" end="2:05.191" itunes:key="L21" ttm:agent="v1"><span begin="1:59.754" end="2:00.487">た</span><span begin="2:00.487" end="2:00.819">ぐ</span><span begin="2:00.819" end="2:01.045">り</span><span begin="2:01.045" end="2:01.227">寄</span><span begin="2:01.227" end="2:01.520">せ</span><span begin="2:01.520" end="2:01.861">て</span><span begin="2:01.861" end="2:02.048">い</span><span begin="2:02.048" end="2:02.398">た</span> <span begin="2:02.490" end="2:03.116">虚</span><span begin="2:03.116" end="2:03.441">ろ</span><span begin="2:03.441" end="2:03.627">な</span><span begin="2:03.627" end="2:03.801">日</span><span begin="2:03.801" end="2:05.191">常</span><span ttm:role="x-translation" xml:lang="zh-CN">把空虚的日常拉至自己身旁</span><span ttm:role="x-roman">taguriyosete ita utsuro na nichijou</span></p><p begin="2:05.572" end="2:11.702" itunes:key="L22" ttm:agent="v2"><span begin="2:05.576" end="2:05.968">も</span><span begin="2:05.968" end="2:06.565">う</span><span begin="2:06.726" end="2:06.997">一</span><span begin="2:06.997" end="2:07.494">度</span><span begin="2:07.494" end="2:07.787">だ</span><span begin="2:07.787" end="2:08.063">け</span><span begin="2:08.063" end="2:08.297">で</span><span begin="2:08.297" end="2:08.675">い</span><span begin="2:08.675" end="2:08.991">い</span> <span begin="2:09.087" end="2:09.380">た</span><span begin="2:09.380" end="2:09.588">だ</span><span begin="2:09.588" end="2:10.117">切</span><span begin="2:10.117" end="2:10.364">に</span><span begin="2:10.364" end="2:10.896">願</span><span begin="2:10.896" end="2:11.147">う</span><span begin="2:11.147" end="2:11.360">の</span><span begin="2:11.360" end="2:11.702">は</span><span ttm:role="x-translation" xml:lang="zh-CN">只要再一次就好了 我迫切祈愿的是</span><span ttm:role="x-roman">mou ichido dake de ii tada setsu ni negau no wa</span></p><p begin="2:12.136" end="2:17.528" itunes:key="L23" ttm:agent="v2"><span begin="2:12.136" end="2:12.861">目</span><span begin="2:12.861" end="2:13.163">を</span><span begin="2:13.163" end="2:13.509">逸</span><span begin="2:13.509" end="2:13.665">ら</span><span begin="2:13.665" end="2:14.013">さ</span><span begin="2:14.013" end="2:14.288">な</span><span begin="2:14.288" end="2:14.485">い</span><span begin="2:14.485" end="2:14.743">で</span> <span begin="2:14.898" end="2:15.186">見</span><span begin="2:15.186" end="2:15.534">つ</span><span begin="2:15.534" end="2:15.806">め</span><span begin="2:15.806" end="2:16.028">た</span><span begin="2:16.028" end="2:16.187">日</span><span begin="2:16.187" end="2:17.528">常</span><span ttm:role="x-translation" xml:lang="zh-CN">请你别移开视线 所凝视过的日常</span><span ttm:role="x-roman">me o sorasanaide mitsumeta nichijou</span></p></div><div begin="2:17.577" end="2:55.527" itunes:songPart="Chorus"><p begin="2:17.577" end="2:23.314" itunes:key="L24" ttm:agent="v1"><span begin="2:17.577" end="2:18.306">君</span><span begin="2:18.306" end="2:19.113">と</span><span begin="2:19.113" end="2:19.899">二人</span><span begin="2:19.899" end="2:20.571">で</span> <span begin="2:20.660" end="2:21.126">空</span><span begin="2:21.126" end="2:21.402">見</span><span begin="2:21.402" end="2:21.984">上</span><span begin="2:21.984" end="2:22.162">げ</span><span begin="2:22.162" end="2:23.314">た</span><span ttm:role="x-translation" xml:lang="zh-CN">与你两人仰视着天空</span><span ttm:role="x-roman">kimi to futari de sora miageta</span><span ttm:role="x-bg" begin="2:18.385" end="2:23.314"><span begin="2:18.385" end="2:19.745">(——You</span> <span begin="2:19.745" end="2:20.691">walk</span> <span begin="2:20.691" end="2:23.314">across)</span><span ttm:role="x-translation" xml:lang="zh-CN">你举步走过</span></span></p><p begin="2:21.421" end="2:23.724" itunes:key="L25" ttm:agent="v2"><span begin="2:21.421" end="2:21.761">君</span><span begin="2:21.761" end="2:22.101">と</span><span begin="2:22.210" end="2:22.377">駆</span><span begin="2:22.377" end="2:22.518">け</span><span begin="2:22.518" end="2:22.749">た</span><span begin="2:22.832" end="2:23.327">道</span><span begin="2:23.327" end="2:23.724">を</span><span ttm:role="x-translation" xml:lang="zh-CN">与你一起奔跑过的道路</span><span ttm:role="x-roman">kimi to kaketa michi o</span></p><p begin="2:23.775" end="2:30.287" itunes:key="L26" ttm:agent="v1"><span begin="2:23.775" end="2:24.522">あ</span><span begin="2:24.522" end="2:24.824">の</span><span begin="2:24.824" end="2:25.000">場</span><span begin="2:25.000" end="2:25.325">所</span><span begin="2:25.325" end="2:25.698">を</span> <span begin="2:26.080" end="2:26.640">忘</span><span begin="2:26.640" end="2:26.868">れ</span><span begin="2:26.868" end="2:27.089">る</span><span begin="2:27.089" end="2:27.380">こ</span><span begin="2:27.380" end="2:27.604">と</span><span begin="2:27.604" end="2:27.856">な</span><span begin="2:27.856" end="2:28.147">ん</span><span begin="2:28.147" end="2:28.400">て</span><span begin="2:28.400" end="2:28.647">で</span><span begin="2:28.647" end="2:28.964">き</span><span begin="2:28.964" end="2:29.210">な</span><span begin="2:29.210" end="2:29.970">い</span><span ttm:role="x-translation" xml:lang="zh-CN">我无法将那些地方给遗忘掉</span><span ttm:role="x-roman">ano basho o wasureru koto nante dekinai</span><span ttm:role="x-bg" begin="2:24.521" end="2:30.287"><span begin="2:24.521" end="2:25.680">(——Time</span> <span begin="2:25.680" end="2:26.094">to</span> <span begin="2:26.094" end="2:26.858">say</span> <span begin="2:26.858" end="2:28.371">goodbye</span> <span begin="2:28.974" end="2:29.234">my</span> <span begin="2:29.234" end="2:30.287">friend)</span><span ttm:role="x-translation" xml:lang="zh-CN">是时候说再见了，我的朋友</span></span></p><p begin="2:27.639" end="2:32.345" itunes:key="L27" ttm:agent="v2"><span begin="2:27.639" end="2:29.221">忘</span><span begin="2:29.221" end="2:29.953">れ</span><span begin="2:29.953" end="2:30.754">な</span><span begin="2:30.754" end="2:32.345">い</span><span ttm:role="x-translation" xml:lang="zh-CN">不会忘记</span><span ttm:role="x-roman">wasurenai</span></p><p begin="2:30.287" end="2:36.147" itunes:key="L28" ttm:agent="v1"><span begin="2:30.287" end="2:31.493">力</span><span begin="2:31.493" end="2:32.045">尽</span><span begin="2:32.045" end="2:32.263">き</span><span begin="2:32.263" end="2:32.916">る</span> <span begin="2:32.916" end="2:33.322">そ</span><span begin="2:33.322" end="2:33.577">の</span><span begin="2:33.577" end="2:34.382">時</span><span begin="2:34.382" end="2:34.572">ま</span><span begin="2:34.572" end="2:35.665">で</span><span ttm:role="x-translation" xml:lang="zh-CN">竭尽全力 直至那时为止</span><span ttm:role="x-roman">chikaratsukiru sono toki made</span><span ttm:role="x-bg" begin="2:31.038" end="2:36.147"><span begin="2:31.038" end="2:32.301">(——Right</span> <span begin="2:32.301" end="2:33.110">choice,</span> <span begin="2:33.110" end="2:36.147">perhaps)</span><span ttm:role="x-translation" xml:lang="zh-CN">希望这会是对的抉择</span></span></p><p begin="2:33.630" end="2:36.147" itunes:key="L29" ttm:agent="v2"><span begin="2:33.630" end="2:34.161">空</span><span begin="2:34.161" end="2:34.424">も、</span><span begin="2:34.507" end="2:34.853">海</span><span begin="2:34.853" end="2:35.123">も、</span><span begin="2:35.186" end="2:35.515">越</span><span begin="2:35.515" end="2:35.685">え</span><span begin="2:35.685" end="2:36.147">て</span><span ttm:role="x-translation" xml:lang="zh-CN">超越天空和海洋</span><span ttm:role="x-roman">sora mo, umi mo, koete</span></p><p begin="2:36.147" end="2:41.561" itunes:key="L30" ttm:agent="v1"><span begin="2:36.147" end="2:36.920">僕</span><span begin="2:36.920" end="2:37.239">は</span> <span begin="2:37.239" end="2:37.703">夢</span><span begin="2:37.703" end="2:38.054">を</span><span begin="2:38.464" end="2:38.722">視</span><span begin="2:38.722" end="2:39.234">続</span><span begin="2:39.234" end="2:39.527">け</span><span begin="2:39.527" end="2:39.782">る</span><span begin="2:39.782" end="2:40.006">だ</span><span begin="2:40.006" end="2:40.289">ろ</span><span begin="2:40.289" end="2:41.561">う</span><span ttm:role="x-translation" xml:lang="zh-CN">我将继续做梦下去的吧</span><span ttm:role="x-roman">boku wa yume o mitsuzukeru darou</span><span ttm:role="x-bg" begin="2:36.988" end="2:40.002"><span begin="2:36.988" end="2:37.694">(——For</span> <span begin="2:37.694" end="2:38.418">you</span> <span begin="2:38.418" end="2:39.213">and</span> <span begin="2:39.213" end="2:40.002">me)</span><span ttm:role="x-translation" xml:lang="zh-CN">对你或是对我来说</span></span></p><p begin="2:40.002" end="2:43.038" itunes:key="L31" ttm:agent="v2"><span begin="2:40.002" end="2:40.617">風</span><span begin="2:40.617" end="2:40.822">の</span><span begin="2:40.822" end="2:41.082">吹</span><span begin="2:41.082" end="2:41.347">か</span><span begin="2:41.347" end="2:41.577">ぬ</span><span begin="2:41.577" end="2:42.139">迷</span><span begin="2:42.139" end="2:42.600">宮</span><span begin="2:42.600" end="2:42.883">に</span><span begin="2:42.883" end="2:43.038">も</span><span ttm:role="x-translation" xml:lang="zh-CN">在连风都不吹的迷宫里也好</span><span ttm:role="x-roman">kaze no fukanu meikyuu ni mo</span><span ttm:role="x-bg" begin="2:40.002" end="2:43.038"><span begin="2:40.002" end="2:40.386">(——We</span> <span begin="2:40.386" end="2:40.798">still</span> <span begin="2:40.798" end="2:41.263">search</span> <span begin="2:41.263" end="2:41.635">the</span> <span begin="2:41.635" end="2:43.038">starlights)</span><span ttm:role="x-translation" xml:lang="zh-CN">我们仍试图冀索星光</span></span></p><p begin="2:43.130" end="2:46.211" itunes:key="L32" ttm:agent="v2"><span begin="2:43.130" end="2:43.695">遥</span><span begin="2:43.695" end="2:43.902">か</span><span begin="2:43.902" end="2:44.463">遠</span><span begin="2:44.463" end="2:44.683">く</span><span begin="2:44.683" end="2:44.956">世</span><span begin="2:44.956" end="2:45.231">の</span><span begin="2:45.231" end="2:45.411">果</span><span begin="2:45.411" end="2:45.716">て</span><span begin="2:45.716" end="2:46.015">に</span><span begin="2:46.015" end="2:46.186">も</span><span ttm:role="x-translation" xml:lang="zh-CN">在遥远世界的尽头也好</span><span ttm:role="x-roman">haruka tooku yo no hate ni mo</span><span ttm:role="x-bg" begin="2:43.496" end="2:46.211"><span begin="2:43.496" end="2:43.914">(——In</span> <span begin="2:43.914" end="2:44.270">spite</span> <span begin="2:44.270" end="2:44.648">of</span> <span begin="2:44.648" end="2:45.532">someones</span> <span begin="2:45.532" end="2:46.211">advice)</span><span ttm:role="x-translation" xml:lang="zh-CN">不论他人如何劝告</span></span></p><p begin="2:46.211" end="2:49.316" itunes:key="L33" ttm:agent="v2"><span begin="2:46.211" end="2:46.540">ど</span><span begin="2:46.540" end="2:46.769">ん</span><span begin="2:46.769" end="2:46.975">な</span><span begin="2:46.975" end="2:47.583">暗</span><span begin="2:47.583" end="2:47.765">い</span><span begin="2:47.765" end="2:48.103">地</span><span begin="2:48.103" end="2:48.280">の</span><span begin="2:48.280" end="2:48.824">底</span><span begin="2:48.824" end="2:49.132">に</span><span begin="2:49.132" end="2:49.316">も</span><span ttm:role="x-translation" xml:lang="zh-CN">在何等黑暗的地底也好</span><span ttm:role="x-roman">donna kurai chi no soko ni mo</span><span ttm:role="x-bg" begin="2:46.491" end="2:48.981"><span begin="2:46.491" end="2:46.949">(——See</span> <span begin="2:46.949" end="2:47.317">my</span> <span begin="2:47.317" end="2:47.699">heart</span> <span begin="2:47.699" end="2:48.113">blaze</span> <span begin="2:48.113" end="2:48.981">up)</span><span ttm:role="x-translation" xml:lang="zh-CN">我的心头正在燃烧</span></span></p><p begin="2:49.329" end="2:55.527" itunes:key="L34" ttm:agent="v2"><span begin="2:49.329" end="2:49.900">君</span><span begin="2:49.900" end="2:50.089">の</span><span begin="2:50.089" end="2:50.646">声</span><span begin="2:50.646" end="2:50.851">は</span><span begin="2:50.851" end="2:51.447">届</span><span begin="2:51.447" end="2:51.633">い</span><span begin="2:51.633" end="2:51.910">て</span><span begin="2:51.910" end="2:52.191">い</span><span begin="2:52.191" end="2:52.422">る</span><span begin="2:52.422" end="2:53.936">か</span><span begin="2:53.936" end="2:55.527">ら</span><span ttm:role="x-translation" xml:lang="zh-CN">因为你的声音在传达着</span><span ttm:role="x-roman">kimi no koe wa todoite iru kara</span><span ttm:role="x-bg" begin="2:49.700" end="2:55.527"><span begin="2:49.700" end="2:50.092">(——To</span> <span begin="2:50.092" end="2:50.430">break</span> <span begin="2:50.430" end="2:50.771">the</span> <span begin="2:50.771" end="2:51.221">spell</span> <span begin="2:51.221" end="2:51.621">of</span> <span begin="2:51.621" end="2:52.007">this</span> <span begin="2:52.007" end="2:52.412">world&apos;s</span> <span begin="2:52.412" end="2:55.527">end)</span><span ttm:role="x-translation" xml:lang="zh-CN">意图粉碎世界不容其终结</span></span></p></div><div begin="2:54.834" end="3:19.419" itunes:songPart="Bridge"><p begin="2:54.834" end="3:00.596" itunes:key="L35" ttm:agent="v3"><span begin="2:54.834" end="2:55.162">Word</span> <span begin="2:55.162" end="2:55.424">you</span> <span begin="2:55.424" end="2:56.047">say</span> <span begin="2:56.300" end="2:56.586">still</span> <span begin="2:56.586" end="2:57.865">remains</span> <span begin="2:57.865" end="2:58.604">this</span> <span begin="2:58.604" end="3:00.596">place</span><span ttm:role="x-translation" xml:lang="zh-CN">你所说的话仍驻留此地</span></p><p begin="3:00.933" end="3:06.473" itunes:key="L36" ttm:agent="v3"><span begin="3:00.933" end="3:01.298">Days</span> <span begin="3:01.298" end="3:01.642">we</span> <span begin="3:01.642" end="3:02.691">played</span> <span begin="3:02.840" end="3:03.234">and</span> <span begin="3:03.234" end="3:04.030">held</span> <span begin="3:04.030" end="3:04.786">each</span> <span begin="3:04.786" end="3:06.473">hands</span><span ttm:role="x-translation" xml:lang="zh-CN">驻留于我们玩耍与紧握彼此双手的时光</span></p><p begin="3:06.706" end="3:12.622" itunes:key="L37" ttm:agent="v3"><span begin="3:06.706" end="3:07.397">Nothing</span> <span begin="3:07.397" end="3:07.708">was</span> <span begin="3:07.708" end="3:09.463">afraid</span> <span begin="3:09.788" end="3:10.204">but</span> <span begin="3:10.204" end="3:10.601">now</span> <span begin="3:10.601" end="3:11.005">we&apos;ve</span> <span begin="3:11.005" end="3:12.622">faced</span><span ttm:role="x-translation" xml:lang="zh-CN">我们曾一无所惧，但此刻却已面对</span></p><p begin="3:12.934" end="3:19.419" itunes:key="L38" ttm:agent="v3"><span begin="3:12.934" end="3:13.269">This</span> <span begin="3:13.269" end="3:14.065">ruthless</span> <span begin="3:14.065" end="3:15.665">fate</span> <span begin="3:16.005" end="3:16.397">tears</span> <span begin="3:16.397" end="3:16.770">drop</span> <span begin="3:16.770" end="3:17.168">in</span> <span begin="3:17.168" end="3:19.419">space</span><span ttm:role="x-translation" xml:lang="zh-CN">这无情的命运之泪洒落于虚空</span></p></div><div begin="3:19.463" end="3:48.127" itunes:songPart="Transition"><p begin="3:19.492" end="3:31.403" itunes:key="L39" ttm:agent="v1"><span begin="3:19.492" end="3:19.861">閉</span><span begin="3:19.861" end="3:20.249">じ</span><span begin="3:20.249" end="3:21.215">た</span><span begin="3:21.459" end="3:22.612">瞳</span><span begin="3:22.612" end="3:22.949">を</span><span begin="3:22.949" end="3:23.917">開</span><span begin="3:23.917" end="3:24.167">け</span><span begin="3:24.167" end="3:25.244">ば</span> <span begin="3:25.682" end="3:26.459">夢</span><span begin="3:26.459" end="3:27.304">を</span><span begin="3:27.641" end="3:27.970">繰</span><span begin="3:27.970" end="3:28.374">り</span><span begin="3:28.374" end="3:29.178">返</span><span begin="3:29.178" end="3:29.516">す</span><span begin="3:29.516" end="3:30.122">世</span><span begin="3:30.122" end="3:31.403">界</span><span ttm:role="x-translation" xml:lang="zh-CN">将闭上的眼睁开的话 梦境重复的世界</span><span ttm:role="x-roman">tojita hitomi o hirakeba yume o kurikaesu sekai</span></p><p begin="3:19.463" end="3:25.308" itunes:key="L40" ttm:agent="v3"><span begin="3:19.463" end="3:19.910">Don&apos;t</span> <span begin="3:19.910" end="3:21.006">forget</span> <span begin="3:21.006" end="3:21.470">I&apos;ll</span> <span begin="3:21.470" end="3:21.840">be</span> <span begin="3:21.840" end="3:22.613">there</span> <span begin="3:22.613" end="3:25.308">always</span><span ttm:role="x-translation" xml:lang="zh-CN">请不要忘记，我永远在你身边</span></p><p begin="3:25.678" end="3:31.230" itunes:key="L41" ttm:agent="v3"><span begin="3:25.678" end="3:26.064">——Phrase</span> <span begin="3:26.064" end="3:26.561">to</span> <span begin="3:26.561" end="3:27.642">make</span> <span begin="3:27.642" end="3:28.044">your</span> <span begin="3:28.044" end="3:28.809">smile</span> <span begin="3:28.809" end="3:31.230">again</span><span ttm:role="x-translation" xml:lang="zh-CN">以字句重拾你微笑</span></p><p begin="3:31.891" end="3:48.127" itunes:key="L42" ttm:agent="v1"><span begin="3:31.891" end="3:33.806">失</span><span begin="3:33.806" end="3:34.205">う</span><span begin="3:34.205" end="3:34.792">の</span><span begin="3:34.792" end="3:35.314">が</span><span begin="3:35.314" end="3:36.273">怖</span><span begin="3:36.273" end="3:36.513">く</span><span begin="3:36.513" end="3:37.483">て</span> <span begin="3:38.068" end="3:38.845">僕</span><span begin="3:38.845" end="3:39.960">は</span><span begin="3:40.016" end="3:40.415">た</span><span begin="3:40.415" end="3:40.996">だ</span><span begin="3:40.996" end="3:41.932">眠</span><span begin="3:41.932" end="3:42.752">り</span><span begin="3:43.050" end="3:44.256">続</span><span begin="3:44.256" end="3:45.045">け</span><span begin="3:45.045" end="3:48.127">る</span><span ttm:role="x-translation" xml:lang="zh-CN">害怕失去 我只是继续入眠</span><span ttm:role="x-roman">ushinau no ga kowakute boku wa tada nemuritsuzukeru</span></p><p begin="3:31.403" end="3:37.516" itunes:key="L43" ttm:agent="v3"><span begin="3:31.403" end="3:31.879">Sky&apos;s</span> <span begin="3:31.879" end="3:32.629">painted</span> <span begin="3:32.629" end="3:34.394">gray</span> <span begin="3:34.394" end="3:34.799">but</span> <span begin="3:34.799" end="3:35.211">we</span> <span begin="3:35.211" end="3:35.629">can</span> <span begin="3:35.629" end="3:37.516">change</span><span ttm:role="x-translation" xml:lang="zh-CN">虽然天色被涂上灰色，但我们仍能改变它</span></p><p begin="3:37.672" end="3:48.127" itunes:key="L44" ttm:agent="v3"><span begin="3:37.672" end="3:37.898">——To</span> <span begin="3:37.898" end="3:38.482">smash</span> <span begin="3:38.482" end="3:38.983">this</span> <span begin="3:38.983" end="3:40.351">fate</span> <span begin="3:40.598" end="3:41.179">and</span> <span begin="3:41.179" end="3:41.592">catch</span> <span begin="3:41.592" end="3:41.972">a</span> <span begin="3:41.972" end="3:42.973">flame</span> <span begin="3:43.402" end="3:44.069">like</span> <span begin="3:44.069" end="3:44.271">the</span> <span begin="3:44.271" end="3:45.066">shooting</span> <span begin="3:45.066" end="3:48.127">star</span><span ttm:role="x-translation" xml:lang="zh-CN">粉碎命运原向，并撷住那流星般的焰火</span></p></div><div begin="3:51.216" end="4:12.524" itunes:songPart="PreChorus"><p begin="3:51.216" end="3:55.816" itunes:key="L45" ttm:agent="v2"><span begin="3:51.216" end="3:51.538">今</span><span begin="3:51.538" end="3:52.215">は</span> <span begin="3:52.773" end="3:53.054">細</span><span begin="3:53.054" end="3:53.514">く</span><span begin="3:53.514" end="3:53.929">遠</span><span begin="3:53.929" end="3:54.302">い</span><span begin="3:54.302" end="3:54.643">声</span><span begin="3:54.643" end="3:55.816">も</span><span ttm:role="x-translation" xml:lang="zh-CN">现在细小而遥远的声音也</span><span ttm:role="x-roman">ima wa hosoku tooi koe mo</span></p><p begin="3:57.431" end="4:01.619" itunes:key="L46" ttm:agent="v2"><span begin="3:57.431" end="3:57.630">や</span><span begin="3:57.630" end="3:57.795">が</span><span begin="3:57.795" end="3:58.435">て</span> <span begin="3:58.955" end="3:59.228">遠</span><span begin="3:59.228" end="3:59.742">い</span><span begin="3:59.742" end="4:00.082">時</span><span begin="4:00.082" end="4:00.472">の</span><span begin="4:00.472" end="4:00.727">果</span><span begin="4:00.727" end="4:00.893">て</span><span begin="4:00.893" end="4:01.619">で</span><span ttm:role="x-translation" xml:lang="zh-CN">终于在遥远时间的尽头</span><span ttm:role="x-roman">yagate tooi toki no hate de</span></p><p begin="4:03.597" end="4:07.795" itunes:key="L47" ttm:agent="v2"><span begin="4:03.597" end="4:03.979">霞</span><span begin="4:03.979" end="4:04.586">み</span><span begin="4:05.094" end="4:05.325">消</span><span begin="4:05.325" end="4:05.502">え</span><span begin="4:05.502" end="4:05.859">る</span> <span begin="4:05.859" end="4:06.272">星</span><span begin="4:06.272" end="4:06.687">の</span><span begin="4:06.687" end="4:06.874">よ</span><span begin="4:06.874" end="4:07.072">う</span><span begin="4:07.072" end="4:07.795">に</span><span ttm:role="x-translation" xml:lang="zh-CN">晚霞消失的星朽般</span><span ttm:role="x-roman">kasumikieru hoshi no you ni</span></p><p begin="4:09.424" end="4:12.524" itunes:key="L48" ttm:agent="v2"><span begin="4:09.424" end="4:10.023">境</span><span begin="4:10.023" end="4:10.844">界</span> <span begin="4:10.933" end="4:11.294">越</span><span begin="4:11.294" end="4:11.864">え</span><span begin="4:11.939" end="4:12.524">て</span><span ttm:role="x-translation" xml:lang="zh-CN">跨越境界</span><span ttm:role="x-roman">kyoukai koete</span></p></div><div begin="4:11.969" end="4:43.891" itunes:songPart="Chorus"><p begin="4:11.969" end="4:18.365" itunes:key="L49" ttm:agent="v1"><span begin="4:11.969" end="4:12.875">君</span><span begin="4:12.875" end="4:13.702">と</span><span begin="4:13.702" end="4:14.447">二人</span><span begin="4:14.447" end="4:15.204">で</span> <span begin="4:15.204" end="4:15.773">夜</span><span begin="4:15.773" end="4:15.990">を</span><span begin="4:15.990" end="4:16.574">駆</span><span begin="4:16.574" end="4:16.771">け</span><span begin="4:16.771" end="4:17.956">た</span><span ttm:role="x-translation" xml:lang="zh-CN">与你二人追赶夜晚</span><span ttm:role="x-roman">kimi to futari de yoru o kaketa</span><span ttm:role="x-bg" begin="4:12.877" end="4:18.365"><span begin="4:12.877" end="4:14.418">(——Walk</span> <span begin="4:14.418" end="4:18.365">Together)</span><span ttm:role="x-translation" xml:lang="zh-CN">我们并肩而行</span></span></p><p begin="4:15.925" end="4:18.365" itunes:key="L50" ttm:agent="v2"><span begin="4:15.925" end="4:16.199">君</span><span begin="4:16.199" end="4:16.653">と</span><span begin="4:16.725" end="4:17.048">僕</span><span begin="4:17.048" end="4:17.462">の</span><span begin="4:17.462" end="4:17.747">日</span><span begin="4:17.747" end="4:17.892">々</span><span begin="4:17.892" end="4:18.365">を</span><span ttm:role="x-translation" xml:lang="zh-CN">你与我的日子</span><span ttm:role="x-roman">kimi to boku no hibi o</span></p><p begin="4:18.365" end="4:24.902" itunes:key="L51" ttm:agent="v1"><span begin="4:18.365" end="4:19.106">こ</span><span begin="4:19.106" end="4:19.391">の</span><span begin="4:19.391" end="4:19.669">奇</span><span begin="4:19.669" end="4:19.895">跡</span><span begin="4:19.895" end="4:20.240">を</span> <span begin="4:20.636" end="4:21.200">忘</span><span begin="4:21.200" end="4:21.450">れ</span><span begin="4:21.450" end="4:21.717">る</span><span begin="4:21.717" end="4:21.959">こ</span><span begin="4:21.959" end="4:22.205">と</span><span begin="4:22.205" end="4:22.489">な</span><span begin="4:22.489" end="4:22.769">ん</span><span begin="4:22.769" end="4:23.004">て</span><span begin="4:23.004" end="4:23.259">で</span><span begin="4:23.259" end="4:23.561">き</span><span begin="4:23.561" end="4:23.806">な</span><span begin="4:23.806" end="4:24.540">い</span><span ttm:role="x-translation" xml:lang="zh-CN">我无法将这个梦境给遗忘掉</span><span ttm:role="x-roman">kono yume o wasureru koto nante dekinai</span><span ttm:role="x-bg" begin="4:19.100" end="4:24.902"><span begin="4:19.100" end="4:20.244">(——Try</span> <span begin="4:20.244" end="4:20.792">to</span> <span begin="4:20.792" end="4:21.239">find</span> <span begin="4:21.239" end="4:22.227">the</span> <span begin="4:22.227" end="4:23.243">way</span> <span begin="4:23.243" end="4:23.747">back</span> <span begin="4:23.747" end="4:24.902">home)</span><span ttm:role="x-translation" xml:lang="zh-CN">找寻回家的路途</span></span></p><p begin="4:22.240" end="4:26.807" itunes:key="L52" ttm:agent="v2"><span begin="4:22.240" end="4:23.615">忘</span><span begin="4:23.615" end="4:24.550">れ</span><span begin="4:24.550" end="4:25.413">な</span><span begin="4:25.413" end="4:26.807">い</span><span ttm:role="x-translation" xml:lang="zh-CN">不会忘记</span><span ttm:role="x-roman">wasurenai</span></p><p begin="4:24.944" end="4:30.688" itunes:key="L53" ttm:agent="v1"><span begin="4:24.944" end="4:25.246">い</span><span begin="4:25.246" end="4:26.053">つ</span><span begin="4:26.053" end="4:26.348">か</span> <span begin="4:26.348" end="4:26.835">月</span><span begin="4:26.835" end="4:27.601">と</span><span begin="4:27.601" end="4:28.210">星</span><span begin="4:28.210" end="4:28.340">の</span><span begin="4:28.340" end="4:29.179">下</span><span begin="4:29.179" end="4:30.223">で</span><span ttm:role="x-translation" xml:lang="zh-CN">总有一天在月亮和星星下</span><span ttm:role="x-roman">itsuka tsuki to hoshi no shita de</span><span ttm:role="x-bg" begin="4:25.288" end="4:30.688"><span begin="4:25.288" end="4:26.385">(——Not</span> <span begin="4:26.385" end="4:26.831">so</span> <span begin="4:26.831" end="4:27.583">hard</span> <span begin="4:27.583" end="4:28.404">I</span> <span begin="4:28.404" end="4:30.688">guess)</span><span ttm:role="x-translation" xml:lang="zh-CN">这将不再困难</span></span></p><p begin="4:28.281" end="4:30.720" itunes:key="L54" ttm:agent="v2"><span begin="4:28.281" end="4:28.436">過</span><span begin="4:28.436" end="4:28.591">去</span><span begin="4:28.591" end="4:29.068">も</span> <span begin="4:29.146" end="4:29.335">現</span><span begin="4:29.335" end="4:29.485">在</span><span begin="4:29.485" end="4:29.894">も</span> <span begin="4:29.894" end="4:30.090">未</span><span begin="4:30.090" end="4:30.246">来</span><span begin="4:30.246" end="4:30.720">も</span><span ttm:role="x-translation" xml:lang="zh-CN">过去也，现在也，将来也</span><span ttm:role="x-roman">kako mo ima mo asu mo</span></p><p begin="4:30.720" end="4:36.138" itunes:key="L55" ttm:agent="v1"><span begin="4:30.720" end="4:31.147">出</span><span begin="4:31.147" end="4:31.456">会</span><span begin="4:31.456" end="4:31.796">う</span><span begin="4:31.796" end="4:32.080">の</span><span begin="4:32.080" end="4:32.270">だ</span><span begin="4:32.270" end="4:32.628">ろう</span> <span begin="4:32.971" end="4:33.331">醒</span><span begin="4:33.331" end="4:33.599">め</span><span begin="4:33.599" end="4:33.832">な</span><span begin="4:33.832" end="4:34.112">い</span><span begin="4:34.112" end="4:34.353">幻</span><span begin="4:34.353" end="4:34.594">想</span><span begin="4:34.594" end="4:36.138">と</span><span ttm:role="x-translation" xml:lang="zh-CN">如果不会醒来的话 还会相遇的吧</span><span ttm:role="x-roman">deau no darou samenai yume to</span><span ttm:role="x-bg" begin="4:31.475" end="4:34.567"><span begin="4:31.475" end="4:32.250">(——For</span> <span begin="4:32.250" end="4:33.060">you</span> <span begin="4:33.060" end="4:33.578">and</span> <span begin="4:33.578" end="4:34.567">me)</span><span ttm:role="x-translation" xml:lang="zh-CN">只因我俩双并双行</span></span></p><p begin="4:34.567" end="4:37.659" itunes:key="L56" ttm:agent="v2"><span begin="4:34.567" end="4:35.163">月</span><span begin="4:35.163" end="4:35.356">と</span><span begin="4:35.356" end="4:35.998">星</span><span begin="4:35.998" end="4:36.140">を</span><span begin="4:36.140" end="4:36.719">違</span><span begin="4:36.719" end="4:36.910">え</span><span begin="4:36.910" end="4:37.209">よ</span><span begin="4:37.209" end="4:37.472">う</span><span begin="4:37.472" end="4:37.610">と</span><span ttm:role="x-translation" xml:lang="zh-CN">不管月亮和星星流逝</span><span ttm:role="x-roman">tsuki to hoshi o tagaeyou to</span><span ttm:role="x-bg" begin="4:34.603" end="4:37.659"><span begin="4:34.603" end="4:35.010">(——We</span> <span begin="4:35.010" end="4:35.342">still</span> <span begin="4:35.342" end="4:35.831">search</span> <span begin="4:35.831" end="4:36.105">the</span> <span begin="4:36.105" end="4:37.659">starlights)</span><span ttm:role="x-translation" xml:lang="zh-CN">我们仍试图冀索星光</span></span></p><p begin="4:37.699" end="4:40.793" itunes:key="L57" ttm:agent="v2"><span begin="4:37.699" end="4:37.975">明</span><span begin="4:37.975" end="4:38.301">け</span><span begin="4:38.301" end="4:38.488">ぬ</span><span begin="4:38.488" end="4:39.021">夜</span><span begin="4:39.021" end="4:39.220">が</span><span begin="4:39.255" end="4:39.775">交</span><span begin="4:39.775" end="4:40.025">わ</span><span begin="4:40.025" end="4:40.277">ろ</span><span begin="4:40.277" end="4:40.571">う</span><span begin="4:40.571" end="4:40.793">と</span><span ttm:role="x-translation" xml:lang="zh-CN">不管不明之夜在交错</span><span ttm:role="x-roman">akenu yoru ga majiwarou to</span><span ttm:role="x-bg" begin="4:38.065" end="4:40.793"><span begin="4:38.065" end="4:38.832">(——Despite</span> <span begin="4:38.832" end="4:39.242">there&apos;s</span> <span begin="4:39.242" end="4:39.643">no</span> <span begin="4:39.643" end="4:40.011">hope</span> <span begin="4:40.011" end="4:40.793">inside)</span><span ttm:role="x-translation" xml:lang="zh-CN">即使当中已无希望</span></span></p><p begin="4:40.793" end="4:43.891" itunes:key="L58" ttm:agent="v2"><span begin="4:40.793" end="4:41.109">た</span><span begin="4:41.109" end="4:41.399">と</span><span begin="4:41.399" end="4:41.579">え</span><span begin="4:41.579" end="4:42.155">時</span><span begin="4:42.155" end="4:42.346">が</span><span begin="4:42.346" end="4:42.892">隔</span><span begin="4:42.892" end="4:43.094">て</span><span begin="4:43.094" end="4:43.410">よ</span><span begin="4:43.410" end="4:43.671">う</span><span begin="4:43.671" end="4:43.891">と</span><span ttm:role="x-translation" xml:lang="zh-CN">即使受到时间的阻隔</span><span ttm:role="x-roman">tatoe toki ga hedateyou to</span><span ttm:role="x-bg" begin="4:41.119" end="4:43.891"><span begin="4:41.119" end="4:41.536">(——Wind</span> <span begin="4:41.536" end="4:41.942">blows</span> <span begin="4:41.942" end="4:42.306">through</span> <span begin="4:42.306" end="4:42.703">this</span> <span begin="4:42.703" end="4:43.891">ground)</span><span ttm:role="x-translation" xml:lang="zh-CN">狂风呼啸横越次第</span></span></p></div><div begin="4:43.891" end="4:50.134" itunes:songPart="Outro"><p begin="4:43.891" end="4:50.134" itunes:key="L59" ttm:agent="v2"><span begin="4:43.891" end="4:44.493">君</span><span begin="4:44.493" end="4:44.684">の</span><span begin="4:44.684" end="4:45.226">声</span><span begin="4:45.226" end="4:45.428">は</span><span begin="4:45.428" end="4:46.017">届</span><span begin="4:46.017" end="4:46.212">い</span><span begin="4:46.212" end="4:46.499">て</span><span begin="4:46.499" end="4:46.791">い</span><span begin="4:46.791" end="4:47.030">る</span><span begin="4:47.030" end="4:48.538">か</span><span begin="4:48.538" end="4:50.134">ら</span><span ttm:role="x-translation" xml:lang="zh-CN">因为你的声音在传达着</span><span ttm:role="x-roman">kimi no koe wa todoite iru kara</span><span ttm:role="x-bg" begin="4:44.081" end="4:50.134"><span begin="4:44.081" end="4:44.486">(——To</span> <span begin="4:44.486" end="4:45.041">make</span> <span begin="4:45.041" end="4:45.434">us</span> <span begin="4:45.434" end="4:46.226">braver</span> <span begin="4:46.226" end="4:46.608">than</span> <span begin="4:46.608" end="4:46.947">we</span> <span begin="4:46.947" end="4:50.134">are)</span><span ttm:role="x-translation" xml:lang="zh-CN">使我们坚韧更胜以往</span></span></p></div></body></tt>