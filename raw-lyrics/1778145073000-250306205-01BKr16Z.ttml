<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xmlns:amll="http://www.example.com/ns/amll" xmlns:itunes="http://itunes.apple.com/lyric-ttml-extensions" xml:lang="en" itunes:timing="Word"><head><metadata><ttm:agent type="person" xml:id="v1"><ttm:name type="full">Pepa</ttm:name></ttm:agent><ttm:agent type="person" xml:id="v2"><ttm:name type="full">Dolores</ttm:name></ttm:agent><ttm:agent type="person" xml:id="v3"><ttm:name type="full">Camilo</ttm:name></ttm:agent><ttm:agent type="person" xml:id="v5"/><ttm:agent type="person" xml:id="v6"/><ttm:agent type="person" xml:id="v7"/><ttm:agent type="person" xml:id="v8"><ttm:name type="full">Isabela</ttm:name></ttm:agent><ttm:agent type="person" xml:id="v9"><ttm:name type="full">Mirabel</ttm:name></ttm:agent><ttm:agent type="person" xml:id="v10"><ttm:name type="full">Alma</ttm:name></ttm:agent><ttm:agent type="person" xml:id="v11"><ttm:name type="full">Felix</ttm:name></ttm:agent><ttm:agent type="group" xml:id="v1000"/><amll:meta key="ncmMusicId" value="1896087128"/><amll:meta key="qqMusicId" value="003Dvq093FiP0F"/><amll:meta key="qqMusicId" value="333281936"/><amll:meta key="qqMusicId" value="000B4g5f4YbV45"/><amll:meta key="qqMusicId" value="339537295"/><amll:meta key="spotifyId" value="52xJxFP6TqMuO4Yt0eOkMz"/><amll:meta key="spotifyId" value="3fYwdlIVtJlYJTvHYrt7ev"/><amll:meta key="appleMusicId" value="1594677760"/><amll:meta key="appleMusicId" value="1605202548"/><amll:meta key="isrc" value="USWD12112915"/><amll:meta key="musicName" value="We Don't Talk About Bruno (From &quot;Encanto&quot;/Soundtrack Version)"/><amll:meta key="musicName" value="We Don't Talk About Bruno - From &quot;Encanto&quot;/Soundtrack Version"/><amll:meta key="musicName" value="We Don't Talk About Bruno"/><amll:meta key="artists" value="Carolina Gaitán"/><amll:meta key="artists" value="Mauro Castillo"/><amll:meta key="artists" value="Adassa"/><amll:meta key="artists" value="Rhenzy Feliz"/><amll:meta key="artists" value="Diane Guerrero"/><amll:meta key="artists" value="Stephanie Beatriz"/><amll:meta key="artists" value="Encanto - Cast"/><amll:meta key="artists" value="Carolina Gaitán - La Gaita"/><amll:meta key="album" value="Encanto (Original Motion Picture Soundtrack)"/><amll:meta key="album" value="We Don’t Talk About Bruno (From &quot;Encanto&quot;)"/><amll:meta key="ttmlAuthorGithub" value="136059186"/><amll:meta key="ttmlAuthorGithub" value="250306205"/><amll:meta key="ttmlAuthorGithubLogin" value="MiaowCham"/><amll:meta key="ttmlAuthorGithubLogin" value="kid141252010"/><iTunesMetadata><songwriters><songwriter>Lin-Manuel Miranda</songwriter></songwriters><translations><translation xml:lang="zh-Hans" type="subtitle"><text for="L1">我们不提布鲁诺 不 不 不</text><text for="L2">我们不提布鲁诺 可是</text><text for="L3">那天是我结婚的日子<span ttm:role="x-bg">那天是我们结婚的日子</span></text><text for="L4">我们在做准备 天空万里无云<span ttm:role="x-bg">天空不许有一朵云</span></text><text for="L5">布鲁诺坏笑着走了进来<span ttm:role="x-bg">雷声隆隆</span></text><text for="L6">你讲还是我讲<span ttm:role="x-bg">抱歉 亲爱的 请继续</span></text><text for="L7">布鲁诺说 看来要下雨<span ttm:role="x-bg">他为何说出来</span></text><text for="L8">那样做让我心绪难宁<span ttm:role="x-bg">奶奶 请把雨伞拿出来</span></text><text for="L9">在狂风骤雨的天气结婚<span ttm:role="x-bg">多么欢乐的一天 可不管怎样</span></text><text for="L10">我们不提布鲁诺 不 不 不</text><text for="L11">我们不提布鲁诺</text><text for="L12">嘿 从小就害怕布鲁诺开口讲话</text><text for="L13">我总是能听到他喃喃自语</text><text for="L14">想起他 我就想到沙子滑落的声音<span ttm:role="x-bg">沙 沙 沙</span></text><text for="L15">这份令人谦卑的天赋太沉重</text><text for="L16">总是让奶奶和家人手足无措</text><text for="L17">让他们面对无法理解的预言</text><text for="L18">你懂吗</text><text for="L19">身高七尺 背上爬老鼠</text><text for="L20">他若唤你名字 万物隐进黑暗</text><text for="L21">没错 他潜入你梦境 乐见你尖叫<span ttm:role="x-bg">嘿</span></text><text for="L22">我们不提布鲁诺 不 不 不<span ttm:role="x-bg">我们不提布鲁诺 不</span></text><text for="L23">我们不提布鲁诺<span ttm:role="x-bg">我们不提布鲁诺</span></text><text for="L24">他说我的鱼会死 第二天鱼真的死了<span ttm:role="x-bg">不 不</span></text><text for="L25">他说我会发福 让他说中了<span ttm:role="x-bg">不 不</span></text><text for="L26">他说我会头秃 结果你看看我的头<span ttm:role="x-bg">不 不</span></text><text for="L27">预言既出 命中注定</text><text for="L28">他说我梦想的生活</text><text for="L29">将会成真 终有一天属于我</text><text for="L30">他说我的力量会增长</text><text for="L31">像藤上茁壮成长的葡萄<span ttm:role="x-bg">喂 马里亚诺在路上</span></text><text for="L32">他说我的梦中情人</text><text for="L33">终将遥不可及</text><text for="L34">会与别人订婚</text><text for="L35">仿佛我现在就听到他说话</text><text for="L36">嘿 妹妹 我不想听到你出声</text><text for="L37">仿佛我现在就能听到他说话</text><text for="L38">我现在就能听到他说话</text><text for="L39">呃 布鲁诺</text><text for="L40">没错 说到那个布鲁诺</text><text for="L41">我真的需要了解布鲁诺</text><text for="L42">告诉我真相 全部真相 布鲁诺<span ttm:role="x-bg">伊莎贝拉 你的男朋友来了</span></text><text for="L43">晚宴时间到</text><text for="L44">他说我梦想的生活<span ttm:role="x-bg">身高七尺</span></text><text for="L45">那天是我结婚的日子<span ttm:role="x-bg">那天是我们结婚的日子</span></text><text for="L46">将会成真 终有一天属于我<span ttm:role="x-bg">背上爬老鼠</span></text><text for="L47">我们在做准备 天空万里无云<span ttm:role="x-bg">他若唤你名字 万物隐进黑暗</span></text><text for="L48">天空万里无云<span ttm:role="x-bg">天空不许有一朵云</span></text><text for="L49">他说我梦想的生活<span ttm:role="x-bg">没错 他潜入你梦境 乐见你尖叫</span></text><text for="L50">布鲁诺坏笑着走了进来</text><text for="L51">你讲还是我讲<span ttm:role="x-bg">雷声隆隆</span></text><text for="L52">像藤上茁壮成长的葡萄</text><text for="L53">喂 马里亚诺在路上<span ttm:role="x-bg">抱歉 亲爱的 请继续</span></text><text for="L54">身高七尺</text><text for="L55">布鲁诺说 看来要下雨</text><text for="L56">他说我梦想的生活<span ttm:role="x-bg">他说我的梦中情人</span></text><text for="L57">背上爬老鼠<span ttm:role="x-bg">他为何说出来</span></text><text for="L58">将会成真 终有一天属于我<span ttm:role="x-bg">终将遥不可及</span></text><text for="L59">他若唤你名字</text><text for="L60">那样做让我心绪难宁<span ttm:role="x-bg">会与别人 别人订婚</span></text><text for="L61">万物隐进黑暗<span ttm:role="x-bg">祖母 带上伞</span></text><text for="L62">在狂风骤雨的天气结婚<span ttm:role="x-bg">我没事 我没事 我没事 我真的没事</span></text><text for="L63">没错 他潜入你梦境 乐见你尖叫<span ttm:role="x-bg">多么愉快的一天</span></text><text for="L64">他来了</text><text for="L65">不提布鲁诺</text><text for="L66">我为何提起布鲁诺</text><text for="L67">绝口不提布鲁诺</text><text for="L68">我真不该提起布鲁诺</text></translation></translations><audio lyricOffset="0.050" role="spatial"/></iTunesMetadata></metadata></head><body dur="03:25.987"><div begin="00:01.257" end="00:10.101" itunes:songPart="Intro"><p begin="00:01.257" end="00:05.552" ttm:agent="v1" itunes:key="L1"><span begin="00:01.257" end="00:01.553">We</span> <span begin="00:01.553" end="00:01.848">don't</span> <span begin="00:01.848" end="00:02.129">talk</span> <span begin="00:02.129" end="00:02.415">a</span><span begin="00:02.415" end="00:02.728">bout</span> <span begin="00:02.728" end="00:03.325">Bru</span><span begin="00:03.325" end="00:03.792">no,</span> <span begin="00:03.902" end="00:04.454">no,</span> <span begin="00:04.454" end="00:05.036">no,</span> <span begin="00:05.036" end="00:05.552">no</span></p><p begin="00:05.908" end="00:10.101" ttm:agent="v1" itunes:key="L2"><span begin="00:05.908" end="00:06.173">We</span> <span begin="00:06.173" end="00:06.505">don't</span> <span begin="00:06.505" end="00:06.788">talk</span> <span begin="00:06.788" end="00:07.074">a</span><span begin="00:07.074" end="00:07.379">bout</span> <span begin="00:07.379" end="00:07.954">Bru</span><span begin="00:07.954" end="00:09.120">no,</span> <span begin="00:09.734" end="00:10.101">but</span></p></div><div begin="00:10.582" end="00:43.125" itunes:songPart="Verse"><p begin="00:10.582" end="00:13.435" ttm:agent="v1" itunes:key="L3"><span begin="00:10.582" end="00:10.716">It</span> <span begin="00:10.716" end="00:10.889">was</span> <span begin="00:10.889" end="00:11.193">my</span> <span begin="00:11.193" end="00:11.513">wed</span><span begin="00:11.513" end="00:11.759">ding</span> <span begin="00:11.759" end="00:12.645">day</span><span ttm:role="x-bg" begin="00:11.724" end="00:13.435"><span begin="00:11.724" end="00:11.894">(It</span> <span begin="00:11.894" end="00:12.059">was</span> <span begin="00:12.059" end="0