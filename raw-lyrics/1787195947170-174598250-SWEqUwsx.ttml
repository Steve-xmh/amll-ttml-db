<tt xmlns="http://www.w3.org/ns/ttml" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xmlns:amll="http://www.example.com/ns/amll"><head><metadata><ttm:agent type="person" xml:id="v1"/><amll:meta key="musicName" value="Forget It"/><amll:meta key="musicName" value="忘れてしまえ"/><amll:meta key="musicName" value="忘掉吧"/><amll:meta key="artists" value="KAF"/><amll:meta key="artists" value="kaf"/><amll:meta key="artists" value="かふ"/><amll:meta key="artists" value="花譜"/><amll:meta key="artists" value="花谱"/><amll:meta key="album" value="Observation"/><amll:meta key="album" value="観測"/><amll:meta key="isrc" value="JPZ921908130"/><amll:meta key="ncmMusicId" value="1399847997"/><amll:meta key="qqMusicId" value="002CaHy520lZ44"/><amll:meta key="qqMusicId" value="237771162"/><amll:meta key="spotifyId" value="073EMDbIEj93cuHpVaAaGQ"/><amll:meta key="appleMusicId" value="1688351146"/><amll:meta key="ttmlAuthorGithub" value="174598250"/><amll:meta key="ttmlAuthorGithubLogin" value="ASyunagi"/></metadata></head><body dur="3:39.390"><div begin="13.390" end="3:39.390"><p begin="13.390" end="15.330" itunes:key="L1" ttm:agent="v1"><span begin="13.390" end="14.070">笑</span><span begin="14.070" end="14.730">う</span><span begin="14.730" end="15.050">な</span><span begin="15.050" end="15.330">ら</span><span ttm:role="x-translation" xml:lang="zh-Hans">若要欢笑</span><span ttm:role="x-translation" xml:lang="zh-Hant">若要歡笑</span><span ttm:role="x-translation" xml:lang="en">If you&apos;re going to smile</span><span ttm:role="x-translation" xml:lang="ko">웃을 거라면</span><span ttm:role="x-translation" xml:lang="fr">Si tu veux sourire</span><span ttm:role="x-translation" xml:lang="es">Si vas a sonreír</span><span ttm:role="x-translation" xml:lang="de">Wenn du lachen willst</span><span ttm:role="x-translation" xml:lang="pt">Se for para sorrir</span><span ttm:role="x-translation" xml:lang="ru">Если смеяться</span><span ttm:role="x-translation" xml:lang="it">Se devi sorridere</span><span ttm:role="x-roman">Warau nara</span></p><p begin="15.720" end="18.660" itunes:key="L2" ttm:agent="v1"><span begin="15.720" end="16.370">描</span><span begin="16.370" end="16.730">く</span><span begin="16.730" end="17.380">な</span><span begin="17.380" end="17.730">ら</span><span begin="17.730" end="18.420">今</span><span begin="18.420" end="18.660">だ</span><span ttm:role="x-translation" xml:lang="zh-Hans">若要描绘 就是此刻</span><span ttm:role="x-translation" xml:lang="zh-Hant">若要描繪 就是此刻</span><span ttm:role="x-translation" xml:lang="en">If you&apos;re going to draw it now is the time</span><span ttm:role="x-translation" xml:lang="ko">그려 낼 거라면 지금이야</span><span ttm:role="x-translation" xml:lang="fr">Si tu veux dessiner c’est maintenant</span><span ttm:role="x-translation" xml:lang="es">Si vas a dibujar que sea ahora</span><span ttm:role="x-translation" xml:lang="de">Wenn du etwas zeichnen willst dann jetzt</span><span ttm:role="x-translation" xml:lang="pt">Se for para desenhar é agora</span><span ttm:role="x-translation" xml:lang="ru">Если рисовать то сейчас</span><span ttm:role="x-translation" xml:lang="it">Se devi dipingere fallo adesso</span><span ttm:role="x-roman">Egaku nara ima da</span></p><p begin="19.020" end="23.700" itunes:key="L3" ttm:agent="v1"><span begin="19.020" end="19.750">言</span><span begin="19.750" end="20.060">葉</span><span begin="20.060" end="20.400">な</span><span begin="20.400" end="20.720">ん</span><span begin="20.720" end="21.050">か</span><span begin="21.050" end="21.230">じ</span><span begin="21.230" end="21.410">ゃ</span><span begin="21.710" end="22.390">伝</span><span begin="22.390" end="22.740">わ</span><span begin="22.740" end="23.090">ら</span><span begin="23.090" end="23.400">な</span><span begin="23.400" end="23.700">い</span><span ttm:role="x-translation" xml:lang="zh-Hans">言语早已无法传达</span><span ttm:role="x-translation" xml:lang="zh-Hant">言語早已無法傳達</span><span ttm:role="x-translation" xml:lang="en">Words could never make it understood</span><span ttm:role="x-translation" xml:lang="ko">말 따위로는 전할 수 없어</span><span ttm:role="x-translation" xml:lang="fr">Les mots ne suffiront jamais à le transmettre</span><span ttm:role="x-translation" xml:lang="es">Con palabras jamás podría expresarse</span><span ttm:role="x-translation" xml:lang="de">Mit Worten allein lässt es sich nicht vermitteln</span><span ttm:role="x-translation" xml:lang="pt">Palavras jamais conseguiriam transmitir isso</span><span ttm:role="x-translation" xml:lang="ru">Одними словами этого не передать</span><span ttm:role="x-translation" xml:lang="it">Con le parole non si può trasmettere</span><span ttm:role="x-roman">Kotoba nanka ja tsutawaranai</span></p><p begin="24.040" end="27.690" itunes:key="L4" ttm:agent="v1"><span begin="24.040" end="24.750">空</span><span begin="24.750" end="25.060">に</span><span begin="25.380" end="26.040">放</span><span begin="26.040" end="26.420">つ</span><span begin="26.690" end="27.080">ラ</span><span begin="27.080" end="27.410">イ</span><span begin="27.410" end="27.690">ン</span><span ttm:role="x-translation" xml:lang="zh-Hans">向天空抛掷的轨迹</span><span ttm:role="x-translation" xml:lang="zh-Hant">向天空拋擲的軌跡</span><span ttm:role="x-translation" xml:lang="en">A line cast into the sky</span><span ttm:role="x-translation" xml:lang="ko">하늘로 던져 올린 선</span><span ttm:role="x-translation" xml:lang="fr">Une ligne lancée vers le ciel</span><span ttm:role="x-translation" xml:lang="es">Una línea lanzada al cielo</span><span ttm:role="x-translation" xml:lang="de">Eine Linie die ich in den Himmel werfe</span><span ttm:role="x-translation" xml:lang="pt">Uma linha lançada ao céu</span><span ttm:role="x-translation" xml:lang="ru">Линия брошенная в небо</span><span ttm:role="x-translation" xml:lang="it">Una linea lanciata nel cielo</span><span ttm:role="x-roman">Sora ni hanatsu rain</span></p><p begin="28.020" end="30.400" itunes:key="L5" ttm:agent="v1"><span begin="28.020" end="28.740">狂</span><span begin="28.740" end="29.080">い</span><span begin="29.080" end="29.410">合</span><span begin="29.410" end="29.760">う</span><span begin="29.760" end="30.400">愛</span><span ttm:role="x-translation" xml:lang="zh-Hans">相互纠缠的愛</span><span ttm:role="x-translation" xml:lang="zh-Hant">相互糾纏的愛</span><span ttm:role="x-translation" xml:lang="en">A love that drove us both mad</span><span ttm:role="x-translation" xml:lang="ko">서로 미쳐 가던 사랑</span><span ttm:role="x-translation" xml:lang="fr">Un amour qui sombre avec nous dans la folie</span><span ttm:role="x-translation" xml:lang="es">Un amor que enloquece al encontrarse</span><span ttm:role="x-translation" xml:lang="de">Eine Liebe die uns beide wahnsinnig machte</span><span ttm:role="x-translation" xml:lang="pt">Um amor em que enlouquecemos juntos</span><span ttm:role="x-translation" xml:lang="ru">Любовь сводившая нас с ума</span><span ttm:role="x-translation" xml:lang="it">Un amore che ci fa impazzire insieme</span><span ttm:role="x-roman">Kuruiau ai</span></p><p begin="30.740" end="34.410" itunes:key="L6" ttm:agent="v1"><span begin="30.740" end="31.040">間</span><span begin="31.040" end="31.800">違</span><span begin="31.800" end="32.040">い</span><span begin="32.040" end="32.420">さ</span><span begin="32.420" end="32.710">え</span><span begin="32.710" end="33.800">貫</span><span begin="33.800" end="34.070">い</span><span begin="34.070" end="34.410">た</span><span ttm:role="x-translation" xml:lang="zh-Hans">连错误都贯彻到底</span><span ttm:role="x-translation" xml:lang="zh-Hant">連錯誤都貫徹到底</span><span ttm:role="x-translation" xml:lang="en">We followed through even with our mistakes</span><span ttm:role="x-translation" xml:lang="ko">잘못마저 끝까지 관철했어</span><span ttm:role="x-translation" xml:lang="fr">J’ai poursuivi jusqu’au bout même dans l’erreur</span><span ttm:role="x-translation" xml:lang="es">Seguimos adelante incluso aferrados a nuestros errores</span><span ttm:role="x-translation" xml:lang="de">Selbst unsere Fehler zogen wir bis zum Ende durch</span><span ttm:role="x-translation" xml:lang="pt">Levamos até os nossos erros até o fim</span><span ttm:role="x-translation" xml:lang="ru">Мы шли до конца даже в своих ошибках</span><span ttm:role="x-translation" xml:lang="it">Abbiamo portato fino in fondo persino i nostri errori</span><span ttm:role="x-roman">Machigai sae tsuranuita</span></p><p begin="34.740" end="39.710" itunes:key="L7" ttm:agent="v1"><span begin="34.740" end="35.370">道</span><span begin="35.370" end="36.070">し</span><span begin="36.070" end="36.410">る</span><span begin="36.410" end="36.740">べ</span><span begin="36.740" end="37.080">は</span><span begin="37.410" end="37.710">こ</span><span begin="37.710" end="38.070">こ</span><span begin="38.070" end="38.420">だ</span><span begin="38.420" end="38.730">っ</span><span begin="38.730" end="39.070">た</span><span begin="39.070" end="39.380">の</span><span begin="39.380" end="39.710">か</span><span ttm:role="x-translation" xml:lang="zh-Hans">路标竟在此处吗</span><span ttm:role="x-translation" xml:lang="zh-Hant">路標竟在此處嗎</span><span ttm:role="x-translation" xml:lang="en">Was this where the signpost had been all along</span><span ttm:role="x-translation" xml:lang="ko">길잡이는 바로 여기였던 걸까</span><span ttm:role="x-translation" xml:lang="fr">C’était donc ici notre point de repère</span><span ttm:role="x-translation" xml:lang="es">¿Así que aquí estaba la señal del camino?</span><span ttm:role="x-translation" xml:lang="de">War also genau hier unser Wegweiser?</span><span ttm:role="x-translation" xml:lang="pt">Então era aqui que estava o nosso caminho</span><span ttm:role="x-translation" xml:lang="ru">Так вот где был наш путеводный знак</span><span ttm:role="x-translation" xml:lang="it">Era davvero qui la nostra guida</span><span ttm:role="x-roman">Michishirube wa koko datta no ka</span></p><p begin="40.030" end="45.070" itunes:key="L8" ttm:agent="v1"><span begin="40.030" end="40.740">全</span><span begin="40.740" end="41.410">て</span><span begin="41.410" end="42.030">は</span><span begin="42.030" end="42.740">君</span><span begin="42.740" end="43.080">が</span><span begin="43.410" end="44.050">学</span><span begin="44.050" end="44.400">ぶ</span><span begin="44.400" end="44.740">の</span><span begin="44.740" end="45.070">だ</span><span ttm:role="x-translation" xml:lang="zh-Hans">一切皆由你领悟</span><span ttm:role="x-translation" xml:lang="zh-Hant">一切皆由你領悟</span><span ttm:role="x-translation" xml:lang="en">You are the one who must learn it all</span><span ttm:role="x-translation" xml:lang="ko">모든 것은 네가 스스로 깨닫게 될 거야</span><span ttm:role="x-translation" xml:lang="fr">C’est à toi d’apprendre tout cela</span><span ttm:role="x-translation" xml:lang="es">Todo tendrás que aprenderlo tú</span><span ttm:role="x-translation" xml:lang="de">Alles musst du selbst begreifen</span><span ttm:role="x-translation" xml:lang="pt">É você quem há de aprender tudo</span><span ttm:role="x-translation" xml:lang="ru">Всему этому тебе предстоит научиться</span><span ttm:role="x-translation" xml:lang="it">Tutto questo dovrai impararlo tu</span><span ttm:role="x-roman">Subete wa kimi ga manabu no da</span></p><p begin="46.040" end="48.080" itunes:key="L9" ttm:agent="v1"><span begin="46.040" end="46.760">No</span><span begin="46.760" end="46.960">ti</span><span begin="46.960" end="47.100">ce</span> <span begin="47.100" end="47.750">no</span><span begin="47.750" end="48.000">ti</span><span begin="48.000" end="48.080">ce</span><span ttm:role="x-translation" xml:lang="zh-Hans">察觉吧 察觉吧</span><span ttm:role="x-translation" xml:lang="zh-Hant">察覺吧 察覺吧</span><span ttm:role="x-translation" xml:lang="ja">気づいて 気づいて</span><span ttm:role="x-translation" xml:lang="ko">깨달아 깨달아</span><span ttm:role="x-translation" xml:lang="fr">Prends conscience prends conscience</span><span ttm:role="x-translation" xml:lang="es">Date cuenta date cuenta</span><span ttm:role="x-translation" xml:lang="de">Merk es merk es</span><span ttm:role="x-translation" xml:lang="pt">Perceba perceba</span><span ttm:role="x-translation" xml:lang="ru">Заметь заметь</span><span ttm:role="x-translation" xml:lang="it">Accorgiti accorgiti</span></p><p begin="48.390" end="51.330" itunes:key="L10" ttm:agent="v1"><span begin="48.390" end="48.690">愛</span><span begin="48.690" end="48.880">し</span><span begin="48.880" end="49.050">い</span><span begin="49.050" end="49.410">か</span><span begin="49.410" end="49.690">な</span><span begin="49.690" end="49.740">？</span><span begin="49.740" end="50.410">別</span><span begin="50.410" end="50.750">れ</span><span begin="50.750" end="51.330">は</span><span ttm:role="x-translation" xml:lang="zh-Hans">可曾怜惜？离别时</span><span ttm:role="x-translation" xml:lang="zh-Hant">可曾憐惜？離別時</span><span ttm:role="x-translation" xml:lang="en">Could parting ever be something dear?</span><span ttm:role="x-translation" xml:lang="ko">이별마저 사랑스러운 걸까</span><span ttm:role="x-translation" xml:lang="fr">Cette séparation serait-elle donc si chère ?</span><span ttm:role="x-translation" xml:lang="es">¿Acaso es entrañable la despedida?</span><span ttm:role="x-translation" xml:lang="de">Ist der Abschied wirklich so liebenswert?</span><span ttm:role="x-translation" xml:lang="pt">Será que até a despedida pode ser querida</span><span ttm:role="x-translation" xml:lang="ru">Неужели даже разлука может быть дорога сердцу?</span><span ttm:role="x-translation" xml:lang="it">È forse così caro l&apos;addio?</span><span ttm:role="x-roman">Itoshii kana? Wakare wa</span></p><p begin="51.330" end="54.740" itunes:key="L11" ttm:agent="v1"><span begin="51.330" end="51.740">散</span><span begin="51.740" end="52.060">る</span><span begin="52.060" end="52.370">タ</span><span begin="52.370" end="52.720">バ</span><span begin="52.720" end="53.080">コ</span><span begin="53.080" end="53.400">の</span><span begin="53.400" end="53.710">明</span><span begin="53.710" end="54.070">か</span><span begin="54.070" end="54.410">り</span><span begin="54.410" end="54.740">が</span><span ttm:role="x-translation" xml:lang="zh-Hans">烟蒂明灭的火光</span><span ttm:role="x-translation" xml:lang="zh-Hant">菸蒂明滅的火光</span><span ttm:role="x-translation" xml:lang="en">The fading glow of a cigarette</span><span ttm:role="x-translation" xml:lang="ko">스러져 가는 담뱃불이</span><span ttm:role="x-translation" xml:lang="fr">La lueur mourante de la cigarette</span><span ttm:role="x-translation" xml:lang="es">La luz del cigarrillo que se extinguía</span><span ttm:role="x-translation" xml:lang="de">Das verglimmende Licht der Zigarette</span><span ttm:role="x-translation" xml:lang="pt">A luz do cigarro se desfazendo</span><span ttm:role="x-translation" xml:lang="ru">Угасающий огонёк сигареты</span><span ttm:role="x-translation" xml:lang="it">Il bagliore disperso della sigaretta</span><span ttm:role="x-roman">Chiru tabako no akari ga</span></p><p begin="55.040" end="56.710" itunes:key="L12" ttm:agent="v1"><span begin="55.040" end="55.400">サ</span><span begin="55.400" end="55.640">イ</span><span begin="55.640" end="55.720">ン</span><span begin="55.720" end="55.950">だ</span><span begin="55.950" end="56.070">っ</span><span begin="56.070" end="56.310">た</span><span begin="56.310" end="56.400">ん</span><span begin="56.400" end="56.710">だ</span><span ttm:role="x-translation" xml:lang="zh-Hans">便是告别的讯号</span><span ttm:role="x-translation" xml:lang="zh-Hant">便是告別的訊號</span><span ttm:role="x-translation" xml:lang="en">Had been the sign</span><span ttm:role="x-translation" xml:lang="ko">그 신호였던 거야</span><span ttm:role="x-translation" xml:lang="fr">C’était le signe</span><span ttm:role="x-translation" xml:lang="es">Era la señal</span><span ttm:role="x-translation" xml:lang="de">War unser Zeichen</span><span ttm:role="x-translation" xml:lang="pt">Era o sinal</span><span ttm:role="x-translation" xml:lang="ru">Был тем самым знаком</span><span ttm:role="x-translation" xml:lang="it">Era quello il segnale</span><span ttm:role="x-roman">Sain dattan da</span></p><p begin="56.710" end="58.760" itunes:key="L13" ttm:agent="v1"><span begin="56.710" end="57.400">For</span><span begin="57.400" end="57.720">get</span> <span begin="57.720" end="58.420">for</span><span begin="58.420" end="58.760">get</span><span ttm:role="x-translation" xml:lang="zh-Hans">忘却吧 忘却吧</span><span ttm:role="x-translation" xml:lang="zh-Hant">忘卻吧 忘卻吧</span><span ttm:role="x-translation" xml:lang="ja">忘れて 忘れて</span><span ttm:role="x-translation" xml:lang="ko">잊어 잊어</span><span ttm:role="x-translation" xml:lang="fr">Oublie oublie</span><span ttm:role="x-translation" xml:lang="es">Olvida olvida</span><span ttm:role="x-translation" xml:lang="de">Vergiss es vergiss es</span><span ttm:role="x-translation" xml:lang="pt">Esqueça esqueça</span><span ttm:role="x-translation" xml:lang="ru">Забудь забудь</span><span ttm:role="x-translation" xml:lang="it">Dimentica dimentica</span></p><p begin="59.060" end="1:00.960" itunes:key="L14" ttm:agent="v1"><span begin="59.060" end="59.400">忘</span><span begin="59.400" end="59.720">れ</span><span begin="59.720" end="1:00.070">ら</span><span begin="1:00.070" end="1:00.400">れ</span><span begin="1:00.400" end="1:00.740">な</span><span begin="1:00.740" end="1:00.960">い</span><span ttm:role="x-translation" xml:lang="zh-Hans">偏偏难以忘怀</span><span ttm:role="x-translation" xml:lang="zh-Hant">偏偏難以忘懷</span><span ttm:role="x-translation" xml:lang="en">I can&apos;t forget</span><span ttm:role="x-translation" xml:lang="ko">잊을 수가 없어</span><span ttm:role="x-translation" xml:lang="fr">Impossible d’oublier</span><span ttm:role="x-translation" xml:lang="es">No puedo olvidarlo</span><span ttm:role="x-translation" xml:lang="de">Ich kann es nicht vergessen</span><span ttm:role="x-translation" xml:lang="pt">Eu não consigo esquecer</span><span ttm:role="x-translation" xml:lang="ru">Но я не могу забыть</span><span ttm:role="x-translation" xml:lang="it">Non riesco a dimenticare</span><span ttm:role="x-roman">Wasure rarenai</span></p><p begin="1:01.370" end="1:05.680" itunes:key="L15" ttm:agent="v1"><span begin="1:01.370" end="1:01.730">す</span><span begin="1:01.730" end="1:02.030">れ</span><span begin="1:02.030" end="1:02.740">違</span><span begin="1:02.740" end="1:03.030">う</span><span begin="1:03.030" end="1:03.360">視</span><span begin="1:03.360" end="1:04.080">線</span><span begin="1:04.080" end="1:04.360">は</span><span begin="1:04.360" end="1:04.740">知</span><span begin="1:04.740" end="1:05.270">ら</span><span begin="1:05.270" end="1:05.420">な</span><span begin="1:05.420" end="1:05.680">い</span><span ttm:role="x-translation" xml:lang="zh-Hans">装作不识交错的目光</span><span ttm:role="x-translation" xml:lang="zh-Hant">裝作不識交錯的目光</span><span ttm:role="x-translation" xml:lang="en">I know nothing of those glances passing by</span><span ttm:role="x-translation" xml:lang="ko">스쳐 가는 시선은 아무것도 몰라</span><span ttm:role="x-translation" xml:lang="fr">Nos regards qui se croisent ne savent rien</span><span ttm:role="x-translation" xml:lang="es">Las miradas que se cruzan no saben nada</span><span ttm:role="x-translation" xml:lang="de">Unsere Blicke die sich kreuzen tun so als wüssten sie von nichts</span><span ttm:role="x-translation" xml:lang="pt">Nada sei dos olhares que se cruzam</span><span ttm:role="x-translation" xml:lang="ru">Наши разминувшиеся взгляды ничего не знают</span><span ttm:role="x-translation" xml:lang="it">Gli sguardi che si incrociano senza conoscersi</span><span ttm:role="x-roman">Surechigau shisen wa shiranai</span></p><p begin="1:05.930" end="1:08.190" itunes:key="L16" ttm:agent="v1"><span begin="1:05.930" end="1:06.030">気</span><span begin="1:06.030" end="1:06.380">づ</span><span begin="1:06.380" end="1:06.740">け</span><span begin="1:06.740" end="1:07.050">な</span><span begin="1:07.050" end="1:07.380">い</span><span begin="1:07.380" end="1:08.080">か</span><span begin="1:08.080" end="1:08.190">ら</span><span ttm:role="x-translation" xml:lang="zh-Hans">因我尚未察觉</span><span ttm:role="x-translation" xml:lang="zh-Hant">因我尚未察覺</span><span ttm:role="x-translation" xml:lang="en">Because I never notice</span><span ttm:role="x-translation" xml:lang="ko">알아차릴 수 없으니까</span><span ttm:role="x-translation" xml:lang="fr">Puisque nous ne pouvons nous en apercevoir</span><span ttm:role="x-translation" xml:lang="es">Porque no logran darse cuenta</span><span ttm:role="x-translation" xml:lang="de">Weil ich es nicht bemerken kann</span><span ttm:role="x-translation" xml:lang="pt">Porque ainda não consigo perceber</span><span ttm:role="x-translation" xml:lang="ru">Потому что я не могу заметить</span><span ttm:role="x-translation" xml:lang="it">Perché non riesco ad accorgermene</span><span ttm:role="x-roman">Kizukenai kara</span></p><p begin="1:17.390" end="1:19.290" itunes:key="L17" ttm:agent="v1"><span begin="1:17.390" end="1:18.030">隠</span><span begin="1:18.030" end="1:18.720">し</span><span begin="1:18.720" end="1:19.070">て</span><span begin="1:19.070" end="1:19.290">も</span><span ttm:role="x-translation" xml:lang="zh-Hans">纵然隐藏</span><span ttm:role="x-translation" xml:lang="zh-Hant">縱然隱藏</span><span ttm:role="x-translation" xml:lang="en">Even if I hide it</span><span ttm:role="x-translation" xml:lang="ko">숨겨 봐도</span><span ttm:role="x-translation" xml:lang="fr">Même si je le cache</span><span ttm:role="x-translation" xml:lang="es">Aunque lo esconda</span><span ttm:role="x-translation" xml:lang="de">Selbst wenn ich es verberge</span><span ttm:role="x-translation" xml:lang="pt">Mesmo que eu esconda</span><span ttm:role="x-translation" xml:lang="ru">Даже если скрывать</span><span ttm:role="x-translation" xml:lang="it">Anche se lo nascondo</span><span ttm:role="x-roman">Kakushite mo</span></p><p begin="1:19.710" end="1:22.640" itunes:key="L18" ttm:agent="v1"><span begin="1:19.710" end="1:20.360">壊</span><span begin="1:20.360" end="1:20.740">し</span><span begin="1:20.740" end="1:21.410">て</span><span begin="1:21.410" end="1:21.740">も</span><span begin="1:21.740" end="1:22.410">未</span><span begin="1:22.410" end="1:22.640">だ</span><span ttm:role="x-translation" xml:lang="zh-Hans">纵然破坏 依然</span><span ttm:role="x-translation" xml:lang="zh-Hant">縱然破壞 依然</span><span ttm:role="x-translation" xml:lang="en">Even if I break it still</span><span ttm:role="x-translation" xml:lang="ko">부숴 봐도 아직</span><span ttm:role="x-translation" xml:lang="fr">Même si je le brise ça demeure encore</span><span ttm:role="x-translation" xml:lang="es">Aunque lo destruya todavía</span><span ttm:role="x-translation" xml:lang="de">Selbst wenn ich es zerstöre bleibt es noch immer</span><span ttm:role="x-translation" xml:lang="pt">Mesmo que eu destrua ainda assim</span><span ttm:role="x-translation" xml:lang="ru">Даже если разрушать всё ещё</span><span ttm:role="x-translation" xml:lang="it">Anche se lo distruggo ancora</span><span ttm:role="x-roman">Kowashite mo imada</span></p><p begin="1:23.030" end="1:27.650" itunes:key="L19" ttm:agent="v1"><span begin="1:23.030" end="1:23.740">言</span><span begin="1:23.740" end="1:24.080">葉</span><span begin="1:24.080" end="1:24.450">な</span><span begin="1:24.450" end="1:24.700">ん</span><span begin="1:24.700" end="1:25.060">か</span><span begin="1:25.060" end="1:25.190">じ</span><span begin="1:25.190" end="1:25.320">ゃ</span><span begin="1:25.750" end="1:26.070">言</span><span begin="1:26.070" end="1:26.390">い</span><span begin="1:26.390" end="1:26.740">切</span><span begin="1:26.740" end="1:27.070">れ</span><span begin="1:27.070" end="1:27.420">な</span><span begin="1:27.420" end="1:27.650">い</span><span ttm:role="x-translation" xml:lang="zh-Hans">言语无法说尽</span><span ttm:role="x-translation" xml:lang="zh-Hant">言語無法說盡</span><span ttm:role="x-translation" xml:lang="en">Words could never say it all</span><span ttm:role="x-translation" xml:lang="ko">말 따위로는 다 표현할 수 없어</span><span ttm:role="x-translation" xml:lang="fr">Les mots ne suffiront jamais à tout dire</span><span ttm:role="x-translation" xml:lang="es">Las palabras no bastan para decirlo todo</span><span ttm:role="x-translation" xml:lang="de">Mit Worten allein lässt sich niemals alles sagen</span><span ttm:role="x-translation" xml:lang="pt">Palavras jamais seriam suficientes para dizer tudo</span><span ttm:role="x-translation" xml:lang="ru">Одними словами всего не выразить</span><span ttm:role="x-translation" xml:lang="it">Le parole non bastano a dire tutto</span><span ttm:role="x-roman">Kotoba nanka ja iikirenai</span></p><p begin="1:28.070" end="1:34.360" itunes:key="L20" ttm:agent="v1"><span begin="1:28.070" end="1:28.750">肌</span><span begin="1:28.750" end="1:29.010">を</span><span begin="1:29.400" end="1:29.740">交</span><span begin="1:29.740" end="1:30.020">わ</span><span begin="1:30.020" end="1:30.290">す</span><span begin="1:30.740" end="1:31.380">夕</span><span begin="1:31.380" end="1:31.680">日</span><span begin="1:32.080" end="1:32.410">の</span><span begin="1:32.410" end="1:33.040">並</span><span begin="1:33.040" end="1:33.420">木</span><span begin="1:33.420" end="1:34.080">道</span><span begin="1:34.080" end="1:34.360">を</span><span ttm:role="x-translation" xml:lang="zh-Hans">肌肤相触的夕阳林荫道</span><span ttm:role="x-translation" xml:lang="zh-Hant">肌膚相觸的夕陽林蔭道</span><span ttm:role="x-translation" xml:lang="en">Along the tree-lined road where the sunset brushed our skin</span><span ttm:role="x-translation" xml:lang="ko">서로의 살결을 스치던 노을 진 가로수길을</span><span ttm:role="x-translation" xml:lang="fr">Sur l’allée bordée d’arbres au couchant où nos peaux se frôlaient</span><span ttm:role="x-translation" xml:lang="es">Por la avenida al atardecer donde nuestras pieles se rozaron</span><span ttm:role="x-translation" xml:lang="de">Die Allee im Abendrot wo unsere Haut sich berührte</span><span ttm:role="x-translation" xml:lang="pt">Pela alameda ao pôr do sol onde nossas peles se tocaram</span><span ttm:role="x-translation" xml:lang="ru">По аллее в закате где мы касались друг друга</span><span ttm:role="x-translation" xml:lang="it">Lungo il viale al tramonto dove le nostre pelli si sfioravano</span><span ttm:role="x-roman">Hada o kawasu yuuhi no namikimichi o</span></p><p begin="1:34.740" end="1:38.390" itunes:key="L21" ttm:agent="v1"><span begin="1:34.740" end="1:35.410">何</span><span begin="1:35.410" end="1:35.640">も</span><span begin="1:35.640" end="1:36.070">言</span><span begin="1:36.070" end="1:36.370">わ</span><span begin="1:36.370" end="1:36.740">ず</span><span begin="1:36.740" end="1:37.790">貫</span><span begin="1:37.790" end="1:38.070">い</span><span begin="1:38.070" end="1:38.390">た</span><span ttm:role="x-translation" xml:lang="zh-Hans">沉默着贯穿始终</span><span ttm:role="x-translation" xml:lang="zh-Hant">沉默著貫穿始終</span><span ttm:role="x-translation" xml:lang="en">We carried on without a word</span><span ttm:role="x-translation" xml:lang="ko">아무 말 없이 끝까지 걸어갔어</span><span ttm:role="x-translation" xml:lang="fr">J’ai continué jusqu’au bout sans rien dire</span><span ttm:role="x-translation" xml:lang="es">Seguimos adelante sin decir una palabra</span><span ttm:role="x-translation" xml:lang="de">Durchquerten wir ohne ein einziges Wort</span><span ttm:role="x-translation" xml:lang="pt">Seguimos até o fim sem dizer nada</span><span ttm:role="x-translation" xml:lang="ru">Мы прошли до конца не сказав ни слова</span><span ttm:role="x-translation" xml:lang="it">Abbiamo continuato senza dire nulla</span><span ttm:role="x-roman">Nani mo iwazu tsuranuita</span></p><p begin="1:38.740" end="1:43.720" itunes:key="L22" ttm:agent="v1"><span begin="1:38.740" end="1:39.400">遠</span><span begin="1:39.400" end="1:40.060">く</span><span begin="1:40.060" end="1:40.410">に</span><span begin="1:40.410" end="1:40.760">い</span><span begin="1:40.760" end="1:41.050">る</span><span begin="1:41.400" end="1:41.720">あ</span><span begin="1:41.720" end="1:42.060">な</span><span begin="1:42.060" end="1:42.720">た</span><span begin="1:42.720" end="1:43.060">だ</span><span begin="1:43.060" end="1:43.410">け</span><span begin="1:43.410" end="1:43.720">が</span><span ttm:role="x-translation" xml:lang="zh-Hans">唯有远方的你</span><span ttm:role="x-translation" xml:lang="zh-Hant">唯有遠方的你</span><span ttm:role="x-translation" xml:lang="en">Only you so far away</span><span ttm:role="x-translation" xml:lang="ko">멀리 있는 너만이</span><span ttm:role="x-translation" xml:lang="fr">Toi qui es loin</span><span ttm:role="x-translation" xml:lang="es">Solo tú que estás tan lejos</span><span ttm:role="x-translation" xml:lang="de">Nur du dort in der Ferne</span><span ttm:role="x-translation" xml:lang="pt">Só você tão distante</span><span ttm:role="x-translation" xml:lang="ru">Лишь ты оставшийся вдали</span><span ttm:role="x-translation" xml:lang="it">Soltanto tu che sei così lontano</span><span ttm:role="x-roman">Tooku ni iru anata dake ga</span></p><p begin="1:44.000" end="1:49.020" itunes:key="L23" ttm:agent="v1"><span begin="1:44.000" end="1:44.750">全</span><span begin="1:44.750" end="1:45.410">て</span><span begin="1:45.410" end="1:46.100">の</span><span begin="1:46.100" end="1:46.410">意</span><span begin="1:46.410" end="1:46.740">味</span><span begin="1:46.740" end="1:47.080">を</span><span begin="1:47.400" end="1:48.060">抱</span><span begin="1:48.060" end="1:48.420">く</span><span begin="1:48.420" end="1:48.730">の</span><span begin="1:48.730" end="1:49.020">だ</span><span ttm:role="x-translation" xml:lang="zh-Hans">承载全部意义</span><span ttm:role="x-translation" xml:lang="zh-Hant">承載全部意義</span><span ttm:role="x-translation" xml:lang="en">Hold the meaning of it all</span><span ttm:role="x-translation" xml:lang="ko">모든 의미를 품고 있는 거야</span><span ttm:role="x-translation" xml:lang="fr">Tu portes en toi tout le sens de tout cela</span><span ttm:role="x-translation" xml:lang="es">Guardas dentro todo su significado</span><span ttm:role="x-translation" xml:lang="de">Trägst die Bedeutung von allem in dir</span><span ttm:role="x-translation" xml:lang="pt">Carrega consigo o sentido de tudo</span><span ttm:role="x-translation" xml:lang="ru">Хранишь в себе смысл всего</span><span ttm:role="x-translation" xml:lang="it">Custodisci il significato di ogni cosa</span><span ttm:role="x-roman">Subete no imi o idaku no da</span></p><p begin="1:50.080" end="1:52.070" itunes:key="L24" ttm:agent="v1"><span begin="1:50.080" end="1:50.430">I</span> <span begin="1:50.430" end="1:50.770">be</span><span begin="1:50.770" end="1:51.080">lieve</span> <span begin="1:51.080" end="1:51.430">I</span> <span begin="1:51.430" end="1:51.770">be</span><span begin="1:51.770" end="1:52.070">lieve</span><span ttm:role="x-translation" xml:lang="zh-Hans">我坚信 我坚信</span><span ttm:role="x-translation" xml:lang="zh-Hant">我堅信 我堅信</span><span ttm:role="x-translation" xml:lang="ja">信じてる 信じてる</span><span ttm:role="x-translation" xml:lang="ko">믿어 믿고 있어</span><span ttm:role="x-translation" xml:lang="fr">J’y crois j’y crois</span><span ttm:role="x-translation" xml:lang="es">Creo creo</span><span ttm:role="x-translation" xml:lang="de">Ich glaube ich glaube</span><span ttm:role="x-translation" xml:lang="pt">Eu acredito eu acredito</span><span ttm:role="x-translation" xml:lang="ru">Я верю я верю</span><span ttm:role="x-translation" xml:lang="it">Ci credo ci credo</span></p><p begin="1:52.390" end="1:55.030" itunes:key="L25" ttm:agent="v1"><span begin="1:52.390" end="1:52.740">何</span><span begin="1:52.740" end="1:53.040">も</span><span begin="1:53.040" end="1:53.420">か</span><span begin="1:53.420" end="1:53.730">も</span><span begin="1:53.730" end="1:54.370">許</span><span begin="1:54.370" end="1:54.740">し</span><span begin="1:54.740" end="1:55.030">て</span><span ttm:role="x-translation" xml:lang="zh-Hans">原谅所有一切</span><span ttm:role="x-translation" xml:lang="zh-Hant">原諒所有一切</span><span ttm:role="x-translation" xml:lang="en">Forgiving everything</span><span ttm:role="x-translation" xml:lang="ko">모든 것을 용서하고</span><span ttm:role="x-translation" xml:lang="fr">Pardonne tout</span><span ttm:role="x-translation" xml:lang="es">Perdónalo todo</span><span ttm:role="x-translation" xml:lang="de">Vergib einfach alles</span><span ttm:role="x-translation" xml:lang="pt">Perdoe tudo</span><span ttm:role="x-translation" xml:lang="ru">Прости мне всё</