<tt xmlns="http://www.w3.org/ns/ttml" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xmlns:amll="http://www.example.com/ns/amll" itunes:timing="Word" xml:lang="ru"><head><metadata><ttm:agent type="person" xml:id="v1"/><ttm:agent type="person" xml:id="v2"/><amll:meta key="musicName" value="至冬 Snezhnaya"/><amll:meta key="musicName" value="至冬"/><amll:meta key="musicName" value="スネージナヤ"/><amll:meta key="musicName" value="Snezhnaya"/><amll:meta key="artists" value="HOYO-MiX"/><amll:meta key="album" value="原神-悯宥慈怜之垠 Where Mercy Endures"/><amll:meta key="album" value="原神 - 悯宥慈怜之垠 (游戏《原神》原声音乐)"/><amll:meta key="album" value="原神 - 憫宥慈憐之垠 (遊戲《原神》原聲音樂)"/><amll:meta key="album" value="原神 - 憐憫と慈悲の果てに (Original Game Soundtrack)"/><amll:meta key="album" value="원신 - 연민이 살아남은 끝자락 (Original Game Soundtrack)"/><amll:meta key="album" value="Genshin Impact - Where Mercy Endures (Original Game Soundtrack)"/><amll:meta key="isrc" value="FRX762649396"/><amll:meta key="isrc" value="FRX762649036"/><amll:meta key="isrc" value="FRX762651963"/><amll:meta key="isrc" value="FRX762648829"/><amll:meta key="isrc" value="FRX762648933"/><amll:meta key="appleMusicId" value="6810715097"/><amll:meta key="appleMusicId" value="6810715112"/><amll:meta key="appleMusicId" value="6810701497"/><amll:meta key="appleMusicId" value="6810716648"/><amll:meta key="appleMusicId" value="6810716785"/><amll:meta key="spotifyId" value="5bnC32TClrIz85p7BRRhDI"/><amll:meta key="spotifyId" value="79tsV6R3sJgIgpsoshH6HS"/><amll:meta key="spotifyId" value="0fsaDd6mGHvLsfylCKfUTn"/><amll:meta key="spotifyId" value="4rBE1sqbE32wnMma6rqlHh"/><amll:meta key="qqMusicId" value="002Bq8QX17iWKT"/><amll:meta key="qqMusicId" value="724664281"/><amll:meta key="ncmMusicId" value="3437729502"/><amll:meta key="ttmlAuthorGithub" value="50987405"/><amll:meta key="ttmlAuthorGithubLogin" value="ITManCHINA"/><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal"><songwriters><songwriter>项柳</songwriter><songwriter>項柳</songwriter><songwriter>Hsiang Liu</songwriter><songwriter>尤裴佳</songwriter><songwriter>Peijia You</songwriter><songwriter>陈致逸</songwriter><songwriter>Yu-Peng Chen</songwriter><songwriter>索德尔</songwriter><songwriter>Deer Suo</songwriter><songwriter>罗静怡</songwriter><songwriter>Caroline Luo</songwriter><songwriter>李洋</songwriter><songwriter>Yang Lee</songwriter></songwriters></iTunesMetadata></metadata></head><body dur="4:50.326"><div begin="1:28.015" end="4:50.326"><p begin="1:28.015" end="1:32.411" itunes:key="L1" ttm:agent="v1"><span begin="1:28.015" end="1:28.151">Pro</span><span begin="1:28.675" end="1:28.871">di</span><span begin="1:29.463" end="1:29.575">ti</span> <span begin="1:29.995" end="1:30.183">su</span><span begin="1:30.183" end="1:30.573">mus</span> <span begin="1:30.843" end="1:31.045">a</span> <span begin="1:31.503" end="1:31.721">mun</span><span begin="1:32.237" end="1:32.411">do</span><span ttm:role="x-translation" xml:lang="de">Wir sind die Verwundeten, die von der ganzen Welt verraten wurden.</span><span ttm:role="x-translation" xml:lang="en">We are the wounded ones, betrayed by the whole world</span><span ttm:role="x-translation" xml:lang="es">Éramos los heridos y traicionados por todo el mundo.</span><span ttm:role="x-translation" xml:lang="fr">Nous sommes des êtres blessés, autrefois trahis par le monde entier.</span><span ttm:role="x-translation" xml:lang="id">Kamilah mereka yang terluka, yang dikhianati oleh dunia.</span><span ttm:role="x-translation" xml:lang="it">Siamo i feriti, traditi dal mondo intero,</span><span ttm:role="x-translation" xml:lang="ja">世界に裏切られてもなお</span><span ttm:role="x-translation" xml:lang="ko">우리는 세상에 버림받았던 자들</span><span ttm:role="x-translation" xml:lang="pt">Somos os feridos, por todo o mundo traídos</span><span ttm:role="x-translation" xml:lang="ru">Мы - израненные, преданные целым миром.</span><span ttm:role="x-translation" xml:lang="th">เราคือผู้แบกรับบาดแผลที่เคยถูกโลกทั้งใบหักหลัง</span><span ttm:role="x-translation" xml:lang="tr">Bir zamanlar tüm dünyanın ihanetine uğramış yaralılarız.</span><span ttm:role="x-translation" xml:lang="vi">Chúng tôi là những kẻ bị thương, từng bị cả thế giới quay lưng</span><span ttm:role="x-translation" xml:lang="zh-Hant">我們是曾為整個世界所背叛的帶傷者</span><span ttm:role="x-translation" xml:lang="zh-Hans">我们是曾为整个世界所背叛的带伤者</span></p><p begin="1:32.777" end="1:39.244" itunes:key="L2" ttm:agent="v1"><span begin="1:32.777" end="1:32.921">No</span><span begin="1:33.115" end="1:33.257">vum</span> <span begin="1:33.611" end="1:33.843">mun</span><span begin="1:34.337" end="1:34.563">dum</span> <span begin="1:35.082" end="1:35.254">om</span><span begin="1:35.584" end="1:35.720">ni</span><span begin="1:35.952" end="1:36.072">bus</span> <span begin="1:36.470" end="1:36.694">a</span><span begin="1:37.018" end="1:37.144">e</span><span begin="1:37.468" end="1:37.572">quum</span> <span begin="1:38.008" end="1:38.120">con</span><span begin="1:38.494" end="1:38.854">de</span><span begin="1:38.854" end="1:39.244">mus</span><span ttm:role="x-translation" xml:lang="de">Wir werden eine neue Welt erschaffen, in der niemand jemals alleingelassen werden wird.</span><span ttm:role="x-translation" xml:lang="en">We shall create a new world, one in which no one shall ever be forsaken</span><span ttm:role="x-translation" xml:lang="es">Crearemos un nuevo mundo en el que nadie se quede atrás.</span><span ttm:role="x-translation" xml:lang="fr">Nous allons créer un nouveau monde que personne n&apos;abandonnera.</span><span ttm:role="x-translation" xml:lang="id">Tapi baiklah kita ciptakan dunia yang baru, dunia yang tidak akan pernah ditinggalkan oleh siapa pun.</span><span ttm:role="x-translation" xml:lang="it">ma creeremo un nuovo mondo, uno in cui nessuno sarà mai abbandonato.</span><span ttm:role="x-translation" xml:lang="ja">すべての者に 等しき新世界を築かん</span><span ttm:role="x-translation" xml:lang="ko">우린 누구도 배신하지 않는 새로운 세상을 만들 것이다</span><span ttm:role="x-translation" xml:lang="pt">Mas criaremos um mundo novo, um mundo no qual ninguém jamais será abandonado</span><span ttm:role="x-translation" xml:lang="ru">Мы построим новый мир, где не будет места предательству.</span><span ttm:role="x-translation" xml:lang="th">ท้ายที่สุดแล้ว เราจะสร้างโลกใบใหม่ที่ไม่มีผู้ใดต้องถูกทอดทิ้งอีก</span><span ttm:role="x-translation" xml:lang="tr">Ama bizler yeni bir dünya yaratacağız ve o dünyada hiç kimse yüzüstü bırakılmayacak.</span><span ttm:role="x-translation" xml:lang="vi">Chúng tôi rồi sẽ xây dựng nên một thế giới mới, nơi đó không ai bị bỏ rơi</span><span ttm:role="x-translation" xml:lang="zh-Hant">我們終將建立誰人都不背棄的新世界</span><span ttm:role="x-translation" xml:lang="zh-Hans">我们终将建立谁人都不背弃的新世界</span></p><p begin="2:15.792" end="2:26.821" itunes:key="L3" ttm:agent="v1"><span begin="2:15.792" end="2:16.668">Si</span><span begin="2:16.668" end="2:18.312">dus</span> <span begin="2:18.762" end="2:19.518">al</span><span begin="2:19.518" end="2:21.228">bum</span> <span begin="2:21.596" end="2:22.968">vos</span> <span begin="2:22.968" end="2:23.652">sus</span><span begin="2:23.652" end="2:24.402">ci</span><span begin="2:24.402" end="2:25.098">pi</span><span begin="2:25.098" end="2:26.821">te</span><span ttm:role="x-translation" xml:lang="de">Erhebt eure Augen zum weißen, schimmernden Bleichstern, denn der ist unser Banner.</span><span ttm:role="x-translation" xml:lang="en">Lift up your eyes to the white, glimmering Pale Star, for that is our banner</span><span ttm:role="x-translation" xml:lang="es">Alza la mirada hacia la centelleante Estrella Albina, y verás nuestra bandera.</span><span ttm:role="x-translation" xml:lang="fr">Levez la tête et portez votre regard sur les étoiles blanches étincelantes, car elles sont notre bannière.</span><span ttm:role="x-translation" xml:lang="id">Pandanglah ke arah bintang-bintang putih yang berkilauan, karena itulah panji kami.</span><span ttm:role="x-translation" xml:lang="it">Alza gli occhi verso la bianca e scintillante Candida Stella, poiché quello è il nostro vessillo.</span><span ttm:role="x-translation" xml:lang="ja">蒼白き星を仰ぎ</span><span ttm:role="x-translation" xml:lang="ko">고개를 들어 새하얀 빛을 뿜고 있는 청색 별을 보라, 그것이 우리의 깃발이다</span><span ttm:role="x-translation" xml:lang="pt">Levante os olhos para as estrelas azuis, pois essa é a nossa bandeira</span><span ttm:role="x-translation" xml:lang="ru">Обрати свой взор к Бледной звезде, что ведёт нас.</span><span ttm:role="x-translation" xml:lang="th">จงแหงนมองไปยังดาราสีจางที่ทอประกายแสงสีขาว นั่นแหละคือธงรบที่เรายึดมั่น</span><span ttm:role="x-translation" xml:lang="tr">Gözlerini parıldayan beyaz yıldızlara dik, onlar bizim sancağımızdır.</span><span ttm:role="x-translation" xml:lang="vi">Hãy ngẩng đầu chiêm ngưỡng vì sao màu ánh bạc kia đi, đó chính là cờ hiệu của chúng tôi</span><span ttm:role="x-translation" xml:lang="zh-Hant">抬頭仰望白磷色的蒼星，那是我等的旗號</span><span ttm:role="x-translation" xml:lang="zh-Hans">抬头仰望白磷色的苍星，那是我等的旗号</span></p><p begin="2:27.233" end="2:38.389" itunes:key="L4" ttm:agent="v1"><span begin="2:27.233" end="2:27.939">Ter</span><span begin="2:27.939" end="2:29.655">ram</span> <span begin="2:30.083" end="2:30.803">mo</span><span begin="2:30.803" end="2:32.371">tam</span> <span begin="2:32.941" end="2:34.283">vos</span> <span begin="2:34.283" end="2:35.025">qu</span><span begin="2:35.025" end="2:35.693">a</span><span begin="2:35.693" end="2:36.405">ti</span><span begin="2:36.405" end="2:38.389">te</span><span ttm:role="x-translation" xml:lang="de">Schließt euch unseren Reihen an, und lasst unsere marschierenden Stiefel die Erde wie Donner erschüttern!</span><span ttm:role="x-translation" xml:lang="en">Join our ranks, and let our marching boots shake the earth like thunder!</span><span ttm:role="x-translation" xml:lang="es">¡Únete a nuestras filas y haz que nuestras botas marchen y hagan retumbar la tierra!</span><span ttm:role="x-translation" xml:lang="fr">Rejoignez nos rangs et que nos bottes fassent trembler la terre avec la force du tonnerre !</span><span ttm:role="x-translation" xml:lang="id">Bergabunglah di atas satu perahu yang sama dengan kami! Biarkan hentak langkah kita mengguncang bumi bak guntur!</span><span ttm:role="x-translation" xml:lang="it">Unisciti ai nostri ranghi! Lascia che la nostra marcia scuota la terra come un tuono!</span><span ttm:role="x-translation" xml:lang="ja">大地を揺るがせ</span><span ttm:role="x-translation" xml:lang="ko">우리와 함께하라, 천둥 같은 군화의 울림으로 천지를 뒤흔들자</span><span ttm:role="x-translation" xml:lang="pt">Junte-se às nossas equipes! Que nossas botas em marcha sacudam a terra como um trovão</span><span ttm:role="x-translation" xml:lang="ru">Стань одним из нас, и да содрогнётся земля от нашего марша.</span><span ttm:role="x-translation" xml:lang="th">มาร่วมขบวนรบกับเราสิ ให้เสียงย่ำบูททหารดังกึกก้องสั่นสะเทือนปฐพี</span><span ttm:role="x-translation" xml:lang="tr">Saflarımıza katıl! Adımlarımız dünyayı bir yıldırım gibi sarssın!</span><span ttm:role="x-translation" xml:lang="vi">Gia nhập với chúng tôi, hãy để bước chân tựa như sấm sét rung động đất trời</span><span ttm:role="x-translation" xml:lang="zh-Hant">加入我等的行列，讓軍靴如雷撼動大地吧</span><span ttm:role="x-translation" xml:lang="zh-Hans">加入我等的行列，让军靴如雷撼动大地吧</span></p><p begin="4:00.429" end="4:23.026" itunes:key="L5" ttm:agent="v1"><span begin="4:00.429" end="4:01.103">No</span><span begin="4:01.103" end="4:02.859">vum</span> <span begin="4:03.257" end="4:03.931">mun</span><span begin="4:03.931" end="4:05.447">dum</span> <span begin="4:06.113" end="4:06.751">in</span><span begin="4:06.751" end="4:08.537">co</span><span begin="4:08.903" end="4:09.579">he</span><span begin="4:09.579" end="4:11.297">mus,</span> <span begin="4:11.709" end="4:12.331">vos</span> <span begin="4:12.331" end="4:14.003">qui</span> <span begin="4:14.529" end="4:15.249">me</span><span begin="4:15.249" end="4:16.877">cum</span> <span begin="4:17.349" end="4:18.091">te</span><span begin="4:18.091" end="4:18.737">ne</span><span begin="4:18.737" end="4:19.433">bras</span> <span begin="4:19.433" end="4:20.147">i</span><span begin="4:20.147" end="4:21.250">ni</span><span begin="4:21.250" end="4:23.026">tis</span><span ttm:role="x-translation" xml:lang="de">Ihr, die ihr mit uns in das Land der Finsternis gehen wollt, kommt! Lasst uns gemeinsam eine neue Welt erschaffen.</span><span ttm:role="x-translation" xml:lang="en">You who will walk with us into the land of darkness, come! Let us create a new world together</span><span ttm:role="x-translation" xml:lang="es">Tú que marcharás con nosotros hacia las tierras más tenebrosas, creemos juntos un nuevo mundo.</span><span ttm:role="x-translation" xml:lang="fr">Vous qui souhaitez marcher avec nous jusqu&apos;aux terres des ténèbres, rejoignez-nous ! Et créons ensemble un monde nouveau !</span><span ttm:role="x-translation" xml:lang="id">Berjalanlah bersama kami ke tanah kegelapan! Marilah, karena akan kita ciptakan dunia baru bersama.</span><span ttm:role="x-translation" xml:lang="it">Tu che camminerai con noi nella terra delle tenebre, vieni! Daremo vita a un nuovo mondo insieme.</span><span ttm:role="x-translation" xml:lang="ja">闇に向かう者たちよ いざ幕開けの時</span><span ttm:role="x-translation" xml:lang="ko">우리와 함께 어둠의 땅으로 나아가길 원하는 자여, 같이 새로운 세계를 만들자</span><span ttm:role="x-translation" xml:lang="pt">Vocês que vão caminhar conosco para a terra das trevas, venham! Criaremos juntos um novo mundo</span><span ttm:role="x-translation" xml:lang="ru">Кто идёт за нами в царство тьмы, чтобы создать новый мир.</span><span ttm:role="x-translation" xml:lang="th">ผู้ที่พร้อมใจจะเดินไปยังสถานที่อันมืดมิดกับพวกเรา มาร่วมสร้างโลกใบใหม่ด้วยกันเถอะ</span><span ttm:role="x-translation" xml:lang="tr">Karanlık diyarlara bizimle yürüyecek olan sen, bize katıl! Birlikte yeni bir dünya yaratacağız.</span><span ttm:role="x-translation" xml:lang="vi">Người muốn cùng chúng tôi đi đến vùng đất u ám, hãy cùng nhau sáng tạo thế giới mới đi nào</span><span ttm:role="x-translation" xml:lang="zh-Hant">願隨我等走向至暗之地者，一同創造新世界吧</span><span ttm:role="x-translation" xml:lang="zh-Hans">愿随我等走向至暗之地者，一同创造新世界吧</span></p><p begin="4:22.245" end="4:28.327" itunes:key="L6" ttm:agent="v2"><span begin="4:22.245" end="4:22.605">Ex</span> <span begin="4:22.605" end="4:23.033">rui</span><span begin="4:23.033" end="4:23.723">nis</span> <span begin="4:23.723" end="4:24.391">or</span><span begin="4:24.391" end="4:25.155">do</span> <span begin="4:25.155" end="4:25.889">no</span><span begin="4:25.889" end="4:26.565">vus</span> <span begin="4:26.565" end="4:27.247">con</span><span begin="4:27.247" end="4:27.929">de</span><span begin="4:27.929" end="4:28.327">mus</span><span ttm:role="x-translation" xml:lang="de">Seid euch bewusst, dass die Zerstörung von allem der Geburt einer neuen Ordnung vorausgehen muss.</span><span ttm:role="x-translation" xml:lang="en">Know that the destruction of all precedes the birth of a new order</span><span ttm:role="x-translation" xml:lang="es">Ten siempre presente que la destrucción global traerá el comienzo de un nuevo orden.</span><span ttm:role="x-translation" xml:lang="fr">Sachez que la destruction totale est le point de départ d&apos;un nouvel ordre.</span><span ttm:role="x-translation" xml:lang="id">Ketahuilah bahwa kehancuran dari segalanya haruslah ada, sebelum sebuah tatanan yang baru bercahaya.</span><span ttm:role="x-translation" xml:lang="it">Ricorda che la distruzione di tutto precede la nascita di un nuovo ordine.</span><span ttm:role="x-translation" xml:lang="ja">破滅より 新たなる秩序を</span><span ttm:role="x-translation" xml:lang="ko">모든 것의 소멸이야말로 새로운 질서의 시작이나니</span><span ttm:role="x-translation" xml:lang="pt">Saiba que a destruição de todos deve preceder o nascimento de uma nova ordem</span><span ttm:role="x-translation" xml:lang="ru">Из руин создадим новый порядок.</span><span ttm:role="x-translation" xml:lang="th">พึงตระหนักไว้ว่าความพินาศของสรรพสิ่ง คือจุดเริ่มต้นของระเบียบใหม่</span><span ttm:role="x-translation" xml:lang="tr">Her şeyi yok ederek yeni bir düzenin kurulabileceğini unutma.</span><span ttm:role="x-translation" xml:lang="vi">Nên biết rằng sự hủy diệt của tất cả rồi sẽ là sự ra đời của một trật tự mới</span><span ttm:role="x-translation" xml:lang="zh-Hant">須知一切的盡毀將是全新秩序的肇始</span><span ttm:role="x-translation" xml:lang="zh-Hans">须知一切的尽毁将是全新秩序的肇始</span></p><p begin="4:28.671" end="4:50.310" itunes:key="L7" ttm:agent="v1"><span begin="4:28.671" end="4:29.369">In</span> <span begin="4:29.369" end="4:30.081">fine</span> <span begin="4:30.081" end="4:30.857">ab</span> <span begin="4:30.857" end="4:31.517">A</span><span begin="4:31.517" end="4:33.241">nas</span><span begin="4:33.579" end="4:33.917">ta</span><span begin="4:33.917" end="4:34.291">si</span><span begin="4:34.291" end="4:34.981">a</span> <span begin="4:34.981" end="4:35.701">ser</span><span begin="4:35.701" end="4:36.827">va</span><span begin="4:36.827" end="4:37.119">ti</span> <span begin="4:37.119" end="4:38.523">su</span><span begin="4:38.523" end="4:39.649">mus,</span> <span begin="4:39.976" end="4:41.399">a</span><span begin="4:42.750" end="4:44.176">u</span><span begin="4:45.570" end="4:47.056">ro</span><span begin="4:48.420" end="4:50.326">ra</span><span ttm:role="x-translation" xml:lang="de">Nur unsere Zarin, Anastasya, wird eine vollkommene Morgenröte einleiten.</span><span ttm:role="x-translation" xml:lang="en">Only our Tsaritsa, Anastasya, shall usher in the perfect dawn</span><span ttm:role="x-translation" xml:lang="es">Solo la Zarina Anastasia nos traerá un amanecer inmaculado.</span><span ttm:role="x-translation" xml:lang="fr">Seule Sa Majesté la Tsarine Anastasya peut apporter une aube immaculée.</span><span ttm:role="x-translation" xml:lang="id">Hanya Tsaritsa kami, Anastasya, yang akan menghadirkan fajar tanpa noda.</span><span ttm:role="x-translation" xml:lang="it">Solo la nostra Tsaritsa, Anastasya, riuscirà a portare un&apos;alba immacolata.</span><span ttm:role="x-translation" xml:lang="ja">我らが女皇の名のもとに 夜明けは来たる必ずや</span><span ttm:role="x-translation" xml:lang="ko">오직 우리의 여왕 아나스타샤만이 맑은 여명을 가져오리라</span><span ttm:role="x-translation" xml:lang="pt">Somente a nossa Tsaritsa, Anastasya, trará o amanhecer perfeito</span><span ttm:role="x-translation" xml:lang="ru">Только царица Анастасия принесёт непорочный рассвет.</span><span ttm:role="x-translation" xml:lang="th">มีเพียงองค์จักรพรรดินี Anastasya ของเราเท่านั้น ที่จะนำพารุ่งอรุณอันไร้มลทินมาให้</span><span ttm:role="x-translation" xml:lang="tr">Kusursuz şafak ancak Çariçe Anastasia&apos;nın gelişiyle doğacak.</span><span ttm:role="x-translation" xml:lang="vi">Cuối cùng nữ hoàng Anastasya sẽ cứu rỗi, bình minh sẽ ló dạng</span><span ttm:role="x-translation" xml:lang="zh-Hant">唯我皇安娜絲塔夏將帶來無垢的黎明</span><span ttm:role="x-translation" xml:lang="zh-Hans">唯我皇安娜丝塔夏将带来无垢的黎明</span></p><p begin="4:39.976" end="4:50.326" itunes:key="L8" ttm:agent="v2"><span begin="4:39.976" end="4:41.399">O</span><span begin="4:42.750" end="4:44.176">ri</span><span begin="4:45.570" end="4:47.056">e</span><span begin="4:48.420" end="4:50.326">tur</span><span ttm:role="x-translation" xml:lang="de">Eine vollkommene Morgenröte einleiten.</span><span ttm:role="x-translation" xml:lang="en">Usher in the perfect dawn</span><span ttm:role="x-translation" xml:lang="es">Nos traerá un amanecer inmaculado.</span><span ttm:role="x-translation" xml:lang="fr">Apporter une aube immaculée</span><span ttm:role="x-translation" xml:lang="id">Menghadirkan fajar tanpa noda.</span><span ttm:role="x-translation" xml:lang="it">Portare un&apos;alba immacolata.</span><span ttm:role="x-translation" xml:lang="ja">夜明けは来たる必ずや</span><span ttm:role="x-translation" xml:lang="ko">맑은 여명을 가져오리라</span><span ttm:role="x-translation" xml:lang="pt">Trará o amanhecer perfeito.</span><span ttm:role="x-translation" xml:lang="ru">Принесёт непорочный рассвет.</span><span ttm:role="x-translation" xml:lang="th">นำพารุ่งอรุณอันไร้มลทินมาให้</span><span ttm:role="x-translation" xml:lang="tr">Kusursuz şafak doğacak.</span><span ttm:role="x-translation" xml:lang="vi">Bình minh sẽ ló dạng</span><span ttm:role="x-translation" xml:lang="zh-Hant">帶來無垢的黎明</span><span ttm:role="x-translation" xml:lang="zh-Hans">带来无垢的黎明</span></p></div></body></tt>