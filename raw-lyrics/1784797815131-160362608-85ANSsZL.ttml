<tt xmlns="http://www.w3.org/ns/ttml" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xmlns:amll="http://www.example.com/ns/amll" itunes:timing="Word" xml:lang="en"><head><metadata><ttm:agent type="person" xml:id="v1"/><amll:meta key="musicName" value="Somebody Else"/><amll:meta key="artists" value="Madeon"/><amll:meta key="album" value="Victory"/><amll:meta key="isrc" value="USQE92600062"/><amll:meta key="spotifyId" value="7xaJbaxbXp0vKvtsH9Xyrn"/><amll:meta key="appleMusicId" value="1892422564"/><amll:meta key="ncmMusicId" value="3397461297"/><amll:meta key="ttmlAuthorGithub" value="160362608"/><amll:meta key="ttmlAuthorGithubLogin" value="AnisphiaPalettia"/><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal"><songwriters><songwriter>Hugo Leclercq</songwriter></songwriters></iTunesMetadata></metadata></head><body dur="3:04.370"><div begin="30.749" end="3:04.370"><p begin="30.749" end="34.503" itunes:key="L1" ttm:agent="v1"><span begin="30.749" end="30.982">I</span> <span begin="30.982" end="31.276">wanna</span> <span begin="31.293" end="31.496">be</span> <span begin="31.496" end="31.712">the</span> <span begin="31.712" end="32.008">one</span> <span begin="32.008" end="32.193">who</span> <span begin="32.257" end="32.659">does</span> <span begin="32.659" end="32.885">it</span> <span begin="32.885" end="34.503">first</span><span ttm:role="x-translation" xml:lang="zh-CN">我想做那个先转身的人</span></p><p begin="36.707" end="40.428" itunes:key="L2" ttm:agent="v1"><span begin="36.707" end="36.915">I</span> <span begin="36.915" end="37.249">wanna</span> <span begin="37.256" end="37.430">be</span> <span begin="37.430" end="37.581">the</span> <span begin="37.593" end="38.231">terror</span> <span begin="38.231" end="38.594">of</span> <span begin="38.594" end="38.989">your</span> <span begin="38.989" end="40.428">nights</span><span ttm:role="x-translation" xml:lang="zh-CN">我想成为你夜里的梦魇</span></p><p begin="42.581" end="45.966" itunes:key="L3" ttm:agent="v1"><span begin="42.581" end="42.787">And</span> <span begin="42.787" end="42.948">there</span> <span begin="42.948" end="43.102">will</span> <span begin="43.102" end="43.381">come</span> <span begin="43.381" end="43.541">a</span> <span begin="43.541" end="44.076">day</span> <span begin="44.096" end="44.150">it</span> <span begin="44.150" end="44.777">doesn&apos;t</span> <span begin="44.777" end="45.966">hurt</span><span ttm:role="x-translation" xml:lang="zh-CN">终会有那么一天不再疼痛</span></p><p begin="48.498" end="52.109" itunes:key="L4" ttm:agent="v1"><span begin="48.498" end="48.733">And</span> <span begin="48.733" end="48.884">I</span> <span begin="48.884" end="49.084">can</span> <span begin="49.084" end="49.329">find</span> <span begin="49.329" end="49.495">a</span> <span begin="49.495" end="50.086">meaning</span> <span begin="50.086" end="50.417">to</span> <span begin="50.417" end="50.774">my</span> <span begin="50.774" end="52.109">life</span><span ttm:role="x-translation" xml:lang="zh-CN">我才能给这生命找到意义</span></p><p begin="53.010" end="57.406" itunes:key="L5" ttm:agent="v1"><span begin="53.010" end="53.313">Do</span> <span begin="53.313" end="53.521">it</span> <span begin="53.521" end="53.703">for</span> <span begin="53.703" end="53.883">your</span><span begin="53.883" end="57.406">self</span><span ttm:role="x-translation" xml:lang="zh-CN">去为你自己活吧</span></p><p begin="57.707" end="1:03.435" itunes:key="L6" ttm:agent="v1"><span begin="57.707" end="58.049">I</span> <span begin="58.049" end="58.673">hope</span> <span begin="58.673" end="58.921">you</span> <span begin="58.921" end="59.205">meet</span> <span begin="59.205" end="59.880">somebody</span> <span begin="59.880" end="1:03.435">else</span><span ttm:role="x-translation" xml:lang="zh-CN">愿你遇见别的人</span></p><p begin="1:03.696" end="1:09.273" itunes:key="L7" ttm:agent="v1"><span begin="1:03.696" end="1:04.018">The</span> <span begin="1:04.018" end="1:04.410">day</span> <span begin="1:04.410" end="1:04.859">I</span> <span begin="1:04.859" end="1:05.401">ever</span> <span begin="1:05.401" end="1:05.781">wan</span><span begin="1:05.781" end="1:07.114">na</span> <span begin="1:07.114" end="1:07.901">love</span> <span begin="1:07.901" end="1:09.273">again</span><span ttm:role="x-translation" xml:lang="zh-CN">若我再也无法去爱那天</span></p><p begin="1:09.590" end="1:15.271" itunes:key="L8" ttm:agent="v1"><span begin="1:09.590" end="1:10.026">I</span> <span begin="1:10.026" end="1:10.488">hope</span> <span begin="1:10.488" end="1:10.730">you</span> <span begin="1:10.730" end="1:11.060">meet</span> <span begin="1:11.060" end="1:11.697">somebody</span> <span begin="1:11.697" end="1:15.271">else</span><span ttm:role="x-translation" xml:lang="zh-CN">愿你遇见别的人</span></p><p begin="1:15.664" end="1:17.710" itunes:key="L9" ttm:agent="v1"><span begin="1:15.664" end="1:15.855">You</span> <span begin="1:15.855" end="1:16.034">should</span> <span begin="1:16.044" end="1:16.298">do</span> <span begin="1:16.298" end="1:16.427">it,</span> <span begin="1:16.430" end="1:16.668">do</span> <span begin="1:16.668" end="1:16.807">it,</span> <span begin="1:16.814" end="1:17.070">do</span> <span begin="1:17.070" end="1:17.194">it,</span> <span begin="1:17.210" end="1:17.486">do</span> <span begin="1:17.486" end="1:17.710">it</span><span ttm:role="x-translation" xml:lang="zh-CN">你就去做吧去做吧</span></p><p begin="1:18.129" end="1:22.081" itunes:key="L10" ttm:agent="v1"><span begin="1:18.129" end="1:18.276">The</span> <span begin="1:18.312" end="1:18.704">boy</span> <span begin="1:18.704" end="1:19.050">you&apos;ve</span> <span begin="1:19.050" end="1:19.437">met</span> <span begin="1:19.448" end="1:20.000">isn&apos;t</span> <span begin="1:20.000" end="1:20.323">so</span> <span begin="1:20.352" end="1:22.081">tough</span><span ttm:role="x-translation" xml:lang="zh-CN">你遇见的那个男孩并不够狠</span></p><p begin="1:24.083" end="1:29.879" itunes:key="L11" ttm:agent="v1"><span begin="1:24.083" end="1:24.256">On</span> <span begin="1:24.256" end="1:24.616">both</span> <span begin="1:24.616" end="1:25.000">his</span> <span begin="1:25.000" end="1:25.399">wrists</span> <span begin="1:25.399" end="1:25.551">a</span> <span begin="1:25.571" end="1:26.344">different</span> <span begin="1:26.344" end="1:27.859">watch</span><span ttm:role="x-translation" xml:lang="zh-CN">左右手腕各戴不同名表</span><span ttm:role="x-bg" begin="1:28.219" end="1:29.879"><span begin="1:28.219" end="1:28.334">(Now</span> <span begin="1:28.334" end="1:28.490">won&apos;t</span> <span begin="1:28.490" end="1:28.622">you</span> <span begin="1:28.622" end="1:28.906">look</span> <span begin="1:28.906" end="1:29.152">at</span> <span begin="1:29.199" end="1:29.879">that)</span><span ttm:role="x-translation" xml:lang="zh-CN">你倒瞧瞧那副样子</span></span></p><p begin="1:30.000" end="1:34.087" itunes:key="L12" ttm:agent="v1"><span begin="1:30.000" end="1:30.204">He</span> <span begin="1:30.204" end="1:30.576">speaks</span> <span begin="1:30.576" end="1:30.789">the</span> <span begin="1:30.789" end="1:31.520">language</span> <span begin="1:31.520" end="1:31.894">of</span> <span begin="1:31.894" end="1:32.287">my</span> <span begin="1:32.287" end="1:32.610">mo</span><span begin="1:32.610" end="1:34.087">ther</span><span ttm:role="x-translation" xml:lang="zh-CN">他说的正是母亲的语言</span></p><p begin="1:35.929" end="1:40.422" itunes:key="L13" ttm:agent="v1"><span begin="1:35.929" end="1:36.101">I</span> <span begin="1:36.101" end="1:36.481">scream</span> <span begin="1:36.481" end="1:36.657">like</span> <span begin="1:36.663" end="1:36.870">an</span> <span begin="1:36.870" end="1:37.602">animal,</span> <span begin="1:37.602" end="1:38.301">enemies</span> <span begin="1:38.310" end="1:39.509">ruining</span> <span begin="1:39.509" end="1:39.864">my</span> <span begin="1:39.864" end="1:40.422">life</span><span ttm:role="x-translation" xml:lang="zh-CN">我像野兽般嘶吼 他们毁我一生</span></p><p begin="1:40.448" end="1:44.846" itunes:key="L14" ttm:agent="v1"><span begin="1:40.448" end="1:40.685">Do</span> <span begin="1:40.685" end="1:40.907">it</span> <span begin="1:40.907" end="1:41.059">for</span> <span begin="1:41.059" end="1:41.234">your</span><span begin="1:41.234" end="1:44.846">self</span><span ttm:role="x-translation" xml:lang="zh-CN">去为你自己活吧</span></p><p begin="1:45.135" end="1:50.773" itunes:key="L15" ttm:agent="v1"><span begin="1:45.135" end="1:45.500">I</span> <span begin="1:45.500" end="1:46.048">hope</span> <span begin="1:46.048" end="1:46.278">you</span> <span begin="1:46.278" end="1:46.594">meet</span> <span begin="1:46.594" end="1:47.232">somebody</span> <span begin="1:47.232" end="1:50.773">else</span><span ttm:role="x-translation" xml:lang="zh-CN">愿你遇见别的人</span></p><p begin="1:51.031" end="1:56.743" itunes:key="L16" ttm:agent="v1"><span begin="1:51.031" end="1:51.410">The</span> <span begin="1:51.410" end="1:51.874">day</span> <span begin="1:51.874" end="1:52.188">I</span> <span begin="1:52.188" end="1:52.763">ever</span> <span begin="1:52.763" end="1:53.099">wan</span><span begin="1:53.099" end="1:54.532">na</span> <span begin="1:54.532" end="1:55.430">love</span> <span begin="1:55.430" end="1:56.743">again</span><span ttm:role="x-translation" xml:lang="zh-CN">若我再也无法去爱那天</span></p><p begin="1:56.949" end="2:02.660" itunes:key="L17" ttm:agent="v1"><span begin="1:56.949" end="1:57.453">I</span> <span begin="1:57.453" end="1:57.938">hope</span> <span begin="1:57.938" end="1:58.098">you</span> <span begin="1:58.098" end="1:58.501">meet</span> <span begin="1:58.501" end="1:59.081">somebody</span> <span begin="1:59.081" end="2:02.660">else</span><span ttm:role="x-translation" xml:lang="zh-CN">愿你遇见别的人</span></p><p begin="2:03.046" end="2:05.199" itunes:key="L18" ttm:agent="v1"><span begin="2:03.046" end="2:03.294">You</span> <span begin="2:03.294" end="2:03.457">should</span> <span begin="2:03.457" end="2:03.690">do</span> <span begin="2:03.690" end="2:03.822">it,</span> <span begin="2:03.822" end="2:04.098">do</span> <span begin="2:04.098" end="2:04.204">it,</span> <span begin="2:04.204" end="2:04.470">do</span> <span begin="2:04.470" end="2:04.583">it,</span> <span begin="2:04.591" end="2:04.902">do</span> <span begin="2:04.902" end="2:05.199">it</span><span ttm:role="x-translation" xml:lang="zh-CN">你就去做吧去做吧</span></p><p begin="2:16.480" end="2:19.563" itunes:key="L19" ttm:agent="v1"><span begin="2:16.480" end="2:16.766">Don&apos;t</span> <span begin="2:16.766" end="2:17.495">call</span> <span begin="2:17.495" end="2:17.962">me</span> <span begin="2:17.962" end="2:18.164">when</span> <span begin="2:18.164" end="2:18.377">the</span> <span begin="2:18.377" end="2:18.652">house</span> <span begin="2:18.652" end="2:18.805">is</span> <span begin="2:18.805" end="2:19.055">on</span> <span begin="2:19.055" end="2:19.563">fire</span><span ttm:role="x-translation" xml:lang="zh-CN">家着火的时候别打给我</span></p><p begin="2:19.450" end="2:22.582" itunes:key="L20" ttm:agent="v1"><span begin="2:19.450" end="2:19.775">Don&apos;t</span> <span begin="2:19.775" end="2:20.448">call</span> <span begin="2:20.448" end="2:20.944">me</span> <span begin="2:20.944" end="2:21.137">when</span> <span begin="2:21.137" end="2:21.293">the</span> <span begin="2:21.293" end="2:21.584">house</span> <span begin="2:21.584" end="2:21.745">is</span> <span begin="2:21.745" end="2:22.047">on</span> <span begin="2:22.047" end="2:22.582">fire</span><span ttm:role="x-translation" xml:lang="zh-CN">家着火的时候别打给我</span></p><p begin="2:22.404" end="2:25.520" itunes:key="L21" ttm:agent="v1"><span begin="2:22.404" end="2:22.731">Don&apos;t</span> <span begin="2:22.731" end="2:23.423">call</span> <span begin="2:23.423" end="2:23.940">me</span> <span begin="2:23.940" end="2:24.086">when</span> <span begin="2:24.086" end="2:24.227">the</span> <span begin="2:24.227" end="2:24.574">house</span> <span begin="2:24.574" end="2:24.708">is</span> <span begin="2:24.708" end="2:25.000">on</spa