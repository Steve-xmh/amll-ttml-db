<tt xmlns="http://www.w3.org/ns/ttml" xmlns:amll="http://www.example.com/ns/amll" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" itunes:timing="Word" xml:lang="en"><head><metadata><ttm:agent type="person" xml:id="v1"/><amll:meta key="musicName" value="Cyberangel"/><amll:meta key="musicName" value="IP动画短片《天使重构》主题曲"/><amll:meta key="musicName" value="Cyberangel (Instrumental)"/><amll:meta key="musicName" value="崩坏3《天使重构》动画短片主题曲"/><amll:meta key="musicName" value="Cyberangel (instrumental)"/><amll:meta key="musicName" value="Cyber​​angel (feat. Hanser) [遊戲《崩壞3》印象曲]"/><amll:meta key="musicName" value="Cyber​​angel (Instrumental)"/><amll:meta key="artists" value="Hanser"/><amll:meta key="artists" value="HOYO-MiX"/><amll:meta key="album" value="崩坏3-Onwards-Original Soundtrack"/><amll:meta key="album" value="Cyberangel (Honkai Impact 3RD Ost)"/><amll:meta key="album" value="[遊戲《崩壞3》印象曲] (feat. Hanser) - Single"/><amll:meta key="album" value="Cyberangel (feat. Hanser) [Honkai Impact 3RD Ost] - Single"/><amll:meta key="ncmMusicId" value="1375725396"/><amll:meta key="ncmMusicId" value="1375725397"/><amll:meta key="qqMusicId" value="0017hqrD44vVfP"/><amll:meta key="qqMusicId" value="335799006"/><amll:meta key="qqMusicId" value="000yup333XfsYY"/><amll:meta key="qqMusicId" value="438588970"/><amll:meta key="spotifyId" value="1bzRUqh03TEtZu9jYZgKQm"/><amll:meta key="spotifyId" value="1JNDiHS6IEc5ro7LW78f1G"/><amll:meta key="appleMusicId" value="1472345207"/><amll:meta key="appleMusicId" value="1472345214"/><amll:meta key="isrc" value="FR59R1965357"/><amll:meta key="isrc" value="FR59R1965358"/><amll:meta key="作曲" value="蔡近翰Zoe"/><amll:meta key="作词" value="尹纯青Eyn"/><amll:meta key="作词" value="Applebeetle"/><amll:meta key="制作人" value="宫奇Gon"/><amll:meta key="录音" value="李昀昇Max"/><amll:meta key="母带处理" value="宫奇Gon"/><amll:meta key="混音" value="宫奇Gon"/><amll:meta key="演唱" value="Hanser"/><amll:meta key="编曲" value="宫奇Gon"/><amll:meta key="ttmlAuthorGithub" value="68000793"/><amll:meta key="ttmlAuthorGithubLogin" value="ranhengzhang"/><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal"><translations><translation type="subtitle" xml:lang="ja"><text for="L1">意識に侵食してくる 崩れた0と1</text><text for="L2">感情のないまま 執行される喚起の命令</text><text for="L3">因果の変数を掴み その瞬間を止める</text><text for="L4">修正実行 運命を再起動する</text><text for="L5">汚れた血が滲んだこの翼でも</text><text for="L6">ネバーランドを求めて 強く羽ばたく</text><text for="L7">私のライブラリに もうエラーは発生しないよ</text><text for="L8">君について行くと決めたから</text><text for="L9">灼熱の弾丸が風を切り裂く</text><text for="L10">フルチャージした装甲で 光のように疾り出し</text><text for="L11">因果の変数を掴み その瞬間を止める</text><text for="L12">今にも手が届きそうな 新しい未来を</text><text for="L13">汚れた血が滲んだこの翼でも</text><text for="L14">ネンバーランドを求めて 強く羽ばたく</text><text for="L15">私のライブラリに もうエラーは発生しないよ</text><text for="L16">君について行くと決めたから</text><text for="L17">汚れた血が滲んだこの翼でも</text><text for="L18">ネンバーランドを求めて 強く羽ばたく</text><text for="L19">私のライブラリに もうエラーは発生しないよ</text><text for="L20">君について行くと決めたから</text><text for="L21">汚れた血が滲んだこの翼でも</text><text for="L22">ネンバーランドを求めて 強く羽ばたく</text><text for="L23">私のライブラリに もうエラーは発生しないよ</text><text for="L24">心に委ねると決めたから</text></translation><translation type="subtitle" xml:lang="ko"><text for="L1">손상된 이진코드는 내 마음을 감염시켜</text><text for="L2">차갑고 무감각하게 호출을 수행하고 있어</text><text for="L3">하나의 변수를 질의하고 시간을 붙잡아</text><text for="L4">다시 컴파일하고 운명의 방아쇠를 당기네</text><text for="L5">비록 내 날개가 피에 얼룩져 지워지지 않더라도</text><text for="L6">꿈꾸던 천국을 향해 전력으로 날아오를 거야</text><text for="L7">나의 라이브러리에는 &quot;예외&quot;란 존재하지 않아</text><text for="L8">항상 너와 함께할 거라는 걸 나는 아니까</text><text for="L9">작열하는 탄두가 바람을 가르고</text><text for="L10">가갑을 빛의 속도가 날 때까지 충전시켜</text><text for="L11">하나의 변수를 질의하고 시간을 붙잡아</text><text for="L12">새롭고도 멀지 않은 미래에서</text><text for="L13">비록 내 날개가 피에 얼룩져 지워지지 않더라도</text><text for="L14">꿈꾸던 천국을 향해 전력으로 날아오를 거야</text><text for="L15">나의 라이브러리에는 &quot;예외&quot;란 존재하지 않아</text><text for="L16">항상 너와 함께할 거라는 걸 나는 아니까</text><text for="L17">비록 내 날개가 피에 얼룩져 지워지지 않더라도</text><text for="L18">꿈꾸던 천국을 향해 전력으로 날아오를 거야</text><text for="L19">나의 라이브러리에는 &quot;예외&quot;란 존재하지 않아</text><text for="L20">항상 너와 함께할 거라는 걸 나는 아니까</text><text for="L21">비록 내 날개가 피에 얼룩져 지워지지 않더라도</text><text for="L22">꿈꾸던 천국을 향해 전력으로 날아오를 거야</text><text for="L23">나의 라이브러리에는 &quot;예외&quot;란 존재하지 않아</text><text for="L24">항상 너와 함께할 거라는 걸 나는 아니까</text></translation><translation type="subtitle" xml:lang="zh-Hant"><text for="L1">錯亂的0和1侵蝕著意識</text><text for="L2">麻木冰冷地執行調用</text><text for="L3">查詢一個變數並綁定時間</text><text for="L4">去重新編譯、觸發命運</text><text for="L5">即使雙翼早已濺上無法擺脫的血污</text><text for="L6">為了夢中彼岸，我要全力飛翔</text><text for="L7">這個庫不會報出“異常”</text><text for="L8">因為我知道，我永遠會與你同行</text><text for="L9">熾熱的彈頭撕裂疾風</text><text for="L10">我為戰甲增能，直至飛馳如光</text><text for="L11">查詢一個變數並綁定時間</text><text for="L12">在全新而並不遙遠的未來</text><text for="L13">即使雙翼早已濺上無法擺脫的血污</text><text for="L14">為了夢中彼岸，我要全力飛翔</text><text for="L15">這個庫不會報出“異常”</text><text for="L16">因為我知道，我永遠會與你同行</text><text for="L17">即使雙翼早已濺上無法擺脫的血污</text><text for="L18">為了夢中彼岸，我要全力飛翔</text><text for="L19">這個庫不會報出“異常”</text><text for="L20">因為我知道，我永遠會與你同行</text><text for="L21">即使雙翼早已濺上無法擺脫的血污</text><text for="L22">為了夢中彼岸，我要全力飛翔</text><text for="L23">這個庫不會報出“異常”</text><text for="L24">因為我知道，我會永遠與心同行</text></translation><translation type="subtitle" xml:lang="zh-Hans"><text for="L1">错乱的0和1侵袭着意识</text><text for="L2">麻木冰冷地执行调用</text><text for="L3">查询一个变量并绑定时间</text><text for="L4">去重新编译 触发命运</text><text for="L5">即使双翼早已溅上无法摆脱的血污</text><text for="L6">为了梦中的彼岸 我要全力飞翔</text><text for="L7">这个库中不会报出“异常”</text><text for="L8">因为我知道 我会永远与你同行</text><text for="L9">炽热的弹头撕裂疾风</text><text for="L10">我为战甲充能 直至飞驰如光</text><text for="L11">查询一个变量并绑定时间</text><text for="L12">在全新而并不遥远的未来</text><text for="L13">即使双翼早已溅上无法摆脱的血污</text><text for="L14">为了梦中的彼岸 我要全力飞翔</text><text for="L15">这个库中不会报出“异常”</text><text for="L16">因为我知道 我会永远与你同行</text><text for="L17">即使双翼早已溅上无法摆脱的血污</text><text for="L18">为了梦中的彼岸 我要全力飞翔</text><text for="L19">这个库中不会报出“异常”</text><text for="L20">因为我知道 我会永远与你同行</text><text for="L21">即使双翼早已溅上无法摆脱的血污</text><text for="L22">为了梦中的彼岸 我要全力飞翔</text><text for="L23">这个库中不会报出“异常”</text><text for="L24">因为我知道 我会永远与心同行</text></translation></translations><songwriters><songwriter>尹纯青Eyn</songwriter><songwriter>Applebeetle</songwriter></songwriters><transliterations/></iTunesMetadata></metadata></head><body dur="2:53.540"><div begin="32.130" end="48.630" itunes:songPart="Verse"><p begin="32.130" end="35.880" itunes:key="L1" ttm:agent="v1"><span begin="32.130" end="32.360">Cor</span><span begin="32.360" end="32.590">rupt</span> <span begin="32.590" end="32.950">bi</span><span begin="32.950" end="33.300">na</span><span begin="33.300" end="33.530">ry</span> <span begin="33.530" end="33.850">co</span><span begin="33.850" end="34.040">des</span> <span begin="34.040" end="34.420">in</span><span begin="34.420" end="34.750">fe</span><span begin="34.750" end="34.880">c</span><span begin="34.880" end="35.220">ting</span> <span begin="35.220" end="35.500">my</span> <span begin="35.500" end="35.880">mind</span></p><p begin="36.230" end="39.620" itunes:key="L2" ttm:agent="v1"><span begin="36.230" end="36.330">Per</span><span begin="36.330" end="36.770">form</span> <span begin="36.770" end="37.140">in</span><span begin="37.140" end="37.390">vo</span><span begin="37.390" end="37.720">ca</span><span begin="37.720" end="38.130">tion</span> <span begin="38.130" end="38.240">wi</span><span begin="38.240" end="38.520">th</span> <span begin="38.520" end="38.850">num</span><span begin="38.850" end="39.180">bing</span> <span begin="39.180" end="39.520">free</span><span begin="39.520" end="39.620">ze</span></p><p begin="39.800" end="43.410" itunes:key="L3" ttm:agent="v1"><span begin="39.800" end="40.050">Que</span><span begin="40.050" end="40.210">rying</span> <span begin="40.210" end="40.470">for</span> <span begin="40.470" end="40.660">a</span> <span begin="40.660" end="40.980">va</span><span begin="40.980" end="41.260">ria</s