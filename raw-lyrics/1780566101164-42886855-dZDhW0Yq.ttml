7">aligned</span><span ttm:role="x-translation" xml:lang="zh-CN">指引漫游脚步归于同一轨迹</span></p><p begin="1:53.014" end="1:56.563" itunes:key="L12" ttm:agent="v1"><span begin="1:53.014" end="1:53.283">In</span> <span begin="1:53.283" end="1:54.658">end</span><span begin="1:54.658" end="1:54.952">less</span> <span begin="1:54.952" end="1:56.563">time</span><span ttm:role="x-translation" xml:lang="zh-CN">于无垠时空</span></p><p begin="1:58.323" end="2:06.612" itunes:key="L13" ttm:agent="v1"><span begin="1:58.323" end="1:58.819">Star</span><span begin="1:58.819" end="1:59.320">light</span> <span begin="1:59.320" end="1:59.811">will</span> <span begin="1:59.811" end="2:01.251">find</span> <span begin="2:01.251" end="2:01.478">my</span> <span begin="2:01.478" end="2:02.851">fate</span> <span begin="2:03.214" end="2:03.264">in</span> <span begin="2:03.264" end="2:05.008">re</span><span begin="2:05.008" end="2:06.612">wind</span><span ttm:role="x-translation" xml:lang="zh-CN">星光将命运倒转重写</span></p><p begin="2:09.878" end="2:13.269" itunes:key="L14" ttm:agent="v1"><span begin="2:09.878" end="2:10.774">Through</span> <span begin="2:10.774" end="2:11.579">the</span> <span begin="2:11.579" end="2:13.269">light</span><span ttm:role="x-translation" xml:lang="zh-CN">穿越光之彼岸</span></p><p begin="2:14.123" end="2:17.806" itunes:key="L15" ttm:agent="v1"><span begin="2:14.123" end="2:14.843">All</span> <span begin="2:14.843" end="2:16.120">voices</span> <span begin="2:16.120" end="2:16.568">inter</span><span begin="2:16.568" end="2:17.806">twine</span><span ttm:role="x-translation" xml:lang="zh-CN">万千心声交织共鸣</span></p><p begin="2:18.094" end="2:25.558" itunes:key="L16" ttm:agent="v1"><span begin="2:18.094" end="2:18.375">Once</span> <span begin="2:18.375" end="2:19.917">fading</span> <span begin="2:19.917" end="2:21.072">hearts</span> <span begin="2:21.307" end="2:21.571">now</span> <span begin="2:21.571" end="2:22.309">glowing</span> <span begin="2:22.309" end="2:23.017">across</span> <span begin="2: