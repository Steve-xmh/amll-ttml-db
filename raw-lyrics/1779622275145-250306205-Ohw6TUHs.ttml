<tt xmlns="http://www.w3.org/ns/ttml" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xmlns:amll="http://www.example.com/ns/amll" itunes:timing="Word" xml:lang="en"><head><metadata><ttm:agent type="person" xml:id="v1"/><amll:meta key="musicName" value="Perfect Celebrity (Apple Music Live)"/><amll:meta key="artists" value="Lady Gaga"/><amll:meta key="artists" value="レディー・ガガ"/><amll:meta key="album" value="Apple Music Live: MAYHEM Requiem"/><amll:meta key="isrc" value="USUM72603831"/><amll:meta key="appleMusicId" value="6768201785"/><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal"><songwriters><songwriter>Andrew Watt</songwriter><songwriter>Henry Russell Walter</songwriter><songwriter>Lady Gaga</songwriter><songwriter>Mike Levy</songwriter></songwriters></iTunesMetadata></metadata></head><body dur="3:19.740"><div begin="37.398" end="54.805" itunes:songPart="Verse"><p begin="37.398" end="41.814" itunes:key="L1" ttm:agent="v1"><span begin="37.398" end="37.846">I&apos;m</span> <span begin="37.846" end="38.097">made</span> <span begin="38.097" end="38.379">of</span> <span begin="38.379" end="38.678">pla</span><span begin="38.678" end="38.995">stic</span> <span begin="38.995" end="39.278">like</span> <span begin="39.278" end="39.579">a</span> <span begin="39.579" end="39.881">hu</span><span begin="39.881" end="40.446">man</span> <span begin="40.446" end="41.814">doll</span><span ttm:role="x-translation" xml:lang="zh-Hans">我像个人偶娃娃一样由塑料制成</span></p><p begin="42.056" end="46.386" itunes:key="L2" ttm:agent="v1"><span begin="42.056" end="42.434">You</span> <span begin="42.434" end="42.736">push</span> <span begin="42.736" end="43.018">and</span> <span begin="43.018" end="43.320">pull</span> <span begin="43.320" end="43.602">me,</span> <span begin="43.602" end="43.901">I</span> <span begin="43.901" end="44.186">don&apos;t</span> <span begin="44.186" end="44.501">hurt</span> <span begin="44.501" end="45.053">at</span> <span begin="45.053" end="46.386">all</span><span ttm:role="x-translation" xml:lang="zh-Hans">任你推拉摆弄 我都感觉不到疼痛</span></p><p begin="46.675" end="51.192" itunes:key="L3" ttm:agent="v1"><span begin="46.675" end="47.062">I</span> <span begin="47.062" end="47.345">talk</span> <span begin="47.345" end="47.627">in</span> <span begin="47.627" end="47.929">cir</span><span begin="47.929" end="48.227">cles</span> <span begin="48.227" end="48.529">&apos;cause</span> <span begin="48.529" end="48.827">my</span> <span begin="48.827" end="49.379">brain,</span> <span begin="49.379" end="49.713">it</span> <span begin="49.713" end="51.192">aches</span><span ttm:role="x-translation" xml:lang="zh-Hans">我说话绕来绕去 只因脑袋隐隐作痛</span></p><p begin="51.285" end="54.805" itunes:key="L4" ttm:agent="v1"><span begin="51.285" end="51.666">You</span> <span begin="51.666" end="51.965">say,</span> <span begin="51.965" end="52.247">&quot;I</span> <span begin="52.247" end="52.549">love</span> <span begin="52.549" end="52.815">you,&quot;</span> <span begin="52.815" end="53.114">I</span> <span begin="53.114" end="53.431">dis</span><span begin="53.431" end="53.765">in</span><span begin="53.765" end="54.266">te</span><span begin="54.266" end="54.805">grate</span><span ttm:role="x-translation" xml:lang="zh-Hans">你说“我爱你” 我瞬间崩解</span></p></div><div begin="55.894" end="1:14.166" itunes:songPart="PreChorus"><p begin="55.894" end="1:00.392" itunes:key="L5" ttm:agent="v1"><span begin="55.894" end="56.320">I&apos;ve</span> <span begin="56.320" end="56.603">be</span><span begin="56.603" end="57.152">come</span> <span begin="57.152" end="57.454">a</span> <span begin="57.454" end="57.752">no</span><span begin="57.752" end="58.286">to</span><span begin="58.286" end="58.619">ri</span><span begin="58.619" end="58.920">ous</span> <span begin="58.920" end="1:00.392">being</span><span ttm:role="x-translation" xml:lang="zh-Hans">我成了声名狼藉的存在</span></p><p begin="1:00.504" end="1:05.320" itunes:key="L6" ttm:agent="v1"><span begin="1:00.504" end="1:00.915">Find</span> <span begin="1:00.915" end="1:01.232">my</span> <span begin="1:01.232" end="1:01.734">clone,</span> <span begin="1:01.734" end="1:02.067">she&apos;s</span> <span begin="1:02.067" end="1:02.350">a</span><span begin="1:02.350" end="1:02.779">sleep</span> <span begin="1:02.899" end="1:03.216">on</span> <span begin="1:03.216" end="1:03.515">the</span> <span begin="1:03.515" end="1:04.083">cei</span><span begin="1:04.083" end="1:04.616">ling</span> <span begin="1:04.616" end="1:05.320">now</span><span ttm:role="x-translation" xml:lang="zh-Hans">去找我的克隆体吧 此刻她正睡在天花板上</span></p><p begin="1:05.413" end="1:07.783" itunes:key="L7" ttm:agent="v1"><span begin="1:05.413" end="1:06.091">Can&apos;t</span> <span begin="1:06.091" end="1:06.640">get</span> <span begin="1:06.640" end="1:07.008">me</span> <span begin="1:07.008" end="1:07.783">down</span><span ttm:role="x-translation" xml:lang="zh-Hans">你无法将我击垮</span></p><p begin="1:07.993" end="1:10.852" itunes:key="L8" ttm:agent="v1"><span begin="1:07.993" end="1:08.406">You</span> <span begin="1:08.406" end="1:08.724">love</span> <span begin="1:08.724" end="1:09.038">to</span> <span begin="1:09.038" end="1:09.857">hate</span> <span begin="1:09.857" end="1:10.852">me</span><span ttm:role="x-translation" xml:lang="zh-Hans">你喜欢恨我</span></p><p begin="1:10.886" end="1:14.166" itunes:key="L9" ttm:agent="v1"><span begin="1:10.886" end="1:11.334">I&apos;m</span> <span begin="1:11.334" end="1:11.649">the</span> <span begin="1:11.649" end="1:12.201">per</span><span begin="1:12.201" end="1:12.734">fect</span> <span begin="1:12.734" end="1:13.033">ce</span><span begin="1:13.033" end="1:13.334">le</span><span begin="1:13.334" end="1:13.617">bri</span><span begin="1:13.617" end="1:14.166">ty</span><span ttm:role="x-translation" xml:lang="zh-Hans">我是完美的名人</span></p></div><div begin="1:14.177" end="1:33.277" itunes:songPart="Chorus"><p begin="1:14.177" end="1:16.822" itunes:key="L10" ttm:agent="v1"><span begin="1:14.177" end="1:14.497">So</span> <span begin="1:14.497" end="1:14.780">rip</span> <span begin="1:14.780" end="1:15.047">off</span> <span begin="1:15.047" end="1:15.215">my</span> <span begin="1:15.215" end="1:15.481">face</span> <span begin="1:15.481" end="1:15.647">in</span> <span begin="1:15.647" end="1:15.948">this</span> <span begin="1:15.948" end="1:16.212">pho</span><span begin="1:16.212" end="1:16.415">to</span><span begin="1:16.415" end="1:16.822">graph</span><span ttm:role="x-translation" xml:lang="zh-Hans">那就从这张照片上撕下我的脸吧</span></p><p begin="1:16.697" end="1:18.756" itunes:key="L11" ttm:agent="v1"><span begin="1:16.697" end="1:17.111">Per</span><span begin="1:17.111" end="1:17.377">fect</span> <span begin="1:17.377" end="1:17.561">ce</span><span begin="1:17.561" end="1:17.828">le</span><span begin="1:17.828" end="1:18.012">bri</span><span begin="1:18.012" end="1:18.756">ty</span><span ttm:role="x-translation" xml:lang="zh-Hans">完美的名人</span></p><p begin="1:18.998" end="1:21.404" itunes:key="L12" ttm:agent="v1"><span begin="1:18.998" end="1:19.395">You</span> <span begin="1:19.395" end="1:19.662">make</span> <span begin="1:19.662" end="1:19.827">me</span> <span begin="1:19.827" end="1:20.110">mo</span><span begin="1:20.110" end="1:20.278">ney,</span> <span begin="1:20.278" end="1:20.579">I&apos;ll</span> <span begin="1:20.579" end="1:20.862">make</span> <span begin="1:20.862" end="1:21.027">you</span> <span begin="1:21.027" end="1:21.404">laugh</span><span ttm:role="x-translation" xml:lang="zh-Hans">你让我赚得盆满钵满 我逗你开怀大笑</span></p><p begin="1:21.302" end="1:23.374" itunes:key="L13" ttm:agent="v1"><span begin="1:21.302" end="1:21.709">Per</span><span begin="1:21.709" end="1:22.008">fect</span> <span begin="1:22.008" end="1:22.192">ce</span><span begin="1:22.192" end="1:22.440">le</span><span begin="1:22.440" end="1:22.608">bri</span><span begin="1:22.608" end="1:23.374">ty</span><span ttm:role="x-translation" xml:lang="zh-Hans">完美的名人</span></p><p begin="1:23.272" end="1:26.454" itunes:key="L14" ttm:agent="v1"><span begin="1:23.272" end="1:23.720">Show</span> <span begin="1:23.720" end="1:24.208">me</span> <span begin="1:24.352" end="1:24.504">your</span> <span begin="1:24.504" end="1:24.771">pret</span><span begin="1:24.771" end="1:24.920">ty,</span> <span begin="1:24.920" end="1:25.203">I&apos;ll</span> <span begin="1:25.203" end="1:25.504">show</span> <span begin="1:25.504" end="1:25.704">you</span> <span begin="1:25.704" end="1:26.454">mine</span><span ttm:role="x-translation" xml:lang="zh-Hans">你展现你的美 我也会让你见识我的光彩</span></p><p begin="1:26.515" end="1:29.150" itunes:key="L15" ttm:agent="v1"><span begin="1:26.515" end="1:26.947">You</span> <span begin="1:26.947" end="1:27.233">love</span> <span begin="1:27.233" end="1:27.499">to</span> <span begin="1:27.499" end="1:28.331">hate</span> <span begin="1:28.331" end="1:29.150">me</span><span ttm:role="x-translation" xml:lang="zh-Hans">你喜欢恨我</span></p><p begin="1:29.312" end="1:33.277" itunes:key="L16" ttm:agent="v1"><span begin="1:29.312" end="1:29.760">I&apos;m</span> <span begin="1:29.760" end="1:30.027">the</span> <span begin="1:30.027" end="1:30.611">per</span><span begin="1:30.611" end="1:31.160">fect</span> <span begin="1:31.160" end="1:31.493">ce</span><span begin="1:31.493" end="1:31.776">le</span><span begin="1:31.776" end="1:32.061">bri</span><span begin="1:32.061" end="1:33.277">ty</span><span ttm:role="x-translation" xml:lang="zh-Hans">我是完美的名人</span></p></div><div begin="1:37.440" end="1:56.682" itunes:songPart="Verse"><p begin="1:37.440" end="1:41.827" itunes:key="L17" ttm:agent="v1"><span begin="1:37.440" end="1:37.829">I</span> <span begin="1:37.829" end="1:38.128">look</span> <span begin="1:38.128" end="1:38.413">so</span> <span begin="1:38.413" end="1:38.696">hun</span><span begin="1:38.696" end="1:38.962">gry,</span> <span begin="1:38.962" end="1:39.261">but</span> <span begin="1:39.261" end="1:39.578">I</span> <span begin="1:39.578" end="1:39.896">look</span> <span begin="1:39.896" end="1:40.445">so</span> <span begin="1:40.445" end="1:41.827">good</span><span ttm:role="x-translation" xml:lang="zh-Hans">我看起来饥饿不堪 却又美得夺目耀眼</span></p><p begin="1:42.037" end="1:46.418" itunes:key="L18" ttm:agent="v1"><span begin="1:42.037" end="1:42.442">Tap</span> <span begin="1:42.442" end="1:42.725">on</span> <span begin="1:42.725" end="1:43.007">my</span> <span begin="1:43.007" end="1:43.309">vein,</span> <span begin="1:43.309" end="1:43.575">suck</span> <span begin="1:43.575" end="1:43.874">on</span> <span begin="1:43.874" end="1:44.159">my</span> <span begin="1:44.159" end="1:44.575">dia</span><span begin="1:44.575" end="1:45.058">mond</span> <span begin="1:45.058" end="1:46.418">blood</span><span ttm:role="x-translation" xml:lang="zh-Hans">轻触我的血管 吮吸我如钻石般珍贵的血液</span></p><p begin="1:46.517" end="1:51.037" itunes:key="L19" ttm:agent="v1"><span begin="1:46.517" end="1:46.997">Choke</span> <span begin="1:46.997" end="1:47.295">on</span> <span begin="1:47.295" end="1:47.597">your</span> <span begin="1:47.597" end="1:47.895">fame</span> <span begin="1:47.895" end="1:48.178">and</span> <span begin="1:48.178" end="1:48.463">hope</span> <span begin="1:48.463" end="1:48.762">it</span> <span begin="1:48.762" end="1:49.178">gets</span> <span begin="1:49.178" end="1:49.645">you</span> <span begin="1:49.645" end="1:51.037">high</span><span ttm:role="x-translation" xml:lang="zh-Hans">在你的盛名中沉沦 盼它能让你飘飘欲仙</span></p><p begin="1:51.168" end="1:56.682" itunes:key="L20" ttm:agent="v1"><span begin="1:51.168" end="1:51.640">Sit</span> <span begin="1:51.640" end="1:51.923">in</span> <span begin="1:51.923" end="1:52.205">the</span> <span begin="1:52.205" end="1:52.539">front</span> <span begin="1:52.539" end="1:52.821">row,</span> <span begin="1:52.821" end="1:53.123">watch</span> <span begin="1:53.123" end="1:53.421">the</span> <span begin="1:53.421" end="1:53.805">prin</span><span begin="1:53.805" end="1