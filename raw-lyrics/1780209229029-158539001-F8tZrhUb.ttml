" value="Anton Rundberg"/><amll:meta key="coProducer" value="Anders Froen"/><amll:meta key="supervisor" value="GREVE GUNNAR"/><amll:meta key="supervisor" value="Marcos G. Pérez"/><amll:meta key="mixingEngineer" value="Soren Von Malmborg"/><amll:meta key="masteringEngineer" value="Soren Von Malmborg"/><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal"><songwriters><songwriter>Alan Walker</songwriter><songwriter>Sabrina Carpenter</songwriter><songwriter>Farruko</songwriter><songwriter>Franklin Martinez</songwriter><songwriter>Julia Karlsson</songwriter><songwriter>Anton Rundberg</songwriter><songwriter>Jesper Borgen</songwriter><songwriter>Anders Froen</songwriter><songwriter>GREVE GUNNAR</songwriter><songwriter>OLSEN FREDRIK BORCH</songwriter><songwriter>Øyvind Sauvik</songwriter><songwriter>Marcos G. Pérez</songwriter><songwriter>Frank Miami</songwriter><songwriter>Gest</songwriter><songwriter>Sharo Towers</songwriter><songwriter>Vinni</songwriter></songwriters></iTunesMetadata></metadata></head><body dur="3:13.049"><div begin="0.115" end="3:13.049"><p begin="0.115" end="1.178" itunes:key="L1" ttm:agent="v1"><span begin="0.115" end="0.197">I&apos;m</span> <span begin="0.197" end="0.756">sor</span><span begin="0.756" end="0.942">ry</span> <span begin="0.942" end="1.178">but</span><span ttm:role="x-translation" xml:lang="zh-CN">我很抱歉</span></p><p begin="2.981" end="4.163" itunes:key="L2" ttm:agent="v1"><span begin="2.981" end="3.203">Don&apos;t</span> <span begin="3.203" end="3.550">wan</span><span begin="3.550" end="3.708">na</span> <span begin="3.708" end="4.163">talk</span><span ttm:role="x-translation" xml:lang="zh-CN">但此刻我不愿开口解释</span></p><p begin="4.439" end="7.082" itunes:key="L3" ttm:agent="v1"><span begin="4.439" end="4.616">I</span> <span begin="4.616" end="4.982">need</span> <span begin="4.982" end="5.107">a</span> <span begin="5.107" end="5.671">mo</span><span begin="5.671" end="5.798">ment</span> <span begin="5.798" end="5.901">be</span><span begin="5.901" end="6.267">fore</span> <span begin="6.267" end="6.561">I</span> <span begin="6.561" end="7.082">go</span><span ttm:role="x-translation" xml:lang="zh-CN">离开前我需要片刻理清思绪</span></p><p begin="8.622" end="11.248" itunes:key="L4" ttm:agent="v1"><span begin="8.622" end="8.831">It&apos;s</span> <span begin="8.831" end="9.039">no</span><span begin="9.039" end="9.376">thing</span> <span begin="9.376" end="10.130">per</span><span begin="10.454" end="10.818">son</span><span begin="10.818" end="11.248">al</span><span ttm:role="x-translation" xml:lang="zh-CN">这无关私人恩怨</span></p><p begin="11.472" end="13.261" itunes:key="L5" ttm:agent="v1"><span begin="11.472" end="11.617">I</span> <span begin="11.617" end="11.997">draw</span> <span begin="11.997" end="12.195">the</span> <span begin="12.195" end="13.261">blinds</span><span ttm:role="x-translation" xml:lang="zh-CN">将百叶窗拉下</span></p><p begin="13.781" end="15.960" itunes:key="L6" ttm:agent="v1"><span begin="13.781" end="13.952">They</span> <span begin="13.952" end="14.115">don&apos;t</span> <span begin="14.115" end="14.264">need</span> <span begin="14.264" end="14.331">to</span> <span begin="14.331" end="14.735">see</span> <span begin="14.735" end="14.993">me</span> <span begin="14.993" end="15.960">cry</span><span ttm:role="x-translation" xml:lang="zh-CN">没必要让别人看到我泪流满面</span></p><p begin="16.482" end="18.381" itunes:key="L7" ttm:agent="v1"><span begin="16.482" end="16.664">&apos;Cause</span> <span begin="16.664" end="16.937">even</span> <span begin="16.937" end="17.110">if</span> <span begin="17.110" end="17.315">they</span> <span begin="17.315" end="17.616">un</span><span begin="17.616" end="17.874">der</span><span begin="17.874" end="18.381">stand</span><span ttm:role="x-translation" xml:lang="zh-CN">因为即便他们能懂</span></p><p begin="19.604" end="21.887" itunes:key="L8" ttm:agent="v1"><span begin="19.604" end="19.794">They</span> <span begin="19.794" end="20.119">don&apos;t</span> <span begin="20.119" end="20.410">un</span><span begin="20.410" end="20.510">der</span><span begin="20.510" end="21.887">stand</span><span ttm:role="x-translation" xml:lang="zh-CN">他们也不能理解我</span></p><p begin="23.350" end="25.000" itunes:key="L9" ttm:agent="v1"><span begin="23.350" end="23.625">So</span> <span begin="23.625" end="23.875">then</span> <span begin="23.875" end="24.140">when</span> <span begin="24.140" end="24.269">I&apos;m</span> <span begin="24.269" end="24.610">fin</span><span begin="24.610" end="25.000">ished</span><span ttm:role="x-translation" xml:lang="zh-CN">所以当我站在最后的终点线</span></p><p begin="25.063" end="26.339" itunes:key="L10" ttm:agent="v1"><span begin="25.063" end="25.123">I&apos;m</span> <span begin="25.123" end="25.366">all</span> <span begin="25.366" end="25.599">&apos;bout</span> <span begin="25.599" end="25.813">my</span> <span begin="25.813" end="26.086">busi</span><span begin="26.086" end="26.339">ness</span><span ttm:role="x-translation" xml:lang="zh-CN">自始至终我都全力以赴</span></p><p begin="26.339" end="28.444" itunes:key="L11" ttm:agent="v1"><span begin="26.339" end="26.560">And</span> <span begin="26.560" end="27.015">ready</span> <span begin="27.015" end="27.142">to</span> <span begin="27.142" end="27.780">save</span> <span begin="27.780" end="27.960">the</span> <span begin="27.960" end="28.444">world</span><span ttm:role="x-translation" xml:lang="zh-CN">我已蓄势待发 拯救世界</span></p><p begin="29.074" end="30.650" itunes:key="L12" ttm:agent="v1"><span begin="29.074" end="29.228">I&apos;m</span> <span begin="29.228" end="29.556">tak</span><span begin="29.556" end="29.839">in&apos;</span> <span begin="29.839" end="30.033">my</span> <span begin="30.033" end="30.336">mis</span><span begin="30.336" end="30.650">ery</span><span ttm:role="x-translation" xml:lang="zh-CN">承受着苦痛</span></p><p begin="30.766" end="31.711" itunes:key="L13" ttm:agent="v1"><span begin="30.766" end="30.994">Make</span> <span begin="30.994" end="31.244">it</span> <span begin="31.244" end="31.469">my</span> <span begin="31.469" end="31.711" amll:obscene="true">bitch</span><span ttm:role="x-translation" xml:lang="zh-CN">势在必得 亲爱的</span></p><p begin="31.711" end="34.265" itunes:key="L14" ttm:agent="v1"><span begin="31.711" end="31.960">Can&apos;t</span> <span begin="31.960" end="32.121">be</span> <span begin="32.121" end="32.664">every</span><span begin="32.664" end="32.933">one&apos;s</span> <span begin="32.933" end="33.189">fa</span><span begin="33.189" end="33.545">vourite</span> <span begin="33.545" end="34.265">girl</span><span ttm:role="x-translation" xml:lang="zh-CN">你无法让所有人都爱你</span></p><p begin="34.413" end="37.418" itunes:key="L15" ttm:agent="v1"><span begin="34.413" end="34.899">So</span> <span begin="34.899" end="35.464">take</span> <span begin="35.464" end="36.012">aim</span> <span begin="36.012" end="36.225">and</span> <span begin="36.225" end="36.671">fire</span> <span begin="36.671" end="37.418">away</span><span ttm:role="x-translation" xml:lang="zh-CN">就瞄准目标 果断出击吧</span></p><p begin="37.601" end="40.200" itunes:key="L16" ttm:agent="v1"><span begin="37.601" end="37.812">I&apos;ve</span> <span begin="37.812" end="38.129">nev</span><span begin="38.129" end="38.347">er</span> <span begin="38.347" end="38.762">been</span> <span begin="38.762" end="39.241">so</span> <span begin="39.241" end="39.596">wide</span> <span begin="39.596" end="39.723">a</span><span begin="39.723" end="40.200">wake</span><span ttm:role="x-translation" xml:lang="zh-CN">我从未如此清醒过</span></p><p begin="40.609" end="43.979" itunes:key="L17" ttm:agent="v1"><span begin="40.609" end="40.923">No,</span> <span begin="41.130" end="41.312">no</span><span begin="41.312" end="41.658">body</span> <span begin="41.658" end="42.053">but</span> <span begin="42.053" end="42.313">me</span> <span begin="42.313" end="42.692">can</span> <span begin="42.692" end="43.043">keep</span> <span begin="43.043" end="43.263">me</span> <span begin="43.263" end="43.979">safe</span><span ttm:role="x-translation" xml:lang="zh-CN">除了自己 无人能护我周全</span></p><p begin="44.305" end="45.855" itunes:key="L18" ttm:agent="v1"><span begin="44.305" end="44.486">And</span> <span begin="44.486" end="44.804">I&apos;m</span> <span begin="44.804" end="45.191">on</span> <span begin="45.191" end="45.521">my</span> <span begin="45.521" end="45.855">way</span><span ttm:role="x-translation" xml:lang="zh-CN">此刻我已踏上征程</span></p><p begin="45.855" end="48.732" itunes:key="L19" ttm:agent="v1"><span begin="45.855" end="46.253">The</span> <span begin="46.253" end="46.780">blood</span> <span begin="46.780" end="47.303">moon</span> <span begin="47.303" end="47.721">is</span> <span begin="47.721" end="48.013">on</span> <span begin="48.013" end="48.190">the</span> <span begin="48.190" end="48.732">rise</span><span ttm:role="x-translation" xml:lang="zh-CN">天际那腥红血月已冉冉升起</span></p><p begin="48.732" end="51.625" itunes:key="L20" ttm:agent="v1"><span begin="48.732" end="48.977">The</span> <span begin="48.977" end="49.597">fire</span> <span begin="49.597" end="50.125">burn</span><span begin="50.125" end="50.477">ing</span> <span begin="50.477" end="50.791">in</span> <span begin="50.791" end="51.012">my</span> <span begin="51.012" end="51.625">eyes</span><span ttm:role="x-translation" xml:lang="zh-CN">熊熊烈焰在我眸中炙热燃烧</span></p><p begin="51.896" end="55.246" itunes:key="L21" ttm:agent="v1"><span begin="51.896" end="52.193">No,</span> <span begin="52.426" end="52.624">no</span><span begin="52.624" end="52.970">body</span> <span begin="52.970" end="53.319">but</span> <span begin="53.319" end="53.567">me</span> <span begin="53.567" end="53.983">can</span> <span begin="53.983" end="54.365">keep</span> <span begin="54.365" end="54.553">me</span> <span begin="54.553" end="55.246">safe</span><span ttm:role="x-translation" xml:lang="zh-CN">除了自己 无人能护我周全</span><span ttm:role="x-bg" begin="51.991" end="53.319"><span begin="51.991" end="53.319">(No)</span></span></p><p begin="55.641" end="1:02.844" itunes:key="L22" ttm:agent="v1"><span begin="55.641" end="55.762">And</span> <span begin="55.762" end="56.179">I&apos;m</span> <span begin="56.179" end="56.517">on</span> <span begin="56.517" end="56.784">my</span> <span begin="56.784" end="57.209">way</span><span ttm:role="x-translation" xml:lang="zh-CN">此刻我已踏上征程</span><span ttm:role="x-bg" begin="57.209" end="1:02.844"><span begin="57.209" end="57.543">(Belp,</span> <span begin="1:02.139" end="1:02.319">yah,</span> <span begin="1:02.319" end="1:02.844">yah)</span></span></p><p begin="1:10.557" end="1:14.495" itunes:key="L23" ttm:agent="v2"><span begin="1:10.557" end="1:10.760">Far</span><span begin="1:10.760" end="1:10.964">ru,</span> <span begin="1:11.721" end="1:13.088">yah-</span><span begin="1:13.088" end="1:13.599">yah,</span> <span begin="1:13.599" end="1:13.798">yah,</span> <span begin="1:13.798" end="1:14.495">yah</span></p><p begin="1:19.285" end="1:24.636" itunes:key="L24" ttm:agent="v2"><span begin="1:19.285" end="1:19.345">Lo</span> <span begin="1:19.345" end="1:19.805">sien</span><span begin="1:19.805" end="1:19.865">to</span> <span begin="1:19.865" end="1:20.269">mu</span><span begin="1:20.269" end="1:21.123">cho</span> <span begin="1:22.050" end="1:22.598">pero</span> <span begin="1:22.598" end="1:22.769">me</span> <span begin="1:22.769" end="1:23.480">voy</span><span ttm:role="x-translation" xml:lang="zh-CN">我满怀歉意 但我现在就要启程</span><span ttm:role="x-bg" begin="1:21.176" end="1:24.636"><span begin="1:21.176" end="1:21.390">(Far</span><span begin="1:21.390" end="1:21.547">ru,</span> <span begin="1:23.675" end="1:24.636">eh)</span></span></p><p begin="1:24.842" end="1:30.159" itunes:key="L25" ttm:agent="v2"><span begin="1:24.842" end="1:24.979">Por</span> <span begin="1:24.979" end="1:25.173">que</span> <span begin="1:25.173" end="1:25.296">a</span> <span begin="1:25.296" end="1:25.597">tu</span> <span begin="1:25.597" end="1:26.335">lado</span> <span begin="1:26.335" end="1:26.648">me</span> <span begin="1:26.648" end="1:26.979">di</span> <span begin="1:26.979" end="1:27.368">cuen</span><span begin="1:27.368" end="1:27.686">ta</span> <span begin="1:27.686" end="1:27.894">que</span> <span begin="1:27.894" end="1:28.320">nada</span> <span begin="1:28.320" end="1:29.172">soy</span><span ttm:role="x-translation" xml:lang="zh-CN">因为在你的身边 我感觉空空如也</span><span ttm:role="x-bg" begin="1:28.949" end="1:30.159"><span begin="1:28.949" end="1:29.530">(Eh-</span><span begin="1:29.530" end="1:30.159">ey)</span></span></p><p begin="1:30.159" end="1:33.195" itunes:key="L26" ttm:agent="v2"><span begin="1:30.159" end="1:30.231">Y</span> <span begin="1:30.231" end="1:30.483">me</span> <span begin="1:30.483" end="1:30.583">can</span><span begin="1:30.583" end="1:30.847">sé</span> <span begin="1:30.847" end="1:30.950">de</span> <span begin="1:30.950" end="1:31.556">luchar</span> <span begin="1:31.556" end="1:31.723">y</span> <span begin="1:31.723" end="1:31.919">de</span> <span begin="1:31.919" end="1:32.243">guer</span><span begin="1:32.243" end="1:32.416">rear</span> <span begin="1:32.416" end="1:32.566">en</span> <span begin="1:32.566" end="1:33.195">vano</span><span ttm:role="x-translation" xml:lang="zh-CN">我已经厌倦了不停地争斗</span></p><p begin="1:33.195" end="1:35.981" itunes:key="L27" ttm:agent="v2"><span begin="1:33.195" end="1:33.281">De</span> <span begin="1:33.281" end="1:33.368">es</span><span begin="1:33.368" end="1:33.454">tar</span> <span begin="1:33.454" end="1:33.532">en</span> <span begin="1:33.532" end="1:33.660">la</span> <span begin="1:33.660" end="1:33.890">línea</span> <span begin="1:33.890" end="1:33.987">de</span> <span begin="1:33.987" end="1:34.443">fuego</span> <span begin="1:34.443" end="1:34.615">y</span> <span begin="1:34.615" end="1:34.790">de</span> <span begin="1:34.790" end="1:35.090">me</span><span begin="1:35.090" end="1:35.296">ter</span> <span begin="1:35.296" end="1:35.414">la</span> <span begin="1:35.414" end="1:35.981">mano</span><span ttm:role="x-translation" xml:lang="zh-CN">我会种下火种 送到你的手中</span></p><p begin="1:35.981" end="1:39.014" itunes:key="L28" ttm:agent="v2"><span begin="1:35.981" end="1:36.267">Acep</span><span begin="1:36.267" end="1:36.423">to</span> <span begin="1:36.423" end="1:36.696">mis</span> <span begin="1:36.696" end="1:36.872">er</span><span begin="1:36.872" end="1:37.392">rore&apos;,</span> <span begin="1:37.392" end="1:37.596">tam</span><span begin="1:37.596" end="1:37.969">bién</span> <span begin="1:37.969" end="1:38.075">soy</span> <span begin="1:38.075" end="1:38.488">hu</span><span begin="1:38.488" end="1:39.014">mano</span><span ttm:role="x-translation" xml:lang="zh-CN">我接受你的教训 我只是个凡人而已</span></p><p begin="1:39.014" end="1:42.309" itunes:key="L29" ttm:agent="v2"><span begin="1:39.014" end="1:39.176">Y</span> <span begin="1:39.176" end="1:39.412">tú</span> <span begin="1:39.412" end="1:39.715">no</span> <span begin="1:39.715" end="1:40.033">ve&apos;</span> <span begin="1:40.033" end="1:40.238">que</span> <span begin="1:40.238" end="1:40.407">lo</span> <span begin="1:40.407" end="1:40.588">hago</span> <span begin="1:40.588" end="1:40.748">por</span> <span begin="1:40.748" end="1:40.944">que</span> <span begin="1:40.944" end="1:41.162">te</span> <span begin="1:41.162" end="1:41.834">amo</span><span ttm:role="x-translation" xml:lang="zh-CN">而你永远不会这样教训我 因为我爱你</span><span ttm:role="x-bg" begin="1:41.325" end="1:42.309"><span begin="1:41.325" end="1:41.484">(Pum-</span><span begin="1:41.484" end="1:41.739">pum-</span><span begin="1:41.739" end="1:41.990">pum-</span><span begin="1:41.990" end="1:42.309">pum)</span></span></p><p begin="1:42.001" end="1:46.606" itunes:key="L30" ttm:agent="v2"><span begin="1:42.001" end="1:42.363">Pero</span> <span begin="1:42.363" end="1:43.378">ya</span> <span begin="1:43.931" end="1:44.120">no</span> <span begin="1:44.120" end="1:44.325">ten</span><span begin="1:44.325" end="1:44.412">go</span> <span begin="1:44.412" end="1:44.665">más</span> <span begin="1:44.665" end="1:44.827">na&apos;</span> <span begin="1:44.827