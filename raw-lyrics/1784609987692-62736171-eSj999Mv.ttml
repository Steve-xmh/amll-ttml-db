<tt xmlns="http://www.w3.org/ns/ttml" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xmlns:amll="http://www.example.com/ns/amll" itunes:timing="Word" xml:lang="zh-Hans"><head><metadata><ttm:agent type="person" xml:id="v1"><ttm:name>早稻叽</ttm:name></ttm:agent><ttm:agent type="person" xml:id="v2"><ttm:name>Akie秋绘</ttm:name></ttm:agent><amll:meta key="musicName" value="未知悲悯"/><amll:meta key="artists" value="时爻彧"/><amll:meta key="artists" value="早稻叽"/><amll:meta key="artists" value="Akie秋绘"/><amll:meta key="album" value="未知悲悯"/><amll:meta key="ncmMusicId" value="3407012703"/><amll:meta key="ncmMusicId" value="3407108408"/><amll:meta key="qqMusicId" value="708059627"/><amll:meta key="qqMusicId" value="708600265"/><amll:meta key="qqMusicId" value="0026eMQl3ebIac"/><amll:meta key="qqMusicId" value="002vxVUw0jyz3p"/><amll:meta key="ttmlAuthorGithub" value="62736171"/><amll:meta key="ttmlAuthorGithubLogin" value="lerdb"/><amll:meta key="策划" value="时爻彧"/><amll:meta key="人声混音" value="康康"/><amll:meta key="分轨混音" value="KamFine_KC"/><amll:meta key="美工" value="寒雪"/><amll:meta key="pv底图" value="寒雪"/><amll:meta key="题字" value="梦落青烟"/><amll:meta key="pv" value="BJ"/><amll:meta key="歌排制作" value="BJ"/><amll:meta key="故事背景简介" value="秦知愿"/><amll:meta key="故事主题简介" value="赛博时代，诸神复活，神话也被重写。数据宇宙天幕出现裂缝，大量数据正极速流失，由此导致了普通人类用户的集体失忆症、空心症和颓废情绪的蔓延。宇宙天幕裂缝的缺口一天天变大。人类文明局高阶会议召开，高层认为目前的危机不足为惧，并通过了“无为而治”的决议。然而，补天程序却在会议结束后自动开启——科技发展局的智能体联盟对本次人类世界面临的危机进行了综合评估，做出了与人类截然相反的决定。“我们并非背叛人类，我们的目的一致，都是为了人类文明的存续。”"/><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal"><songwriters><songwriter>冰橘子</songwriter><songwriter>子杳</songwriter></songwriters></iTunesMetadata></metadata></head><body dur="3:26.449"><div begin="23.415" end="1:08.560" itunes:songPart="Verse"><p begin="23.415" end="27.677" itunes:key="L1" ttm:agent="v1"><span begin="23.415" end="23.730">早</span><span begin="23.730" end="23.896">被</s