<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xmlns:amll="http://www.example.com/ns/amll" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xml:lang="en" itunes:timing="Word"><head><metadata><ttm:agent type="person" xml:id="v1"/><amll:meta key="musicName" value="Come Back...Be Here (Taylor's Version)"/><amll:meta key="musicName" value="カム・バック...ビー・ヒア(テイラーズ・ヴァージョン)"/><amll:meta key="artists" value="Taylor Swift"/><amll:meta key="artists" value="テイラー・スウィフト"/><amll:meta key="album" value="Red (Taylor’s Version) [+ A Message from Taylor]"/><amll:meta key="album" value="Red (Taylor's Version) [Video Deluxe]"/><amll:meta key="album" value="Red (Taylor’s Version): The Slow Motion Chapter"/><amll:meta key="album" value="Red (Taylor's Version)"/><amll:meta key="isrc" value="USUG12103678"/><amll:meta key="appleMusicId" value="1590368747"/><amll:meta key="appleMusicId" value="1604664839"/><amll:meta key="appleMusicId" value="1590368669"/><amll:meta key="appleMusicId" value="1595423274"/><amll:meta key="spotifyId" value="4pNApnaUWAL2J4KO2eqokq"/><amll:meta key="spotifyId" value="5XaLWURooWKZiraOWSTWjm"/><amll:meta key="ncmMusicId" value="1891454354"/><amll:meta key="ncmMusicId" value="1914927527"/><amll:meta key="ttmlAuthorGithub" value="64765950"/><amll:meta key="ttmlAuthorGithub" value="250306205"/><amll:meta key="ttmlAuthorGithubLogin" value="Thereallo1026"/><amll:meta key="ttmlAuthorGithubLogin" value="kid141252010"/><amll:meta key="ttmlAuthorLyricify" value="Thereallo"/><amll:meta key="qqMusicId" value="331220360"/><amll:meta key="qqMusicId" value="001SkdQh33ESAv"/><iTunesMetadata><songwriters><songwriter>Dan Wilson</songwriter><songwriter>Taylor Swift</songwriter></songwriters><translations><translation xml:lang="zh-Hans" type="subtitle"><text for="L1">你说的那么云淡风轻</text><text for="L2">分开后的第二天凌晨四点</text><text for="L3">多奇怪 我对你竟一无所知</text><text for="L4">漫长的道别里 慌乱失措</text><text for="L5">最后一吻 然后赶往你的航班</text><text for="L6">偏偏在我刚要沦陷的时刻</text><text for="L7">我不断告诫自己 切莫动情</text><text for="L8">脑海中却一遍遍倒带重演</text><text for="L9">旋转得比带走你的飞机还要飞快</text><text for="L10">而这一刻 沉痛的落寞袭上心头</text><text for="L11">我不想这样蚀骨地想念你</text><text for="L12">回到我身边 留在这一刻</text><text for="L13">回到我身边 陪伴在我身旁</text><text for="L14">我想你今天应该到了纽约</text><text for="L15">我不想这样难以自拔地依赖你</text><text for="L16">回到我身边 留在这一刻</text><text for="L17">回到我身边 陪伴在我身旁</text><text for="L18">最初那份悸动的狂喜</text><text for="L19">感觉仿佛早已将你看透</text><text for="L20">却又其实一无所知</text><text for="L21">如今我终于能坦然面对</text><text for="L22">若早知会深陷至此</text><text for="L23">当初绝不会装得那般漫不经心</text><text for="L24">穿梭的出租车与喧嚣街头</text><text for="L25">却再也带不回你的身影</text><text for="L26">多希望你离开时能带上我</text><text for="L27">而这一刻 沉痛的落寞袭上心头</text><text for="L28">我不想这样蚀骨地想念你</text><text for="L29">回到我身边 留在这一刻</text><text for="L30">回到我身边 陪伴在我身旁</text><text for="L31">我想你今天又飞到了伦敦</text><text for="L32">我不想这样难以自拔地依赖你</text><text for="L33">回到我身边 留在这一刻</text><text for="L34">回到我身边 陪伴在我身旁</text><text for="L35">这是最残忍的动情方式</text><text for="L36">在你身处天涯时 爱上了你</text><text for="L37">你在纽约 却希望你留在身旁</text><text for="L38">可你到了伦敦 我瞬间崩溃</text><text for="L39">凭什么要承受你不在的煎熬</text><text for="L40">而这一刻 沉痛的落寞袭上心头</text><text for="L41">我不想这样蚀骨地想念你</text><text for="L42">回到我身边 留在这一刻</text><text for="L43">回到我身边 陪伴在我身旁</text><text for="L44">我想你今天应该到了纽约</text><text for="L45">我不想这样难以自拔地依赖你</text><text for="L46">回到我身边 留在这一刻</text><text for="L47">回到我身边 陪伴在我身旁</text><text for="L48">我不想这样蚀骨地想念你</text><text for="L49">回到我身边 留在这一刻</text><text for="L50">回到我身边 陪伴在我身旁</text></translation></translations><audio lyricOffset="1.011" role="spatial"/></iTunesMetadata></metadata></head><body dur="03:34.618"><div begin="00:06.011" end="00:27.990" itunes:songPart="Verse"><p begin="00:06.011" end="00:08.825" ttm:agent="v1" itunes:key="L1"><span begin="00:06.011" end="00:06.152">You</span> <span begin="00:06.152" end="00:06.681">said</span> <span begin="00:06.681" end="00:06.851">it</span> <span begin="00:06.