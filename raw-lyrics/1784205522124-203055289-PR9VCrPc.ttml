<tt xmlns="http://www.w3.org/ns/ttml" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xmlns:amll="http://www.example.com/ns/amll"><head><metadata><ttm:agent type="person" xml:id="v1"/><ttm:agent type="person" xml:id="v2"/><amll:meta key="musicName" value="远光点"/><amll:meta key="musicName" value="APHELION [Galbrena&apos;s Lullaby]"/><amll:meta key="musicName" value="游戏《鸣潮》原声音乐"/><amll:meta key="musicName" value="Aphelion[Galbrena&apos;s Lullaby](Original Game Soundtrack)"/><amll:meta key="artists" value="鸣潮先约电台"/><amll:meta key="artists" value="Crywolf"/><amll:meta key="artists" value="鳴潮"/><amll:meta key="artists" value="명조: 워더링 웨이브"/><amll:meta key="album" value="远光点(APHELION [Galbrena&apos;s Lullaby])"/><amll:meta key="album" value="远光点(游戏《鸣潮》原声音乐) - Single"/><amll:meta key="album" value="APHELION [Galbrena&apos;s Lullaby]"/><amll:meta key="album" value="Aphelion[Galbrena&apos;s Lullaby](Original Game Soundtrack)"/><amll:meta key="isrc" value="HKG732569558"/><amll:meta key="qqMusicId" value="607240405"/><amll:meta key="qqMusicId" value="002d5NTY0FgLNi"/><amll:meta key="ncmMusicId" value="2750998233"/><amll:meta key="appleMusicId" value="1842820039"/><amll:meta key="ttmlAuthorGithub" value="203055289"/><amll:meta key="ttmlAuthorGithubLogin" value="jshxb84"/><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal"><songwriters><songwriter>Justin Phillips</songwriter><songwriter>Alexander Phillips</songwriter></songwriters></iTunesMetadata></metadata></head><body dur="5:17.521"><div begin="47.140" end="5:17.521"><p begin="47.140" end="50.503" itunes:key="L1" ttm:agent="v1"><span begin="47.140" end="47.528">In</span> <span begin="47.528" end="48.325">my</span> <span begin="48.325" end="50.503">dreams</span><span ttm:role="x-translation" xml:lang="zh-Hans">在我的梦中</span></p><p begin="51.381" end="53.864" itunes:key="L2" ttm:agent="v1"><span begin="51.381" end="51.548">I&apos;m</span> <span begin="51.548" end="51.954">cra</span><span begin="51.954" end="52.631">dled</span> <span begin="52.631" end="52.862">in</span> <span begin="52.862" end="53.242">my</span> <span begin="53.242" end="53.864">tomb</span><span ttm:role="x-translation" xml:lang="zh-Hans">我安眠于自己的坟墓</span></p><p begin="54.224" end="56.614" itunes:key="L3" ttm:agent="v1"><span begin="54.224" end="54.721">All</span> <span begin="54.721" end="55.125">this</span> <span begin="55.125" end="55.853">hun</span><span begin="55.853" end="56.614">ger</span><span ttm:role="x-translation" xml:lang="zh-Hans">这无尽的饥饿</span></p><p begin="57.880" end="59.629" itunes:key="L4" ttm:agent="v1"><span begin="57.880" end="58.453">Tastes</span> <span begin="58.453" end="58.837">like</span> <span begin="58.837" end="59.629">love</span><span ttm:role="x-translation" xml:lang="zh-Hans">滋味似爱如饴</span></p><p begin="1:01.789" end="1:05.973" itunes:key="L5" ttm:agent="v1"><span begin="1:01.789" end="1:02.242">Do</span> <span begin="1:02.242" end="1:03.254">you</span> <span begin="1:03.254" end="1:05.124">fear</span> <span begin="1:05.124" end="1:05.973">me?</span><span ttm:role="x-translation" xml:lang="zh-Hans">你会害怕我吗？</span></p><p begin="1:06.420" end="1:08.738" itunes:key="L6" ttm:agent="v1"><span begin="1:06.420" end="1:06.731">The</span> <span begin="1:06.731" end="1:07.123">angel</span> <span begin="1:07.123" end="1:07.549">that</span> <span begin="1:07.549" end="1:07.986">con</span><span begin="1:07.986" end="1:08.738">sumes</span><span ttm:role="x-translation" xml:lang="zh-Hans">害怕这吞噬着一切的“天使”</span></p><p begin="1:09.006" end="1:11.679" itunes:key="L7" ttm:agent="v1"><span begin="1:09.006" end="1:09.419">Oh</span> <span begin="1:09.419" end="1:09.696">my</span> <span begin="1:09.696" end="1:10.686">fa</span><span begin="1:10.686" end="1:11.679">ther</span><span ttm:role="x-translation" xml:lang="zh-Hans">我的父亲，你能否告诉我</span></p><p begin="1:12.627" end="1:15.197" itunes:key="L8" ttm:agent="v1"><span begin="1:12.627" end="1:13.150">Oh</span> <span begin="1:13.150" end="1:13.599">my</span> <span begin="1:13.599" end="1:14.457">moth</span><span begin="1:14.457" end="1:15.197">er</span><span ttm:role="x-translation" xml:lang="zh-Hans">我的母亲，你能否告诉我</span></p><p begin="1:15.701" end="1:17.853" itunes:key="L9" ttm:agent="v1"><span begin="1:15.701" end="1:16.029">What</span> <span begin="1:16.029" end="1:16.606">have</span> <span begin="1:16.606" end="1:16.905">I</span> <span begin="1:16.905" end="1:17.300">be</span><span begin="1:17.300" end="1:17.853">come?</span><span ttm:role="x-translation" xml:lang="zh-Hans">我为何堕落？</span></p><p begin="1:23.059" end="1:25.328" itunes:key="L10" ttm:agent="v1"><span begin="1:23.059" end="1:23.444">What</span> <span begin="1:23.444" end="1:23.786">have</span> <span begin="1:23.786" end="1:24.241">I</span> <span begin="1:24.241" end="1:24.647">be</span><span begin="1:24.647" end="1:25.328">come?</span><span ttm:role="x-translation" xml:lang="zh-Hans">我将走向何方？</span></p><p begin="1:30.453" end="1:33.581" itunes:key="L11" ttm:agent="v1"><span begin="1:30.453" end="1:30.777">What</span> <span begin="1:30.777" end="1:31.324">have</span> <span begin="1:31.324" end="1:31.635">I</span> <span begin="1:31.635" end="1:32.068">be</span><span begin="1:32.068" end="1:33.581">come?</span><span ttm:role="x-translation" xml:lang="zh-Hans">我究竟变成了什么？</span><span ttm:role="x-bg" begin="1:36.977" end="1:37.235"><span begin="1:36.977" end="1:37.235">(Run)</span><span ttm:role="x-translation" xml:lang="zh-Hans">快逃</span></span></p><p begin="1:52.877" end="1:53.259" itunes:key="L12" ttm:agent="v2"><span begin="1:52.877" end="1:53.259">Run</span><span ttm:role="x-translation" xml:lang="zh-Hans">快逃</span></p><p begin="1:53.803" end="1:54.177" itunes:key="L13" ttm:agent="v2"><span begin="1:53.803" end="1:54.177">Run</span><span ttm:role="x-translation" xml:lang="zh-Hans">快逃</span></p><p begin="1:54.704" end="1:55.057" itunes:key="L14" ttm:agent="v2"><span begin="1:54.704" end="1:55.057">Run</span><span ttm:role="x-translation" xml:lang="zh-Hans">快逃</span></p><p begin="1:55.578" end="1:55.922" itunes:key="L15" ttm:agent="v2"><span begin="1:55.578" end="1:55.922">Run</span><span ttm:role="x-translation" xml:lang="zh-Hans">快逃</span></p><p begin="1:56.438" end="1:56.811" itunes:key="L16" ttm:agent="v2"><span begin="1:56.438" end="1:56.811">Run</span><span ttm:role="x-translation" xml:lang="zh-Hans">快逃</span></p><p begin="1:57.344" end="1:57.742" itunes:key="L17" ttm:agent="v2"><span begin="1:57.344" end="1:57.742">Run</span><span ttm:role="x-translation" xml:lang="zh-Hans">快逃</span></p><p begin="1:58.235" end="1:58.610" itunes:key="L18" ttm:agent="v2"><span begin="1:58.235" end="1:58.610">Run</span><span ttm:role="x-translation" xml:lang="zh-Hans">快逃</span></p><p begin="1:59.142" end="1:59.520" itunes:key="L19" ttm:agent="v2"><span begin="1:59.142" end="1:59.520">Run</span><span ttm:role="x-translation" xml:lang="zh-Hans">快逃</span></p><p begin="1:59.984" end="2:00.371" itunes:key="L20" ttm:agent="v2"><span begin="1:59.984" end="2:00.371">Run</span><span ttm:role="x-translation" xml:lang="zh-Hans">快逃</span></p><p begin="2:00.898" end="2:01.270" itunes:key="L21" ttm:agent="v2"><span begin="2:00.898" end="2:01.270">Run</span><span ttm:role="x-translation" xml:lang="zh-Hans">快逃</span></p><p begin="2:01.775" end="2:02.156" itunes:key="L22" ttm:agent="v2"><span begin="2:01.775" end="2:02.156">Run</span><span ttm:role="x-translation" xml:lang="zh-Hans">快逃</span></p><p begin="2:02.700" end="2:03.035" itunes:key="L23" ttm:agent="v2"><span begin="2:02.700" end="2:03.035">Run</span><span ttm:role="x-translation" xml:lang="zh-Hans">快逃</span></p><p begin="2:03.585" end="2:03.926" itunes:key="L24" ttm:agent="v2"><span begin="2:03.585" end="2:03.926">Run</span><span ttm:role="x-translation" xml:lang="zh-Hans">快逃</span></p><p begin="2:04.487" end="2:04.849" itunes:key="L25" ttm:agent="v2"><span begin="2:04.487" end="2:04.849">Run</span><span ttm:role="x-translation" xml:lang="zh-Hans">快逃</span></p><p begin="2:05.306" end="2:05.777" itunes:key="L26" ttm:agent="v2"><span begin="2:05.306" end="2:05.777">Run</span><span ttm:role="x-translation" xml:lang="zh-Hans">快逃</span></p><p begin="2:09.797" end="2:12.289" itunes:key="L27" ttm:agent="v2"><span begin="2:09.797" end="2:10.378">Run</span> <span begin="2:11.148" end="2:11.626">and</span> <span begin="2:11.626" end="2:12.289">hide</span><span ttm:role="x-translation" xml:lang="zh-Hans">快跑，快躲起来</span><span ttm:role="x-bg" begin="2:11.852" end="2:14.097"><span begin="2:11.852" end="2:11.968">(Am</span> <span begin="2:11.968" end="2:12.132">I</span> <span begin="2:12.132" end="2:12.288">the</span> <span begin="2:12.288" end="2:12.700">lamb</span> <span begin="2:12.700" end="2:12.909">that</span> <span begin="2:12.909" end="2:13.138">must</span> <span begin="2:13.138" end="2:13.309">be</span> <span begin="2:13.309" end="2:13.703">slaugh</span><span begin="2:13.703" end="2:14.097">tered?)</span><span ttm:role="x-translation" xml:lang="zh-Hans">我是那只任人宰割的羔羊？</span></span></p><p begin="2:15.272" end="2:18.095" itunes:key="L28" ttm:agent="v2"><span begin="2:15.272" end="2:15.391">Or</span> <span begin="2:15.391" end="2:15.593">the</span> <span begin="2:15.593" end="2:16.184">knife</span> <span begin="2:16.184" end="2:16.399">that</span> <span begin="2:16.399" end="2:16.814">plunges</span> <span begin="2:16.814" end="2:16.940">in</span> <span begin="2:16.940" end="2:17.289">while</span> <span begin="2:17.289" end="2:17.626">it</span> <span begin="2:17.626" end="2:18.095">weeps?</span><span ttm:role="x-translation" xml:lang="zh-Hans">还是那把在泪水中刺向命运的刀？</span></p><p begin="2:16.940" end="2:19.364" itunes:key="L29" ttm:agent="v2"><span begin="2:16.940" end="2:18.236">Run</span> <span begin="2:18.236" end="2:18.679">and</span> <span begin="2:18.679" end="2:19.364">hide</span><span ttm:role="x-translation" xml:lang="zh-Hans">快跑，快躲起来</span><span ttm:role="x-bg" begin="2:19.404" end="2:22.310"><span begin="2:19.404" end="2:19.617">(Will</span> <span begin="2:19.617" end="2:19.946">god</span> <span begin="2:19.946" end="2:20.343">forgive</span> <span begin="2:20.343" end="2:20.422">the</span> <span begin="2:20.422" end="2:21.085">sins</span> <span begin="2:21.085" end="2:21.259">he</span> <span begin="2:21.259" end="2:21.581">makes</span> <span begin="2:21.581" end="2:21.735">me</span> <span begin="2:21.735" end="2:22.310">commit?)</span><span ttm:role="x-translation" xml:lang="zh-Hans">若是祂让我犯下的罪，这份罪孽会被宽恕吗？</span></span></p><p begin="2:22.207" end="2:28.631" itunes:key="L30" ttm:agent="v1"><span begin="2:22.207" end="2:22.890">What</span> <span begin="2:22.890" end="2:23.200">am</span> <span begin="2:23.200" end="2:23.414">I</span> <span begin="2:23.414" end="2:23.832">to</span> <span begin="2:23.832" end="2:25.802">do</span> <span begin="2:25.802" end="2:26.472">knowing</span> <span begin="2:26.472" end="2:26.956">I&apos;m</span> <span begin="2:26.956" end="2:27.172">the</span> <span begin="2:27.172" end="2:28.631">storm?</span><span ttm:role="x-translation" xml:lang="zh-Hans">当我成为摧毁一切的风暴，我该怎么办？</span></p><p begin="2:29.343" end="2:35.635" itunes:key="L31" ttm:agent="v1"><span begin="2:29.343" end="2:29.710">Moth</span><span begin="2:29.710" end="2:29.978">er</span> <span begin="2:29.978" end="2:31.150">deso</span><span begin="2:31.150" end="2:32.850">lation</span> <span begin="2:32.850" end="2:33.327">wait</span><span begin="2:33.327" end="2:33.630">ing</span> <span begin="2:33.630" end="2:34.128">to</span> <span begin="2:34.128" end="2:34.553">be</span> <span begin="2:34.553" end="2:35.635">born</span><span ttm:role="x-translation" xml:lang="zh-Hans">荒芜之母，等待降生的来到</span></p><p begin="2:36.325" end="2:42.356" itunes:key="L32" ttm:agent="v1"><span begin="2:36.325" end="2:37.021">What</span> <span begin="2:37.021" end="2:37.331">am</span> <span begin="2:37.331" end="2:37.608">I</span> <span begin="2:37.608" end="2:38.015">to</span> <span begin="2:38.015" end="2:39.518">do</span> <span begin="2:39.518" end="2:39.821">with</span> <span begin="2:39.821" end="2:40.148">this</span> <span begin="2:40.148" end="2:40.505">hun</span><span begin="2:40.505" end="2:40.862">ger</span> <span begin="2:40.862" end="2:41.219">in</span> <span begin="2:41.219" end="2:41.438">my</span> <span begin="2:41.438" end="2:42.356">soul?</span><span ttm:role="x-translation" xml:lang="zh-Hans">当饥饿在我的灵魂深处燃烧，我该怎么办？</span></p><p begin="2:43.618" end="2:52.291" itunes:key="L33" ttm:agent="v1"><span begin="2:43.618" end="2:43.878">All</span> <span begin="2:43.878" end="2:44.773">these</span> <span begin="2:44.773" end="2:45.143">gaping</span> <span begin="2:45.143" end="2:47.139">mouths</span> <span begin="2:47.139" end="2:47.770">longing</span> <span begin="2:47.770" end="2:48.328">for</span> <span begin="2:48.328" end="2:48.600">a</span> <span begin="2:48.600" end="2:50.147">taste</span> <span begin="2:50.147" end="2:50.219">of</span> <span begin="2:50.219" end="2:52.291">doom</span><span ttm:role="x-translation" xml:lang="zh-Hans">张开的巨口正渴望着品尝噩运的滋味</span></p><p begin="2:52.429" end="2:54.999" itunes:key="L34" ttm:agent="v2"><span begin="2:52.429" end="2:53.796">Run</span> <span begin="2:53.796" end="2:54.248">and</span> <span begin="2:54.248" end="2:54.999">hide</span><span ttm:role="x-translation" xml:lang="zh-Hans">逃吧，躲吧</span></p><p begin="2:55.563" end="3:00.526" itunes:key="L35" ttm:agent="v2"><span begin="2:55.563" end="2:55.970">The</span> <span begin="2:55.970" end="2:56.483">kee</span><span begin="2:56.483" end="2:56.892">per</span> <span begin="2:56.892" end="2:57.802">of</span> <span begin="2:57.802" end="2:58.699">dark</span><span begin="2:58.699" end="2:59.596">ness</span> <span begin="2:59.596" end="3:00.526">wakes</span><span ttm:role="x-translation" xml:lang="zh-Hans">黑夜的守望者已经苏醒</span></p><p begin="3:00.922" end="3:02.103" itunes:key="L36" ttm:agent="v2"><span begin="3:00.922" end="3:01.358">The</span> <sp