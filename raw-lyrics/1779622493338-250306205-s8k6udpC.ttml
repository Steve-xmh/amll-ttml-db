<tt xmlns="http://www.w3.org/ns/ttml" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xmlns:amll="http://www.example.com/ns/amll" itunes:timing="Word" xml:lang="en"><head><metadata><ttm:agent type="person" xml:id="v1"/><amll:meta key="musicName" value="Vanish Into You (Apple Music Live)"/><amll:meta key="artists" value="Lady Gaga"/><amll:meta key="artists" value="レディー・ガガ"/><amll:meta key="album" value="Apple Music Live: MAYHEM Requiem"/><amll:meta key="isrc" value="USUM72603832"/><amll:meta key="appleMusicId" value="6768201786"/><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal"><songwriters><songwriter>Andrew Watt</songwriter><songwriter>Henry Russell Walter</songwriter><songwriter>Lady Gaga</songwriter><songwriter>Michael Polansky</songwriter></songwriters></iTunesMetadata></metadata></head><body dur="4:23.494"><div begin="10.780" end="46.672" itunes:songPart="Verse"><p begin="10.780" end="17.728" itunes:key="L1" ttm:agent="v1"><span begin="10.780" end="11.810">High</span> <span begin="11.810" end="12.060">on</span> <span begin="12.060" end="12.295">a</span> <span begin="12.295" end="13.060">hill,</span> <span begin="13.863" end="15.500">you</span> <span begin="15.500" end="17.728">called</span><span ttm:role="x-translation" xml:lang="zh-Hans">你在高山上呼唤</span></p><p begin="18.351" end="27.733" itunes:key="L2" ttm:agent="v1"><span begin="18.351" end="19.153">Two</span> <span begin="19.153" end="20.702">lovers</span> <span begin="20.800" end="22.308">regret</span> <span begin="23.124" end="24.022">their</span> <span begin="24.022" end="27.733">time</span><span ttm:role="x-translation" xml:lang="zh-Hans">两个恋人懊悔往昔</span></p><p begin="29.904" end="37.254" itunes:key="L3" ttm:agent="v1"><span begin="29.904" end="30.685">Once</span> <span begin="30.685" end="30.936">in</span> <span begin="30.936" end="31.219">a</span> <span begin="31.219" end="32.219">blue</span> <span begin="32.704" end="33.453">moon,</span> <span begin="33.453" end="35.304">I</span> <span begin="35.304" end="36.269">forget</span> <span begin="36.269" end="37.254">you</span><span ttm:role="x-translation" xml:lang="zh-Hans">我很少会将你忘记</span></p><p begin="37.387" end="46.672" itunes:key="L4" ttm:agent="v1"><span begin="37.387" end="38.305">And</span> <span begin="38.305" end="39.546">once</span> <span begin="39.835" end="40.102">in</span> <span begin="40.102" end="40.587">your</span> <span begin="40.587" end="41.654">life,</span> <span begin="41.835" end="42.118">you&apos;ll</span> <span begin="42.118" end="42.753">be</span> <span begin="42.753" end="46.672">mine</span><span ttm:role="x-translation" xml:lang="zh-Hans">在你生命中的某一刻 你终将属于我</span></p></div><div begin="48.170" end="1:03.232" itunes:songPart="PreChorus"><p begin="48.170" end="52.936" itunes:key="L5" ttm:agent="v1"><span begin="48.170" end="48.632">Do</span> <span begin="48.632" end="48.930">you</span> <span begin="48.930" end="49.314">see</span> <span begin="49.314" end="49.935">me?</span> <span begin="50.418" end="50.733">Oh,</span> <span begin="50.733" end="50.999">do</span> <span begin="50.999" end="51.266">you</span> <span begin="51.266" end="51.701">see</span> <span begin="51.701" end="52.218">me</span> <span begin="52.218" end="52.936">now?</span><span ttm:role="x-translation" xml:lang="zh-Hans">你看见我了吗 哦 你现在看见我了吗</span></p><p begin="53.106" end="57.808" itunes:key="L6" ttm:agent="v1"><span begin="53.106" end="53.338">I&apos;ve</span> <span begin="53.338" end="53.672">been</span> <span begin="53.672" end="54.591">waiting</span> <span begin="54.693" end="55.344">for</span> <span begin="55.344" end="55.842">you,</span> <span begin="55.842" end="57.026">cryin&apos;</span> <span begin="57.026" end="57.808">out</span><span ttm:role="x-translation" xml:lang="zh-Hans">我一直在等你 哭喊着</span></p><p begin="57.965" end="1:03.232" itunes:key="L7" ttm:agent="v1"><span begin="57.965" end="58.173">Do</span> <span begin="58.173" end="58.459">you</span> <span begin="58.459" end="58.725">see</span> <span begin="58.725" end="59.342">me?</span> <span begin="59.436" end="59.992">Do</span> <span begin="59.992" end="1:00.624">you</span> <span begin="1:00.624" end="1:01.125">see</span> <span begin="1:01.125" end="1:01.741">me</span> <span begin="1:01.741" end="1:03.232">now?</span><span ttm:role="x-translation" xml:lang="zh-Hans">你看见我了吗 你现在看见我了吗</span></p></div><div begin="1:04.692" end="1:24.882" itunes:songPart="Chorus"><p begin="1:04.692" end="1:09.746" itunes:key="L8" ttm:agent="v1"><span begin="1:04.692" end="1:05.022">I</span> <span begin="1:05.022" end="1:05.356">saw</span> <span begin="1:05.356" end="1:05.641">your</span> <span begin="1:05.641" end="1:05.990">face</span> <span begin="1:05.990" end="1:06.556">and</span> <span begin="1:06.556" end="1:09.746">mine</span><span ttm:role="x-translation" xml:lang="zh-Hans">我看到你我的面容</span></p><p begin="1:09.776" end="1:14.419" itunes:key="L9" ttm:agent="v1"><span begin="1:09.776" end="1:10.027">In</span> <span begin="1:10.027" end="1:10.328">a</span> <span begin="1:10.328" end="1:11.294">picture</span> <span begin="1:11.294" end="1:12.201">by</span> <span begin="1:12.544" end="1:13.011">our</span> <span begin="1:13.011" end="1:14.419">bedside</span><span ttm:role="x-translation" xml:lang="zh-Hans">在我们床边的照片里</span></p><p begin="1:14.514" end="1:19.165" itunes:key="L10" ttm:agent="v1"><span begin="1:14.514" end="1:14.805">It</span> <span begin="1:14.805" end="1:15.071">was</span> <span begin="1:15.071" end="1:15.455">cold</span> <span begin="1:15.455" end="1:16.021">in</span> <span begin="1:16.021" end="1:16.522">the,</span> <span begin="1:16.706" end="1:16.954">oh,</span> <span begin="1:16.954" end="1:17.221">in</span> <span begin="1:17.221" end="1:17.471">the</span> <span begin="1:17.471" end="1:19.165">summertime</span><span ttm:role="x-translation" xml:lang="zh-Hans">夏日里却感到寒意 哦 夏日里</span></p><p begin="1:19.277" end="1:24.882" itunes:key="L11" ttm:agent="v1"><span begin="1:19.277" end="1:19.515">We</span> <span begin="1:19.515" end="1:19.864">were</span> <span begin="1:19.864" end="1:20.696">happy,</span> <span begin="1:20.851" end="1:21.083">oh,</span> <span begin="1:21.083" end="1:21.781">just</span> <span begin="1:21.952" end="1:22.250">to</span> <span begin="1:22.250" end="1:22.779">be</span> <span begin="1:22.779" end="1:24.882">alive</span><span ttm:role="x-translation" xml:lang="zh-Hans">我们曾因生命而感到喜悦 哦 只是活着</span></p></div><div begin="1:24.935" end="1:40.855" itunes:songPart="PostChorus"><p begin="1:24.935" end="1:34.021" itunes:key="L12" ttm:agent="v1"><span begin="1:24.935" end="1:25.685">Can</span> <span begin="1:25.685" end="1:27.253">I-</span><span begin="1:27.253" end="1:27.586">I-</span><span begin="1:27.586" end="1:27.901">I-</span><span begin="1:27.901" end="1:29.040">I,</span> <span begin="1:30.160" end="1:30.645">oh,</span> <span begin="1:30.645" end="1:31.096">I</span> <span begin="1:31.096" end="1:31.811">vanish</span> <span begin="1:31.811" end="1:32.728">into</span> <span begin="1:32.728" end="1:34.021">you?</span><span ttm:role="x-translation" xml:lang="zh-Hans">我 我 我 我 哦 我能否悄然融入你心底</span></p><p begin="1:34.388" end="1:40.855" itunes:key="L13" ttm:agent="v1"><span begin="1:34.388" end="1:35.012">Can</span> <span begin="1:35.012" end="1:35.983">I-</span><span begin="1:35.983" end="1:36.266">I-</span><span begin="1:36.266" end="1:36.599">I-</span><span begin="1:36.599" end="1:37.098">I-</span><span begin="1:37.098" end="1:37.514">I-</span><span begin="1:37.514" end="1:37.994">I</span> <span begin="1:38.242" end="1:38.842">vanish</span> <span begin="1:38.842" end="1:39.842">into</span> <span begin="1:39.842" end="1:40.855">you?</span><span ttm:role="x-translation" xml:lang="zh-Hans">我 我 我 我 我 我能否悄然融入你心底</span></p></div><div begin="1:45.927" end="2:02.626" itunes:songPart="Verse"><p begin="1:45.927" end="1:50.676" itunes:key="L14" ttm:agent="v1"><span begin="1:45.927" en