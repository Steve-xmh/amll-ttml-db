<tt xmlns="http://www.w3.org/ns/ttml" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xmlns:amll="http://www.example.com/ns/amll"><head><metadata><ttm:agent type="person" xml:id="v1"/><ttm:agent type="person" xml:id="v2"/><amll:meta key="musicName" value="フタリボシ"/><amll:meta key="artists" value="そらる"/><amll:meta key="artists" value="ろん"/><amll:meta key="album" value="空中さんぽ"/><amll:meta key="ncmMusicId" value="26112208"/><amll:meta key="ttmlAuthorGithubLogin" value="Mrs4s"/></metadata></head><body dur="4:47.080"><div begin="33.530" end="4:47.080"><p begin="33.530" end="37.450" itunes:key="L1" ttm:agent="v1"><span begin="33.530" end="34.013">満</span><span begin="34.013" end="34.490">天</span><span begin="34.490" end="34.803">の</span><span begin="34.803" end="35.303">星</span><span begin="35.303" end="35.600">た</span><span begin="35.600" end="35.783">ち</span><span begin="35.783" end="36.053">が</span><span begin="36.053" end="36.590">僕</span><span begin="36.590" end="37.450">を</span><span ttm:role="x-translation" xml:lang="zh-Hans">满天星斗</span><span ttm:role="x-roman">manten no hoshi tachi ga boku o</span></p><p begin="37.580" end="42.263" itunes:key="L2" ttm:agent="v1"><span begin="37.580" end="37.920">ま</span><span begin="37.920" end="38.083">る</span><span begin="38.083" end="38.453">で</span><span begin="38.453" end="39.373">祝</span><span begin="39.373" end="39.780">福</span><span begin="39.780" end="40.123">す</span><span begin="40.123" end="40.663">る</span><span begin="40.663" end="40.893">み</span><span begin="40.893" end="41.150">た</span><span begin="41.150" end="41.450">い</span><span begin="41.450" end="42.263">に</span><span ttm:role="x-translation" xml:lang="zh-Hans">仿佛在为我祝福</span><span ttm:role="x-roman">marude shukufuku suru mitai ni</span></p><p begin="42.653" end="47.013" itunes:key="L3" ttm:agent="v1"><span begin="42.653" end="43.933">瞬</span><span begin="43.933" end="44.413">い</span><span begin="44.413" end="44.973">て</span><span begin="44.973" end="45.453">い</span><span begin="45.453" end="45.723">る</span><span begin="45.723" end="47.013">よ</span><span ttm:role="x-translation" xml:lang="zh-Hans">熠熠闪烁着</span><span ttm:role="x-roman">shibatatai te iru yo</span></p><p begin="49.793" end="53.360" itunes:key="L4" ttm:agent="v2"><span begin="49.793" end="50.303">満</span><span begin="50.303" end="50.803">点</span><span begin="50.803" end="51.083">の</span><span begin="51.083" end="52.093">答</span><span begin="52.093" end="52.353">え</span><span begin="52.353" end="52.613">な</span><span begin="52.613" end="52.853">ん</span><span begin="52.853" end="53.360">て</span><span ttm:role="x-translation" xml:lang="zh-Hans">所谓满分的答案</span><span ttm:role="x-roman">manten no kotae nante</span></p><p begin="53.883" end="58.383" itunes:key="L5" ttm:agent="v2"><span begin="53.883" end="54.360">きっ</span><span begin="54.360" end="54.873">と</span><span begin="54.873" end="55.133">見</span><span begin="55.133" end="55.623">つ</span><span begin="55.623" end="55.913">け</span><span begin="55.913" end="56.153">ら</span><span begin="56.153" end="56.393">れ</span><span begin="56.393" end="56.680">な</span><span begin="56.680" end="56.903">い</span><span begin="56.903" end="57.190">け</span><span begin="57.190" end="57.683">れ</span><span begin="57.683" end="58.383">ど</span><span ttm:role="x-translation" xml:lang="zh-Hans">虽然注定找不到</span><span ttm:role="x-roman">kitto mitsuke rare nai keredo</span></p><p begin="58.833" end="1:03.560" itunes:key="L6" ttm:agent="v2"><span begin="58.833" end="59.463">そ</span><span begin="59.463" end="59.943">れ</span><span begin="59.943" end="1:00.250">で</span><span begin="1:00.250" end="1:00.733">いいっ</span><span begin="1:00.733" end="1:01.243">て</span><span begin="1:01.243" end="1:01.920">思</span><span begin="1:01.920" end="1:02.243">え</span><span begin="1:02.243" end="1:03.560">る</span><span ttm:role="x-translation" xml:lang="zh-Hans">我却觉得那样就好</span><span ttm:role="x-roman">sore de ii tte omoeru</span></p><p begin="1:04.283" end="1:09.990" itunes:key="L7" ttm:agent="v2"><span begin="1:04.283" end="1:04.603">あ</span><span begin="1:04.603" end="1:04.813">の</span><span begin="1:04.813" end="1:05.000">場</span><span begin="1:05.000" end="1:05.303">所</span><span begin="1:05.303" end="1:05.573">で</span><span begin="1:05.573" end="1:06.080">見</span><span begin="1:06.080" end="1:06.323">上</span><span begin="1:06.323" end="1:06.823">げ</span><span begin="1:06.823" end="1:07.270">た</span><span begin="1:07.270" end="1:07.853">夜</span><span begin="1:07.853" end="1:09.990">空</span><span ttm:role="x-translation" xml:lang="zh-Hans">在那个地方仰望过的夜空</span><span ttm:role="x-roman">ano basho de miage ta yozora</span></p><p begin="1:08.343" end="1:12.680" itunes:key="L8" ttm:agent="v1"><span begin="1:08.343" end="1:08.850">僕</span><span begin="1:08.850" end="1:09.113">ら</span><span begin="1:09.113" end="1:09.340">が</span><span begin="1:09.340" end="1:10.120">誓</span><span begin="1:10.120" end="1:10.423">い</span><span begin="1:10.423" end="1:10.913">合っ</span><span begin="1:10.913" end="1:11.393">た</span><span begin="1:11.393" end="1:12.163">言</span><span begin="1:12.163" end="1:12.680">葉</span><span ttm:role="x-translation" xml:lang="zh-Hans">我们彼此许下誓言的话语</span><span ttm:role="x-roman">boku ra ga chikaia~tsu ta kotoba</span></p><p begin="1:12.880" end="1:15.550" itunes:key="L9" ttm:agent="v2"><span begin="1:12.880" end="1:13.403">君</span><span begin="1:13.403" end="1:13.693">が</span><span begin="1:13.693" end="1:14.480">笑</span><span begin="1:14.480" end="1:15.550">う</span><span ttm:role="x-translation" xml:lang="zh-Hans">你笑着</span><span ttm:role="x-roman">kimi ga warau</span></p><p begin="1:14.910" end="1:16.820" itunes:key="L10" ttm:agent="v1"><span begin="1:14.910" end="1:15.270">僕</span><span begin="1:15.270" end="1:15.713">も</span><span begin="1:15.713" end="1:16.470">笑</span><span begin="1:16.470" end="1:16.820">う</span><span ttm:role="x-translation" xml:lang="zh-Hans">我也笑着</span><span ttm:role="x-roman">boku mo warau</span></p><p begin="1:16.880" end="1:21.070" itunes:key="L11" ttm:agent="v1"><span begin="1:16.880" end="1:17.253">そ</span><span begin="1:17.253" end="1:17.473">れ</span><span begin="1:17.473" end="1:17.733">だ</span><span begin="1:17.733" end="1:18.253">け</span><span begin="1:18.253" end="1:18.450">で</span><span begin="1:18.450" end="1:19.370">幸</span><span begin="1:19.370" end="1:21.070">せ</span><span ttm:role="x-translation" xml:lang="zh-Hans">仅此便已幸福</span><span ttm:role="x-roman">sore dake de shiawase</span></p><p begin="1:22.828" end="1:26.573" itunes:key="L12" ttm:agent="v1"><span begin="1:22.828" end="1:23.353">眠</span><span begin="1:23.353" end="1:23.603">れ</span><span begin="1:23.603" end="1:23.900">ぬ</span><span begin="1:23.900" end="1:24.343">夜</span><span begin="1:24.343" end="1:24.613">に</span><span begin="1:24.613" end="1:25.003">恋</span><span begin="1:25.003" end="1:25.410">を</span><span begin="1:25.410" end="1:25.613">し</span><span begin="1:25.613" end="1:26.573">て</span><span ttm:role="x-translation" xml:lang="zh-Hans">恋上无眠的夜</span><span ttm:role="x-roman">nemure nu yoru ni koi o shi te</span></p><p begin="1:26.873" end="1:30.473" itunes:key="L13" ttm:agent="v1"><span begin="1:26.873" end="1:27.280">今</span><span begin="1:27.280" end="1:27.663">す</span><span begin="1:27.663" end="1:27.923">ぐ</span><span begin="1:27.923" end="1:28.340">君</span><span begin="1:28.340" end="1:28.703">に</span><span begin="1:28.703" end="1:28.970">会</span><span begin="1:28.970" end="1:29.203">い</span><span begin="1:29.203" end="1:29.460">に</span><span begin="1:29.460" end="1:29.693">行</span><span begin="1:29.693" end="1:29.950">こ</span><span begin="1:29.950" end="1:30.473">う</span><span ttm:role="x-translation" xml:lang="zh-Hans">此刻就去见你吧</span><span ttm:role="x-roman">ima sugu kimi ni ai ni ikou</span></p><p begin="1:30.723" end="1:35.770" itunes:key="L14" ttm:agent="v2"><span begin="1:30.723" end="1:31.360">指</span><span begin="1:31.360" end="1:32.253">先</span><span begin="1:32.253" end="1:32.710">で</span><span begin="1:32.710" end="1:33.263">繋</span><span begin="1:33.263" end="1:33.773">ぐ</span><span begin="1:33.773" end="1:34.793">星</span><span begin="1:34.793" end="1:35.770">屑</span><span ttm:role="x-translation" xml:lang="zh-Hans">以指尖连缀的星屑</span><span ttm:role="x-roman">yubisaki de tsunagu hoshikuzu</span></p><p begin="1:35.770" end="1:38.620" itunes:key="L15" ttm:agent="v2"><span begin="1:35.770" end="1:36.550">描</span><span begin="1:36.550" end="1:36.823">き</span><span begin="1:36.823" end="1:37.170">出</span><span begin="1:37.170" end="1:37.540">す</span><span begin="1:37.540" end="1:38.620">夢</span><span ttm:role="x-translation" xml:lang="zh-Hans">描绘出的梦</span><span ttm:role="x-roman">egakidasu yume</span></p><p begin="1:39.043" end="1:42.690" itunes:key="L16" ttm:agent="v1"><span begin="1:39.043" end="1:39.833">形</span><span begin="1:39.833" end="1:40.123">の</span><span begin="1:40.123" end="1:40.550">ない</span><span begin="1:40.550" end="1:41.643">光</span><span begin="1:41.643" end="1:41.913">で</span><span begin="1:41.913" end="1:42.690">も</span><span ttm:role="x-translation" xml:lang="zh-Hans">纵然是无形的光芒</span><span ttm:role="x-roman">katachi no nai hikari de mo</span></p><p begin="1:43.113" end="1:46.890" itunes:key="L17" ttm:agent="v1"><span begin="1:43.113" end="1:43.693">君</span><span begin="1:43.693" end="1:43.933">を</span><span begin="1:43.933" end="1:44.293">想</span><span begin="1:44.293" end="1:44.650">う</span><span begin="1:44.650" end="1:44.953">ほ</span><span begin="1:44.953" end="1:45.463">ど</span><span begin="1:45.463" end="1:45.670">に</span><span begin="1:45.670" end="1:46.223">強</span><span begin="1:46.223" end="1:46.890">く</span><span ttm:role="x-translation" xml:lang="zh-Hans">也因思念你而愈发强烈</span><span ttm:role="x-roman">kimi o omou hodo ni tsuyoku</span></p><p begin="1:46.960" end="1:52.033" itunes:key="L18" ttm:agent="v1"><span begin="1:46.960" end="1:47.233">見</span><span begin="1:47.233" end="1:47.753">上</span><span begin="1:47.753" end="1:48.080">げ</span><span begin="1:48.080" end="1:48.523">れ</span><span begin="1:48.523" end="1:49.033">ば</span><span begin="1:49.033" end="1:49.270">あ</span><span begin="1:49.270" end="1:49.490">の</span><span begin="1:49.490" end="1:50.043">日</span><span begin="1:50.043" end="1:50.700">見</span><span begin="1:50.700" end="1:51.053">つ</span><span begin="1:51.053" end="1:51.563">け</span><span begin="1:51.563" end="1:52.033">た</span><span ttm:role="x-translation" xml:lang="zh-Hans">抬头仰望 便能看见那天寻见的</span><span ttm:role="x-roman">miagere ba ano hi mitsuke ta</span></p><p begin="1:52.033" end="1:59.260" itunes:key="L19" ttm:agent="v1"><span begin="1:52.033" end="1:52.593">二</span><span begin="1:52.593" end="1:52.823">人</span><span begin="1:52.823" end="1:55.093">星</span> <span begin="1:55.093" end="1:56.110">輝</span><span begin="1:56.110" end="1:59.260">く</span><span ttm:role="x-translation" xml:lang="zh-Hans">双星 正熠熠生辉</span><span ttm:role="x-roman">futari hoshi kagayaku</span></p><p begin="2:05.023" end="2:08.610" itunes:key="L20" ttm:agent="v1"><span begin="2:05.023" end="2:05.593">何</span><span begin="2:05.593" end="2:06.063">回</span><span begin="2:06.063" end="2:06.333">も</span><span begin="2:06.333" end="2:06.760">何</span><span begin="2:06.760" end="2:07.290">千</span><span begin="2:07.290" end="2:07.823">回</span><span begin="2:07.823" end="2:08.180">で</span><span begin="2:08.180" end="2:08.610">も</span><span ttm:role="x-translation" xml:lang="zh-Hans">无论多少次 哪怕数千回</span><span ttm:role="x-roman">nan kai mo nanzen kai de mo</span></p><p begin="2:09.093" end="2:13.670" itunes:key="L21" ttm:agent="v1"><span begin="2:09.093" end="2:09.613">きっ</span><span begin="2:09.613" end="2:10.080">と</span><span begin="2:10.080" end="2:10.883">言</span><span begin="2:10.883" end="2:11.153">葉</span><span begin="2:11.153" end="2:11.363">に</span><span begin="2:11.363" end="2:11.603">で</span><span begin="2:11.603" end="2:12.163">き</span><span begin="2:12.163" end="2:12.393">な</span><span begin="2:12.393" end="2:12.923">く</span><span begin="2:12.923" end="2:13.670">て</span><span ttm:role="x-translation" xml:lang="zh-Hans">终究无法化作言语</span><span ttm:role="x-roman">kitto kotoba ni deki naku te</span></p><p begin="2:14.213" end="2:18.400" itunes:key="L22" ttm:agent="v1"><span begin="2:14.213" end="2:14.753">飲</span><span begin="2:14.753" end="2:15.203">み</span><span begin="2:15.203" end="2:15.620">込</span><span begin="2:15.620" end="2:15.953">ん</span><span begin="2:15.953" end="2:16.270">で</span><span begin="2:16.270" end="2:17.003">し</span><span begin="2:17.003" end="2:17.253">ま</span><span begin="2:17.253" end="2:18.400">う</span><span ttm:role="x-translation" xml:lang="zh-Hans">只能默默咽回心底</span><span ttm:role="x-roman">nomikon de shimau</span></p><p begin="2:21.273" end="2:25.063" itunes:key="L23" ttm:agent="v2"><span begin="2:21.273" end="2:21.833">何</span><span begin="2:21.833" end="2:22.290">回</span><span begin="2:22.290" end="2:22.583">も</span><span begin="2:22.583" end="2:23.103">何</span><span begin="2:23.103" end="2:23.623">万</span><span begin="2:23.623" end="2:24.103">回</span><span begin="2:24.103" end="2:24.373">で</span><span begin="2:24.373" end="2:25.063">も</span><span ttm:role="x-translation" xml:lang="zh-Hans">无论多少次 哪怕数万回</span><span ttm:role="x-roman">nan kai mo nan man kai de mo</span></p><p begin="2:25.260" end="2:30.060" itunes:key="L24" ttm:agent="v2"><span begin="2:25.260" end="2:25.903">そっ</span><span begin="2:25.903" end="2:26.393">と</span><span begin="2:26.393" end="2:27.193">君</span><span begin="2:27.193" end="2:27.523">を</span><span begin="2:27.523" end="2:27.880">想</span><span begin="2:27.880" end="2:28.193">う</span><span begin="2:28.193" end="2:28.433">コ</span><span begin="2:28.433" end="2:28.703">コ</span><span begin="2:28.703" end="2:29.243">ロ</span><span begin="2:29.243" end="2:30.060">は</span><span ttm:role="x-translation" xml:lang="zh-Hans">这颗悄然思念你的心</span><span ttm:role="x-roman">sotto kimi o omou kokoro wa</span></p><p begin="2:30.433" end="2:35.350" itunes:key="L25" ttm:agent="v2"><span begin="2:30.433" end="2:31.463">伝</span><span begin="2:31.463" end="2:31.753">え</span><span begin="2:31.753" end="2:32.213">き</span><span begin="2:32.213" end="2:32.783">れ</span><span begin="2:32.783" end="2:33.060">な</span><span begin="2:33.060" end="2:33.410">い</span><span begin="2:33.410" end="2:33.763">ん</span><span begin="2:33.763" end="2:35.350">だ</span><span ttm:role="x-translation" xml:lang="zh-Hans">却总是传达不尽</span><span ttm:role="x-roman">tsutae kire nai n da</span></p><p begin="2:35.803" end="2:40.890" itunes:key="L26" ttm:agent="v2"><span begin="2:35.803" end="2:36.063">あ</span><span begin="2:36.063" end="2:36.310">の</span><span begin="2:36.310" end="2:36.823">星</span><span begin="2:36.823" end="2:37.063">が</span><span begin="2:37.063" end="2:37.843">君</span><span begin="2:37.843" end="2:38.363">だ</span><span begin="2:38.363" end="2:38.730">と</span><span begin="2:38.730" end="2:39.383">し</span><span begin="2:39.383" end="2:39.593">た</span><span begin="2:39.593" end="2:40.890">ら</span><span ttm:role="x-translation" xml:lang="zh-Hans">如果那颗星是你</span><span ttm:role="x-roman">ano hoshi ga kimi da to shi tara</span></p><p begin="2:39.893" end="2:44.330" itunes:key="L27" ttm:agent="v1"><span begin="2:39.893" end="2:40.290">僕</span><span begin="2:40.290" end="2:40.550">は</span><span begin="2:40.550" end="2:40.923">そ</span><span begin="2:40.923" end="2:41.153">の</span><span begin="2:41.153" end="2:42.423">隣</span><span begin="2:42.423" end="2:42.923">の</span><span begin="2:42.923" end="2:43.693">星</span><span begin="2:43.693" end="2:44.330">だ</span><span ttm:role="x-translation" xml:lang="zh-Hans">我便是它身旁的那颗星</span><span ttm:role="x-roman">boku wa sono tonari no hoshi da</span></p><p begin="2:44.420" end="2:47.690" itunes:key="L28" ttm:agent="v2"><span begin="2:44.420" end="2:44.963">君</span><span begin="2:44.963" end="2:45.253">の</span><span begin="2:45.253" end="2:45.723">名</span><span begin="2:45.723" end="2:47.690">前</span><span ttm:role="x-translation" xml:lang="zh-Hans">你的名字</span><span ttm:role="x-roman">kimi no namae</span></p><p begin="2:46.493" end="2:48.390" itunes:key="L29" ttm:agent="v1"><span begin="2:46.493" end="2:47.000">僕</span><span begin="2:47.000" end="2:47.380">の</span><span begin="2:47.380" end="2:47.753">名</span><span begin="2:47.753" end="2:48.390">前</span><span ttm:role="x-translation" xml:lang="zh-Hans">我的名字</span><span ttm:role="x-roman">boku no namae</span></p><p begin="2:48.503" end="2:52.530" itunes:key="L30" ttm:agent="v1"><span begin="2:48.503" end="2:48.773">あ</span><span begin="2:48.773" end="2:49.070">の</span><span begin="2:49.070" end="2:49.743">星</span><span begin="2:49.743" end="2:50.003">に</span><span begin="2:50.003" end="2:50.553">重</span><span begin="2:50.553" end="2:51.003">ね</span><span begin="2:51.003" end="2:52.530">て</span><span ttm:role="x-translation" xml:lang="zh-Hans">叠映在那颗星上</span><span ttm:role="x-roman">ano hoshi ni kasane te</span></p><p begin="2:54.363" end="2:58.340" itunes:key="L31" ttm:agent="v1"><span begin="2:54.363" end="2:54.893">眠</span><span begin="2:54.893" end="2:55.133">れ</span><span begin="2:55.133" end="2:55.450">ぬ</span><span begin="2:55.450" end="2:55.940">夜</span><span begin="2:55.940" end="2:56.200">は</span><span begin="2:56.200" end="2:56.440">い</span><span begin="2:56.440" end="2:56.653">つ</span><span begin="2:56.653" end="2:57.133">だっ</span><span begin="2:57.133" end="2:58.340">て</span><span ttm:role="x-translation" xml:lang="zh-Hans">无眠的夜晚 无论何时</span><span ttm:role="x-roman">nemure nu yoru wa itsu da tte</span></p><p begin="2:58.423" end="3:01.990" itunes:key="L32" ttm:agent="v1"><span begin="2:58.423" end="2:58.860">誰</span><span begin="2:58.860" end="2:59.183">よ</span><span begin="2:59.183" end="2:59.453">り</span><span begin="2:59.453" end="2:59.920">君</span><span begin="2:59.920" end="3:00.213">に</span><span begin="3:00.213" end="3:00.500">会</span><span begin="3:00.500" end="3:00.713">い</span><span begin="3:00.713" end="3:01.000">た</span><span begin="3:01.000" end="3:01.223">く</span><span begin="3:01.223" end="3:01.990">て</span><span ttm:role="x-translation" xml:lang="zh-Hans">我都比任何人更想见你</span><span ttm:role="x-roman">dare yori kimi ni ai taku te</span></p><p begin="3:02.243" end="3:09.790" itunes:key="L33" ttm:agent="v1"><span begin="3:02.243" end="3:02.600">「も</span><span begin="3:02.600" end="3:02.850">う</span><span begin="3:02.850" end="3:03.623">少</span><span begin="3:03.623" end="3:04.120">し、</span><span begin="3:04.120" end="3:04.400">も</span><span begin="3:04.400" end="3:04.670">う</span><span begin="3:04.670" end="3:05.920">少</span><span begin="3:05.920" end="3:06.343">し</span><span begin="3:06.343" end="3:06.813">だ</span><span begin="3:06.813" end="3:07.260">け</span><span begin="3:07.260" end="3:08.173">傍</span><span begin="3:08.173" end="3:08.450">に</span><span begin="3:08.450" end="3:08.770">い</span><span begin="3:08.770" end="3:09.040">さ</span><span begin="3:09.040" end="3:09.363">せ</span><span begin="3:09.363" end="3:09.790">て」</span><span ttm:role="x-translation" xml:lang="zh-Hans">「再一会儿，只要再一会儿，让我留在你身边」</span><span ttm:role="x-roman">「mou sukoshi、mou sukoshi dake soba ni i sase te」</span></p><p begin="3:10.593" end="3:14.190" itunes:key="L34" ttm:agent="v1"><span begin="3:10.593" end="3:11.133">君</span><span begin="3:11.133" end="3:11.373">が</span><span begin="3:11.373" end="3:11.950">零</span><span begin="3:11.950" end="3:12.123">し</span><span begin="3:12.123" end="3:12.413">た</span><span begin="3:12.413" end="3:13.320">涙</span><span begin="3:13.320" end="3:14.190">も</span><span ttm:role="x-translation" xml:lang="zh-Hans">连你洒落的泪水</span><span ttm:role="x-roman">kimi ga koboshi ta namida mo</span></p><p begin="3:14.683" end="3:18.150" itunes:key="L35" ttm:agent="v1"><span begin="3:14.683" end="3:14.890">夜</span><span begin="3:14.890" end="3:15.463">空</span><span begin="3:15.463" end="3:15.713">の</span><span begin="3:15.713" end="3:16.223">星</span><span begin="3:16.223" end="3:16.473">に</span><span begin="3:16.473" end="3:16.700">変</span><span begin="3:16.700" end="3:16.973">え</span><span begin="3:16.973" end="3:17.170">て</span><span begin="3:17.170" end="3:17.380">み</span><span begin="3:17.380" end="3:17.720">せ</span><span begin="3:17.720" end="3:18.150">る</span><span ttm:role="x-translation" xml:lang="zh-Hans">我也要让它们化作夜空的星辰</span><span ttm:role="x-roman">yozora no hoshi ni kae te miseru</span></p><p begin="3:18.483" end="3:23.603" itunes:key="L36" ttm:agent="v2"><span begin="3:18.483" end="3:18.773">泣</span><span begin="3:18.773" end="3:19.273">き</span><span begin="3:19.273" end="3:20.063">虫</span><span begin="3:20.063" end="3:20.523">な</span><span begin="3:20.523" end="3:21.053">君</span><span begin="3:21.053" end="3:21.573">の</span><span begin="3:21.573" end="3:22.583">横</span><span begin="3:22.583" end="3:23.603">顔</span><span ttm:role="x-translation" xml:lang="zh-Hans">爱哭的你那侧脸</span><span ttm:role="x-roman">nakimushi na kimi no yokogao</span></p><p begin="3:23.603" end="3:31.950" itunes:key="L37" ttm:agent="v1"><span begin="3:23.603" end="3:23.843">流</span><span begin="3:23.843" end="3:24.343">れ</span><span begin="3:24.343" end="3:25.850">星</span> <span begin="3:26.563" end="3:27.153">流</span><span begin="3:27.153" end="3:27.673">れ</span><span begin="3:27.673" end="3:31.950">る</span><span ttm:role="x-translation" xml:lang="zh-Hans">流星 正划过天际</span><span ttm:role="x-roman">nagareboshi nagareru</span></p><p begin="4:01.493" end="4:05.120" itunes:key="L38" ttm:agent="v1"><span begin="4:01.493" end="4:02.003">眠</span><span begin="4:02.003" end="4:02.243">れ</span><span begin="4:02.243" end="4:02.503">ぬ</span><span begin="4:02.503" end="4:03.020">夜</span><span begin="4:03.020" end="4:03.210">を</span><span begin="4:03.210" end="4:03.463">抜</span><span begin="4:03.463" end="4:03.733">け</span><span begin="4:03.733" end="4:03.990">出</span><span begin="4:03.990" end="4:04.243">し</span><span begin="4:04.243" end="4:05.120">て</span><span ttm:role="x-translation" xml:lang="zh-Hans">逃离无眠的夜</span><span ttm:role="x-roman">nemure nu yoru o nukedashi te</span></p><p begin="4:05.520" end="4:09.210" itunes:key="L39" ttm:agent="v1"><span begin="4:05.520" end="4:05.950">今</span><span begin="4:05.950" end="4:06.313">す</span><span begin="4:06.313" end="4:06.543">ぐ</span><span begin="4:06.543" end="4:07.063">君</span><span begin="4:07.063" end="4:07.323">に</span><span begin="4:07.323" end="4:07.650">会</span><span begin="4:07.650" end="4:07.840">い</span><span begin="4:07.840" end="4:08.110">に</span><span begin="4:08.110" end="4:08.343">行</span><span begin="4:08.343" end="4:08.690">こ</span><span begin="4:08.690" end="4:09.210">う</span><span ttm:role="x-translation" xml:lang="zh-Hans">此刻就去见你吧</span><span ttm:role="x-roman">ima sugu kimi ni ai ni ikou</span></p><p begin="4:09.363" end="4:17.200" itunes:key="L40" ttm:agent="v2"><span begin="4:09.363" end="4:10.123">暗</span><span begin="4:10.123" end="4:10.383">が</span><span begin="4:10.383" end="4:10.883">り</span><span begin="4:10.883" end="4:11.413">で</span><span begin="4:11.413" end="4:11.893">震</span><span begin="4:11.893" end="4:12.423">え</span><span begin="4:12.423" end="4:13.050">る</span><span begin="4:13.050" end="4:13.853">空</span><span begin="4:13.853" end="4:14.380">を</span><span begin="4:14.380" end="4:14.800">追</span><span begin="4:14.800" end="4:15.213">い</span><span begin="4:15.213" end="4:15.410">越</span><span begin="4:15.410" end="4:15.973">し</span><span begin="4:15.973" end="4:16.263">な</span><span begin="4:16.263" end="4:16.493">が</span><span begin="4:16.493" end="4:17.200">ら</span><span ttm:role="x-translation" xml:lang="zh-Hans">越过暗影中颤抖的夜空</span><span ttm:role="x-roman">kuragari de furueru sora o oikoshi nagara</span></p><p begin="4:17.743" end="4:21.300" itunes:key="L41" ttm:agent="v1"><span begin="4:17.743" end="4:18.503">形</span><span begin="4:18.503" end="4:18.763">の</span><span begin="4:18.763" end="4:18.940">な</span><span begin="4:18.940" end="4:19.200">い</span><span begin="4:19.200" end="4:20.293">光</span><span begin="4:20.293" end="4:20.533">で</span><span begin="4:20.533" end="4:21.300">も</span><span ttm:role="x-translation" xml:lang="zh-Hans">纵然是无形的光芒</span><span ttm:role="x-roman">katachi no nai hikari de mo</span></p><p begin="4:21.753" end="4:25.430" itunes:key="L42" ttm:agent="v1"><span begin="4:21.753" end="4:22.320">君</span><span begin="4:22.320" end="4:22.583">を</span><span begin="4:22.583" end="4:22.940">想</span><span begin="4:22.940" end="4:23.220">う</span><span begin="4:23.220" end="4:23.593">ほ</span><span begin="4:23.593" end="4:24.113">ど</span><span begin="4:24.113" end="4:24.320">に</span><span begin="4:24.320" end="4:24.903">強</span><span begin="4:24.903" end="4:25.430">く</span><span ttm:role="x-translation" xml:lang="zh-Hans">也因思念你而愈发强烈</span><span ttm:role="x-roman">kimi o omou hodo ni tsuyoku</span></p><p begin="4:25.680" end="4:30.723" itunes:key="L43" ttm:agent="v1"><span begin="4:25.680" end="4:25.933">見</span><span begin="4:25.933" end="4:26.383">上</span><span begin="4:26.383" end="4:26.653">げ</span><span begin="4:26.653" end="4:27.220">れ</span><span begin="4:27.220" end="4:27.703">ば</span><span begin="4:27.703" end="4:27.973">あ</span><span begin="4:27.973" end="4:28.120">の</span><span begin="4:28.120" end="4:28.710">日</span><span begin="4:28.710" end="4:29.340">見</span><span begin="4:29.340" end="4:29.713">つ</span><span begin="4:29.713" end="4:30.203">け</span><span begin="4:30.203" end="4:30.723">た</span><span ttm:role="x-translation" xml:lang="zh-Hans">抬头仰望 便能看见那天寻见的</span><span ttm:role="x-roman">miagere ba ano hi mitsuke ta</span></p><p begin="4:30.723" end="4:38.200" itunes:key="L44" ttm:agent="v1"><span begin="4:30.723" end="4:31.243">二</span><span begin="4:31.243" end="4:31.473">人</span><span begin="4:31.473" end="4:33.010">星</span> <span begin="4:33.753" end="4:34.773">輝</span><span begin="4:34.773" end="4:38.200">く</span><span ttm:role="x-translation" xml:lang="zh-Hans">双星 正熠熠生辉</span><span ttm:role="x-roman">futari hoshi kagayaku</span></p><p begin="4:38.843" end="4:47.080" itunes:key="L45" ttm:agent="v1"><span begin="4:38.843" end="4:39.080">い</span><span begin="4:39.080" end="4:39.373">つ</span><span begin="4:39.373" end="4:39.613">ま</span><span begin="4:39.613" end="4:39.863">で</span><span begin="4:39.863" end="4:41.640">も</span> <span begin="4:41.893" end="4:42.513">二</span><span begin="4:42.513" end="4:42.893">人</span><span begin="4:42.893" end="4:47.080">で</span><span ttm:role="x-translation" xml:lang="zh-Hans">永远 两人相伴</span><span ttm:role="x-roman">itsu made mo futari de</span></p></div></body></tt>