<tt xmlns="http://www.w3.org/ns/ttml" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xmlns:amll="http://www.example.com/ns/amll"><head><metadata><ttm:agent type="person" xml:id="v1"/><ttm:agent type="person" xml:id="v2"/><amll:meta key="musicName" value="Blackwater"/><amll:meta key="artists" value="RIOT"/><amll:meta key="album" value="Dogma Resistance"/><amll:meta key="album" value="Blackwater - Single"/><amll:meta key="album" value="Blackwater"/><amll:meta key="isrc" value="CA-6D2-19-00351"/><amll:meta key="ncmMusicId" value="1401182405"/><amll:meta key="qqMusicId" value="002529Xt1jnWxl"/><amll:meta key="spotifyId" value="4lE6N1E0L8CssgKEUCgdbA"/><amll:meta key="appleMusicId" value="1483853741"/><amll:meta key="ttmlAuthorGithub" value="142661449"/><amll:meta key="ttmlAuthorGithubLogin" value="fywmjj"/><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal"><songwriters><songwriter>Daniel Magid</songwriter><songwriter>Tom Davidson</songwriter></songwriters></iTunesMetadata></metadata></head><body dur="4:16.002"><div begin="1.280" end="4:16.002"><p begin="1.280" end="3.959" itunes:key="L1" ttm:agent="v1"><span begin="1.280" end="1.399">In</span> <span begin="1.399" end="1.510">a</span> <span begin="1.510" end="2.060">time</span> <span begin="2.060" end="2.427">when</span> <span begin="2.427" end="2.982">lawmen</span> <span begin="2.982" end="3.087">were</span> <span begin="3.087" end="3.959">outlaws</span><span ttm:role="x-translation" xml:lang="zh-Hans">在那个执法者沦为法外之徒的时代</span></p><p begin="4.684" end="7.584" itunes:key="L2" ttm:agent="v1"><span begin="4.684" end="4.836">A</span> <span begin="4.836" end="5.305">thief,</span> <span begin="5.471" end="5.723">a</span> <span begin="5.723" end="6.150">cutthroat,</span> <span begin="6.602" end="6.700">and</span> <span begin="6.700" end="6.884">a</span> <span begin="6.884" end="7.275">bounty</span> <span begin="7.275" end="7.584">hunter</span><span ttm:role="x-translation" xml:lang="zh-Hans">盗贼、杀手与赏金猎人</span></p><p begin="7.755" end="9.263" itunes:key="L3" ttm:agent="v1"><span begin="7.755" end="7.964">Face</span> <span begin="7.964" end="8.117">an</span> <span begin="8.117" end="8.378">enemy</span> <span begin="8.378" end="8.527">of</span> <span begin="8.527" end="8.628">a</span> <span begin="8.628" end="8.837">new</span> <span begin="8.837" end="9.263">kind</span><span ttm:role="x-translation" xml:lang="zh-Hans">共同面对前所未有的强敌</span></p><p begin="10.890" end="12.867" itunes:key="L4" ttm:agent="v1"><span begin="10.890" end="10.983">Through</span> <span begin="10.983" end="11.169">the</span> <span begin="11.169" end="11.775">uncharted</span> <span begin="11.775" end="12.118">lands</span> <span begin="12.118" end="12.240">of</span> <span begin="12.240" end="12.392">the</span> <span begin="12.392" end="12.867">West</span><span ttm:role="x-translation" xml:lang="zh-Hans">穿越西部那片未被开拓的蛮荒之地</span></p><p begin="13.153" end="16.439" itunes:key="L5" ttm:agent="v1"><span begin="13.153" end="13.269">A</span> <span begin="13.269" end="13.463">fist</span><span begin="13.463" end="13.702">ful</span> <span begin="13.702" end="13.889">of</span> <span begin="13.889" end="14.079">men</span> <span begin="14.079" end="15.052">ride</span> <span begin="15.052" end="15.255">for</span> <span begin="15.255" end="15.447">the</span> <span begin="15.447" end="15.916">Black</span><span begin="15.916" end="16.439">water</span><span ttm:role="x-translation" xml:lang="zh-Hans">几名硬汉策马奔向黑水镇</span></p><p begin="1:10.656" end="1:14.762" itunes:key="L6" ttm:agent="v1"><span begin="1:10.656" end="1:10.762">To</span><span begin="1:10.762" end="1:11.175">night,</span> <span begin="1:11.604" end="1:11.746">an</span> <span begin="1:11.746" end="1:11.890">un</span><span begin="1:11.890" end="1:12.586">settling</span> <span begin="1:12.586" end="1:13.502">tone</span> <span begin="1:13.502" end="1:14.002">lingers</span> <span begin="1:14.002" end="1:14.161">in</span> <span begin="1:14.161" end="1:14.333">the</span> <span begin="1:14.333" end="1:14.762">air</span><span ttm:role="x-translation" xml:lang="zh-Hans">今夜，空气中弥漫着不安的气息</span></p><p begin="1:15.778" end="1:20.016" itunes:key="L7" ttm:agent="v1"><span begin="1:15.778" end="1:15.936">The</span> <span begin="1:15.936" end="1:16.796">sound</span> <span begin="1:17.348" end="1:17.747">makes</span> <span begin="1:17.747" end="1:17.874">the</span> <span begin="1:17.874" end="1:18.662">horses</span> <span begin="1:18.662" end="1:19.084">shriek</span> <span begin="1:19.084" end="1:19.372">in</span> <span begin="1:19.372" end="1:20.016">fear</span><span ttm:role="x-translation" xml:lang="zh-Hans">异样的声响让马匹惊恐嘶鸣</span></p><p begin="1:21.111" end="1:24.378" itunes:key="L8" ttm:agent="v1"><span begin="1:21.111" end="1:21.269">From</span> <span begin="1:21.269" end="1:21.764">above,</span> <span begin="1:22.744" end="1:23.156">pierc</span><span begin="1:23.156" end="1:23.411">ing</span> <span begin="1:23.411" end="1:23.886">thunder</span> <span begin="1:23.886" end="1:24.378">roars</span><span ttm:role="x-translation" xml:lang="zh-Hans">穹顶之上，惊雷滚滚破空而来</span></p><p begin="1:25.171" end="1:27.537" itunes:key="L9" ttm:agent="v1"><span begin="1:25.171" end="1:25.305">The</span> <span begin="1:25.305" end="1:26.484">earth</span> <span begin="1:26.484" end="1:26.659">has</span> <span begin="1:26.659" end="1:27.537">visitors</span><span ttm:role="x-translation" xml:lang="zh-Hans">不速之客已悄然降临人间</span></p><p begin="1:28.022" end="1:30.622" itunes:key="L10" ttm:agent="v1"><span begin="1:28.022" end="1:28.176">This</span> <span begin="1:28.176" end="1:28.392">is</span> <span begin="1:28.392" end="1:28.521">the</span> <span begin="1:28.521" end="1:29.422">sound</span> <span begin="1:29.422" end="1:29.652">of</span> <span begin="1:29.652" end="1:29.873">the</span> <span begin="1:29.873" end="1:30.622">machine</span><span ttm:role="x-translation" xml:lang="zh-Hans">那是钢铁巨兽的轰鸣</span></p><p begin="1:41.925" end="1:44.599" itunes:key="L11" ttm:agent="v1"><span begin="1:41.925" end="1:42.476">Now</span> <span begin="1:42.476" end="1:43.237">staring</span> <span begin="1:43.237" end="1:43.525">into</span> <span begin="1:43.525" end="1:43.824">the</span> <span begin="1:43.824" end="1:44.599">sky</span><span ttm:role="x-translation" xml:lang="zh-Hans">抬头仰望夜空</span></p><p begin="1:44.686" end="1:47.241" itunes:key="L12" ttm:agent="v1"><span begin="1:44.686" end="1:45.122">The</span> <span begin="1:45.122" end="1:45.527">stars</span> <span begin="1:45.527" end="1:46.359">dissipate</span> <span begin="1:46.359" end="1:46.572">to</span> <span begin="1:46.572" end="1:46.860">make</span> <span begin="1:46.860" end="1:47.241">way</span><span ttm:role="x-translation" xml:lang="zh-Hans">群星黯然退散 为其让道</span></p><p begin="1:47.459" end="1:52.046" itunes:key="L13" ttm:agent="v1"><span begin="1:47.459" end="1:47.715">As</span> <span begin="1:47.715" end="1:47.971">the</span> <span begin="1:47.971" end="1:48.654">mechanical</span> <span begin="1:48.654" end="1:49.273">beast</span> <span begin="1:49.273" end="1:49.614">makes</span> <span begin="1:49.614" end="1:49.977">its</span> <span begin="1:49.977" end="1:50.595">descent</span> <span begin="1:50.595" end="1:51.267">towards</span> <span begin="1:51.267" end="1:51.502">the</span> <span begin="1:51.502" end="1:52.046">earth</span><span ttm:role="x-translation" xml:lang="zh-Hans">钢铁巨兽正向人间降临</span></p><p begin="1:52.530" end="1:56.537" itunes:key="L14" ttm:agent="v1"><span begin="1:52.530" end="1:52.768">Through</span> <span begin="1:52.768" end="1:53.453">galaxies</span> <span begin="1:53.453" end="1:53.701">in</span> <span begin="1:53.701" end="1:54.541">space</span> <span begin="1:54.541" end="1:54.799">and</span> <span begin="1:54.799" end="1:55.236">tales</span> <span begin="1:55.236" end="1:55.556">old</span> <span begin="1:55.556" end="1:55.876">as</span> <span begin="1:55.876" end="1:56.537">time</span><span ttm:role="x-translation" xml:lang="zh-Hans">穿越浩瀚星系与亘古流传的传说</span></p><p begin="1:57.407" end="2:04.095" itunes:key="L15" ttm:agent="v1"><span begin="1:57.407" end="1:57.876">Fear</span> <span begin="1:57.876" end="1:58.399">finds</span> <span begin="1:58.399" end="1:58.580">a</span> <span begin="1:58.580" end="1:59.242">way</span> <span begin="1:59.242" end="1:59.594">into</span> <span begin="1:59.594" end="1:59.828">the</span> <span begin="1:59.828" end="2:00.639">heart</span> <span begin="2:00.639" end="2:00.980">of</span> <span begin="2:00.980" end="2:01.343">every</span> <span begin="2:01.343" end="2:02.004">man</span> <span begin="2:02.004" end="2:02.335">of</span> <span begin="2:02.335" end="2:02.730">the</span> <span begin="2:02.730" end="2:04.095">Blackwater</span><span ttm:role="x-translation" xml:lang="zh-Hans">恐惧悄然侵蚀着黑水镇每个人的心房</span></p><p begin="2:04.691" end="2:05.363" itunes:key="L16" ttm:agent="v2"><span begin="2:04.691" end="2:05.363">Blackwater</span><span ttm:role="x-translation" xml:lang="zh-Hans">黑水镇</span></p><p begin="2:10.067" end="2:10.696" itunes:key="L17" ttm:agent="v2"><span begin="2:10.067" end="2:10.696">Blackwater</span><span ttm:role="x-translation" xml:lang="zh-Hans">黑水镇</span></p><p begin="2:31.436" end="2:31.998" itunes:key="L18" ttm:agent="v2"><span begin="2:31.436" end="2:31.998">Blackwater</span><span ttm:role="x-translation" xml:lang="zh-Hans">黑水镇</span></p><p begin="3:05.137" end="3:08.534" itunes:key="L19" ttm:agent="v1"><span begin="3:05.137" end="3:05.269">From</span> <span begin="3:05.269" end="3:06.627">above,</span> <span begin="3:06.627" end="3:06.905">pierc</span><span begin="3:06.905" end="3:07.293">ing</span> <span begin="3:07.293" end="3:07.875">thunder</span> <span begin="3:07.875" end="3:08.534">roars</span><span ttm:role="x-translation" xml:lang="zh-Hans">穹顶之上，惊雷滚滚破空而来</span></p><p begin="3:09.248" end="3:11.349" itunes:key="L20" ttm:agent="v1"><span begin="3:09.248" end="3:09.394">The</span> <span begin="3:09.394" end="3:10.309">earth</span> <span begin="3:10.309" end="3:10.614">has</span> <span begin="3:10.614" end="3:11.349">visitors</span><span ttm:role="x-translation" xml:lang="zh-Hans">不速之客已悄然降临人间</span></p><p begin="3:11.992" end="3:14.640" itunes:key="L21" ttm:agent="v1"><span begin="3:11.992" end="3:12.262">This</span> <span begin="3:12.262" end="3:12.387">is</span> <span begin="3:12.387" end="3:12.532">the</span> <span begin="3:12.532" end="3:13.496">sound</span> <span begin="3:13.496" end="3:13.690">of</span> <span begin="3:13.690" end="3:13.884">the</span> <span begin="3:13.884" end="3:14.640">machine</span><span ttm:role="x-translation" xml:lang="zh-Hans">那是钢铁巨兽的轰鸣</span></p><p begin="3:26.160" end="3:28.689" itunes:key="L22" ttm:agent="v1"><span begin="3:26.160" end="3:26.521">Now</span> <span begin="3:26.521" end="3:27.022">staring</span> <span begin="3:27.022" end="3:27.515">into</span> <span begin="3:27.515" end="3:27.963">the</span> <span begin="3:27.963" end="3:28.689">sky</span><span ttm:role="x-translation" xml:lang="zh-Hans">抬头仰望夜空</span></p><p begin="3:28.689" end="3:31.032" itunes:key="L23" ttm:agent="v1"><span begin="3:28.689" end="3:28.869">The</span> <span begin="3:28.869" end="3:29.446">stars</span> <span begin="3:29.446" end="3:30.189">dissipate</span> <span begin="3:30.189" end="3:30.330">to</span> <span begin="3:30.330" end="3:30.669">make</span> <span begin="3:30.669" end="3:31.032">way</span><span ttm:role="x-translation" xml:lang="zh-Hans">群星黯然退散 为其让道</span></p><p begin="3:31.339" end="3:36.047" itunes:key="L24" ttm:agent="v1"><span begin="3:31.339" end="3:31.582">As</span> <span begin="3:31.582" end="3:31.887">the</span> <span begin="3:31.887" end="3:32.691">mechanical</span> <span begin="3:32.691" end="3:33.198">beast</span> <span begin="3:33.198" end="3:33.655">makes</span> <span begin="3:33.655" end="3:33.877">its</span> <span begin="3:33.877" end="3:34.660">descent</span> <span begin="3:34.660" end="3:35.271">towards</span> <span begin="3:35.271" end="3:35.381">the</span> <span begin="3:35.381" end="3:36.047">earth</span><span ttm:role="x-translation" xml:lang="zh-Hans">钢铁巨兽正向人间降临</span></p><p begin="3:48.686" end="3:49.327" itunes:key="L25" ttm:agent="v2"><span begin="3:48.686" end="3:49.327">Blackwater</span><span ttm:role="x-translation" xml:lang="zh-Hans">黑水镇</span></p><p begin="3:53.999" end="3:54.663" itunes:key="L26" ttm:agent="v2"><span begin="3:53.999" end="3:54.663">Blackwater</span><span ttm:role="x-translation" xml:lang="zh-Hans">黑水镇</span></p><p begin="4:15.345" end="4:16.002" itunes:key="L27" ttm:agent="v2"><span begin="4:15.345" end="4:16.002">Blackwater</span><span ttm:role="x-translation" xml:lang="zh-Hans">黑水镇</span></p></div></body></tt>