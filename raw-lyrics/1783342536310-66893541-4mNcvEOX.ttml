<tt xmlns="http://www.w3.org/ns/ttml" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xmlns:amll="http://www.example.com/ns/amll" itunes:timing="Word"><head><metadata><ttm:agent type="person" xml:id="v1"/><amll:meta key="musicName" value="クズリ念"/><amll:meta key="musicName" value="KUZURI"/><amll:meta key="artists" value="ずっと真夜中でいいのに。"/><amll:meta key="artists" value="ZUTOMAYO"/><amll:meta key="album" value="虚仮の一念海馬に託す"/><amll:meta key="isrc" value="JPPO02404478"/><amll:meta key="ncmMusicId" value="2639244959"/><amll:meta key="appleMusicId" value="1770242097"/><amll:meta key="qqMusicId" value="532063824"/><amll:meta key="qqMusicId" value="0043J7zY3E962M"/><amll:meta key="spotifyId" value="7t79PIxAZwn6RtJzAKoKTI"/><amll:meta key="ttmlAuthorGithubLogin" value="WTP016-CN"/><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal"><songwriters><songwriter>ACAね</songwriter></songwriters></iTunesMetadata></metadata></head><body dur="3:26.182"><div begin="8.405" end="3:26.182"><p begin="8.405" end="14.081" itunes:key="L1" ttm:agent="v1"><span begin="8.405" end="9.005">心</span><span begin="9.005" end="9.540">臓</span><span begin="9.540" end="9.780">こ</span><span begin="9.780" end="10.045">じ</span><span begin="10.045" end="10.284">開</span><span begin="10.284" end="10.548">け</span><span begin="10.548" end="11.245">て</span><span begin="11.245" end="11.727">さ</span><span begin="11.727" end="11.863">ら</span><span begin="11.863" end="11.999">っ</span><span begin="11.999" end="12.231">と</span><span begin="12.231" end="12.345">食</span><span begin="12.345" end="13.153">べ</span><span begin="13.153" end="14.081">て</span><span ttm:role="x-translation" xml:lang="zh-CN">撬开心脏，然后快意地吞下</span></p><p begin="14.081" end="16.276" itunes:key="L2" ttm:agent="v1"><span begin="14.081" end="14.657">何</span><span begin="14.657" end="14.978">も</span><span begin="14.978" end="15.377">感</span><span begin="15.377" end="15.681">じ</span><span begin="15.681" end="15.929">な</span><span begin="15.929" end="16.276">い</span><span ttm:role="x-translation" xml:lang="zh-CN">可什么也没能察觉到</span></p><p begin="16.276" end="19.855" itunes:key="L3" ttm:agent="v1"><span begin="16.276" end="17.292">雨</span><span begin="17.292" end="17.508">の</span><span begin="17.508" end="17.945">中</span><span begin="17.945" end="18.085">ず</span><span begin="18.085" end="18.225">っ</span><span begin="18.225" end="18.489">と</span><span begin="18.489" end="18.721">煮</span><span begin="18.721" end="18.933">込</span><span begin="18.933" end="18.988">ん</span><span begin="18.988" end="19.492">で</span><span begin="19.492" end="19.855">も</span><span ttm:role="x-translation" xml:lang="zh-CN">即使在雨中一直炖煮</span></p><p begin="19.855" end="23.119" itunes:key="L4" ttm:agent="v1"><span begin="19.855" end="20.015">ま</span><span begin="20.015" end="20.183">ず</span><span begin="20.183" end="20.751">い</span><span begin="20.751" end="20.959">も</span><span begin="20.959" end="21.127">の</span><span begin="21.127" end="21.743">は</span><span begin="21.743" end="21.939">不</span><span begin="21.939" end="22.135">味</span><span begin="22.135" end="23.119">い</span><span ttm:role="x-translation" xml:lang="zh-CN">难过的坏事终究也无法改变</span></p><p begin="24.031" end="27.611" itunes:key="L5" ttm:agent="v1"><span begin="24.031" end="24.527">世</span><span begin="24.527" end="24.983">の</span><span begin="24.983" end="25.535">中</span><span begin="25.535" end="25.815">の</span><span begin="25.815" end="26.079">意</span><span begin="26.079" end="26.311">図</span><span begin="26.311" end="26.311">・</span><span begin="26.311" end="26.583">書</span><span begin="26.583" end="26.783">が</span><span begin="26.783" end="27.207">全</span><span begin="27.207" end="27.611">部</span><span ttm:role="x-translation" xml:lang="zh-CN">人世间所有的思绪和书籍</span></p><p begin="27.611" end="31.396" itunes:key="L6" ttm:agent="v1"><span begin="27.611" end="28.155">響</span><span begin="28.155" end="28.307">く</span><span begin="28.307" end="28.555">と</span><span begin="28.555" end="28.723">は</span><span begin="28.723" end="29.083">限</span><span begin="29.083" end="29.275">ら</span><span begin="29.275" end="29.411">な</span><span begin="29.411" end="29.627">い</span><span begin="29.627" end="29.867">こ</span><span begin="29.867" end="29.996">と</span><span begin="29.996" end="30.237">わ</span><span begin="30.237" end="30.492">か</span><span begin="30.492" end="30.788">る</span><span begin="30.788" end="30.971">よ</span><span begin="30.971" end="31.183">も</span><span begin="31.184" end="31.396">う</span><span ttm:role="x-translation" xml:lang="zh-CN">并非都能让人产生共鸣 这我已经了然</span></p><p begin="31.396" end="35.262" itunes:key="L7" ttm:agent="v1"><span begin="31.396" end="31.587">で</span><span begin="31.587" end="31.747">も</span><span begin="31.747" end="32.227">褒</span><span begin="32.227" end="32.611">め</span><span begin="32.611" end="32.963">ら</span><span begin="32.963" end="33.195">れ</span><span begin="33.195" end="33.516">る</span><span begin="33.516" end="33.851">た</span><span begin="33.851" end="34.019">め</span><span begin="34.019" end="34.347">に</span><span begin="34.347" end="34.539">目</span><span begin="34.539" end="34.731">指</span><span begin="34.731" end="35.262">す</span><span ttm:role="x-translation" xml:lang="zh-CN">如此 我也依然愿意为了被认同而前行</span></p><p begin="35.262" end="38.607" itunes:key="L8" ttm:agent="v1"><span begin="35.262" end="35.526">晴</span><span begin="35.526" end="36.006">れ</span><span begin="36.006" end="36.502">も</span><span begin="36.502" end="36.686">い</span><span begin="36.686" end="36.870">い</span><span begin="36.870" end="37.054">ん</span><span begin="37.054" end="37.334">で</span><span begin="37.334" end="37.779">し</span><span begin="37.779" end="38.224">ょ</span><span begin="38.225" end="38.607">う</span><span ttm:role="x-translation" xml:lang="zh-CN">天晴了 似乎也不错 不是吗</span></p><p begin="39.103" end="41.226" itunes:key="L9" ttm:agent="v1"><span begin="39.103" end="39.551">没</span><span begin="39.551" end="40.031">頭</span><span begin="40.031" end="40.239">し</span><span begin="40.239" end="41.226">て</span><span ttm:role="x-translation" xml:lang="zh-CN">要认真一点诶</span></p><p begin="41.226" end="46.950" itunes:key="L10" ttm:agent="v1"><span begin="41.226" end="41.329">ち</span><span begin="41.330" end="41.433">っ</span><span begin="41.433" end="41.513">ち</span><span begin="41.513" end="41.593">ゃ</span><span begin="41.593" end="41.745">い</span><span begin="41.745" end="42.065">悪</span><span begin="42.065" end="42.217">魔</span><span begin="42.217" end="42.441">に</span><span begin="42.441" end="42.673">な</span><span begin="42.673" end="42.889">れ</span><span begin="42.889" end="43.113">た</span><span begin="43.113" end="43.433">ら</span><span begin="43.433" end="43.873">楽</span><span begin="43.873" end="44.577">で</span><span begin="44.577" end="45.214">す</span><span begin="45.214" end="45.646">頑</span><span begin="45.646" end="45.814">張</span><span begin="45.814" end="46.950">ろ</span><span ttm:role="x-translation" xml:lang="zh-CN">要是能化身为小恶魔就好了 继续加油吧</span></p><p begin="46.950" end="48.910" itunes:key="L11" ttm:agent="v1"><span begin="46.950" end="47.214">た</span><span begin="47.214" end="47.678">だ</span><span begin="47.678" end="48.118">凌</span><span begin="48.118" end="48.270">い</span><span begin="48.270" end="48.910">で</span><span ttm:role="x-translation" xml:lang="zh-CN">还是说只是想短暂逃避而已吗</span></p><p begin="48.910" end="52.902" itunes:key="L12" ttm:agent="v1"><span begin="48.910" end="49.230">魘</span><span begin="49.230" end="49.470">さ</span><span begin="49.470" end="49.646">れ</span><span begin="49.646" end="49.854">る</span><span begin="49.854" end="50.006">の</span><span begin="50.006" end="50.167">も</span><span begin="50.167" end="50.446">一</span><span begin="50.446" end="50.654">時</span><span begin="50.654" end="51.095">的</span><span begin="51.095" end="51.438">な</span><span begin="51.438" end="51.574">所</span><span begin="51.574" end="51.862">業</span><span begin="51.958" end="52.350">一</span><span begin="52.350" end="52.494">過</span><span begin="52.494" end="52.902">性</span><span ttm:role="x-translation" xml:lang="zh-CN">可梦魇也只是短暂的</span></p><p begin="52.902" end="55.647" itunes:key="L13" ttm:agent="v1"><span begin="52.902" end="53.142">言</span><span begin="53.142" end="53.382">い</span><span begin="53.382" end="54.759">訳</span><span begin="54.759" end="55.239">で</span><span begin="55.239" end="55.647">す</span><span ttm:role="x-translation" xml:lang="zh-CN">终究只是个借口吗</span></p><p begin="56.025" end="1:00.041" itunes:key="L14" ttm:agent="v1"><span begin="56.025" end="56.173">ロ</span><span begin="56.173" end="56.321">ン</span><span begin="56.321" end="56.505">リ</span><span begin="56.505" end="56.689">ー</span><span begin="56.689" end="56.905">ナ</span><span begin="56.905" end="57.201">イ</span><span begin="57.201" end="57.386">ト</span><span begin="57.386" end="57.913">冷</span><span begin="57.913" end="58.345">蔵</span><span begin="58.345" end="58.697">庫</span><span begin="58.697" end="58.929">の</span><span begin="58.929" end="59.386">灯</span><span begin="59.386" end="59.690">り</span><span begin="59.690" end="1:00.041">が</span><span ttm:role="x-translation" xml:lang="zh-CN">于孤独的深夜静默 冰箱里闪灼的灯光</span></p><p begin="1:00.041" end="1:04.093" itunes:key="L15" ttm:agent="v1"><span begin="1:00.041" end="1:00.569">映</span><span begin="1:00.569" end="1:00.929">し</span><span begin="1:00.929" end="1:01.153">出</span><span begin="1:01.153" end="1:01.393">す</span><span begin="1:01.393" end="1:01.793">僕</span><span begin="1:01.793" end="1:02.041">の</span><span begin="1:02.041" end="1:02.281">虚</span><span begin="1:02.281" end="1:02.481">無</span><span begin="1:02.481" end="1:02.753">を</span><span begin="1:02.753" end="1:03.193">証</span><span begin="1:03.193" end="1:03.617">明</span><span begin="1:03.617" end="1:03.785">し</span><span begin="1:03.785" end="1:04.093">て</span><span ttm:role="x-translation" xml:lang="zh-CN">映照着 证明着我的虚无</span></p><p begin="1:04.093" end="1:07.757" itunes:key="L16" ttm:agent="v1"><span begin="1:04.093" end="1:04.333">そ</span><span begin="1:04.333" end="1:04.533">れ</span><span begin="1:04.533" end="1:04.949">は</span><span begin="1:04.949" end="1:05.349">誰</span><span begin="1:05.349" end="1:05.557">も</span><span begin="1:05.557" end="1:06.061">奪</span><span begin="1:06.061" end="1:06.333">え</span><span begin="1:06.333" end="1:06.517">や</span><span begin="1:06.517" end="1:06.669">し</span><span begin="1:06.669" end="1:06.853">な</span><span begin="1:06.853" end="1:06.981">い</span><span begin="1:06.981" end="1:07.109">ん</span><span begin="1:07.109" end="1:07.381">だ</span><span begin="1:07.381" end="1:07.757">よ</span><span ttm:role="x-translation" xml:lang="zh-CN">那是 谁也无法夺走的事物啊</span></p><p begin="1:07.757" end="1:12.651" itunes:key="L17" ttm:agent="v1"><span begin="1:07.757" end="1:08.054">孤</span><span begin="1:08.054" end="1:08.765">独</span><span begin="1:08.765" end="1:08.929">じ</span><span begin="1:08.929" end="1:09.093">ゃ</span><span begin="1:09.093" end="1:09.277">な</span><span begin="1:09.277" end="1:09.425">き</span><span begin="1:09.425" end="1:09.573">ゃ</span><span begin="1:09.574" end="1:10.005">眠</span><span begin="1:10.005" end="1:10.301">れ</span><span begin="1:10.301" end="1:10.805">な</span><span begin="1:10.805" end="1:11.365">い</span><span begin="1:11.660" end="1:12.012">眠</span><span begin="1:12.012" end="1:12.172">れ</span><span begin="1:12.172" end="1:12.300">な</span><span begin="1:12.300" end="1:12.651">い</span><span ttm:role="x-translation" xml:lang="zh-CN">不孤独的话 我将无法入梦 得以安睡</span></p><p begin="1:27.632" end="1:31.065" itunes:key="L18" ttm:agent="v1"><span begin="1:27.632" end="1:28.176">空</span><span begin="1:28.176" end="1:28.400">っ</span><span begin="1:28.400" end="1:28.712">ぽ</span><span begin="1:28.712" end="1:28.840">な</span><span begin="1:28.840" end="1:29.096">オ</span><span begin="1:29.096" end="1:29.336">ケ</span><span begin="1:29.336" end="1:29.624">で</span><span begin="1:29.624" end="1:30.176">歌</span><span begin="1:30.176" end="1:30.328">う</span><span begin="1:30.328" end="1:30.632">習</span><span begin="1:30.632" end="1:31.065">慣</span><span ttm:role="x-translation" xml:lang="zh-CN">已经习惯了在空洞的伴奏声中歌唱</span></p><p begin="1:31.065" end="1:34.865" itunes:key="L19" ttm:agent="v1"><span begin="1:31.065" end="1:31.552">新</span><span begin="1:31.552" end="1:32.017">参</span><span begin="1:32.017" end="1:32.281">お</span><span begin="1:32.281" end="1:32.776">皿</span><span begin="1:32.776" end="1:33.008">を</span><span begin="1:33.008" end="1:33.232">舐</span><span begin="1:33.232" end="1:33.432">め</span><span begin="1:33.432" end="1:33.688">る</span><span begin="1:33.688" end="1:34.072">探</span><span begin="1:34.072" end="1:34.401">究</span><span begin="1:34.401" end="1:34.545">死</span><span begin="1:34.545" end="1:34.865">因</span><span ttm:role="x-translation" xml:lang="zh-CN">如同新人一般舔舐餐盘 追寻着死亡的原因</span></p><p begin="1:34.865" end="1:38.722" itunes:key="L20" ttm:agent="v1"><span begin="1:34.865" end="1:35.176">や</span><span begin="1:35.176" end="1:35.408">り</span><span begin="1:35.408" end="1:35.608">た</span><span begin="1:35.608" end="1:35.928">い</span><span begin="1:35.928" end="1:36.128">こ</span><span begin="1:36.128" end="1:36.384">と</span><span begin="1:36.384" end="1:36.648">で</span><span begin="1:36.648" end="1:36.872">き</span><span begin="1:36.872" end="1:37.097">な</span><span begin="1:37.097" end="1:37.280">く</span><span begin="1:37.280" end="1:37.497">て</span><span begin="1:37.497" end="1:37.920">正</span><span begin="1:37.920" end="1:38.328">解</span><span begin="1:38.328" end="1:38.442">じ</span><span begin="1:38.443" end="1:38.557">ゃ</span><span begin="1:38.557" end="1:38.722">ん</span><span ttm:role="x-translation" xml:lang="zh-CN">不能随心所欲 也是正确的吗</span></p><p begin="1:38.723" end="1:42.571" itunes:key="L21" ttm:agent="v1"><span begin="1:38.723" end="1:38.951">言</span><span begin="1: