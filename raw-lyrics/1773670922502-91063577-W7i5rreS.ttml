<tt xmlns="http://www.w3.org/ns/ttml" xmlns:amll="http://www.example.com/ns/amll" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" itunes:timing="Word"><head><metadata><ttm:agent type="person" xml:id="v1"/><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal"><songwriters><songwriter>中瀬ミル</songwriter><songwriter>是</songwriter></songwriters></iTunesMetadata><amll:meta key="musicName" value="さがさないでください"/><amll:meta key="musicName" value="请不要寻找"/><amll:meta key="artists" value="中瀬ミル"/><amll:meta key="artists" value="是"/><amll:meta key="artists" value="初音ミク"/><amll:meta key="album" value="さがさないでください"/><amll:meta key="appleMusicId" value="1825622283"/><amll:meta key="ncmMusicId" value="2726981897"/><amll:meta key="qqMusicId" value="588350339"/><amll:meta key="ttmlAuthorGithub" value="91063577"/><amll:meta key="ttmlAuthorGithubLogin" value="IzumiiKonata"/></metadata></head><body dur="2:39.787"><div begin="11.396" end="2:39.787"><p begin="11.396" end="14.111" itunes:key="L1" ttm:agent="v1"><span begin="11.396" end="11.590">ちょ</span><span begin="11.759" end="11.937">っと</span><span begin="11.937" end="12.086">不</span><span begin="12.086" end="12.405">安</span><span begin="12.405" end="12.599">と</span><span begin="12.599" end="12.788">か</span><span begin="12.788" end="13.427">忘</span><span begin="13.427" end="13.776">れ</span><span begin="13.776" end="14.111">て</span><span ttm:role="x-translation" xml:lang="zh-CN">稍微把不安抛在脑后</span><span ttm:role="x-roman">chotto fuan toka wasurete</span></p><p begin="14.111" end="16.429" itunes:key="L2" ttm:agent="v1"><span begin="14.111" end="14.260">お</span><span begin="14.447" end="14.614">っと</span><span begin="14.614" end="14.790">ふ</span><span begin="14.790" end="14.995">ら</span><span begin="15.091" end="15.258">っと</span><span begin="15.258" end="15.434">く</span><span begin="15.434" end="15.730">ら</span><span begin="15.730" end="16.096">く</span><span begin="16.096" end="16.429">ら</span><span ttm:role="x-translation" xml:lang="zh-CN">哎呀，摇摇晃晃晕晕乎乎</span><span ttm:role="x-roman">otto furatto kurakura</span></p><p begin="16.759" end="19.971" itunes:key="L3" ttm:agent="v1"><span begin="16.759" end="16.975">蛾</span><span begin="17.091" end="17.248">と</span><span begin="17.248" end="17.440">か</span><span begin="17.440" end="17.665">蚊</span><span begin="17.777" end="17.899">が</span><span begin="17.899" end="18.101">左</span><span begin="18.101" end="18.433">往</span><span begin="18.433" end="18.735">右</span><span begin="18.735" end="19.102">往</span><span begin="19.102" end="19.459">す</span><span begin="19.459" end="19.971">る</span><span ttm:role="x-translation" xml:lang="zh-CN">飞蛾和蚊子左冲右撞</span><span ttm:role="x-roman">ga toka ka ga saou uou suru</span></p><p begin="22.016" end="24.721" itunes:key="L4" ttm:agent="v1"><span begin="22.016" end="22.420">み</span><span begin="22.420" end="22.598">っと</span><span begin="22.598" end="22.772">も</span><span begin="22.772" end="22.926">な</span><span begin="22.926" end="23.085">い</span><span begin="23.085" end="23.249">か</span><span begin="23.249" end="23.423">ら</span><span begin="23.423" end="24.107">隠</span><span begin="24.107" end="24.416">れ</span><span begin="24.416" end="24.721">て</span><span ttm:role="x-translation" xml:lang="zh-CN">因为有点丢脸那就藏起来把</span><span ttm:role="x-roman">mittomonai kara kakurete</span></p><p begin="24.721" end="27.081" itunes:key="L5" ttm:agent="v1"><span begin="24.721" end="25.058">知</span><span begin="25.058" end="25.242">って</span><span begin="25.242" end="25.409">る</span><span begin="25.409" end="25.751">こ</span><span begin="25.751" end="25.913">と</span><span begin="25.913" end="26.385">隠</span><span begin="26.385" end="26.742">し</span><span begin="26.742" end="27.081">た</span><span ttm:role="x-translation" xml:lang="zh-CN">隐藏了知道的事情</span><span ttm:role="x-roman">shitteru koto kakushita</span></p><p begin="27.401" end="31.440" itunes:key="L6" ttm:agent="v1"><span begin="27.401" end="27.756">最</span><span begin="27.756" end="27.936">後</span><span begin="27.936" end="28.111">の</span><span begin="28.111" end="28.431">最</span><span begin="28.431" end="28.606">後</span><span begin="28.606" end="28.751">に</span><span begin="28.751" end="29.426">託</span><span begin="29.426" end="29.751">し</span><span begin="29.751" end="30.096">て</span><span begin="30.096" end="30.602">る</span> <span begin="30.711" end="31.036">ず</span><span begin="31.036" end="31.440">っと</span><span ttm:role="x-translation" xml:lang="zh-CN">一直 把最后的最后都托付出去</span><span ttm:role="x-roman">saigo no saigo ni takushiteru zutto</span></p><p begin="31.440" end="33.764" itunes:key="L7" ttm:agent="v1"><span begin="31.440" end="31.763">1</span><span begin="31.763" end="32.096">番</span><span begin="32.096" end="32.274">乗</span><span begin="32.274" end="32.432">り</span><span begin="32.432" end="32.620">だ</span><span begin="32.620" end="32.758">よ</span><span begin="32.758" end="33.126">停</span><span begin="33.126" end="33.429">留</span><span begin="33.429" end="33.764">所</span><span ttm:role="x-translation" xml:lang="zh-CN">第一个到达的公交站</span><span ttm:role="x-roman">ichiban nori da yo teiryuujo</span></p><p begin="34.114" end="36.514" itunes:key="L8" ttm:agent="v1"><span begin="34.114" end="34.418">破</span><span begin="34.418" end="34.573">る</span><span begin="34.573" end="34.759">お</span><span begin="34.759" end="34.926">母</span><span begin="34.926" end="35.084">さ</span><span begin="35.084" end="35.247">ん</span><span begin="35.247" end="35.410">の</span><span begin="35.410" end="35.573">せ</span><span begin="35.573" end="35.756">い</span><span begin="35.756" end="36.100">きゅう</span><span begin="36.100" end="36.514">書</span><span ttm:role="x-translation" xml:lang="zh-CN">撕毁妈妈的账单</span><span ttm:role="x-roman">yaburu okaasan no seikyuusho</span></p><p begin="36.779" end="39.016" itunes:key="L9" ttm:agent="v1"><span begin="36.779" end="37.080">誰</span><span begin="37.080" end="37.246">も</span><span begin="37.246" end="37.432">来</span><span begin="37.432" end="37.599">な</span><span begin="37.599" end="37.749">い</span><span begin="37.749" end="37.895">こ</span><span begin="37.895" end="38.101">の</span><span begin="38.101" end="38.437">迷</span><span begin="38.437" end="38.753">宮</span><span begin="38.753" end="39.016">の</span><span ttm:role="x-translation" xml:lang="zh-CN">没人来的这个迷宫</span><span ttm:role="x-roman">dare mo konai kono meikyuu no</span></p><p begin="39.076" end="41.798" itunes:key="L10" ttm:agent="v1"><span begin="39.076" end="39.429">ま</span><span begin="39.429" end="39.777">ん</span><span begin="39.777" end="40.065">な</span><span begin="40.065" end="40.408">か</span><span begin="40.408" end="40.776">ま</span><span begin="40.776" end="41.109">で</span> <span begin="41.109" end="41.437">で</span> <span begin="41.437" end="41.798">で</span><span ttm:role="x-translation" xml:lang="zh-CN">一直走到正中间</span><span ttm:role="x-roman">mannaka made de de</span></p><p begin="42.078" end="44.605" itunes:key="L11" ttm:agent="v1"><span begin="42.078" end="42.256">映</span><span begin="42.256" end="42.434">え</span><span begin="42.434" end="42.607">な</span><span begin="42.607" end="42.770">い</span><span begin="42.770" end="42.939">日</span><span begin="42.939" end="43.105">々</span><span begin="43.105" end="43.238">を</span><span begin="43.238" end="43.416">切</span><span begin="43.416" end="43.759">り</span><span begin="43.759" end="44.072">取</span><span begin="44.072" end="44.605">って</span><span ttm:role="x-translation" xml:lang="zh-CN">捕捉那些不怎么出彩的日子</span><span ttm:role="x-roman">baenai hibi o kiritotte</span></p><p begin="44.605" end="47.149" itunes:key="L12" ttm:agent="v1"><span begin="44.605" end="44.790">名</span><span begin="44.790" end="45.105">前</span><span begin="45.105" end="45.250">無</span><span begin="45.250" end="45.400">い</span><span begin="45.400" end="45.555">明</span><span begin="45.555" end="45.720">日</span><span begin="45.720" end="45.895">へ</span><span begin="45.895" end="46.105">連</span><span begin="46.105" end="46.425">れ</span><span begin="46.425" end="46.585">て</span><span begin="46.585" end="46.745">い</span><span begin="46.745" end="47.149">く</span><span ttm:role="x-translation" xml:lang="zh-CN">带向没有名字的明天</span><span ttm:role="x-roman">namae nai asu e tsurete yuku</span></p><p begin="47.424" end="52.553" itunes:key="L13" ttm:agent="v1"><span begin="47.424" end="47.611">ふ</span><span begin="47.611" end="47.778">た</span><span begin="47.778" end="47.920">り</span><span begin="47.920" end="48.107">の</span><span begin="48.107" end="48.289">距</span><span begin="48.289" end="48.421">離</span><span begin="48.421" end="48.593">が</span><span begin="48.593" end="49.143">近</span><span begin="49.143" end="49.452">づ</span><span begin="49.452" end="49.769">く</span><span begin="49.769" end="50.581">所</span><span begin="50.581" end="50.763">ま</span><span begin="50.763" end="51.230">で</span><span begin="51.230" end="51.442">行</span><span begin="51.442" end="51.739">け</span><span begin="51.739" end="52.106">た</span><span begin="52.106" end="52.553">ら</span><span ttm:role="x-translation" xml:lang="zh-CN">如果能走到你我距离拉近的地方</span><span ttm:role="x-roman">futari no kyori ga chikazuku toko made yuketara</span></p><p begin="52.725" end="55.240" itunes:key="L14" ttm:agent="v1"><span begin="52.725" end="52.932">冴</span><span begin="52.932" end="53.104">え</span><span begin="53.104" end="53.296">な</span><span begin="53.296" end="53.428">い</span><span begin="53.428" end="53.785">今</span><span begin="53.785" end="53.927">を</span><span begin="53.927" end="54.274">笑</span><span begin="54.274" end="54.411">え</span><span begin="54.411" end="54.777">そう</span><span begin="54.777" end="55.240">で</span><span ttm:role="x-translation" xml:lang="zh-CN">好像就能笑着面对这乏味的现实</span><span ttm:role="x-roman">saenai ima o waraesou de</span></p><p begin="55.240" end="57.810" itunes:key="L15" ttm:agent="v1"><span begin="55.240" end="55.433">く</span><span begin="55.433" end="55.598">だ</span><span begin="55.598" end="55.761">ん</span><span begin="55.761" end="55.932">な</span><span begin="55.932" end="56.095">い</span><span begin="56.095" end="56.243">過</span><span begin="56.243" end="56.406">去</span><span begin="56.406" end="56.539">は</span><span begin="56.539" end="57.070">棄</span><span begin="57.070" end="57.248">て</span><span begin="57.248" end="57.421">い</span><span begin="57.421" end="57.810">く</span><span ttm:role="x-translation" xml:lang="zh-CN">抛弃那无聊的过去</span><span ttm:role="x-roman">kudannai kako wa sutete yuku</span></p><p begin="58.051" end="1:00.500" itunes:key="L16" ttm:agent="v1"><span begin="58.051" end="58.277">世</span><span begin="58.277" end="58.603">界</span><span begin="58.603" end="58.744">の</span><span begin="58.744" end="59.105">線</span><span begin="59.105" end="59.276">が</span><span begin="59.276" end="59.442">ブ</span><span begin="59.442" end="59.763">レ</span><span begin="59.763" end="1:00.094">て</span><span begin="1:00.094" end="1:00.500">る。</span><span ttm:role="x-translation" xml:lang="zh-CN">世界的线条在颤抖</span><span ttm:role="x-roman">sekai no sen ga bureteru.</span></p><p begin="1:00.710" end="1:03.629" itunes:key="L17" ttm:agent="v1"><span begin="1:00.710" end="1:00.976">な</span><span begin="1:00.976" end="1:01.257">ん</span><span begin="1:01.257" end="1:01.433">て</span><span begin="1:01.433" end="1:01.897">ね、</span><span begin="1:01.897" end="1:02.338">可</span><span begin="1:02.338" end="1:02.769">笑</span><span begin="1:02.769" end="1:03.086">い</span><span begin="1:03.086" end="1:03.377">よ</span><span begin="1:03.377" end="1:03.629">ね</span><span ttm:role="x-translation" xml:lang="zh-CN">哈哈，是不是有点好笑？</span><span ttm:role="x-roman">nante ne, okashii yo ne</span></p><p begin="1:14.117" end="1:16.402" itunes:key="L18" ttm:agent="v1"><span begin="1:14.117" end="1:14.594">道</span><span begin="1:14.594" end="1:14.776">の</span><span begin="1:14.776" end="1:15.248">脇</span><span begin="1:15.248" end="1:15.400">で</span><span begin="1:15.400" end="1:15.747">果</span><span begin="1:15.747" end="1:16.089">て</span><span begin="1:16.089" end="1:16.402">た</span><span ttm:role="x-translation" xml:lang="zh-CN">在路边死去的猫</span><span ttm:role="x-roman">michi no waki de hateta</span></p><p begin="1:16.775" end="1:19.116" itunes:key="L19" ttm:agent="v1"><span begin="1:16.775" end="1:17.253">猫</span><span begin="1:17.253" end="1:17.403">の</span><span begin="1:17.403" end="1:17.941">腹</span><span begin="1:17.941" end="1:18.124">を</span><span begin="1:18.124" end="1:18.437">撫</span><span begin="1:18.437" end="1:18.775">で</span><span begin="1:18.775" end="1:19.116">た</span><span ttm:role="x-translation" xml:lang="zh-CN">抚摸了一下它的肚子</span><span ttm:role="x-roman">neko no hara o nadeta</span></p><p begin="1:19.401" end="1:21.757" itunes:key="L20" ttm:agent="v1"><span begin="1:19.401" end="1:19.951">君</span><span begin="1:19.951" end="1:20.071">が</span><span begin="1:20.071" end="1:20.421">言</span><span begin="1:20.421" end="1:20.541">った、</span><span begin="1:20.541" end="1:20.746">は</span><span begin="1:20.746" end="1:21.041">い、</span><span begin="1:21.041" end="1:21.416">ちー</span><span begin="1:21.416" end="1:21.757">ず</span><span ttm:role="x-translation" xml:lang="zh-CN">你说了声 好，茄子！</span><span ttm:role="x-roman">kimi ga itta, hai, chiizu</span></p><p begin="1:22.072" end="1:24.439" itunes:key="L21" ttm:agent="v1"><span begin="1:22.072" end="1:22.386">咄</span><span begin="1:22.386" end="1:22.605">嗟</span><span begin="1:22.605" end="1:22.754">に</span><span begin="1:22.754" end="1:23.072">ポー</span><span begin="1:23.072" end="1:23.246">ズ</span><span begin="1:23.246" end="1:23.395">決</span><span begin="1:23.395" end="1:23.774">め</span><span begin="1:23.774" end="1:24.048">れ</span><span begin="1:24.048" end="1:24.439">ず</span><span ttm:role="x-translation" xml:lang="zh-CN">我却一时摆不出姿势</span><span ttm:role="x-roman">tossa ni poozu kimerezu</span></p><p begin="1:24.794" end="1:27.260" itunes:key="L22" ttm:agent="v1"><span begin="1:24.794" end="1:25.213">息</span><span begin="1:25.213" end="1:25.417">を</span><span begin="1:25.417" end="1:25.721">吸</span><span begin="1:25.721" end="1:25.919">って</span><span begin="1:25.919" end="1:26.093">吐</span><span begin="1:26.093" end="1:26.447">く</span><span begin="1:26.447" end="1:26.756">の</span><span begin="1:26.756" end="1:27.260">が</span><span ttm:role="x-translation" xml:lang="zh-CN">吸气吐气这种事</span><span ttm:role="x-roman">iki o sutte haku no ga</span></p><p begin="1:27.455" end="1:29.815" itunes:key="L23" ttm:agent="v1"><span begin="1:27.455" end="1:27.980">偉</span><span begin="1:27.980" end="1:28.130">い</span><span begin="1:28.130" end="1:28.290">な</span><span begin="1:28.290" end="1:28.445">ん</span><span begin="1:28.445" end="1:28.600">て</span><span begin="1:28.600" end="1:29.110">嘘</span><span begin="1:29.110" end="1:29.440">だ</span><span begin="1:29.440" end="1:29.815">と</span><span ttm:role="x-translation" xml:lang="zh-CN">看似伟大实则谎言</span><span ttm:role="x-roman">erai nante uso da to</span></p><p begin="1:30.080" end="1:35.010" itunes:key="L24" ttm:agent="v1"><span begin="1:30.080" end="1:30.354">か</span><span begin="1:30.354" end="1:30.593">わ</span><span begin="1:30.593" end="1:30.812">い</span><span begin="1:30.812" end="1:31.133">い</span><span begin="1:31.281" end="1:31.445">終</span><span begin="1:31.445" end="1:31.709">わ</span><span begin="1:31.709" end="1:31.943">り</span><span begin="1:31.943" end="1:32.132">を</span><span begin="1:32.132" end="1:32.361">見</span><span begin="1:32.361" end="1:32.595">て</span><span begin="1:32.595" end="1:33.173">思</span><span begin="1:33.429" end="1:35.010">う</span><span ttm:role="x-translation" xml:lang="zh-CN">看着可爱的结局我在想</span><span ttm:role="x-roman">kawaii owari o mite omou</span></p><p begin="1:35.430" end="1:37.749" itunes:key="L25" ttm:agent="v1"><span begin="1:35.430" end="1:35.924">明</span><span begin="1:35.924" end="1:36.108">日</span><span begin="1:36.108" end="1:36.422">天</span><span begin="1:36.422" end="1:36.596">気</span><span begin="1:36.596" end="1:36.765">に</span><span begin="1:36.765" end="1:37.113">な</span><span begin="1:37.254" end="1:37.457">った</span><span begin="1:37.457" end="1:37.749">ら</span><span ttm:role="x-translation" xml:lang="zh-CN">如果明天天气变好的话</span><span ttm:role="x-roman">ashita tenki ni nattara</span></p><p begin="1:38.044" end="1:40.456" itunes:key="L26" ttm:agent="v1"><span begin="1:38.044" end="1:38.191">お</span><span begin="1:38.191" end="1:38.418">し</span><span begin="1:38.418" end="1:38.610">ま</span><span begin="1:38.610" end="1:38.787">い</span><span begin="1:38.787" end="1:39.119">だ</span><span begin="1:39.119" end="1:39.243">って</span><span begin="1:39.243" end="1:39.950">騒</span><span begin="1:39.950" end="1:40.456">ごう</span><span ttm:role="x-translation" xml:lang="zh-CN">就大喊「结束了」</span><span ttm:role="x-roman">oshimai datte sawagou</span></p><p begin="1:40.751" end="1:43.185" itunes:key="L27" ttm:agent="v1"><span begin="1:40.751" end="1:41.066">そう</span><span begin="1:41.066" end="1:41.256">し</span><span begin="1:41.256" end="1:41.446">て</span><span begin="1:41.446" end="1:41.761">元</span><span begin="1:41.761" end="1:41.921">気</span><span begin="1:41.921" end="1:42.106">に</span><span begin="1:42.106" end="1:42.586">な</span><span begin="1:42.586" end="1:42.736">って</span><span begin="1:42.736" end="1:43.185">さ...</span><span ttm:role="x-translation" xml:lang="zh-CN">然后变得元气满满的吧…</span><span ttm:role="x-roman">sou shite genki ni natte sa...</span></p><p begin="1:46.110" end="1:48.620" itunes:key="L28" ttm:agent="v1"><span begin="1:46.110" end="1:46.264">い</span><span begin="1:46.264" end="1:46.428">け</span><span begin="1:46.428" end="1:46.612">な</span><span begin="1:46.612" end="1:46.751">い</span><span begin="1:46.751" end="1:46.925">こ</span><span begin="1:46.925" end="1:47.099">と</span><span begin="1:47.099" end="1:47.258">だ</span><span begin="1:47.258" end="1:47.433">と</span><span begin="1:47.433" end="1:47.737">連</span><span begin="1:47.737" end="1:48.105">中</span><span begin="1:48.105" end="1:48.620">も</span><span ttm:role="x-translation" xml:lang="zh-CN">在他们察觉这是不对之前</span><span ttm:role="x-roman">ikenai koto da to renchuu mo</span></p><p begin="1:48.743" end="1:51.165" itunes:key="L29" ttm:agent="v1"><span begin="1:48.743" end="1:48.934">気</span><span begin="1:48.934" end="1:49.110">付</span><span begin="1:49.110" end="1:49.281">く</span><span begin="1:49.281" end="1:49.627">前</span><span begin="1:49.627" end="1:49.773">に</span><span begin="1:49.773" end="1:49.939">と</span><span begin="1:49.939" end="1:50.095">き</span><span begin="1:50.095" end="1:50.251">め</span><span begin="1:50.251" end="1:50.427">い</span><span begin="1:50.427" end="1:50.563">て</span><span begin="1:50.563" end="1:50.739">い</span><span begin="1:50.739" end="1:51.165">よう</span><span ttm:role="x-translation" xml:lang="zh-CN">就已经心跳加速了吧</span><span ttm:role="x-roman">kizuku mae ni tokimeite iyou</span></p><p begin="1:51.415" end="1:53.729" itunes:key="L30" ttm:agent="v1"><span begin="1:51.415" end="1:51.560">さ</span><span begin="1:51.560" end="1:51.760">よ</span><span begin="1:51.760" end="1:51.935">な</span><span begin="1:51.935" end="1:52.105">ら</span><span begin="1:52.105" end="1:52.260">ま</span><span begin="1:52.260" end="1:52.425">た</span><span begin="1:52.425" end="1:52.600">ね</span><span begin="1:52.600" end="1:52.765">の</span><span begin="1:52.765" end="1:53.045">練</span><span begin="1:53.045" end="1:53.415">習</span><span begin="1:53.415" end="1:53.729">を</span><span ttm:role="x-translation" xml:lang="zh-CN">「拜拜，下次见」的练习</span><span ttm:role="x-roman">sayonara mata ne no renshuu o</span></p><p begin="1:53.714" end="1:55.455" itunes:key="L31" ttm:agent="v1"><span begin="1:53.714" end="1:54.084">終</span><span begin="1:54.084" end="1:54.429">わ</span><span begin="1:54.429" end="1:54.754">ら</span><span begin="1:54.754" end="1:55.074">せ</span><span begin="1:55.074" end="1:55.455">て</span><span ttm:role="x-translation" xml:lang="zh-CN">让它结束吧</span><span ttm:role="x-roman">owarasete</span></p><p begin="1:56.757" end="1:59.158" itunes:key="L32" ttm:agent="v1"><span begin="1:56.757" end="1:56.930">映</span><span begin="1:56.930" end="1:57.103">え</span><span begin="1:57.103" end="1:57.271">な</span><span begin="1:57.271" end="1:57.414">い</span><span begin="1:57.414" end="1:57.605">日</span><span begin="1:57.605" end="1:57.745">々</span><span begin="1:57.745" end="1:57.888">を</span><span begin="1:57.888" end="1:58.086">切</span><span begin="1:58.086" end="1:58.424">り</span><span begin="1:58.424" end="1:58.747">取</span><span begin="1:58.747" end="1:59.158">って</span><span ttm:role="x-translation" xml:lang="zh-CN">捕捉那些不怎么出彩的日子</span><span ttm:role="x-roman">baenai hibi o kiritotte</span></p><p begin="1:59.273" end="2:01.823" itunes:key="L33" ttm:agent="v1"><span begin="1:59.273" end="1:59.429">名</span><span begin="1:59.429" end="1:59.795">前</span><span begin="1:59.795" end="1:59.936">無</span><span begin="1:59.936" end="2:00.067">い</span><span begin="2:00.067" end="2:00.258">明</span><span begin="2:00.258" end="2:00.424">日</span><span begin="2:00.424" end="2:00.570">へ</span><span begin="2:00.570" end="2:00.781">連</span><span begin="2:00.781" end="2:01.087">れ</span><span begin="2:01.087" end="2:01.248">て</span><span begin="2:01.248" end="2:01.409">い</span><span begin="2:01.409" end="2:01.823">く</span><span ttm:role="x-translation" xml:lang="zh-CN">带向没有名字的明天</span><span ttm:role="x-roman">namae nai asu e tsurete yuku</span></p><p begin="2:02.048" end="2:07.125" itunes:key="L34" ttm:agent="v1"><span begin="2:02.048" end="2:02.238">ふ</span><span begin="2:02.238" end="2:02.428">た</span><span begin="2:02.428" end="2:02.593">り</span><span begin="2:02.593" end="2:02.733">の</span><span begin="2:02.733" end="2:02.933">距</span><span begin="2:02.933" end="2:03.098">離</span><span begin="2:03.098" end="2:03.233">が</span><span begin="2:03.233" end="2:03.728">近</span><span begin="2:03.728" end="2:04.098">づ</span><span begin="2:04.098" end="2:04.408">く</span><span begin="2:04.408" end="2:05.258">所</span><span begin="2:05.258" end="2:05.423">ま</span><span begin="2:05.423" end="2:05.918">で</span><span begin="2:05.918" end="2:06.073">行</span><span begin="2:06.073" end="2:06.748">こう</span><span begin="2:06.748" end="2:07.125">よ!</span><span ttm:role="x-translation" xml:lang="zh-CN">你我一起走到距离拉近的地方吧</span><span ttm:role="x-roman">futari no kyori ga chikazuku toko made ikou yo!</span></p><p begin="2:07.430" end="2:09.833" itunes:key="L35" ttm:agent="v1"><span begin="2:07.430" end="2:07.776">案</span><span begin="2:07.776" end="2:08.092">外</span><span begin="2:08.092" end="2:08.228">ぼ</span><span begin="2:08.228" end="2:08.429">く</span><span begin="2:08.429" end="2:08.600">ら</span><span begin="2:08.600" end="2:08.896">笑</span><span begin="2:08.896" end="2:09.097">え</span><span begin="2:09.097" end="2:09.459">そう</span><span begin="2:09.459" end="2:09.833">で</span><span ttm:role="x-translation" xml:lang="zh-CN">意外的是我们好像能笑出来</span><span ttm:role="x-roman">angai bokura waraesou de</span></p><p begin="2:09.912" end="2:12.469" itunes:key="L36" ttm:agent="v1"><span begin="2:09.912" end="2:10.104">く</span><span begin="2:10.104" end="2:10.256">だ</span><span begin="2:10.256" end="2:10.418">ん</span><span begin="2:10.418" end="2:10.580">な</span><span begin="2:10.580" end="2:10.757">い</span><span begin="2:10.757" end="2:11.089">傷</span><span begin="2:11.089" end="2:11.251">は</span><span begin="2:11.251" end="2:11.458">消</span><span begin="2:11.458" end="2:11.750">え</span><span begin="2:11.750" end="2:11.917">て</span><span begin="2:11.917" end="2:12.074">い</span><span begin="2:12.074" end="2:12.469">く</span><span ttm:role="x-translation" xml:lang="zh-CN">无聊的伤痕渐渐消失</span><span ttm:role="x-roman">kudannai kizu wa kiete yuku</span></p><p begin="2:12.714" end="2:15.128" itunes:key="L37" ttm:agent="v1"><span begin="2:12.714" end="2:12.977">世</span><span begin="2:12.977" end="2:13.280">界</span><span begin="2:13.280" end="2:13.428">の</span><span begin="2:13.428" end="2:13.771">色</span><span begin="2:13.771" end="2:13.934">が</span><span begin="2:13.934" end="2:14.097">暈</span><span begin="2:14.097" end="2:14.430">け</span><span begin="2:14.430" end="2:14.768">て</span><span begin="2:14.768" end="2:15.128">る。</span><span ttm:role="x-translation" xml:lang="zh-CN">世界的颜色逐渐晕染</span><span ttm:role="x-roman">sekai no iro ga boketeru.</span></p><p begin="2:15.423" end="2:18.488" itunes:key="L38" ttm:agent="v1"><span begin="2:15.423" end="2:15.730">な</span><span begin="2:15.730" end="2:15.907">ん</span><span begin="2:15.907" end="2:16.104">て</span><span begin="2:16.104" end="2:16.428">ね、</span><span begin="2:16.428" end="2:17.080">可</span><span begin="2:17.080" end="2:17.432">笑</span><span begin="2:17.432" end="2:17.721">い</span><span begin="2:17.721" end="2:18.008">よ</span><span begin="2:18.008" end="2:18.299">ね</span><span ttm:role="x-translation" xml:lang="zh-CN">哈哈，是不是有点好笑？</span><span ttm:role="x-roman">nante ne, okashii yo ne</span><span ttm:role="x-bg" begin="2:18.088" end="2:18.488"><span begin="2:18.088" end="2:18.488">(ねぇ)</span><span ttm:role="x-translation" xml:lang="zh-CN">吶</span><span ttm:role="x-roman">nee</span></span></p><p begin="2:18.393" end="2:21.071" itunes:key="L39" ttm:agent="v1"><span begin="2:18.393" end="2:18.585">錆</span><span begin="2:18.585" end="2:18.742">び</span><span begin="2:18.742" end="2:18.919">つ</span><span begin="2:18.919" end="2:19.101">い</span><span begin="2:19.101" end="2:19.263">て</span><span begin="2:19.263" end="2:19.420">分</span><span begin="2:19.420" end="2:19.607">か</span><span begin="2:19.607" end="2:19.769">ら</span><span begin="2:19.769" end="2:19.946">な</span><span begin="2:19.946" end="2:20.093">い</span><span begin="2:20.093" end="2:20.340">標</span><span begin="2:20.340" end="2:20.772">識</span><span begin="2:20.772" end="2:21.071">の</span><span ttm:role="x-translation" xml:lang="zh-CN">那生锈看不清的路标</span><span ttm:role="x-roman">sabitsuite wakaranai hyoushiki no</span></p><p begin="2:21.071" end="2:23.711" itunes:key="L40" ttm:agent="v1"><span begin="2:21.071" end="2:21.262">そ</span><span begin="2:21.262" end="2:21.393">の</span><span begin="2:21.393" end="2:21.749">先</span><span begin="2:21.749" end="2:21.865">の</span><span begin="2:21.865" end="2:22.266">先</span><span begin="2:22.266" end="2:22.422">ま</span><span begin="2:22.422" end="2:22.593">で</span><span begin="2:22.593" end="2:22.774">見</span><span begin="2:22.774" end="2:22.935">に</span><span begin="2:22.935" end="2:23.081">行</span><span begin="2:23.081" end="2:23.408">こう</span><span begin="2:23.408" end="2:23.711">よ</span><span ttm:role="x-translation" xml:lang="zh-CN">我们去看它前方的前方吧</span><span ttm:role="x-roman">sono saki no saki made mi ni yukou yo</span></p><p begin="2:23.711" end="2:26.294" itunes:key="L41" ttm:agent="v1"><span begin="2:23.711" end="2:23.947">ち</span><span begin="2:23.947" end="2:24.063">か</span><span begin="2:24.063" end="2:24.274">ち</span><span begin="2:24.274" end="2:24.430">か</span><span begin="2:24.430" end="2:24.606">ち</span><span begin="2:24.606" end="2:24.772">か</span><span begin="2:24.772" end="2:24.948">翅</span><span begin="2:24.948" end="2:25.109">が</span><span begin="2:25.109" end="2:25.255">鳴</span><span begin="2:25.255" end="2:25.611">る</span><span begin="2:25.611" end="2:25.757">蛍</span><span begin="2:25.757" end="2:26.088">光</span><span begin="2:26.088" end="2:26.294">灯</span><span ttm:role="x-translation" xml:lang="zh-CN">荧光灯闪烁，翅膀嗡嗡作响</span><span ttm:role="x-roman">chikachikachika ha ga naru keikoutou</span></p><p begin="2:26.294" end="2:29.119" itunes:key="L42" ttm:agent="v1"><span begin="2:26.294" end="2:26.541">終</span><span begin="2:26.541" end="2:26.768">わ</span><span begin="2:26.768" end="2:26.940">る</span><span begin="2:26.940" end="2:27.102">ま</span><span begin="2:27.102" end="2:27.279">で</span><span begin="2:27.279" end="2:27.596">話</span><span begin="2:27.596" end="2:27.768">し</span><span begin="2:27.768" end="2:27.955">て</span><span begin="2:27.955" end="2:28.117">い</span><span begin="2:28.117" end="2:28.299">て</span><span begin="2:28.299" end="2:28.436">み</span><span begin="2:28.436" end="2:28.623">た</span><span begin="2:28.623" end="2:28.815">い</span><span begin="2:28.815" end="2:29.119">よ</span><span ttm:role="x-translation" xml:lang="zh-CN">好想一直聊到一切结束</span><span ttm:role="x-roman">owaru made hanashite ite mitai yo</span></p><p begin="2:29.119" end="2:31.748" itunes:key="L43" ttm:agent="v1"><span begin="2:29.119" end="2:29.433">誰</span><span begin="2:29.433" end="2:29.607">に</span><span begin="2:29.607" end="2:29.761">も</span><span begin="2:29.761" end="2:30.080">飾</span><span begin="2:30.080" end="2:30.259">ら</span><span begin="2:30.259" end="2:30.433">れ</span><span begin="2:30.433" end="2:30.602">な</span><span begin="2:30.602" end="2:30.751">い</span><span begin="2:30.751" end="2:31.085">芸</span><span begin="2:31.085" end="2:31.384">術</span><span begin="2:31.384" end="2:31.748">を</span><span ttm:role="x-translation" xml:lang="zh-CN">不被任何人装饰的艺术</span><span ttm:role="x-roman">dare ni mo kazararenai geijutsu o</span></p><p begin="2:31.748" end="2:34.447" itunes:key="L44" ttm:agent="v1"><span begin="2:31.748" end="2:31.920">こ</span><span begin="2:31.920" end="2:32.097">こ</span><span begin="2:32.097" end="2:32.244">だ</span><span begin="2:32.244" end="2:32.426">け</span><span begin="2:32.426" end="2:32.593">で</span><span begin="2:32.593" end="2:32.940">始</span><span begin="2:32.940" end="2:33.117">め</span><span begin="2:33.117" end="2:33.264">て</span><span begin="2:33.264" end="2:33.616">眺</span><span begin="2:33.616" end="2:33.748">め</span><span begin="2:33.748" end="2:34.067">よう</span><span begin="2:34.067" end="2:34.447">よ</span><span ttm:role="x-translation" xml:lang="zh-CN">就在这里开始凝望吧</span><span ttm:role="x-roman">koko dake de hajimete nagameyou yo</span></p><p begin="2:34.597" end="2:37.122" itunes:key="L45" ttm:agent="v1"><span begin="2:34.597" end="2:34.758">カ</span><span begin="2:34.758" end="2:34.954">メ</span><span begin="2:34.954" end="2:35.100">ラ</span><span begin="2:35.100" end="2:35.256">に</span><span begin="2:35.256" end="2:35.562">写</span><span begin="2:35.562" end="2:35.738">せ</span><span begin="2:35.738" end="2:35.959">な</span><span begin="2:35.959" end="2:36.195">い</span><span begin="2:36.195" end="2:36.416">光</span><span begin="2:36.416" end="2:36.762">景</span><span begin="2:36.762" end="2:37.122">を</span><span ttm:role="x-translation" xml:lang="zh-CN">去寻找相机拍不下的风景</span><span ttm:role="x-roman">kamera ni utsusenai koukei o</span></p><p begin="2:37.192" end="2:39.787" itunes:key="L46" ttm:agent="v1"><span begin="2:37.192" end="2:37.625">探</span><span begin="2:37.625" end="2:37.768">し</span><span begin="2:37.768" end="2:37.936">に</span><span begin="2:37.936" end="2:38.104">行</span><span begin="2:38.104" end="2:38.578">こう、</span><span begin="2:38.578" end="2:38.906">帰</span><span begin="2:38.906" end="2:39.069">ら</span><span begin="2:39.069" end="2:39.252">な</span><span begin="2:39.252" end="2:39.440">い</span><span begin="2:39.440" end="2:39.787">よ</span><span ttm:role="x-translation" xml:lang="zh-CN">去寻找吧，回不去了呢</span><span ttm:role="x-roman">sagashi ni ikou, kaeranai yo</span></p></div></body></tt>