<tt xmlns="http://www.w3.org/ns/ttml" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xmlns:amll="http://www.example.com/ns/amll"><head><metadata><ttm:agent type="person" xml:id="v1"/><ttm:agent type="person" xml:id="v2"/><amll:meta key="musicName" value="天球儀-ヨゾラノホシ-"/><amll:meta key="artists" value="yukina"/><amll:meta key="artists" value="みぃ"/><amll:meta key="album" value="星降る夜のユートピア"/><amll:meta key="ncmMusicId" value="1320647550"/><amll:meta key="ttmlAuthorGithubLogin" value="Mrs4s"/><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal"><songwriters><songwriter>ななつめ</songwriter><songwriter>tomoya</songwriter></songwriters></iTunesMetadata></metadata></head><body dur="5:20.380"><div begin="25.573" end="5:20.380"><p begin="25.573" end="29.323" itunes:key="L1" ttm:agent="v1"><span begin="25.573" end="26.113">星</span><span begin="26.113" end="26.573">の</span><span begin="26.573" end="26.870">な</span><span begin="26.870" end="27.100">い</span><span begin="27.100" end="27.463">世</span><span begin="27.463" end="28.083">界</span><span begin="28.083" end="29.323">で</span><span ttm:role="x-translation" xml:lang="zh-Hans">在没有群星的世界之中</span><span ttm:role="x-roman">hoshi no nai sekai de</span></p><p begin="29.323" end="34.550" itunes:key="L2" ttm:agent="v1"><span begin="29.323" end="29.653">手</span><span begin="29.653" end="29.903">を</span><span begin="29.903" end="30.523">繋</span><span begin="30.523" end="30.903">ぎ</span> <span begin="30.903" end="31.823">星</span><span begin="31.823" end="32.220">見</span><span begin="32.220" end="32.733">上</span><span begin="32.733" end="33.373">げ</span><span begin="33.373" end="34.550">た</span><span ttm:role="x-translation" xml:lang="zh-Hans">与你双手紧系 并肩仰望星空</span><span ttm:role="x-roman">te o tsunagi hoshi miage ta</span></p><p begin="35.494" end="41.500" itunes:key="L3" ttm:agent="v1"><span begin="35.494" end="36.463">忘</span><span begin="36.463" end="36.763">れ</span><span begin="36.763" end="37.460">物</span><span begin="37.460" end="38.053">を</span><span begin="38.356" end="38.940">探</span><span begin="38.940" end="39.313">す</span><span begin="39.313" end="39.660">よ</span><span begin="39.660" end="39.913">う</span><span begin="39.913" end="41.500">に</span><span ttm:role="x-translation" xml:lang="zh-Hans">寻找着被遗忘之物一样</span><span ttm:role="x-roman">wasuremono o sagasu you ni</span></p><p begin="44.165" end="48.497" itunes:key="L4" ttm:agent="v1"><span begin="44.165" end="45.173">鏡</span><span begin="45.173" end="45.443">合</span><span begin="45.443" end="45.743">わ</span><span begin="45.743" end="46.343">せ</span><span begin="46.343" end="46.653">み</span><span begin="46.653" end="46.990">た</span><span begin="46.990" end="47.292">い</span><span begin="47.292" end="48.497">な</span><span ttm:role="x-translation" xml:lang="zh-Hans">在水天一镜般</span><span ttm:role="x-roman">kagami awase mitai na</span></p><p begin="48.497" end="54.500" itunes:key="L5" ttm:agent="v1"><span begin="48.497" end="49.471">瞳</span><span begin="49.471" end="49.890">に</span><span begin="49.890" end="50.450">映</span><span begin="50.450" end="50.693">る</span><span begin="50.693" end="51.953">星</span><span begin="51.953" end="53.183">空</span><span begin="53.183" end="54.500">を</span><span ttm:role="x-translation" xml:lang="zh-Hans">双目中倒映而出的星空</span><span ttm:role="x-roman">hitomi ni utsuru hoshizora o</span></p><p begin="55.314" end="1:01.420" itunes:key="L6" ttm:agent="v1"><span begin="55.314" end="55.793">誰</span><span begin="55.793" end="56.273">か</span><span begin="56.273" end="56.523">の</span><span begin="56.523" end="57.173">夢</span><span begin="57.173" end="58.093">と</span> <span begin="58.093" end="58.723">重</span><span begin="58.723" end="59.053">ね</span><span begin="59.053" end="59.333">な</span><span begin="59.333" end="59.733">が</span><span begin="59.733" end="1:01.420">ら</span><span ttm:role="x-translation" xml:lang="zh-Hans">与谁的无名之梦交织重叠</span><span ttm:role="x-roman">dare ka no yume to kasane nagara</span></p><p begin="1:02.130" end="1:04.263" itunes:key="L7" ttm:agent="v1"><span begin="1:02.130" end="1:02.454">目</span><span begin="1:02.454" end="1:02.723">を</span><span begin="1:02.723" end="1:03.053">凝</span><span begin="1:03.053" end="1:03.363">ら</span><span begin="1:03.363" end="1:03.633">し</span><span begin="1:03.633" end="1:04.263">て</span><span ttm:role="x-translation" xml:lang="zh-Hans">视线凝固于此</span><span ttm:role="x-roman">me o korashi te</span></p><p begin="1:04.582" end="1:09.183" itunes:key="L8" ttm:agent="v1"><span begin="1:04.582" end="1:05.223">“後</span><span begin="1:05.223" end="1:05.533">ろ</span><span begin="1:05.533" end="1:06.113">振</span><span begin="1:06.113" end="1:06.433">り</span><span begin="1:06.433" end="1:07.093">返</span><span begin="1:07.093" end="1:07.373">る</span><span begin="1:07.373" end="1:07.703">た</span><span begin="1:07.703" end="1:08.023">び</span><span begin="1:08.023" end="1:09.183">に</span><span ttm:role="x-translation" xml:lang="zh-Hans">“每当再回望时</span><span ttm:role="x-roman">“ushiro furikaeru tabi ni</span></p><p begin="1:09.579" end="1:13.813" itunes:key="L9" ttm:agent="v1"><span begin="1:09.579" end="1:10.183">闇</span><span begin="1:10.183" end="1:10.463">に</span><span begin="1:10.463" end="1:11.430">怯</span><span begin="1:11.430" end="1:11.723">え</span><span begin="1:11.723" end="1:12.323">る</span><span begin="1:12.323" end="1:12.643">な</span><span begin="1:12.643" end="1:12.983">ら</span><span begin="1:12.983" end="1:13.813">ば”</span><span ttm:role="x-translation" xml:lang="zh-Hans">若是惧怕黑夜的话”</span><span ttm:role="x-roman">yami ni obieru nara ba”</span></p><p begin="1:14.480" end="1:21.823" itunes:key="L10" ttm:agent="v1"><span begin="1:14.480" end="1:14.803">た</span><span begin="1:14.803" end="1:15.113">だ</span> <span begin="1:15.113" end="1:16.053">前</span><span begin="1:16.053" end="1:16.653">を</span><span begin="1:16.653" end="1:17.263">向</span><span begin="1:17.263" end="1:17.573">い</span><span begin="1:17.573" end="1:18.193">て</span> <span begin="1:18.193" end="1:18.783">歩</span><span begin="1:18.783" end="1:19.143">こ</span><span begin="1:19.143" end="1:21.823">う</span><span ttm:role="x-translation" xml:lang="zh-Hans">只能 向前方 不断奔跑</span><span ttm:role="x-roman">tada mae o mui te arukou</span></p><p begin="1:26.180" end="1:30.793" itunes:key="L11" ttm:agent="v1"><span begin="1:26.180" end="1:26.853">“夢</span><span begin="1:26.853" end="1:27.743">を</span><span begin="1:27.743" end="1:28.043">見</span><span begin="1:28.043" end="1:28.313">る</span><span begin="1:28.313" end="1:28.603">よ</span><span begin="1:28.603" end="1:28.953">う</span><span begin="1:28.953" end="1:30.793">に</span><span ttm:role="x-translation" xml:lang="zh-Hans">“真像做梦一样啊</span><span ttm:role="x-roman">“yume o miru you ni</span></p><p begin="1:31.062" end="1:35.773" itunes:key="L12" ttm:agent="v1"><span begin="1:31.062" end="1:31.350">夜</span><span begin="1:31.350" end="1:32.613">空</span><span begin="1:32.613" end="1:32.793">の</span><span begin="1:32.793" end="1:33.643">謎</span><span begin="1:33.643" end="1:33.853">を</span><span begin="1:33.853" end="1:34.133">解</span><span begin="1:34.133" end="1:34.460">き</span><span begin="1:34.460" end="1:34.763">明</span><span begin="1:34.763" end="1:34.900">か</span><span begin="1:34.900" end="1:35.253">し</span><span begin="1:35.253" end="1:35.773">て</span><span ttm:role="x-translation" xml:lang="zh-Hans">将宇宙之谜阐明殆尽</span><span ttm:role="x-roman">yozora no nazo o tokiakashi te</span></p><p begin="1:35.971" end="1:40.603" itunes:key="L13" ttm:agent="v1"><span begin="1:35.971" end="1:36.613">辿</span><span begin="1:36.613" end="1:37.517">る</span><span begin="1:37.517" end="1:37.843">未</span><span begin="1:37.843" end="1:38.163">知</span><span begin="1:38.163" end="1:38.443">の</span><span begin="1:38.443" end="1:39.353">数</span><span begin="1:39.353" end="1:39.533">だ</span><span begin="1:39.533" end="1:40.603">け”</span><span ttm:role="x-translation" xml:lang="zh-Hans">探索着未知的未来”</span><span ttm:role="x-roman">tadoru michi no kazu dake”</span></p><p begin="1:40.883" end="1:47.503" itunes:key="L14" ttm:agent="v1"><span begin="1:40.883" end="1:41.203">積</span><span begin="1:41.203" end="1:41.473">み</span><span begin="1:41.473" end="1:42.093">重</span><span begin="1:42.093" end="1:42.273">ね</span><span begin="1:42.273" end="1:42.543">て</span><span begin="1:42.543" end="1:43.303">く</span> <span begin="1:43.303" end="1:43.643">時</span><span begin="1:43.643" end="1:44.283">間</span><span begin="1:44.283" end="1:44.533">の</span><span begin="1:44.533" end="1:45.033">限</span><span begin="1:45.033" end="1:45.513">り</span> <span begin="1:45.513" end="1:46.113">今</span><span begin="1:46.113" end="1:46.433">で</span><span begin="1:46.433" end="1:47.503">も</span><span ttm:role="x-translation" xml:lang="zh-Hans">无数次往复 在有限的时间中</span><span ttm:role="x-roman">tsumikasane te ku jikan no kagiri ima de mo</span></p><p begin="1:47.921" end="1:53.223" itunes:key="L15" ttm:agent="v1"><span begin="1:47.921" end="1:48.553">星</span><span begin="1:48.553" end="1:48.833">を</span><span begin="1:48.833" end="1:49.453">追</span><span begin="1:49.453" end="1:50.073">い</span><span begin="1:50.073" end="1:50.363">か</span><span begin="1:50.363" end="1:50.683">け</span><span begin="1:50.683" end="1:51.313">て</span><span begin="1:51.313" end="1:53.223">る</span><span ttm:role="x-translation" xml:lang="zh-Hans">我依旧追逐着群星</span><span ttm:role="x-roman">hoshi o oikake teru</span></p><p begin="2:10.784" end="2:14.500" itunes:key="L16" ttm:agent="v2"><span begin="2:10.784" end="2:11.413">誰</span><span begin="2:11.413" end="2:11.733">も</span><span begin="2:11.733" end="2:12.343">い</span><span begin="2:12.343" end="2:12.630">な</span><span begin="2:12.630" end="2:12.933">い</span><span begin="2:12.933" end="2:13.193">世</span><span begin="2:13.193" end="2:13.843">界</span><span begin="2:13.843" end="2:14.500">で</span><span ttm:role="x-translation" xml:lang="zh-Hans">在空无一人的世界之中</span><span ttm:role="x-roman">dare mo i nai sekai de</span></p><p begin="2:15.006" end="2:19.973" itunes:key="L17" ttm:agent="v2"><span begin="2:15.006" end="2:15.353">時</span><span begin="2:15.353" end="2:15.963">間</span><span begin="2:15.963" end="2:16.263">だ</span><span begin="2:16.263" end="2:16.593">け</span><span begin="2:16.593" end="2:17.040">が</span><span begin="2:17.040" end="2:17.493">過</span><span begin="2:17.493" end="2:17.773">ぎ</span><span begin="2:17.773" end="2:18.383">て</span><span begin="2:18.383" end="2:18.973">い</span><span begin="2:18.973" end="2:19.973">く</span><span ttm:role="x-translation" xml:lang="zh-Hans">光阴在我眼中似水消逝</span><span ttm:role="x-roman">jikan dake ga sugi te iku</span></p><p begin="2:21.080" end="2:23.523" itunes:key="L18" ttm:agent="v2"><span begin="2:21.080" end="2:21.393">い</span><span begin="2:21.393" end="2:22.023">つ</span><span begin="2:22.023" end="2:22.313">の</span><span begin="2:22.313" end="2:22.623">日</span><span begin="2:22.623" end="2:22.973">に</span><span begin="2:22.973" end="2:23.523">か</span><span ttm:role="x-translation" xml:lang="zh-Hans">终有一日</span><span ttm:role="x-roman">itsu no hi ni ka</span></p><p begin="2:23.819" end="2:30.143" itunes:key="L19" ttm:agent="v2"><span begin="2:23.819" end="2:24.143">終</span><span begin="2:24.143" end="2:24.433">わ</span><span begin="2:24.433" end="2:24.733">る</span><span begin="2:24.733" end="2:25.053">夜</span><span begin="2:25.053" end="2:26.890">を</span> <span begin="2:27.748" end="2:27.940">惜</span><span begin="2:27.940" end="2:28.413">し</span><span begin="2:28.413" end="2:28.683">み</span><span begin="2:28.683" end="2:29.273">な</span><span begin="2:29.273" end="2:29.590">が</span><span begin="2:29.590" end="2:30.143">ら</span><span ttm:role="x-translation" xml:lang="zh-Hans">遗憾着夜晚的逝去</span><span ttm:role="x-roman">owaru yoru o oshimi nagara</span></p><p begin="2:30.145" end="2:34.440" itunes:key="L20" ttm:agent="v1"><span begin="2:30.145" end="2:30.513">“繰</span><span begin="2:30.513" end="2:30.793">り</span><span begin="2:30.793" end="2:31.620">返</span><span begin="2:31.620" end="2:31.993">す</span><span begin="2:31.993" end="2:32.613">夢</span><span begin="2:32.613" end="2:32.933">の</span><span begin="2:32.933" end="2:33.563">中</span><span begin="2:33.563" end="2:34.440">で</span><span ttm:role="x-translation" xml:lang="zh-Hans">“循环往复的烟梦之中</span><span ttm:role="x-roman">“kurikaesu yume no naka de</span></p><p begin="2:35.011" end="2:39.423" itunes:key="L21" ttm:agent="v2"><span begin="2:35.011" end="2:35.633">明</span><span begin="2:35.633" end="2:35.943">日</span><span begin="2:35.943" end="2:36.543">に</span> <span begin="2:36.543" end="2:36.900">手</span><span begin="2:36.900" end="2:37.173">を</span><span begin="2:37.173" end="2:37.763">伸</span><span begin="2:37.763" end="2:38.113">ば</span><span begin="2:38.113" end="2:38.363">し</span><span begin="2:38.363" end="2:39.423">て”</span><span ttm:role="x-translation" xml:lang="zh-Hans">把手向着明日之景探去”</span><span ttm:role="x-roman">asu ni te o nobashi te”</span></p><p begin="2:39.874" end="2:47.040" itunes:key="L22" ttm:agent="v1"><span begin="2:39.874" end="2:40.233">た</span><span begin="2:40.233" end="2:40.523">だ</span> <span begin="2:40.523" end="2:41.453">前</span><span begin="2:41.453" end="2:42.063">を</span><span begin="2:42.063" end="2:42.622">向</span><span begin="2:42.622" end="2:42.923">い</span><span begin="2:42.923" end="2:43.543">て</span> <span begin="2:43.543" end="2:44.123">歩</span><span begin="2:44.123" end="2:44.433">こ</span><span begin="2:44.433" end="2:47.040">う</span><span ttm:role="x-translation" xml:lang="zh-Hans">只能 向前方 不断奔跑</span><span ttm:role="x-roman">tada mae o mui te arukou</span></p><p begin="2:51.368" end="2:55.893" itunes:key="L23" ttm:agent="v1"><span begin="2:51.368" end="2:52.003">“夢</span><span begin="2:52.003" end="2:52.883">を</span><span begin="2:52.883" end="2:53.203">見</span><span begin="2:53.203" end="2:53.513">る</span><span begin="2:53.513" end="2:53.853">た</span><span begin="2:53.853" end="2:54.183">び</span><span begin="2:54.183" end="2:55.893">に</span><span ttm:role="x-translation" xml:lang="zh-Hans">“陷入梦境所见的</span><span ttm:role="x-roman">“yume o miru tabi ni</span></p><p begin="2:51.997" end="2:56.493" itunes:key="L24" ttm:agent="v2"><span begin="2:51.997" end="2:53.513">夢</span><span begin="2:53.513" end="2:54.680">を</span><span begin="2:54.680" end="2:55.023">見</span><span begin="2:55.023" end="2:55.333">る</span><span begin="2:55.333" end="2:55.893">た</span><span begin="2:55.893" end="2:56.213">び</span><span begin="2:56.213" end="2:56.493">に</span><span ttm:role="x-translation" xml:lang="zh-Hans">正如次次梦见的</span><span ttm:role="x-roman">yume o miru tabi ni</span></p><p begin="2:56.492" end="3:00.710" itunes:key="L25" ttm:agent="v1"><span begin="2:56.492" end="2:57.433">瞳</span><span begin="2:57.433" end="2:57.713">に</span><span begin="2:57.713" end="2:58.643">映</span><span begin="2:58.643" end="2:58.903">し</span><span begin="2:58.903" end="2:59.223">た</span> <span begin="2:59.223" end="2:59.813">星</span><span begin="2:59.813" end="3:00.253">空</span><span begin="3:00.253" end="3:00.710">が</span><span ttm:role="x-translation" xml:lang="zh-Hans">印在瞳孔深处的 那片星空</span><span ttm:role="x-roman">hitomi ni utsushi ta hoshizora ga</span></p><p begin="2:57.147" end="3:00.710" itunes:key="L26" ttm:agent="v2"><span begin="2:57.147" end="2:57.713">偽</span><span begin="2:57.713" end="2:58.903">物</span><span begin="2:58.903" end="2:59.223">の</span><span begin="2:59.223" end="2:59.813">星</span><span begin="2:59.813" end="3:00.253">空</span><span begin="3:00.253" end="3:00.710">が</span><span ttm:role="x-translation" xml:lang="zh-Hans">未曾见过的星夜</span><span ttm:role="x-roman">nisemono no hoshizora ga</span></p><p begin="3:01.066" end="3:05.513" itunes:key="L27" ttm:agent="v1"><span begin="3:01.066" end="3:01.603">続</span><span begin="3:01.603" end="3:02.513">く</span><span begin="3:02.513" end="3:02.803">現</span><span begin="3:02.803" end="3:03.103">実</span><span begin="3:03.103" end="3:03.403">と</span><span begin="3:03.403" end="3:04.033">幻</span><span begin="3:04.033" end="3:04.607">想</span><span begin="3:04.607" end="3:05.513">を”</span><span ttm:role="x-translation" xml:lang="zh-Hans">连接着现实（今日）与幻想（明日）”</span><span ttm:role="x-roman">tsudzuku genjitsu to gensou o”</span></p><p begin="3:01.599" end="3:06.123" itunes:key="L28" ttm:agent="v2"><span begin="3:01.599" end="3:03.640">涙</span><span begin="3:03.640" end="3:04.033">さ</span><span begin="3:04.033" end="3:04.603">え</span> <span begin="3:04.603" end="3:05.513">流</span><span begin="3:05.513" end="3:05.823">し</span><span begin="3:05.823" end="3:06.123">て</span><span ttm:role="x-translation" xml:lang="zh-Hans">泪如雨下</span><span ttm:role="x-roman">namida sae nagashi te</span></p><p begin="3:05.816" end="3:12.488" itunes:key="L29" ttm:agent="v1"><span begin="3:05.816" end="3:06.393">繋</span><span begin="3:06.393" end="3:06.633">ぎ</span><span begin="3:06.633" end="3:06.993">合</span><span begin="3:06.993" end="3:07.173">わ</span><span begin="3:07.173" end="3:07.453">せ</span><span begin="3:07.453" end="3:07.953">る</span> <span begin="3:08.191" end="3:08.533">境</span><span begin="3:08.533" end="3:09.120">界</span><span begin="3:09.120" end="3:09.423">を</span><span begin="3:09.423" end="3:09.563">超</span><span begin="3:09.563" end="3:09.863">え</span><span begin="3:09.863" end="3:10.293">て</span> <span begin="3:10.293" end="3:10.933">今</span><span begin="3:10.933" end="3:11.263">で</span><span begin="3:11.263" end="3:12.488">も</span><span ttm:role="x-translation" xml:lang="zh-Hans">延伸在一处 现在就飞越境界（世界）</span><span ttm:role="x-roman">tsunagiawaseru kyoukai o koe te ima de mo</span></p><p begin="3:06.987" end="3:12.483" itunes:key="L30" ttm:agent="v2"><span begin="3:06.987" end="3:07.453">明</span><span begin="3:07.453" end="3:07.953">日</span><span begin="3:07.953" end="3:08.193">に</span> <span begin="3:08.857" end="3:09.863">続</span><span begin="3:09.863" end="3:10.603">い</span><span begin="3:10.603" end="3:11.250">て</span><span begin="3:11.250" end="3:12.483">る</span><span ttm:role="x-translation" xml:lang="zh-Hans">天明仍落</span><span ttm:role="x-roman">asu ni tsudzui teru</span></p><p begin="3:12.662" end="3:16.421" itunes:key="L31" ttm:agent="v1"><span begin="3:12.662" end="3:13.283">星</span><span begin="3:13.283" end="3:13.573">を</span><span begin="3:13.573" end="3:14.133">追</span><span begin="3:14.133" end="3:14.713">い</span><span begin="3:14.713" end="3:15.003">か</span><span begin="3:15.003" end="3:15.293">け</span><span begin="3:15.293" end="3:15.883">て</span><span begin="3:15.883" end="3:16.421">る</span><span ttm:role="x-translation" xml:lang="zh-Hans">追逐夜空转瞬即逝的银星</span><span ttm:role="x-roman">hoshi o oikake teru</span></p><p begin="3:12.677" end="3:17.073" itunes:key="L32" ttm:agent="v2"><span begin="3:12.677" end="3:13.283">星</span><span begin="3:13.283" end="3:13.573">を</span><span begin="3:13.573" end="3:14.133">追</span><span begin="3:14.133" end="3:14.713">い</span><span begin="3:14.713" end="3:15.003">か</span><span begin="3:15.003" end="3:15.293">け</span><span begin="3:15.293" end="3:15.883">て</span><span begin="3:15.883" end="3:17.073">る</span><span ttm:role="x-translation" xml:lang="zh-Hans">追逐夜空繁星</span><span ttm:role="x-roman">hoshi o oikake teru</span></p><p begin="3:15.878" end="3:20.233" itunes:key="L33" ttm:agent="v1"><span begin="3:15.878" end="3:16.420">出</span><span begin="3:16.420" end="3:17.073">会</span><span begin="3:17.073" end="3:17.303">い</span><span begin="3:17.303" end="3:17.800">が</span> <span begin="3:17.800" end="3:18.443">運</span><span begin="3:18.443" end="3:19.283">命</span><span begin="3:19.283" end="3:19.853">な</span><span begin="3:19.853" end="3:20.233">ら</span><span ttm:role="x-translation" xml:lang="zh-Hans">二人的相遇如同命定</span><span ttm:role="x-roman">deai ga unmei nara</span></p><p begin="3:20.403" end="3:24.743" itunes:key="L34" ttm:agent="v1"><span begin="3:20.403" end="3:21.583">流</span><span begin="3:21.583" end="3:21.883">れ</span><span begin="3:21.883" end="3:22.133">る</span><span begin="3:22.133" end="3:23.303">涙</span><span begin="3:23.303" end="3:24.743">も</span><span ttm:role="x-translation" xml:lang="zh-Hans">为此哽咽的泪水</span><span ttm:role="x-roman">nagareru namida mo</span></p><p begin="3:20.410" end="3:26.153" itunes:key="L35" ttm:agent="v2"><span begin="3:20.410" end="3:21.583">い</span><span begin="3:21.583" end="3:22.433">つ</span><span begin="3:22.433" end="3:23.640">か</span><span begin="3:23.640" end="3:24.140">物</span><span begin="3:24.140" end="3:25.003">語</span><span begin="3:25.003" end="3:26.153">が</span><span ttm:role="x-translation" xml:lang="zh-Hans">如同曾经故事</span><span ttm:role="x-roman">itsu ka monogatari ga</span></p><p begin="3:25.007" end="3:31.330" itunes:key="L36" ttm:agent="v1"><span begin="3:25.007" end="3:25.305">止</span><span begin="3:25.305" end="3:25.623">ま</span><span begin="3:25.623" end="3:26.153">ら</span><span begin="3:26.153" end="3:26.413">な</span><span begin="3:26.413" end="3:27.013">い</span> <span begin="3:27.013" end="3:27.593">止</span><span begin="3:27.593" end="3:27.863">め</span><span begin="3:27.863" end="3:28.153">ら</span><span begin="3:28.153" end="3:28.433">れ</span><span begin="3:28.433" end="3:28.663">な</span><span begin="3:28.663" end="3:28.993">い</span><span begin="3:28.993" end="3:29.583">か</span><span begin="3:29.583" end="3:31.330">ら</span><span ttm:role="x-translation" xml:lang="zh-Hans">无法停下的滴落 命运已无法逃开</span><span ttm:role="x-roman">tomara nai tome rare nai kara</span></p><p begin="3:31.860" end="3:35.493" itunes:key="L37" ttm:agent="v2"><span begin="3:31.860" end="3:32.453">終</span><span begin="3:32.453" end="3:32.753">わ</span><span begin="3:32.753" end="3:33.283">る</span><span begin="3:33.283" end="3:33.583">場</span><span begin="3:33.583" end="3:34.143">所</span><span begin="3:34.143" end="3:35.493">で</span><span ttm:role="x-translation" xml:lang="zh-Hans">最终结束的地点</span><span ttm:role="x-roman">owaru basho de</span></p><p begin="3:34.142" end="3:38.113" itunes:key="L38" ttm:agent="v1"><span begin="3:34.142" end="3:35.080">心</span><span begin="3:35.080" end="3:35.593">の</span><span begin="3:35.593" end="3:36.140">嘘</span><span begin="3:36.140" end="3:36.713">を</span><span begin="3:36.713" end="3:36.973">暴</span><span begin="3:36.973" end="3:37.273">い</span><span begin="3:37.273" end="3:38.113">て</span><span ttm:role="x-translation" xml:lang="zh-Hans">被揭发了藏在心底的谎言</span><span ttm:role="x-roman">kokoro no uso o abai te</span></p><p begin="3:35.868" end="3:38.113" itunes:key="L39" ttm:agent="v2"><span begin="3:35.868" end="3:36.983">二</span><span begin="3:36.983" end="3:37.273">人</span><span begin="3:37.273" end="3:38.113">で</span><span ttm:role="x-translation" xml:lang="zh-Hans">二人向着</span><span ttm:role="x-roman">futari de</span></p><p begin="3:38.118" end="3:42.853" itunes:key="L40" ttm:agent="v1"><span begin="3:38.118" end="3:38.683">何</span><span begin="3:38.683" end="3:39.273">度</span><span begin="3:39.273" end="3:39.543">で</span><span begin="3:39.543" end="3:40.093">も</span> <span begin="3:40.093" end="3:40.673">夢</span><span begin="3:40.673" end="3:41.243">の</span><span begin="3:41.243" end="3:41.843">先</span><span begin="3:41.843" end="3:42.853">へ</span><span ttm:role="x-translation" xml:lang="zh-Hans">无论几次都向着梦的前方走去</span><span ttm:role="x-roman">nan do de mo yume no saki e</span></p><p begin="3:38.683" end="3:42.853" itunes:key="L41" ttm:agent="v2"><span begin="3:38.683" end="3:38.983">目</span><span begin="3:38.983" end="3:39.273">指</span><span begin="3:39.273" end="3:39.543">し</span><span begin="3:39.543" end="3:40.093">た</span> <span begin="3:40.093" end="3:40.673">夢</span><span begin="3:40.673" end="3:41.250">の</span><span begin="3:41.250" end="3:41.843">先</span><span begin="3:41.843" end="3:42.853">へ</span><span ttm:role="x-translation" xml:lang="zh-Hans">相同之梦不断前行</span><span ttm:role="x-roman">mezashi ta yume no saki e</span></p><p begin="3:43.195" end="3:50.010" itunes:key="L42" ttm:agent="v1"><span begin="3:43.204" end="3:43.690">“『偽</span><span begin="3:43.690" end="3:44.160">物</span><span begin="3:44.160" end="3:44.623">の</span><span begin="3:44.623" end="3:44.983">星</span><span begin="3:44.983" end="3:45.263">空』</span><span begin="3:45.263" end="3:46.050">を</span> <span begin="3:46.273" end="3:46.593">見</span><span begin="3:46.593" end="3:46.893">上</span><span begin="3:46.893" end="3:47.173">げ</span><span begin="3:47.173" end="3:47.453">な</span><span begin="3:47.453" end="3:47.733">が</span><span begin="3:47.733" end="3:50.010">ら”</span><span ttm:role="x-translation" xml:lang="zh-Hans">“抬头望着那片『晦伪的星空』 ”</span><span ttm:role="x-roman">“『nisemono no hoshizora』o miage nagara”</span><span ttm:role="x-bg" begin="3:43.195" end="3:46.050"><span begin="3:43.195" end="3:43.513">(見</span><span begin="3:43.513" end="3:43.773">知</span><span begin="3:43.773" end="3:44.073">ら</span><span begin="3:44.073" end="3:44.510">ぬ</span><span begin="3:44.510" end="3:44.983">空</span><span begin="3:44.983" end="3:46.050">を)</span><span ttm:role="x-translation" xml:lang="zh-Hans">未曾见过的星空</span><span ttm:role="x-roman">mishira nu sora o</span></span></p><p begin="3:53.454" end="3:57.550" itunes:key="L43" ttm:agent="v2"><span begin="3:53.454" end="3:54.043">夢</span><span begin="3:54.043" end="3:54.333">か</span><span begin="3:54.333" end="3:55.560">ら</span><span begin="3:55.560" end="3:56.043">醒</span><span begin="3:56.043" end="3:56.323">め</span><span begin="3:56.323" end="3:56.563">て</span><span begin="3:56.563" end="3:57.550">も</span><span ttm:role="x-translation" xml:lang="zh-Hans">尽管已从梦中醒来</span><span ttm:role="x-roman">yume kara same te mo</span></p><p begin="3:57.730" end="4:08.520" itunes:key="L44" ttm:agent="v2"><span begin="3:57.730" end="3:58.653">二</span><span begin="3:58.653" end="3:58.973">人</span><span begin="3:58.973" end="4:01.533">の</span> <span begin="4:02.085" end="4:02.983">物</span><span begin="4:02.983" end="4:03.858">語</span><span begin="4:03.858" end="4:04.630">は</span> <span begin="4:04.630" end="4:05.333">続</span><span begin="4:05.333" end="4:05.603">い</span><span begin="4:05.603" end="4:05.903">て</span><span begin="4:05.903" end="4:08.520">る</span><span ttm:role="x-translation" xml:lang="zh-Hans">二人的故事 却还远未结束。</span><span ttm:role="x-roman">futari no monogatari wa tsudzui teru</span></p><p begin="4:12.588" end="4:17.113" itunes:key="L45" ttm:agent="v1"><span begin="4:12.588" end="4:13.233">“夢</span><span begin="4:13.233" end="4:14.173">を</span><span begin="4:14.173" end="4:14.480">見</span><span begin="4:14.480" end="4:14.723">る</span><span begin="4:14.723" end="4:15.043">よ</span><span begin="4:15.043" end="4:15.383">う</span><span begin="4:15.383" end="4:17.113">に</span><span ttm:role="x-translation" xml:lang="zh-Hans">“真像在做梦一样</span><span ttm:role="x-roman">“yume o miru you ni</span></p><p begin="4:17.374" end="4:21.953" itunes:key="L46" ttm:agent="v1"><span begin="4:17.374" end="4:17.733">世</span><span begin="4:17.733" end="4:18.983">界</span><span begin="4:18.983" end="4:19.133">の</span><span begin="4:19.133" end="4:19.893">謎</span><span begin="4:19.893" end="4:20.183">を</span><span begin="4:20.183" end="4:20.453">解</span><span begin="4:20.453" end="4:20.710">き</span><span begin="4:20.710" end="4:21.033">明</span><span begin="4:21.033" end="4:21.253">か</span><span begin="4:21.253" end="4:21.523">し</span><span begin="4:21.523" end="4:21.953">て</span><span ttm:role="x-translation" xml:lang="zh-Hans">不断解析世界之谜</span><span ttm:role="x-roman">sekai no nazo o tokiakashi te</span></p><p begin="4:22.239" end="4:26.487" itunes:key="L47" ttm:agent="v2"><span begin="4:22.239" end="4:22.883">描</span><span begin="4:22.883" end="4:23.733">く</span><span begin="4:23.733" end="4:24.353">天</span><span begin="4:24.353" end="4:24.963">球</span><span begin="4:24.963" end="4:26.487">儀”</span><span ttm:role="x-translation" xml:lang="zh-Hans">描绘着天球仪”</span><span ttm:role="x-roman">egaku tenkyuu gi”</span><span ttm:role="x-bg" begin="4:23.737" end="4:26.480"><span begin="4:23.737" end="4:24.053">(夜</span><span begin="4:24.053" end="4:24.653">空</span><span begin="4:24.653" end="4:24.963">の</span><span begin="4:24.963" end="4:25.723">星</span><span begin="4:25.723" end="4:26.480">で)</span><span ttm:role="x-translation" xml:lang="zh-Hans">夜空之中河外星云</span><span ttm:role="x-roman">yozora no hoshi de</span></span></p><p begin="4:26.988" end="4:31.443" itunes:key="L48" ttm:agent="v2"><span begin="4:26.988" end="4:27.663">二</span><span begin="4:27.663" end="4:27.973">人</span><span begin="4:27.973" end="4:28.280">の</span><span begin="4:28.280" end="4:28.403">未</span><span begin="4:28.403" end="4:28.783">知</span><span begin="4:28.783" end="4:29.463">を</span> <span begin="4:29.463" end="4:30.053">前</span><span begin="4:30.053" end="4:30.310">に</span><span begin="4:30.310" end="4:30.823">進</span><span begin="4:30.823" end="4:31.083">め</span><span begin="4:31.083" end="4:31.443">る</span><span ttm:role="x-translation" xml:lang="zh-Hans">二人向着未知之物 不断前行</span><span ttm:role="x-roman">futari no michi o mae ni susumeru</span></p><p begin="4:31.443" end="4:38.503" itunes:key="L49" ttm:agent="v1"><span begin="4:31.443" end="4:32.173">今</span><span begin="4:32.173" end="4:32.473">で</span><span begin="4:32.473" end="4:33.953">も</span><span begin="4:33.953" end="4:34.533">星</span><span begin="4:34.533" end="4:34.833">を</span><span begin="4:34.833" end="4:35.383">追</span><span begin="4:35.383" end="4:35.973">い</span><span begin="4:35.973" end="4:36.263">か</span><span begin="4:36.263" end="4:36.563">け</span><span begin="4:36.563" end="4:37.093">て</span><span begin="4:37.093" end="4:38.503">る</span><span ttm:role="x-translation" xml:lang="zh-Hans">如今依然追逐着群星之谜</span><span ttm:role="x-roman">ima de mo hoshi o oikake teru</span></p><p begin="4:37.179" end="4:45.730" itunes:key="L50" ttm:agent="v1"><span begin="4:37.179" end="4:38.273">“春、</span><span begin="4:38.273" end="4:39.213">夏、</span><span begin="4:39.213" end="4:39.963">秋</span><span begin="4:39.963" end="4:40.543">か</span><span begin="4:40.543" end="4:40.843">ら</span><span begin="4:40.843" end="4:41.673">冬</span><span begin="4:41.673" end="4:42.283">へ</span><span begin="4:42.283" end="4:42.540">変</span><span begin="4:42.540" end="4:42.843">わ</span><span begin="4:42.843" end="4:43.170">り</span><span begin="4:43.170" end="4:43.393">ゆ</span><span begin="4:43.393" end="4:43.683">く</span><span begin="4:43.683" end="4:44.273">季</span><span begin="4:44.273" end="4:44.543">節</span><span begin="4:44.543" end="4:45.730">は”</span><span ttm:role="x-translation" xml:lang="zh-Hans">“春、夏、秋向着冬转变 不断远去的无情四季（时间）”</span><span ttm:role="x-roman">“haru、natsu、aki kara fuyu e kawariyuku kisetsu wa”</span></p><p begin="4:41.789" end="4:47.423" itunes:key="L51" ttm:agent="v2"><span begin="4:41.789" end="4:42.843">い</span><span begin="4:42.843" end="4:43.683">つ</span><span begin="4:43.683" end="4:44.543">も</span> <span begin="4:44.543" end="4:45.560">物</span><span begin="4:45.560" end="4:46.273">語</span><span begin="4:46.273" end="4:47.423">が</span><span ttm:role="x-translation" xml:lang="zh-Hans">一如既往 故事</span><span ttm:role="x-roman">itsu mo monogatari ga</span></p><p begin="4:46.265" end="4:52.580" itunes:key="L52" ttm:agent="v1"><span begin="4:46.265" end="4:46.573">止</span><span begin="4:46.573" end="4:46.930">ま</span><span begin="4:46.930" end="4:47.423">ら</span><span begin="4:47.423" end="4:47.740">な</span><span begin="4:47.740" end="4:48.253">い</span> <span begin="4:48.253" end="4:48.835">止</span><span begin="4:48.835" end="4:49.123">め</span><span begin="4:49.123" end="4:49.413">ら</span><span begin="4:49.413" end="4:49.683">れ</span><span begin="4:49.683" end="4:49.913">な</span><span begin="4:49.913" end="4:50.253">い</span><span begin="4:50.253" end="4:50.833">か</span><span begin="4:50.833" end="4:52.580">ら</span><span ttm:role="x-translation" xml:lang="zh-Hans">无法停止这四季轮回 亦无法逃开命运</span><span ttm:role="x-roman">tomara nai tome rare nai kara</span></p><p begin="4:53.136" end="4:56.630" itunes:key="L53" ttm:agent="v2"><span begin="4:53.136" end="4:54.003">続</span><span begin="4:54.003" end="4:54.543">く</span><span begin="4:54.543" end="4:54.850">よ</span><span begin="4:54.850" end="4:55.403">う</span><span begin="4:55.403" end="4:56.630">に</span><span ttm:role="x-translation" xml:lang="zh-Hans">如常延续</span><span ttm:role="x-roman">tsudzuku you ni</span></p><p begin="4:55.398" end="5:03.768" itunes:key="L54" ttm:agent="v1"><span begin="4:55.398" end="4:55.980">二</span><span begin="4:55.980" end="4:56.290">人</span><span begin="4:56.290" end="4:56.773">の</span><span begin="4:56.773" end="4:57.663">瞳</span><span begin="4:57.663" end="4:58.253">重</span><span begin="4:58.253" end="4:58.533">ね</span><span begin="4:58.533" end="4:59.383">て</span> <span begin="4:59.383" end="4:59.923">何</span><span begin="4:59.923" end="5:00.503">度</span><span begin="5:00.503" end="5:00.783">で</span><span begin="5:00.783" end="5:01.363">も</span> <span begin="5:01.363" end="5:01.923">夢</span><span begin="5:01.923" end="5:02.400">の</span><span begin="5:02.400" end="5:03.063">先</span><span begin="5:03.063" end="5:03.768">へ</span><span ttm:role="x-translation" xml:lang="zh-Hans">彼此对视之时 无论几次都向着梦的前方走去</span><span ttm:role="x-roman">futari no hitomi kasane te nan do de mo yume no saki e</span></p><p begin="4:57.120" end="5:03.768" itunes:key="L55" ttm:agent="v2"><span begin="4:57.120" end="4:57.663">二</span><span begin="4:57.663" end="4:58.533">人</span><span begin="4:58.533" end="4:59.383">で</span> <span begin="4:59.928" end="5:00.190">目</span><span begin="5:00.190" end="5:00.410">指</span><span begin="5:00.410" end="5:00.783">し</span><span begin="5:00.783" end="5:01.363">た</span> <span begin="5:01.363" end="5:01.923">夢</span><span begin="5:01.923" end="5:02.390">の</span><span begin="5:02.390" end="5:03.063">先</span><span begin="5:03.063" end="5:03.768">へ</span><span ttm:role="x-translation" xml:lang="zh-Hans">二人向着相同之梦不断前行</span><span ttm:role="x-roman">futari de mezashi ta yume no saki e</span></p><p begin="5:04.453" end="5:11.175" itunes:key="L56" ttm:agent="v1"><span begin="5:04.475" end="5:04.763">『見</span><span begin="5:04.763" end="5:05.033">果</span><span begin="5:05.033" end="5:05.333">て</span><span begin="5:05.333" end="5:05.693">ぬ</span><span begin="5:05.693" end="5:06.143">星</span><span begin="5:06.143" end="5:06.443">空』</span><span begin="5:06.443" end="5:07.290">を</span> <span begin="5:07.595" end="5:07.883">見</span><span begin="5:07.883" end="5:08.143">上</span><span begin="5:08.143" end="5:08.423">げ</span><span begin="5:08.423" end="5:08.713">な</span><span begin="5:08.713" end="5:08.953">が</span><span begin="5:08.953" end="5:11.175">ら…”</span><span ttm:role="x-translation" xml:lang="zh-Hans">“抬头望着那片无尽的夜空”</span><span ttm:role="x-roman">『mi hate nu hoshizora』o miage nagara…”</span><span ttm:role="x-bg" begin="5:04.453" end="5:07.300"><span begin="5:04.453" end="5:04.733">(見</span><span begin="5:04.763" end="5:05.033">知</span><span begin="5:05.033" end="5:05.333">ら</span><span begin="5:05.333" end="5:05.730">ぬ</span><span begin="5:05.730" end="5:06.443">空</span><span begin="5:06.443" end="5:07.300">を)</span><span ttm:role="x-translation" xml:lang="zh-Hans">从未遇见的夜空</span><span ttm:role="x-roman">mishira nu sora o</span></span></p><p begin="5:13.491" end="5:20.380" itunes:key="L57" ttm:agent="v1"><span begin="5:13.491" end="5:13.783">不</span><span begin="5:13.783" end="5:14.083">思</span><span begin="5:14.083" end="5:14.353">議</span><span begin="5:14.353" end="5:14.933">な</span><span begin="5:14.933" end="5:15.523">夜</span><span begin="5:15.523" end="5:16.653">の</span><span begin="5:16.653" end="5:16.893">向</span><span begin="5:16.893" end="5:17.206">こ</span><span begin="5:17.206" end="5:17.493">う</span><span begin="5:17.493" end="5:18.100">側</span><span begin="5:18.100" end="5:20.380">へ</span><span ttm:role="x-translation" xml:lang="zh-Hans">向着那 不可思议夜空的另一侧 前行</span><span ttm:role="x-roman">fushigi na yoru no mukougawa e</span></p></div></body></tt>