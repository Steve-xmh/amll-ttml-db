<tt xmlns="http://www.w3.org/ns/ttml" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xmlns:amll="http://www.example.com/ns/amll" itunes:timing="Word" xml:lang="ja"><head><metadata><ttm:agent type="person" xml:id="v1"/><amll:meta key="musicName" value="なにが悪い"/><amll:meta key="artists" value="結束バンド"/><amll:meta key="album" value="なにが悪い"/><amll:meta key="appleMusicId" value="1652476671"/></metadata></head><body dur="3:35.015"><div begin="19.597" end="3:35.015"><p begin="19.597" end="23.919" itunes:key="L1" ttm:agent="v1"><span begin="19.597" end="20.058">あ</span><span begin="20.058" end="21.004">あ</span> <span begin="21.004" end="21.569">夕</span><span begin="21.569" end="22.368">焼け</span><span begin="22.368" end="23.050">みた</span><span begin="23.050" end="23.919">い</span><span ttm:role="x-translation" xml:lang="zh-CN">啊啊 宛如晚霞般绚丽</span></p><p begin="24.074" end="26.985" itunes:key="L2" ttm:agent="v1"><span begin="24.074" end="24.781">みん</span><span begin="24.781" end="25.351">なの</span><span begin="25.351" end="25.727">世</span><span begin="25.727" end="26.985">界</span><span ttm:role="x-translation" xml:lang="zh-CN">大家的世界</span></p><p begin="27.102" end="30.115" itunes:key="L3" ttm:agent="v1"><span begin="27.102" end="27.818">眺</span><span begin="27.818" end="28.558">めて</span><span begin="28.558" end="28.876">い</span><span begin="28.876" end="30.115">る</span><span ttm:role="x-translation" xml:lang="zh-CN">都在眺望着</span></p><p begin="30.206" end="33.234" itunes:key="L4" ttm:agent="v1"><span begin="30.206" end="30.911">太</span><span begin="30.911" end="31.620">陽</span><span begin="31.620" end="32.062">の</span><span begin="32.062" end="32.594">レッ</span><span begin="32.594" end="33.234">ド</span><span ttm:role="x-translation" xml:lang="zh-CN">太阳的红色</span></p><p begin="33.296" end="36.365" itunes:key="L5" ttm:agent="v1"><span begin="33.296" end="33.954">深</span><span begin="33.954" end="34.342">く</span><span begin="34.342" end="34.918">なる</span><span begin="34.918" end="35.298">ブ</span><span begin="35.298" end="36.365">ルー</span><span ttm:role="x-translation" xml:lang="zh-CN">深邃的蓝色</span></p><p begin="36.508" end="39.370" itunes:key="L6" ttm:agent="v1"><span begin="36.508" end="37.348">瞬</span><span begin="37.348" end="37.562">く</span><span begin="37.562" end="38.221">イエ</span><span begin="38.221" end="39.370">ロー</span><span ttm:role="x-translation" xml:lang="zh-CN">明亮的黄色</span></p><p begin="39.598" end="41.865" itunes:key="L7" ttm:agent="v1"><span begin="39.598" end="40.296">色</span><span begin="40.296" end="41.196">づいて</span><span begin="41.196" end="41.865">いく</span><span ttm:role="x-translation" xml:lang="zh-CN">让一切染上斑斓之彩</span></p><p begin="42.067" end="50.470" itunes:key="L8" ttm:agent="v1"><span begin="42.067" end="43.656">僕</span><span begin="43.656" end="44.420">の</span><span begin="44.420" end="45.639">嬉しい、</span><span begin="45.639" end="46.794">楽しい、</span><span begin="46.794" end="47.819">さみしい、</span><span begin="47.819" end="49.155">感情の</span><span begin="49.155" end="50.470">色彩が</span><span ttm:role="x-translation" xml:lang="zh-CN">我的喜悦、快乐、寂寞的情感色彩</span></p><p begin="50.600" end="55.418" itunes:key="L9" ttm:agent="v1"><span begin="50.600" end="51.676">ついに</span><span begin="51.934" end="52.429">混ざ</span><span begin="52.429" end="52.818">り</span><span begin="52.818" end="53.698">始め</span><span begin="53.698" end="55.418">た</span><span ttm:role="x-translation" xml:lang="zh-CN">终于相互交织</span></p><p begin="55.864" end="58.836" itunes:key="L10" ttm:agent="v1"><span begin="55.864" end="56.292">いつ</span><span begin="56.292" end="56.837">まで</span><span begin="56.837" end="57.351">も</span> <span begin="57.351" end="57.793">いくつ</span><span begin="57.793" end="58.214">まで</span><span begin="58.214" end="58.836">も</span><span ttm:role="x-translation" xml:lang="zh-CN">无论何时 不管多少次</span></p><p begin="58.846" end="1:02.141" itunes:key="L11" ttm:agent="v1"><span begin="58.846" end="59.541">忘</span><span begin="59.541" end="59.939">れ</span><span begin="59.939" end="1:00.594">ない</span><span begin="1:00.594" end="1:01.378">よう</span><span begin="1:01.378" end="1:02.141">に</span><span ttm:role="x-translation" xml:lang="zh-CN">绝不会忘记</span></p><p begin="1:02.348" end="1:06.110" itunes:key="L12" ttm:agent="v1"><span begin="1:02.348" end="1:03.102">鬱</span><span begin="1:03.102" end="1:04.028">向いて</span><span begin="1:04.028" end="1:04.609">塞い</span><span begin="1:04.609" end="1:05.319">でた</span><span begin="1:05.319" end="1:06.110">僕を</span><span ttm:role="x-translation" xml:lang="zh-CN">总是郁郁寡欢的我</span></p><p begin="1:06.120" end="1:09.655" itunes:key="L13" ttm:agent="v1"><span begin="1:06.120" end="1:06.940">見つけ</span><span begin="1:06.940" end="1:07.687">出して</span><span begin="1:07.687" end="1:08.433">くれ</span><span begin="1:08.433" end="1:08.682">た</span><span begin="1:08.682" end="1:09.066">あの</span><span begin="1:09.066" end="1:09.655">日を</span><span ttm:role="x-translation" xml:lang="zh-CN">自将这样的我找出那天起</span></p><p begin="1:09.815" end="1:11.216" itunes:key="L14" ttm:agent="v1"><span begin="1:09.815" end="1:10.305">いつ</span><span begin="1:10.305" end="1:10.786">まで</span><span begin="1:10.786" end="1:11.216">も</span><span ttm:role="x-translation" xml:lang="zh-CN">无论何时</span></p><p begin="1:11.332" end="1:14.677" itunes:key="L15" ttm:agent="v1"><span begin="1:11.332" end="1:12.091">夢</span><span begin="1:12.091" end="1:12.729">叶</span><span begin="1:12.729" end="1:13.145">わ</span><span begin="1:13.145" end="1:13.730">なけ</span><span begin="1:13.730" end="1:14.067">り</span><span begin="1:14.067" end="1:14.677">ゃ</span><span ttm:role="x-translation" xml:lang="zh-CN">倘若梦想无法实现的话</span></p><p begin="1:14.718" end="1:18.561" itunes:key="L16" ttm:agent="v1"><span begin="1:14.718" end="1:15.526">僕</span><span begin="1:15.526" end="1:16.377">らは</span><span begin="1:16.377" end="1:17.122">この</span><span begin="1:17.122" end="1:17.846">まま</span><span begin="1:17.846" end="1:18.561">ずっと</span><span ttm:role="x-translation" xml:lang="zh-CN">我们是否将永远如此</span></p><p begin="1:18.601" end="1:22.306" itunes:key="L17" ttm:agent="v1"><span begin="1:18.601" end="1:19.418">隣</span><span begin="1:19.418" end="1:20.111">同士</span><span begin="1:20.111" end="1:20.983">笑って</span><span begin="1:20.983" end="1:21.716">いれる</span><span begin="1:21.716" end="1:22.002">か</span><span begin="1:22.002" end="1:22.306">な</span><span ttm:role="x-translation" xml:lang="zh-CN">而旁观之人是否会嘲笑我们呢</span></p><p begin="1:22.316" end="1:25.716" itunes:key="L18" ttm:agent="v1"><span begin="1:22.316" end="1:22.649">…</span><span begin="1:22.649" end="1:23.486">僕が</span><span begin="1:23.486" end="1:23.900">僕</span><span begin="1:23.900" end="1:24.279">じゃ</span><span begin="1:24.279" end="1:24.687">ない</span><span begin="1:24.687" end="1:25.128">みたい</span><span begin="1:25.128" end="1:25.716">！</span><span ttm:role="x-translation" xml:lang="zh-CN">…我仿佛并非昔日自己！</span></p><p begin="1:37.321" end="1:41.816" itunes:key="L19" ttm:agent="v1"><span begin="1:37.321" end="1:37.888">あ</span><span begin="1:37.888" end="1:38.810">あ</span> <span begin="1:38.810" end="1:39.462">朝</span><span begin="1:39.462" end="1:40.190">焼け</span><span begin="1:40.190" end="1:40.912">みた</span><span begin="1:40.912" end="1:41.816">い</span><span ttm:role="x-translation" xml:lang="zh-CN">啊啊 宛如晚霞般绚丽</span></p><p begin="1:41.933" end="1:44.982" itunes:key="L20" ttm:agent="v1"><span begin="1:41.933" end="1:42.621">眠</span><span begin="1:42.621" end="1:43.018">れ</span><span begin="1:43.018" end="1:43.569">なく</span><span begin="1:43.569" end="1:44.982">て</span><span ttm:role="x-translation" xml:lang="zh-CN">彻夜难眠</span></p><p begin="1:45.059" end="1:47.381" itunes:key="L21" ttm:agent="v1"><span begin="1:45.059" end="1:46.019">空を</span><span begin="1:46.019" end="1:46.679">見て</span><span begin="1:46.679" end="1:47.381">る</span><span ttm:role="x-translation" xml:lang="zh-CN">凝视夜空</span></p><p begin="1:47.479" end="1:56.009" itunes:key="L22" ttm:agent="v1"><span begin="1:47.479" end="1:49.122">僕</span><span begin="1:49.122" end="1:50.025">の</span><span begin="1:50.025" end="1:51.146">苦しい、</span><span begin="1:51.146" end="1:52.233">悔しい、</span><span begin="1:52.233" end="1:53.442">虚しい</span><span begin="1:53.442" end="1:54.584">感情の</span><span begin="1:54.584" end="1:56.009">色彩が</span><span ttm:role="x-translation" xml:lang="zh-CN">我内心痛苦、懊悔、空虚的情感色彩</span></p><p begin="1:56.202" end="2:00.817" itunes:key="L23" ttm:agent="v1"><span begin="1:56.202" end="1:57.309">胸の</span><span begin="1:57.309" end="1:57.846">中</span><span begin="1:57.846" end="1:58.452">ループ</span><span begin="1:58.452" end="1:59.182">してい</span><span begin="1:59.182" end="2:00.817">る</span><span ttm:role="x-translation" xml:lang="zh-CN">在胸腔中循环流转</span></p><p begin="2:01.032" end="2:03.051" itunes:key="L24" ttm:agent="v1"><span begin="2:01.032" end="2:01.934">濁って</span><span begin="2:01.934" end="2:03.051">いく</span><span ttm:role="x-translation" xml:lang="zh-CN">变得浑浊不清</span></p><p begin="2:26.516" end="2:30.247" itunes:key="L25" ttm:agent="v1"><span begin="2:26.516" end="2:27.201">全部</span><span begin="2:27.201" end="2:27.768">混</span><span begin="2:27.768" end="2:28.068">ぜ</span><span begin="2:28.068" end="2:28.671">た</span><span begin="2:28.671" end="2:29.323">パレッ</span><span begin="2:29.323" end="2:29.804">トの</span><span begin="2:29.804" end="2:30.247">上に</span><span ttm:role="x-translation" xml:lang="zh-CN">混杂所有颜色的调色板之上</span></p><p begin="2:30.323" end="2:34.221" itunes:key="L26" ttm:agent="v1"><span begin="2:30.323" end="2:31.714">涙</span><span begin="2:31.714" end="2:32.342">一</span><span begin="2:32.342" end="2:32.976">粒</span><span begin="2:32.976" end="2:33.508">落ちた</span><span begin="2:33.508" end="2:34.221">ら</span><span ttm:role="x-translation" xml:lang="zh-CN">一颗泪滴零落调入</span></p><p begin="2:34.369" end="2:38.863" itunes:key="L27" ttm:agent="v1"><span begin="2:34.369" end="2:35.045">僕</span><span begin="2:35.045" end="2:36.203">だけの</span><span begin="2:36.203" end="2:37.367">色</span><span begin="2:37.367" end="2:37.732">に</span><span begin="2:37.732" end="2:38.150">なっ</span><span begin="2:38.150" end="2:38.863">た</span><span ttm:role="x-translation" xml:lang="zh-CN">变成了我独有的色彩</span></p><p begin="2:39.035" end="2:44.407" itunes:key="L28" ttm:agent="v1"><span begin="2:39.035" end="2:39.728">どんな</span><span begin="2:39.728" end="2:41.126">名前を</span><span begin="2:41.126" end="2:42.578">つけたら</span><span begin="2:42.578" end="2:42.946">い</span><span begin="2:42.946" end="2:43.759">い</span><span begin="2:43.759" end="2:44.407">？</span><span ttm:role="x-translation" xml:lang="zh-CN">该取一个怎样的名字呢？</span></p><p begin="2:46.250" end="2:49.449" itunes:key="L29" ttm:agent="v1"><span begin="2:46.250" end="2:46.958">灰</span><span begin="2:46.958" end="2:47.584">色</span><span begin="2:47.584" end="2:48.098">の</span><span begin="2:48.098" end="2:48.812">横断</span><span begin="2:48.812" end="2:49.449">歩道</span><span ttm:role="x-translation" xml:lang="zh-CN">灰白相间的斑马线上</span></p><p begin="2:49.595" end="2:52.691" itunes:key="L30" ttm:agent="v1"><span begin="2:49.595" end="2:50.085">浮</span><span begin="2:50.085" end="2:50.556">かぶ</span><span begin="2:50.556" end="2:51.358">白</span><span begin="2:51.358" end="2:51.719">を</span><span begin="2:51.719" end="2:52.036">踏</span><span begin="2:52.036" end="2:52.691">む</span><span ttm:role="x-translation" xml:lang="zh-CN">踏出飘渺而洁白的足迹</span></p><p begin="2:53.027" end="2:56.705" itunes:key="L31" ttm:agent="v1"><span begin="2:53.027" end="2:54.197">緑</span><span begin="2:54.197" end="2:54.665">の</span><span begin="2:54.665" end="2:55.740">点滅</span><span begin="2:55.740" end="2:56.093">が</span><span begin="2:56.093" end="2:56.705">僕を</span><span ttm:role="x-translation" xml:lang="zh-CN">绿灯闪烁着光芒</span></p><p begin="2:56.876" end="2:58.913" itunes:key="L32" ttm:agent="v1"><span begin="2:56.876" end="2:57.760">急かし</span><span begin="2:57.760" end="2:58.188">て</span><span begin="2:58.188" end="2:58.476">く</span><span begin="2:58.476" end="2:58.913">る</span><span ttm:role="x-translation" xml:lang="zh-CN">促使我前行</span></p><p begin="2:58.923" end="3:01.799" itunes:key="L33" ttm:agent="v1"><span begin="2:58.923" end="2:59.366">いつ</span><span begin="2:59.366" end="2:59.956">まで</span><span begin="2:59.956" end="3:00.480">も</span><span begin="3:00.480" end="3:00.968">いくつ</span><span begin="3:00.968" end="3:01.468">まで</span><span begin="3:01.468" end="3:01.799">も</span><span ttm:role="x-translation" xml:lang="zh-CN">无论何时 不管多少次</span></p><p begin="3:01.862" end="3:05.171" itunes:key="L34" ttm:agent="v1"><span begin="3:01.862" end="3:02.681">忘</span><span begin="3:02.681" end="3:03.058">れ</span><span begin="3:03.058" end="3:04.171">ないで</span><span begin="3:04.171" end="3:04.713">いよ</span><span begin="3:04.713" end="3:05.171">う</span><span ttm:role="x-translation" xml:lang="zh-CN">绝不会忘记</span></p><p begin="3:05.393" end="3:09.172" itunes:key="L35" ttm:agent="v1"><span begin="3:05.393" end="3:06.131">まっ</span><span begin="3:06.131" end="3:07.370">さらな</span><span begin="3:07.370" end="3:08.483">キャンバス</span><span begin="3:08.483" end="3:08.809">の</span><span begin="3:08.809" end="3:09.172">上</span><span ttm:role="x-translation" xml:lang="zh-CN">好似在纯粹无暇的画布上</span></p><p begin="3:09.337" end="3:12.827" itunes:key="L36" ttm:agent="v1"><span begin="3:09.337" end="3:10.088">描き</span><span begin="3:10.088" end="3:10.789">殴る</span><span begin="3:10.789" end="3:11.509">ように</span><span begin="3:11.509" end="3:12.253">刻むん</span><span begin="3:12.253" end="3:12.827">だ</span><span ttm:role="x-translation" xml:lang="zh-CN">如同潦草绘画般雕琢</span></p><p begin="3:12.837" end="3:14.369" itunes:key="L37" ttm:agent="v1"><span begin="3:12.837" end="3:13.404">いつ</span><span begin="3:13.404" end="3:13.883">かは</span><span begin="3:13.883" end="3:14.369">さ</span><span ttm:role="x-translation" xml:lang="zh-CN">纵使总有一日</span></p><p begin="3:14.434" end="3:17.704" itunes:key="L38" ttm:agent="v1"><span begin="3:14.434" end="3:15.239">色</span><span begin="3:15.239" end="3:15.599">褪</span><span begin="3:15.599" end="3:15.992">せ</span><span begin="3:15.992" end="3:16.904">ちゃって</span><span begin="3:16.904" end="3:17.704">も</span><span ttm:role="x-translation" xml:lang="zh-CN">褪去了色彩</span></p><p begin="3:17.833" end="3:21.546" itunes:key="L39" ttm:agent="v1"><span begin="3:17.833" end="3:18.619">何</span><span begin="3:18.619" end="3:19.465">回</span><span begin="3:19.465" end="3:20.104">でも</span><span begin="3:20.104" end="3:20.964">再生</span><span begin="3:20.964" end="3:21.546">して</span><span ttm:role="x-translation" xml:lang="zh-CN">那就再无数次放起这首歌</span></p><p begin="3:21.657" end="3:25.583" itunes:key="L40" ttm:agent="v1"><span begin="3:21.657" end="3:22.492">次の</span><span begin="3:22.492" end="3:23.272">夢を</span><span begin="3:23.272" end="3:24.233">育てに</span><span begin="3:24.233" end="3:25.013">いこう</span><span begin="3:25.013" end="3:25.583">よ</span><span ttm:role="x-translation" xml:lang="zh-CN">育出下一个梦想吧</span></p><p begin="3:25.593" end="3:28.620" itunes:key="L41" ttm:agent="v1"><span begin="3:25.593" end="3:25.827">…</span><span begin="3:25.827" end="3:26.489">こんな</span><span begin="3:26.489" end="3:27.300">僕は</span><span begin="3:27.300" end="3:27.759">僕</span><span begin="3:27.759" end="3:28.620">じゃない！</span><span ttm:role="x-translation" xml:lang="zh-CN">…这样的我并非是我！</span></p><p begin="3:28.849" end="3:31.804" itunes:key="L42" ttm:agent="v1"><span begin="3:28.849" end="3:29.663">こんなん</span><span begin="3:29.663" end="3:30.444">全然</span><span begin="3:30.444" end="3:31.110">聞いて</span><span begin="3:31.110" end="3:31.517">ない</span><span begin="3:31.517" end="3:31.804">!!</span><span ttm:role="x-translation" xml:lang="zh-CN">这样的事我从未听闻!!</span></p><p begin="3:31.857" end="3:35.015" itunes:key="L43" ttm:agent="v1"><span begin="3:31.857" end="3:32.164">…</span><span begin="3:32.164" end="3:32.844">でも</span><span begin="3:32.844" end="3:33.432">なんか、</span><span begin="3:33.432" end="3:34.045">嫌い</span><span begin="3:34.045" end="3:34.353">じゃ</span><span begin="3:34.353" end="3:34.660">な</span><span begin="3:34.660" end="3:35.015">い</span><span ttm:role="x-translation" xml:lang="zh-CN">…不过、我并不讨厌</span></p></div></body></tt>