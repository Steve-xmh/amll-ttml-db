<tt xmlns="http://www.w3.org/ns/ttml" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xmlns:amll="http://www.example.com/ns/amll"><head><metadata><ttm:agent type="person" xml:id="v1"/><amll:meta key="musicName" value="while this lasts"/><amll:meta key="musicName" value="そばにいていいよ"/><amll:meta key="musicName" value="可以待在身边喔"/><amll:meta key="artists" value="KAF"/><amll:meta key="artists" value="kaf"/><amll:meta key="artists" value="かふ"/><amll:meta key="artists" value="花譜"/><amll:meta key="artists" value="花谱"/><amll:meta key="album" value="Transcendent Love"/><amll:meta key="album" value="深愛"/><amll:meta key="album" value="深爱"/><amll:meta key="isrc" value="JPB602601140"/><amll:meta key="ncmMusicId" value="3383671947"/><amll:meta key="qqMusicId" value="003Ualgn1jC4Qb"/><amll:meta key="qqMusicId" value="667146777"/><amll:meta key="spotifyId" value="0G8axz0sy9p3uAkTxpZLDX"/><amll:meta key="appleMusicId" value="6764277989"/><amll:meta key="ttmlAuthorGithub" value="174598250"/><amll:meta key="ttmlAuthorGithubLogin" value="ASyunagi"/></metadata></head><body dur="3:07.440"><div begin="23.920" end="3:07.440"><p begin="23.920" end="28.190" itunes:key="L1" ttm:agent="v1"><span begin="23.920" end="24.310">ま</span><span begin="24.310" end="24.870">だ</span><span begin="25.050" end="25.540">居</span><span begin="25.700" end="26.340">れ</span><span begin="26.440" end="26.800">ば</span><span begin="27.190" end="27.470">い</span><span begin="27.470" end="27.850">い</span><span begin="27.850" end="28.190">よ</span><span ttm:role="x-translation" xml:lang="zh-Hans">再待一会也可以啊</span><span ttm:role="x-translation" xml:lang="zh-Hant">再待一會也可以啊</span><span ttm:role="x-translation" xml:lang="en">You can stay a little longer</span><span ttm:role="x-translation" xml:lang="ko">조금 더 있어도 돼</span><span ttm:role="x-translation" xml:lang="fr">Tu peux rester encore</span><span ttm:role="x-translation" xml:lang="es">Puedes quedarte un poco más</span><span ttm:role="x-translation" xml:lang="de">Du kannst ruhig noch ein wenig bleiben</span><span ttm:role="x-translation" xml:lang="pt">Pode ficar mais um pouco</span><span ttm:role="x-translation" xml:lang="ru">Можешь ещё остаться</span><span ttm:role="x-translation" xml:lang="it">Puoi restare ancora</span><span ttm:role="x-roman">Mada ireba ii yo</span></p><p begin="29.590" end="33.370" itunes:key="L2" ttm:agent="v1"><span begin="29.590" end="29.860">い</span><span begin="29.970" end="30.230">か</span><span begin="30.350" end="30.580">な</span><span begin="30.700" end="30.900">く</span><span begin="31.080" end="31.300">て</span><span begin="31.480" end="31.740">も</span><span begin="32.240" end="32.720">いい</span><span begin="32.930" end="33.370">よ</span><span ttm:role="x-translation" xml:lang="zh-Hans">不用离开也可以啊</span><span ttm:role="x-translation" xml:lang="zh-Hant">不用離開也可以啊</span><span ttm:role="x-translation" xml:lang="en">You don&apos;t have to go</span><span ttm:role="x-translation" xml:lang="ko">가지 않아도 돼</span><span ttm:role="x-translation" xml:lang="fr">Tu n’es pas obligé de partir</span><span ttm:role="x-translation" xml:lang="es">No hace falta que te vayas</span><span ttm:role="x-translation" xml:lang="de">Du musst nicht gehen</span><span ttm:role="x-translation" xml:lang="pt">Não precisa ir embora</span><span ttm:role="x-translation" xml:lang="ru">Можешь никуда не уходить</span><span ttm:role="x-translation" xml:lang="it">Non devi andare</span><span ttm:role="x-roman">Ikanakute mo ii yo</span></p><p begin="35.260" end="39.680" itunes:key="L3" ttm:agent="v1"><span begin="35.260" end="35.640">そ</span><span begin="35.730" end="36.310">ば</span><span begin="36.450" end="36.910">に</span><span begin="37.210" end="37.700">い</span><span begin="37.870" end="38.240">て</span><span begin="38.590" end="38.900">い</span><span begin="38.900" end="39.260">い</span><span begin="39.260" end="39.680">よ</span><span ttm:role="x-translation" xml:lang="zh-Hans">可以待在我身边啊</span><span ttm:role="x-translation" xml:lang="zh-Hant">可以待在我身邊啊</span><span ttm:role="x-translation" xml:lang="en">You can stay here by my side</span><span ttm:role="x-translation" xml:lang="ko">내 곁에 있어도 돼</span><span ttm:role="x-translation" xml:lang="fr">Tu peux rester près de moi</span><span ttm:role="x-translation" xml:lang="es">Puedes quedarte a mi lado</span><span ttm:role="x-translation" xml:lang="de">Du kannst ruhig bei mir bleiben</span><span ttm:role="x-translation" xml:lang="pt">Pode ficar ao meu lado</span><span ttm:role="x-translation" xml:lang="ru">Можешь остаться рядом со мной</span><span ttm:role="x-translation" xml:lang="it">Puoi restare accanto a me</span><span ttm:role="x-roman">Soba ni ite ii yo</span></p><p begin="40.970" end="44.660" itunes:key="L4" ttm:agent="v1"><span begin="40.970" end="41.280">い</span><span begin="41.390" end="41.650">か</span><span begin="41.770" end="42.040">な</span><span begin="42.120" end="42.330">く</span><span begin="42.500" end="42.750">て</span><span begin="42.890" end="43.180">も</span><span begin="43.630" end="44.160">いい</span><span begin="44.320" end="44.660">よ</span><span ttm:role="x-translation" xml:lang="zh-Hans">不用离开也可以啊</span><span ttm:role="x-translation" xml:lang="zh-Hant">不用離開也可以啊</span><span ttm:role="x-translation" xml:lang="en">You don&apos;t have to go</span><span ttm:role="x-translation" xml:lang="ko">가지 않아도 돼</span><span ttm:role="x-translation" xml:lang="fr">Tu n’es pas obligé de partir</span><span ttm:role="x-translation" xml:lang="es">No hace falta que te vayas</span><span ttm:role="x-translation" xml:lang="de">Du musst nicht gehen</span><span ttm:role="x-translation" xml:lang="pt">Não precisa ir embora</span><span ttm:role="x-translation" xml:lang="ru">Можешь никуда не уходить</span><span ttm:role="x-translation" xml:lang="it">Non devi andare</span><span ttm:role="x-roman">Ikanakute mo ii yo</span></p><p begin="48.000" end="50.450" itunes:key="L5" ttm:agent="v1"><span begin="48.000" end="48.170">部</span><span begin="48.170" end="48.460">屋</span><span begin="48.460" end="48.610">の</span><span begin="48.610" end="49.300">奥</span><span begin="49.450" end="49.630">の</span><span begin="49.630" end="50.000">影</span><span begin="50.090" end="50.450">が</span><span ttm:role="x-translation" xml:lang="zh-Hans">房间深处的影子</span><span ttm:role="x-translation" xml:lang="zh-Hant">房間深處的影子</span><span ttm:role="x-translation" xml:lang="en">The shadow deep inside the room</span><span ttm:role="x-translation" xml:lang="ko">방 안 깊숙한 곳의 그림자가</span><span ttm:role="x-translation" xml:lang="fr">L’ombre au fond de la pièce</span><span ttm:role="x-translation" xml:lang="es">La sombra al fondo de la habitación</span><span ttm:role="x-translation" xml:lang="de">Der Schatten tief im Zimmer</span><span ttm:role="x-translation" xml:lang="pt">A sombra no fundo do quarto</span><span ttm:role="x-translation" xml:lang="ru">Тень в глубине комнаты</span><span ttm:role="x-translation" xml:lang="it">L’ombra in fondo alla stanza</span><span ttm:role="x-roman">Heya no oku no kage ga</span></p><p begin="50.820" end="53.370" itunes:key="L6" ttm:agent="v1"><span begin="50.820" end="51.120">薄</span><span begin="51.210" end="51.330">く</span><span begin="51.410" end="51.670">な</span><span begin="51.670" end="52.010">り</span><span begin="52.280" end="52.400">途</span><span begin="52.500" end="52.660">絶</span><span begin="52.660" end="52.820">え</span><span begin="53.000" end="53.370">た</span><span ttm:role="x-translation" xml:lang="zh-Hans">渐渐淡去 直至消失</span><span ttm:role="x-translation" xml:lang="zh-Hant">漸漸淡去 直至消失</span><span ttm:role="x-translation" xml:lang="en">Faded away until it disappeared</span><span ttm:role="x-translation" xml:lang="ko">희미해지다 이내 사라졌어</span><span ttm:role="x-translation" xml:lang="fr">S’est estompée puis s’est évanouie</span><span ttm:role="x-translation" xml:lang="es">Se fue desvaneciendo hasta desaparecer</span><span ttm:role="x-translation" xml:lang="de">Verblasste langsam und verschwand</span><span ttm:role="x-translation" xml:lang="pt">Foi desvanecendo até desaparecer</span><span ttm:role="x-translation" xml:lang="ru">Поблекла и исчезла</span><span ttm:role="x-translation" xml:lang="it">Si è fatta tenue fino a svanire</span><span ttm:role="x-roman">Usuku nari todaeta</span></p><p begin="55.120" end="56.510" itunes:key="L7" ttm:agent="v1"><span begin="55.120" end="55.560">雨</span><span begin="55.640" end="55.790">の</span><span begin="55.790" end="56.510">後</span><span ttm:role="x-translation" xml:lang="zh-Hans">雨过之后</span><span ttm:role="x-translation" xml:lang="zh-Hant">雨過之後</span><span ttm:role="x-translation" xml:lang="en">After the rain</span><span ttm:role="x-translation" xml:lang="ko">비가 그친 뒤</span><span ttm:role="x-translation" xml:lang="fr">Après la pluie</span><span ttm:role="x-translation" xml:lang="es">Después de la lluvia</span><span ttm:role="x-translation" xml:lang="de">Nach dem Regen</span><span ttm:role="x-translation" xml:lang="pt">Depois da chuva</span><span ttm:role="x-translation" xml:lang="ru">После дождя</span><span ttm:role="x-translation" xml:lang="it">Dopo la pioggia</span><span ttm:role="x-roman">Ame no ato</span></p><p begin="59.390" end="1:01.840" itunes:key="L8" ttm:agent="v1"><span begin="59.390" end="59.630">木</span><span begin="59.630" end="59.980">霊</span><span begin="59.980" end="1:00.120">し</span><span begin="1:00.250" end="1:00.690">た</span><span begin="1:00.850" end="1:01.250">言</span><span begin="1:01.250" end="1:01.410">葉</span><span begin="1:01.550" end="1:01.840">も</span><span ttm:role="x-translation" xml:lang="zh-Hans">那些曾回荡的话语</span><span ttm:role="x-translation" xml:lang="zh-Hant">那些曾迴盪的話語</span><span ttm:role="x-translation" xml:lang="en">Even the words that once echoed</span><span ttm:role="x-translation" xml:lang="ko">메아리치던 말들도</span><span ttm:role="x-translation" xml:lang="fr">Même les paroles qui résonnaient en écho</span><span ttm:role="x-translation" xml:lang="es">Incluso las palabras que hicieron eco</span><span ttm:role="x-translation" xml:lang="de">Auch die Worte die einst widerhallten</span><span ttm:role="x-translation" xml:lang="pt">Até as palavras que ecoaram</span><span ttm:role="x-translation" xml:lang="ru">Даже слова что отзывались эхом</span><span ttm:role="x-translation" xml:lang="it">Anche le parole che riecheggiavano</span><span ttm:role="x-roman">Kodama shita kotoba mo</span></p><p begin="1:02.310" end="1:05.050" itunes:key="L9" ttm:agent="v1"><span begin="1:02.310" end="1:02.730">届</span><span begin="1:02.730" end="1:02.970">か</span><span begin="1:02.970" end="1:03.250">な</span><span begin="1:03.250" end="1:03.620">い</span><span begin="1:03.830" end="1:04.030">もう</span><span begin="1:04.030" end="1:04.240">二</span><span begin="1:04.240" end="1:04.400">度</span><span begin="1:04.540" end="1:05.050">と</span><span ttm:role="x-translation" xml:lang="zh-Hans">也再也无法传达</span><span ttm:role="x-translation" xml:lang="zh-Hant">也再也無法傳達</span><span ttm:role="x-translation" xml:lang="en">Will never reach beyond again</span><span ttm:role="x-translation" xml:lang="ko">이제 두 번 다시 닿지 않아</span><span ttm:role="x-translation" xml:lang="fr">Ne parviendront plus jamais jusqu’à toi</span><span ttm:role="x-translation" xml:lang="es">Ya no llegarán nunca más</span><span ttm:role="x-translation" xml:lang="de">Erreichen dich nie wieder</span><span ttm:role="x-translation" xml:lang="pt">Já não chegam nunca mais</span><span ttm:role="x-translation" xml:lang="ru">Уже никогда не достигнут тебя</span><span ttm:role="x-translation" xml:lang="it">Non arriveranno mai più</span><span ttm:role="x-roman">Todokanai mou nido to</span></p><p begin="1:06.590" end="1:08.180" itunes:key="L10" ttm:agent="v1"><span begin="1:06.590" end="1:07.090">朝</span><span begin="1:07.090" end="1:07.320">の</span><span begin="1:07.320" end="1:08.060">匂</span><span begin="1:08.060" end="1:08.180">い</span><span ttm:role="x-translation" xml:lang="zh-Hans">清晨的气息</span><span ttm:role="x-translation" xml:lang="zh-Hant">清晨的氣息</span><span ttm:role="x-translation" xml:lang="en">The scent of morning</span><span ttm:role="x-translation" xml:lang="ko">아침의 향기</span><span ttm:role="x-translation" xml:lang="fr">Le parfum du matin</span><span ttm:role="x-translation" xml:lang="es">El aroma de la mañana</span><span ttm:role="x-translation" xml:lang="de">Der Duft des Morgens</span><span ttm:role="x-translation" xml:lang="pt">O aroma da manhã</span><span ttm:role="x-translation" xml:lang="ru">Запах утра</span><span ttm:role="x-translation" xml:lang="it">Il profumo del mattino</span><span ttm:role="x-roman">Asa no nioi</span></p><p begin="1:10.240" end="1:15.330" itunes:key="L11" ttm:agent="v1"><span begin="1:10.240" end="1:10.940">ら</span><span begin="1:11.010" end="1:11.690">ら</span><span begin="1:11.760" end="1:12.400">ら</span><span begin="1:12.450" end="1:13.110">ら</span><span begin="1:13.200" end="1:14.530">ら</span><span begin="1:14.580" end="1:15.330">ら</span><span ttm:role="x-translation" xml:lang="zh-Hans">啦啦啦啦啦啦</span><span ttm:role="x-translation" xml:lang="zh-Hant">啦啦啦啦啦啦</span><span ttm:role="x-translation" xml:lang="en">La la la la la la</span><span ttm:role="x-translation" xml:lang="ko">라라라라라라</span><span ttm:role="x-translation" xml:lang="fr">La la la la la la</span><span ttm:role="x-translation" xml:lang="es">La la la la la la</span><span ttm:role="x-translation" xml:lang="de">La la la la la la</span><span ttm:role="x-translation" xml:lang="pt">Lá lá lá lá lá lá</span><span ttm:role="x-translation" xml:lang="ru">Лалалалалала</span><span ttm:role="x-translation" xml:lang="it">La la la la la la</span><span ttm:role="x-roman">Ra ra ra ra ra ra</span></p><p begin="1:16.020" end="1:20.890" itunes:key="L12" ttm:agent="v1"><span begin="1:16.020" end="1:16.680">ら</span><span begin="1:16.750" end="1:17.410">ら</span><span begin="1:17.470" end="1:18.060">ら</span><span begin="1:18.160" end="1:18.890">ら</span><span begin="1:18.980" end="1:20.890">ら</spa