<tt xmlns="http://www.w3.org/ns/ttml" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xmlns:amll="http://www.example.com/ns/amll"><head><metadata><ttm:agent type="person" xml:id="v1"/><ttm:agent type="other" xml:id="v2"/><amll:meta key="musicName" value="Musician, Pt. 1 (Live)"/><amll:meta key="artists" value="Porter Robinson"/><amll:meta key="album" value="Secret Sky 2021 (Live)"/><amll:meta key="ncmMusicId" value="1864857547"/><amll:meta key="ttmlAuthorGithub" value="235518886"/><amll:meta key="ttmlAuthorGithubLogin" value="chan-air"/></metadata></head><body dur="6:12.630"><div begin="1:50.731" end="6:12.630"><p begin="1:50.731" end="1:54.334" itunes:key="L0" ttm:agent="v1"><span begin="1:50.731" end="1:50.970">No</span> <span begin="1:50.970" end="1:51.098">I</span> <span begin="1:51.098" end="1:51.371">don’t</span> <span begin="1:51.371" end="1:51.611">miss</span> <span begin="1:51.611" end="1:51.847">the</span> <span begin="1:51.847" end="1:52.243">fee</span><span begin="1:52.243" end="1:52.550">ling</span> <span begin="1:53.248" end="1:53.483">a</span><span begin="1:53.483" end="1:53.740">ny</span><span begin="1:53.740" end="1:54.334">more</span><span ttm:role="x-translation" xml:lang="zh-CN">不 我再也不会思念那种感觉了</span></p><p begin="1:54.735" end="1:58.228" itunes:key="L1" ttm:agent="v1"><span begin="1:54.735" end="1:54.990">Yeah</span> <span begin="1:54.990" end="1:55.109">I</span> <span begin="1:55.109" end="1:55.356">want</span> <span begin="1:55.356" end="1:55.621">some</span><span begin="1:55.621" end="1:55.873">thing</span> <span begin="1:55.873" end="1:56.479">new</span> <span begin="1:57.231" end="1:57.727">to</span> <span begin="1:57.727" end="1:58.228">love</span><span ttm:role="x-translation" xml:lang="zh-CN">我希望能有新事物来让我施予爱意</span></p><p begin="1:58.228" end="2:00.602" itunes:key="L2" ttm:agent="v1"><span begin="1:58.228" end="1:58.481">I</span> <span begin="1:58.481" end="1:59.002">was</span> <span begin="1:59.002" end="1:59.481">so</span> <span begin="1:59.481" end="1:59.724">nos</span><span begin="1:59.724" end="2:00.231">tal</span><span begin="2:00.231" end="2:00.602">gic</span><span ttm:role="x-translation" xml:lang="zh-CN">我是如此地恋旧</span></p><p begin="2:00.602" end="2:02.726" itunes:key="L3" ttm:agent="v1"><span begin="2:00.602" end="2:00.719">But</span> <span begin="2:00.719" end="2:00.985">I’m</span> <span begin="2:00.985" end="2:01.463">fine</span> <span begin="2:01.463" end="2:01.749">wi</span><span begin="2:01.749" end="2:02.240">thout</span> <span begin="2:02.240" end="2:02.726">it</span><span ttm:role="x-translation" xml:lang="zh-CN">但抛掉那种感觉 其实也没关系</span></p><p begin="2:02.726" end="2:06.314" itunes:key="L4" ttm:agent="v1"><span begin="2:02.726" end="2:03.002">You</span> <span begin="2:03.002" end="2:03.244">don’t</span> <span begin="2:03.244" end="2:03.501">real</span><span begin="2:03.501" end="2:03.732">ly</span> <span begin="2:03.732" end="2:04.248">want</span> <span begin="2:04.248" end="2:04.481">what</span> <span begin="2:04.481" end="2:04.726">you</span> <span begin="2:04.726" end="2:05.245">think</span> <span begin="2:05.245" end="2:05.742">you</span> <span begin="2:05.742" end="2:06.314">want</span><span ttm:role="x-translation" xml:lang="zh-CN">你渴望的并非就是你真正想要的</span></p><p begin="2:06.753" end="2:10.494" itunes:key="L5" ttm:agent="v1"><span begin="2:06.753" end="2:06.989">No</span> <span begin="2:06.989" end="2:07.094">I</span> <span begin="2:07.094" end="2:07.341">don’t</span> <span begin="2:07.341" end="2:07.589">wan</span><span begin="2:07.589" end="2:07.833">na</span> <span begin="2:07.833" end="2:08.226">lose</span> <span begin="2:08.226" end="2:08.723">it</span> <span begin="2:09.247" end="2:09.496">this</span> <span begin="2:09.496" end="2:09.739">e</span><span begin="2:09.739" end="2:10.237">mo</span><span begin="2:10.237" end="2:10.494">tion</span><span ttm:role="x-translation" xml:lang="zh-CN">不 我不想抛弃掉这份情绪</span></p><p begin="2:10.729" end="2:14.026" itunes:key="L6" ttm:agent="v1"><span begin="2:10.729" end="2:10.973">Yeah</span> <span begin="2:10.973" end="2:11.091">I</span> <span begin="2:11.091" end="2:11.366">just</span> <span begin="2:11.366" end="2:11.607">wan</span><span begin="2:11.607" end="2:11.858">na</span> <span begin="2:11.858" end="2:12.544">do</span> <span begin="2:12.734" end="2:13.461">e</span><span begin="2:13.461" end="2:13.723">very</span><span begin="2:13.723" end="2:14.026">thing</span><span ttm:role="x-translation" xml:lang="zh-CN">我只是想体验世间所有</span></p><p begin="2:14.251" end="2:16.586" itunes:key="L7" ttm:agent="v1"><span begin="2:14.251" end="2:14.485">I</span> <span begin="2:14.485" end="2:14.984">get</span> <span begin="2:14.984" end="2:15.469">so</span> <span begin="2:15.469" end="2:15.709">ex</span><span begin="2:15.709" end="2:16.212">ci</span><span begin="2:16.212" end="2:16.586">ted</span><span ttm:role="x-translation" xml:lang="zh-CN">我变得异常兴奋</span></p><p begin="2:16.586" end="2:18.526" itunes:key="L8" ttm:agent="v1"><span begin="2:16.586" end="2:16.701">When</span> <span begin="2:16.701" end="2:17.006">I</span> <span begin="2:17.006" end="2:17.336">fi</span><span begin="2:17.336" end="2:17.443">nal</span><span begin="2:17.443" end="2:17.721">ly</span> <span begin="2:17.721" end="2:18.234">find</span> <span begin="2:18.234" end="2:18.526">it</span><span ttm:role="x-translation" xml:lang="zh-CN">当我终于找寻到时</span></p><p begin="2:18.712" end="2:22.519" itunes:key="L9" ttm:agent="v1"><span begin="2:18.712" end="2:18.969">It</span> <span begin="2:18.969" end="2:19.359">just</span> <span begin="2:19.359" end="2:19.716">gets</span> <span begin="2:19.716" end="2:20.271">brigh</span><span begin="2:20.271" end="2:20.707">ter</span> <span begin="2:20.707" end="2:21.244">from</span> <span begin="2:21.244" end="2:21.744">now</span> <span begin="2:21.744" end="2:22.519">on</span><span ttm:role="x-translation" xml:lang="zh-CN">那种顿悟之感 自此愈发变得明亮</span></p><p begin="2:23.253" end="2:26.479" itunes:key="L10" ttm:agent="v1"><span begin="2:23.253" end="2:23.498">Then</span> <span begin="2:23.498" end="2:23.975">you</span> <span begin="2:23.975" end="2:26.479">sigh</span><span ttm:role="x-translation" xml:lang="zh-CN">随后你叹气道</span></p><p begin="2:26.736" end="2:29.236" itunes:key="L11" ttm:agent="v1"><span begin="2:26.736" end="2:26.996">You</span> <span begin="2:26.996" end="2:27.234">know</span> <span begin="2:27.234" end="2:27.753">I</span> <span begin="2:27.753" end="2:28.233">love</span> <span begin="2:28.233" end="2:28.527">you</span> <span begin="2:28.740" end="2:28.840">so</span> <span begin="2:28.840" end="2:29.000">I</span> <span begin="2:29.000" end="2:29.236">think</span><span ttm:role="x-translation" xml:lang="zh-CN">你知道我爱你 所以我想</span></p><p begin="2:29.236" end="2:31.458" itunes:key="L12" ttm:agent="v1"><span begin="2:29.236" end="2:29.481">I</span> <span begin="2:29.481" end="2:29.741">should</span> <span begin="2:29.741" end="2:30.172">tell</span> <span begin="2:30.172" end="2:30.513">you</span> <span begin="2:30.736" end="2:31.225">Por</span><span begin="2:31.225" end="2:31.458">ter</span><span ttm:role="x-translation" xml:lang="zh-CN">我应该告诉你 颇特</span></p><p begin="2:31.458" end="2:38.141" itunes:key="L13" ttm:agent="v1"><span begin="2:31.458" end="2:31.975">This</span> <span begin="2:31.975" end="2:34.586">life</span> <span begin="2:34.743" end="2:35.001">well</span> <span begin="2:35.001" end="2:35.244">i</span><span begin="2:35.244" end="2:35.490">sn’t</span> <span begin="2:35.490" end="2:35.718">it</span> <span begin="2:35.718" end="2:36.499">time</span> <span begin="2:36.499" end="2:36.732">that</span> <span begin="2:36.732" end="2:37.236">you</span> <span begin="2:37.236" end="2:37.727">grow</span> <span begin="2:37.727" end="2:38.141">up</span><span ttm:role="x-translation" xml:lang="zh-CN">生命至此 你是不是也应该长大了?</span></p><p begin="2:39.243" end="2:41.473" itunes:key="L14" ttm:agent="v1"><span begin="2:39.243" end="2:39.498">Oh</span> <span begin="2:39.498" end="2:39.982">it’s</span> <span begin="2:39.982" end="2:40.736">cal</span><span begin="2:40.736" end="2:41.473">ling</span><span ttm:role="x-translation" xml:lang="zh-CN">噢 那感觉呼唤着我</span></p><p begin="2:41.754" end="2:45.463" itunes:key="L15" ttm:agent="v1"><span begin="2:41.754" end="2:42.248">I</span> <span begin="2:42.248" end="2:42.511">just</span> <span begin="2:42.511" end="2:42.991">can’t</span> <span begin="2:42.991" end="2:43.479">stop</span> <span begin="2:43.479" end="2:43.983">I’m</span> <span begin="2:43.983" end="2:44.734">sor</span><span begin="2:44.734" end="2:45.463">ry</span><span ttm:role="x-translation" xml:lang="zh-CN">我只是无法停下 我很抱歉</span></p><p begin="2:45.721" end="2:48.841" itunes:key="L16" ttm:agent="v1"><span begin="2:45.721" end="2:46.229">I</span> <span begin="2:46.229" end="2:46.478">can</span> <span begin="2:46.478" end="2:46.727">feel</span> <span begin="2:46.727" end="2:46.963">a</span> <span begin="2:46.963" end="2:47.481">new</span> <span begin="2:47.481" end="2:47.963">day</span> <span begin="2:47.963" end="2:48.488">daw</span><span begin="2:48.488" end="2:48.841">ning</span><span ttm:role="x-translation" xml:lang="zh-CN">我能感受到新的一天的黎明降临</span></p><p begin="2:48.242" end="2:50.479" itunes:key="L17" ttm:agent="v2"><span begin="2:48.242" end="2:48.477">I</span> <span begin="2:48.477" end="2:48.994">burn</span> <span begin="2:48.994" end="2:49.329">up</span> <span begin="2:49.497" end="2:49.984">burn</span> <span begin="2:49.984" end="2:50.479">out</span><span ttm:role="x-translation" xml:lang="zh-CN">我熊熊燃烧 燃烧殆尽</span></p><p begin="2:50.971" end="2:54.564" itunes:key="L18" ttm:agent="v2"><span begin="2:50.971" end="2:51.234">I</span> <span begin="2:51.234" end="2:51.474">shoul</span><span begin="2:51.474" end="2:51.737">dn’t</span> <span begin="2:51.737" end="2:52.246">do</span> <span begin="2:52.246" end="2:52.694">this</span> <span begin="2:52.694" end="2:53.248">to</span> <span begin="2:53.248" end="2:53.719">my</span><span begin="2:53.719" end="2:54.564">self</span><span ttm:role="x-translation" xml:lang="zh-CN">我本不应该这样对待自己的</span></p><p begin="2:55.249" end="2:57.444" itunes:key="L19" ttm:agent="v1"><span begin="2:55.249" end="2:55.507">But</span> <span begin="2:55.507" end="2:55.958">sin</span><span begin="2:55.958" end="2:56.734">cere</span><span begin="2:56.734" end="2:57.444">ly</span><span ttm:role="x-translation" xml:lang="zh-CN">但诚恳地</span></p><p begin="2:57.717" end="3:01.269" itunes:key="L20" ttm:agent="v1"><span begin="2:57.717" end="2:58.233">Can’t</span> <span begin="2:58.233" end="2:58.492">you</span> <span begin="2:58.492" end="2:58.992">feel</span> <span begin="2:58.992" end="2:59.492">what</span> <span begin="2:59.492" end="2:59.968">I’m</span> <span begin="2:59.968" end="3:00.737">fee</span><span begin="3:00.737" end="3:01.269">ling</span><span ttm:role="x-translation" xml:lang="zh-CN">难道你感受不到我的感觉吗</span></p><p begin="3:01.737" end="3:05.090" itunes:key="L21" ttm:agent="v1"><span begin="3:01.737" end="3:02.219">I</span> <span begin="3:02.219" end="3:02.476">can</span> <span begin="3:02.476" end="3:02.736">see</span> <span begin="3:02.736" end="3:02.989">my</span> <span begin="3:02.989" end="3:03.473">life</span> <span begin="3:03.473" end="3:03.971">so</span> <span begin="3:03.971" end="3:04.709">clear</span><span begin="3:04.709" end="3:05.090">ly</span><span ttm:role="x-translation" xml:lang="zh-CN">生活在我的眼中如此清晰</span></p><p begin="3:04.284" end="3:06.527" itunes:key="L22" ttm:agent="v2"><span begin="3:04.284" end="3:04.521">I</span> <span begin="3:04.521" end="3:05.021">burn</span> <span begin="3:05.021" end="3:05.400">up</span> <span begin="3:05.532" end="3:06.032">burn</span> <span begin="3:06.032" end="3:06.527">out</span><span ttm:role="x-translation" xml:lang="zh-CN">我熊熊燃烧 燃烧殆尽</span></p><p begin="3:07.019" end="3:10.584" itunes:key="L23" ttm:agent="v2"><span begin="3:07.019" end="3:07.260">I</span> <span begin="3:07.260" end="3:07.524">shoul</span><span begin="3:07.524" end="3:07.784">dn’t</span> <span begin="3:07.784" end="3:08.253">do</span> <span begin="3:08.253" end="3:08.759">this</span> <span begin="3:08.759" end="3:09.291">to</span> <span begin="3:09.291" end="3:09.769">my</span><span begin="3:09.769" end="3:10.584">self</span><span ttm:role="x-translation" xml:lang="zh-CN">我本不应该这样对待自己的</span></p><p begin="3:10.828" end="3:14.729" itunes:key="L24" ttm:agent="v1"><span begin="3:10.828" end="3:11.003">Well</span> <span begin="3:11.003" end="3:11.144">this</span> <span begin="3:11.144" end="3:11.415">is</span> <span begin="3:11.415" end="3:11.650">why</span> <span begin="3:11.650" end="3:11.910">we</span> <span begin="3:11.910" end="3:12.274">do</span> <span begin="3:12.274" end="3:12.782">it</span> <span begin="3:13.295" end="3:13.516">for</span> <span begin="3:13.516" end="3:13.784">the</span> <span begin="3:13.784" end="3:14.274">fee</span><span begin="3:14.274" end="3:14.729">ling</span><span ttm:role="x-translation" xml:lang="zh-CN">好吧 这就是我们的缘由 为了那种感觉</span></p><p begin="3:15.036" end="3:16.816" itunes:key="L25" ttm:agent="v1"><span begin="3:15.036" end="3:15.149">How</span> <span begin="3:15.149" end="3:15.389">do</span> <span begin="3:15.389" end="3:15.650">you</span> <span begin="3:15.650" end="3:15.911">do</span> <span begin="3:15.911" end="3:16.294">mu</span><span begin="3:16.294" end="3:16.816">sic</span><span ttm:role="x-translation" xml:lang="zh-CN">你是如何创作音乐的呢</span></p><p begin="3:17.283" end="3:18.648" itunes:key="L26" ttm:agent="v1"><span begin="3:17.283" end="3:17.529">Well</span> <span begin="3:17.529" end="3:17.766">it’s</span> <span begin="3:17.766" end="3:18.284">ea</span><span begin="3:18.284" end="3:18.648">sy</span><span ttm:role="x-translation" xml:lang="zh-CN">其实这很简单</span></p><p begin="3:18.648" end="3:20.656" itunes:key="L27" ttm:agent="v1"><span begin="3:18.648" end="3:18.756">You</span> <span begin="3:18.756" end=