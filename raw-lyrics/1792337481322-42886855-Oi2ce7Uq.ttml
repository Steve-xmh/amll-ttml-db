3.227">ing</span> <span begin="1:33.227" end="1:33.704">sense</span><span ttm:role="x-translation" xml:lang="zh-Hans">却没有任何感动的事物</span></p><p begin="1:33.704" end="1:38.075" itunes:key="L22" ttm:agent="v1"><span begin="1:33.704" end="1:34.174">She&apos;s</span> <span begin="1:34.174" end="1:35.109">been</span> <span begin="1:36.049" end="1:36.537">chas</span><span begin="1:36.537" end="1:36.856">ing</span> <span begin="1:36.856" end="1:37.152">an</span> <span begin="1:37.152" end="1:37.686">an</span><span begin="1:37.686" end="1:38.075">swer</span><span ttm:role="x-translation" xml:lang="zh-Hans">她致力追寻的答案</span></p><p begin="1:38.075" end="1:40.623" itunes:key="L23" ttm:agent="v1"><span begin="1:38.075" end="1:38.307">A</span> <span begin="1:38.307" end="1:38.894">sign</span> <span begin="1:38.894" end="1:39.149">lost</span> <span begin="1:39.149" end="1:39.433">in</span> <span begin="1:39.433" end="1:39.863">the</span> <span begin="1:39.863" end="1:40.623">abyss</span><span ttm:role="x-translation" xml:lang="zh-Hans">而那符号却迷失</span></p><p begin="1:41.065" end="1:42.626" itunes:key="L24" ttm:agent="v1"><span begin="1:41.065" end="1:41.355">This</span> <span begin="1:41.355" end="1:41.668">Me</span><span begin="1:41.668" end="1:41.947">trop</span><span begin="1:41.947" end="1:42.226">o</span><span begin="1:42.226" end="1:42.626">lis</span><span ttm:role="x-translation" xml:lang="zh-Hans">在这座大城市的深渊</span></p><p begin="1:42.771" end="1:45.935" itunes:key="L25" ttm:agent="v1"><span begin="1:42.771" end="1:43.230">She</span> <span begin="1:43.230" end="1:44.095">says...</span><span begin="1:44.484" end="1:44.774">“Yeah,</span> <span begin="1:44.774" end="1:45.059">he&apos;s</span> <span begin="1:45.059" end="1:45.355">still</span> <span begin="1:45.355" end="1:45.627">com</span><span begin="1:45.627" end="1:45.935">ing</span><span ttm:role="x-translation" xml:lang="zh-Hans">他说：是的，他一定会来的</span></p><p begin="1:45.935" end="1:48.017" itunes:key="L26" ttm:agent="v1"><span begin="1:45.935" end="1:46.196">Just</span> <span begin="1:46.196" end="1:46.498">a</span> <span begin="1:46.498" end="1:46.771">lit</span><span begin="1:46.771" end="1:47.073">tle</span> <span begin="1:47.073" end="1:47.681">bit</span> <span begin="1:47.681" end="1:48.017">late</span><span ttm:role="x-translation" xml:lang="zh-Hans">只是有点晚</span></p><p begin="1:48.219" end="1:50.697" itunes:key="L27" ttm:agent="v1"><span begin="1:48.219" end="1:48.518">He</span> <span begin="1:48.518" end="1:48.841">got</span> <span begin="1:48.841" end="1:49.129">stuck</span> <span begin="1:49.129" end="1:49.415">at</span> <span begin="1:49.415" end="1:49.695">the</span> <span begin="1:49.695" end="1:49.978">Five</span> <span begin="1:49.978" end="1:50.270">and</span> <span begin="1:50.270" end="1:50.697">Dime</span><span ttm:role="x-translation" xml:lang="zh-Hans">他因为那五毛钱卡在洗衣店</span></p><p begin="1:50.781" end="1:52.285" itunes:key="L28" ttm:agent="v1"><span begin="1:50.781" end="1:51.064">Sav</span><span begin="1:51.064" end="1:51.347">ing</span> <span begin="1:51.347" end="1:51.799">the</span> <span begin="1:51.799" end="1:52.285">day”</span><span ttm:role="x-translation" xml:lang="zh-Hans">而耽误了一整天</span></p><p begin="1:52.285" end="1:53.911" itunes:key="L29" ttm:agent="v1"><span begin="1:52.285" end="1:52.686">She</span> <span begin="1:52.686" end="1:53.911">says...</span><span ttm:role="x-translation" xml:lang="zh-Hans">她说</span></p><p begin="1:54.201" end="1:56.111" itunes:key="L30" ttm:agent="v1"><span begin="1:54.201" end="1:54.433">“If</span> <span begin="1:54.433" end="1:54.700">life</span> <span begin="1:54.700" end="1:54.996">was</span> <span begin="1:54.996" end="1:55.287">a</span> <span begin="1:55.287" end="1:56.111">movie</span><span ttm:role="x-translation" xml:lang="zh-Hans">如果生命像一部电影</span></p><p begin="1:56.111" end="1:58.721" itunes:key="L31" ttm:agent="v1"><span begin="1:56.111" end="1:56.378">Then</span> <span begin="1:56.378" end="1:56.895">it</span> <span begi