pan begin="2:37.422" end="2:37.532">no</span><span begin="2:37.532" end="2:38.113">a ru</span><span begin="2:38.113" end="2:38.370">ki</span><span begin="2:38.370" end="2:38.709">ka ta</span></text><text for="L33"><span begin="2:38.861" end="2:38.968">da</span><span begin="2:38.968" end="2:39.097">ka</span><span begin="2:39.097" end="2:39.780">ra</span><span begin="2:39.780" end="2:40.026">kyo</span><span begin="2:40.026" end="2:40.280">u</span><span begin="2:40.280" end="2:40.515">ko</span><span begin="2:40.515" end="2:40.776">ko</span><span begin="2:40.776" end="2:41.005">ma</span><span begin="2:41.005" end="2:41.720">de</span><span begin="2:41.720" end="2:41.809">ki</span><span begin="2:41.809" end="2:41.935">ta</span><span begin="2:41.935" end="2:42.257">ro?</span></text><text for="L34"><span begin="2:42.451" end="2:42.927">ha ji</span><span begin="2:42.927" end="2:43.187">ma</span><span begin="2:43.187" end="2:43.278">ri</span><span begin="2:43.278" end="2:43.569">no</span><span begin="2:43.569" end="2:43.882">hi</span><span begin="2:43.882" end="2:44.126">no</span> <span begin="2:44.386" end="2:44.486">i</span><span begin="2:44.620" end="2:44.720">ku</span><span begin="2:44.879" end="2:45.079">a te</span><span begin="2:45.337" end="2:45.437">mo</span><span begin="2:45.566" end="2:46.007">ne ga</span><span begin="2:46.007" end="2:46.179">i</span><span begin="2:46.179" end="2:46.360">mo</span></text><text for="L35"><span begin="2:46.510" end="2:46.620">do</span><span begin="2:46.620" end="2:46.751">re</span><span begin="2:46.751" end="2:47.460">mo</span><span begin="2:47.460" end="2:47.721">yo</span><span begin="2:47.721" end="2:48.207">te i</span><span begin="2:48.207" end="2:48.395">to</span><span begin="2:48.395" end="2:49.035">chi ga</span><span begin="2:49.035" end="2:49.395">u</span><span begin="2:49.395" end="2:49.524">ke</span><span begin="2:49.524" end="2:49.655">re</span><span begin="2:49.655" end="2:49.889">do</span></text><text for="L36"><span begin="2:50.103" end="2:50.606">ho</span><span begin="2:50.606" end="2:51.028">ra,</span><span begin="2:51.318" end="2:51.814">ko e</span><span begin="2:51.814" end="2:51.920">ga</span><span begin="2:51.920" end="2:52.315">su</span><span begin="2:52.315" end="2:52.532">ru</span><span begin="2:52.532" end="2:52.881">no</span></text><text for="L37"><span begin="2:53.147" end="2:53.492">&quot;so</span><span begin="2:53.492" end="2:53.737">re</span><span begin="2:53.737" end="2:53.972">de</span><span begin="2:53.972" end="2:54.172">mo&quot;</span><span begin="2:54.172" end="2:54.448">t</span><span begin="2:54.448" end="2:57.098">te</span></text><text for="L38"><span begin="2:57.568" end="2:57.812">a</span><span begin="2:57.812" end="2:58.053">re</span><span begin="2:58.053" end="2:58.288">ka</span><span begin="2:58.288" end="2:58.789">ra</span><span begin="2:59.015" end="2:59.272">ma</span><span begin="2:59.272" end="2:59.722">da</span> <span begin="2:59.980" end="3:00.213">o</span><span begin="3:00.213" end="3:00.480">wa</span><span begin="3:00.480" end="3:00.684">ra</span><span begin="3:00.684" end="3:00.921">na</span><span begin="3:00.921" end="3:01.165">i</span><span begin="3:01.165" end="3:01.683">yu me</span><span begin="3:01.683" end="3:01.873">no</span><span begin="3:01.873" end="3:02.098">to</span><span begin="3:02.098" end="3:03.802">chu u</span></text><text for="L39"><span begin="3:05.233" end="3:05.501">mi</span><span begin="3:05.501" end="3:05.961">ra i</span><span begin="3:05.961" end="3:06.479">no</span><span begin="3:06.658" end="3:06.938">hi</span><span begin="3:06.938" end="3:07.369">no</span> <span begin="3:07.633" end="3:07.872">ka</span><span begin="3:07.872" end="3:08.118">ko</span><span begin="3:08.118" end="3:08.375">wo</span><span begin="3:08.375" end="3:08.851">i ma</span><span begin="3:08.851" end="3:09.070">ka</span><span begin="3:09.070" end="3:09.219">e</span><span begin="3:09.219" end="3:09.356">te</span><span begin="3:09.356" end="3:09.496">mi</span><span begin="3:09.496" end="3:09.823">se</span><span begin="3:09.823" end="3:10.175">te</span></text></transliteration></transliterations></iTunesMetadata></metadata></head><body dur="3:10.655"><div begin="1.151" end="3:10.655"><p begin="1.151" end="5.216" itunes:key="L1" ttm:agent="v1"><span begin="1.151" end="1.623" amll:empty-beat="1">歩</span><span begin="1.623" end="1.869">き</span><span begin="1.869" end="2.376" amll:empty-beat="1">始</span><span begin="2.376" end="2.597">め</span><span begin="2.597" end="2.902">た</span><span begin="3.064" end="3.564" amll:empty-beat="1">時</span><span begin="3.564" end="3.803">か</span><span begin="3.803" end="3.930">ら</span><span begin="3.930" end="4.085">今</span><span begin="4.085" end="4.302">日</span><span begin="4.302" end="4.503">の</span><span begin="4.503" end="4.779">日</span><span begin="4.779" end="4.893">ま</span><span begin="4.893" end="5.034">で</span><span ttm:role="x-translation" xml:lang="zh-CN">从迈出第一步的那天 直至今日 / From the moment I first set out, all the way to today</span></p><p begin="5.216" end="8.651" itunes:key="L2" ttm:agent="v1"><span begin="5.216" end="5.339">見</span><span begin="5.339" end="5.484">え</span><span begin="5.484" end="5.741">な</span><span begin="5.741" end="5.897">い</span><span begin="6.190" end="6.670" amll:empty-beat="1">何</span><span begin="6.670" end="6.918">か</span><span begin="6.918" end="7.116">を</span><span begin="7.116" end="7.419">追</span><span begin="7.419" end="7.779">い</span><span begin="8.104" end="8.219">か</span><span begin="8.219" end="8.355">け</span><span begin="8.355" end="8.651">て</span><span ttm:role="x-translation" xml:lang="zh-CN">一直在追逐着看不见的某物 / I&apos;ve been chasing something I could never see</span></p><p begin="8.843" end="12.866" itunes:key="L3" ttm:agent="v1"><span begin="8.843" end="9.074">ど</span><span begin="9.074" end="9.335">こ</span><span begin="9.335" end="9.585">ま</span><span begin="9.585" end="9.712">で</span><span begin="9.712" end="10.035">往</span><span begin="10.035" end="10.282">く</span><span begin="10.282" end="10.577">の</span> <span begin="10.760" end="11.243" amll:empty-beat="1">何</span><span begin="11.243" end="11.481">の</span><span begin="11.481" end="11.990" amll:empty-beat="1">為</span><span begin="11.990" end="12.180">生</span><span begin="12.180" end="12.452">き</span><span begin="12.452" end="12.565">る</span><span begin="12.565" end="12.866">の</span><span ttm:role="x-translation" xml:lang="zh-CN">要往何处去 又是为何而活 / How far am I going? What am I living for?</span></p><p begin="12.866" end="17.009" itunes:key="L4" ttm:agent="v1"><span begin="12.928" end="13.054">言</span><span begin="13.054" end="13.176">え</span><span begin="13.176" end="13.426">な</span><span begin="13.426" end="13.621">い</span><span begin="13.882" end="14.137">ま</span><span begin="14.137" end="14.378">ま</span><span begin="14.378" end="14.600">に</span><span begin="14.600" end="15.069" amll:empty-beat="1">脚</span><span begin="15.069" end="15.798">を</span><span begin="15.798" end="15.910">止</span><span begin="15.910" end="16.037">め</span><span begin="16.037" end="16.516">た</span> <span begin="16.516" end="16.749">あ</span><span begin="16.749" end="17.009">あ、</span><span ttm:role="x-translation" xml:lang="zh-CN">始终说不出口 就这样停下了脚步 啊… / With no answer, my steps just came to a stop, ah...</span></p><p begin="32.598" end="36.449" itunes:key="L5" ttm:agent="v1"><span begin="32.598" end="32.804">完</span><span begin="32.804" end="33.077">成</span><span begin="33.077" end="33.334">形</span><span begin="33.334" end="33.581">は</span><span begin="33.581" end="33.686">野</span><span begin="33.686" end="33.909" amll:empty-beat="1">放</span><span begin="33.909" end="34.062">図</span><span begin="34.062" end="34.413">で</span> <span begin="34.523" end="34.699" amll:empty-beat="1">感</span><span begin="34.699" end="35.011" amll:empty-beat="1">情</span><span begin="35.011" end="35.213">の</span><span begin="35.213" end="35.362">食</span><span begin="35.362" end="35.475">い</span><span begin="35.475" end="35.775" amll:empty-beat="1">違</span><span begin="35.775" end="35.848">っ</span><span begin="35.848" end="35.986">た</span><span begin="35.986" end="36.399">り</span><span ttm:role="x-translation" xml:lang="zh-CN">所谓完成形 是没有边际的 时而与感性相悖 / The final shape turned wild, out of step with what I feel</span></p><p begin="36.449" end="40.234" itunes:key="L6" ttm:agent="v1"><span begin="36.449" end="36.544">だ</span><span begin="36.544" end="36.689">れ</span><span begin="36.689" end="36.928">も</span><span begin="36.928" end="37.044">理</span><span begin="37.044" end="37.396" amll:empty-beat="1">想</span><span begin="37.396" end="37.533">を</span><span begin="37.533" end="37.882" amll:empty-beat="1">望</span><span begin="37.882" end="38.239">む</span> <span begin="38.365" end="38.609" amll:empty-beat="1">役</span><span begin="38.609" end="38.778">も</span><span begin="38.778" end="39.000" amll:empty-beat="1">酸</span><span begin="39.000" end="39.332">素</span><span begin="39.332" end="39.450">も</span><span begin="39.450" end="39.702">取</span><span begin="39.702" end="39.802">り</span><span begin="39.802" end="39.959">合</span><span begin="39.959" end="40.234">う</span><span ttm:role="x-translation" xml:lang="zh-CN">谁都在渴望理想 连角色和氧气也相互争抢 / Everyone&apos;s chasing ideals, fighting for roles, for air to breathe</span></p><p begin="40.264" end="44.138" itunes:key="L7" ttm:agent="v1"><span begin="40.264" end="40.380">あ</span><span begin="40.380" end="40.511">の</span><span begin="40.511" end="40.742">日</span><span begin="40.742" end="40.995">か</span><span begin="40.995" end="41.241">ら</span><span begin="41.241" end="41.380">焼</span><span begin="41.380" end="41.574">き</span><span begin="41.574" end="41.738">付</span><span begin="41.738" end="41.971">い</span><span begin="41.971" end="42.425">て</span> <span begin="42.647" end="42.821">消</span><span begin="42.821" end="42.934">え</span><span begin="42.934" end="43.090">な</span><span begin="43.090" end="43.775">い</span><span ttm:role="x-translation" xml:lang="zh-CN">自那天起便烙印心底 无法消去 / Since that day, something burned itself into me</span></p><p begin="44.138" end="46.273" itunes:key="L8" ttm:agent="v1"><span begin="44.138" end="44.266">モ</span><span begin="44.266" end="44.383">ニ</span><span begin="44.383" end="44.505">タ</span><span begin="44.505" end="44.629">ー</span><span begin="44.629" end="44.764">の</span><span begin="44.764" end="45.206" amll:empty-beat="1">先</span><span begin="45.206" end="45.444">の</span><span begin="45.444" end="45.570">な</span><span begin="45.570" end="45.800">に</span><span begin="45.800" end="46.273">か</span><span ttm:role="x-translation" xml:lang="zh-CN">屏幕另一端的某种东西 / Something is waiting on the other side of the screen</span></p><p begin="46.525" end="50.358" itunes:key="L9" ttm:agent="v1"><span begin="46.525" end="46.999" amll:empty-beat="1">例</span><span begin="46.999" end="47.119">え</span><span begin="47.119" end="47.344">ば</span><span begin="47.344" end="47.482">過</span><span begin="47.482" end="47.737">去</span><span begin="47.737" end="48.194">に</span> <span begin="48.448" end="48.683" amll:empty-beat="1">戻</span><span begin="48.683" end="48.940">れ</span><span begin="48.940" end="49.040">ば</span><span begin="49.040" end="49.128">ど</span><span begin="49.128" end="49.232">う</span><span begin="49.232" end="49.419">し</span><span begin="49.419" end="49.489">よ</span><span begin="49.489" end="49.648">う</span><span begin="49.648" end="49.978">か</span><span ttm:role="x-translation" xml:lang="zh-CN">譬如说 如果回到过去 会怎么样呢 / If I could go back to the past</span></p><p begin="50.358" end="53.988" itunes:key="L10" ttm:agent="v1"><span begin="50.358" end="50.467">ど</span><span begin="50.467" end="50.598">こ</span><span begin="50.598" end="50.846">か</span><span begin="50.846" end="50.967">で</span><span begin="50.967" end="51.353" amll:empty-beat="1">忘</span><span begin="51.353" end="51.567">れ</span><span begin="51.567" end="51.912">た</span> <span begin="52.285" end="52.530" amll:empty-beat="1">夢</span><span begin="52.530" end="52.745">を</span><span begin="52.745" end="53.007" amll:empty-beat="1">選</span><span begin="53.007" end="53.133">ん</span><span begin="53.133" end="53.252">で</span><span begin="53.252" end="53.382">み</span><span begin="53.382" end="53.498">た</span><span begin="53.498" end="53.919">ら</span><span ttm:role="x-translation" xml:lang="zh-CN">试着选择在某处被遗忘的梦想 / And choose a dream I left behind somewhere</span></p><p begin="53.988" end="56.123" itunes:key="L11" ttm:agent="v1"><span begin="53.988" end="54.459" amll:empty-beat="1">案</span><span begin="54.459" end="54.693" amll:empty-beat="1">外</span><span begin="54.693" end="54.814">上</span><span begin="54.814" end="55.063">手</span><span begin="55.063" end="55.163">く</span><span begin="55.163" end="55.401" amll:empty-beat="1">いっ</span><span begin="55.401" end="55.891">て</span><span ttm:role="x-translation" xml:lang="zh-CN">竟意外顺利 / Maybe things would turn out fine</span></p><p begin="56.123" end="1:02.130" itunes:key="L12" ttm:agent="v1"><span begin="56.123" end="56.253">で</span><span begin="56.253" end="56.366">も</span><span begin="56.366" end="56.726" amll:empty-beat="1">別</span><span begin="56.726" end="56.904">の</span><span begin="56.904" end="57.064">世</span><span begin="57.064" end="57.326" amll:empty-beat="1">界</span><span begin="57.326" end="57.775">の</span><span begin="58.043" end="58.302" amll:empty-beat="1">君</span><span begin="58.302" end="58.526">は</span> <span begin="58.526" end="58.897" amll:empty-beat="1">今</span><span begin="58.897" end="59.015">の</span><span begin="59.015" end="59.253" amll:empty-beat="1">君</span><span begin="59.253" end="59.731">に</span><span begin="59.731" end="59.974">な</span><span begin="59.974" end="1:00.204">り</span><span begin="1:00.204" end="1:00.473">た</span><span begin="1:00.473" end="1:00.667">い</span><span begin="1:00.667" end="1:01.156">か</span><span begin="1:01.156" end="1:02.130">も</span><span ttm:role="x-translation" xml:lang="zh-CN">可是 另一个世界里的你 或许正想成为此刻的你 / But the &quot;you&quot; in that other world might wish to be the &quot;you&quot; you are now</span></p><p begin="1:02.614" end="1:06.681" itunes:key="L13" ttm:agent="v1"><span begin="1:02.614" end="1:02.852">だ</span><span begin="1:02.852" end="1:03.084">れ</span><span begin="1:03.084" end="1:03.330">も</span><span begin="1:03.330" end="1:03.393">が</span><span begin="1:03.393" end="1:03.811">識</span><span begin="1:03.811" end="1:04.048">れ</span><span begin="1:04.048" end="1:04.156">な</span><span begin="1:04.156" end="1:04.325">い</span> <span begin="1:04.492" end="1:04.771">世</span><span begin="1:04.771" end="1:05.249" amll:empty-beat="1">界</span><span begin="1:05.249" end="1:05.361">の</span><span begin="1:05.361" end="1:05.942" amll:empty-beat="1">歩</span><span begin="1:05.942" end="1:06.181">き</span><span begin="1:06.181" end="1:06.491" amll:empty-beat="1">方</span><span ttm:role="x-translation" xml:lang="zh-CN">谁都不知晓的 世界的行走方式 / We all walk through worlds no one else has known</span></p><p begin="1:06.681" end="1:10.062" itunes:key="L14" ttm:agent="v1"><span begin="1:06.681" end="1:06.790">見</span><span begin="1:06.790" end="1:06.927">え</span><span begin="1:06.927" end="1:07.247">な</span><span begin="1:07.247" end="1:07.401">い</span><span begin="1:07.635" end="1:08.137" amll:empty-beat="1">答</span><span begin="1:08.137" end="1:08.372">え</span><span begin="1:08.372" end="1:08.625">を</span><span begin="1:08.625" end="1:08.865">追</span><span begin="1:08.865" end="1:09.555">い</span><span begin="1:09.555" end="1:09.688">か</span><span begin="1:09.688" end="1:09.805">け</span><span begin="1:09.805" end="1:10.062">て</span><span ttm:role="x-translation" xml:lang="zh-CN">追逐着看不见的答案 / Chasing answers we can&apos;t see</span></p><p begin="1:10.281" end="1:14.375" itunes:key="L15" ttm:agent="v1"><span begin="1:10.281" end="1:10.516">ど</span><span begin="1:10.516" end="1:10.775">こ</span><span begin="1:10.775" end="1:11.015">ま</span><span begin="1:11.015" end="1:11.152">で</span><span begin="1:11.152" end="1:11.397">往</span><span begin="1:11.397" end="1:11.489">っ</span><span begin="1:11.489" end="1:11.735">て</span><span begin="1:11.735" end="1:11.998">も</span> <span begin="1:12.223" end="1:12.699" amll:empty-beat="1">何</span><span begin="1:12.699" end="1:12.934">の</span><span begin="1:12.934" end="1:13.436" amll:empty-beat="1">為</span><span begin="1:13.436" end="1:13.630">生</span><span begin="1:13.630" end="1:13.887">き</span><span begin="1:13.887" end="1:14.022">て</span><span begin="1:14.022" end="1:14.249">も</span><span ttm:role="x-translation" xml:lang="zh-CN">无论走到哪里 无论为何而活 / No matter how far we go, or what we live for</span></p><p begin="1:14.375" end="1:18.000" itunes:key="L16" ttm:agent="v1"><span begin="1:14.375" end="1:14.481">癒</span><span begin="1:14.481" end="1:14.610">え</span><span begin="1:14.610" end="1:14.882">な</span><span begin="1:14.882" end="1:15.120">い</span><span begin="1:15.321" end="1:15.819" amll:empty-beat="1">傷</span><span begin="1:15.819" end="1:16.012">は</span><span begin="1:16.012" end="1:16.286">増</span><span begin="1:16.286" end="1:16.525">え</span><span begin="1:16.525" end="1:17.255">る</span><span begin="1:17.255" end="1:17.379">け</span><span begin="1:17.379" end="1:17.492">れ</span><span begin="1:17.492" end="1:17.771">ど</span><span ttm:role="x-translation" xml:lang="zh-CN">虽然无法痊愈的伤痕在增加 / The wounds that won&apos;t heal only grow but still</span></p><p begin="1:18.000" end="1:18.603" itunes:key="L17" ttm:agent="v1"><span begin="1:18.000" end="1:18.199">行</span><span begin="1:18.199" end="1:18.443">こ</span><span begin="1:18.443" end="1:18.603">う</span><span ttm:role="x-translation" xml:lang="zh-CN">出发吧 / We go on</span></p><p begin="1:34.053" end="1:37.889" itunes:key="L18" ttm:agent="v1"><span begin="1:34.053" end="1:34.230" amll:empty-beat="1">大</span><span begin="1:34.230" end="1:34.529">事</span><span begin="1:34.529" end="1:34.773">に</span><span begin="1:34.773" end="1:35.123" amll:empty-beat="1">握</span><span begin="1:35.123" end="1:35.283">り</span><span begin="1:35.283" end="1:35.502">締</span><span begin="1:35.502" end="1:35.728">め</span> <span begin="1:35.957" end="1:36.231" amll:empty-beat="1">歪</span><span begin="1:36.231" end="1:36.449">ん</span><span begin="1:36.449" end="1:36.686">で</span><span begin="1:36.686" end="1:36.929">い</span><span begin="1:36.929" end="1:37.038">た</span><span begin="1:37.038" end="1:37.291">希</span><span begin="1:37.291" end="1:37.650" amll:empty-beat="1">望</span><span ttm:role="x-translation" xml:lang="zh-CN">曾珍重紧握 却已扭曲的希望 / The hope I held so tightly twisted out of shape</span></p><p begin="1:37.889" end="1:41.487" itunes:key="L19" ttm:agent="v1"><span begin="1:37.889" end="1:38.115" amll:empty-beat="1">高</span><span begin="1:38.115" end="1:38.358">く</span><span begin="1:38.358" end="1:38.587">飛</span><span begin="1:38.587" end="1:38.699">ぼ</span><span begin="1:38.699" end="1:38.817">う</span><span begin="1:38.817" end="1:38.918">と</span><span begin="1:38.918" end="1:39.222">す</span><span begin="1:39.222" end="1:39.318">れ</span><span begin="1:39.318" end="1:39.609">ば</span> <span begin="1:39.809" end="1:40.041" amll:empty-beat="1">深</span><span begin="1:40.041" end="1:40.282">く</span><span begin="1:40.282" end="1:40.503">落</span><span begin="1:40.503" end="1:40.778">ち</span><span begin="1:40.778" end="1:40.846">て</span><span begin="1:40.846" end="1:41.132">し</span><span begin="1:41.132" end="1:41.262">ま</span><span begin="1:41.262" end="1:41.487">う</span><span ttm:role="x-translation" xml:lang="zh-CN">越想飞得高 就会坠得越深 / Whenever I tried to fly higher, I only fell deeper</span></p><p begin="1:41.722" end="1:45.579" itunes:key="L20" ttm:agent="v1"><span begin="1:41.722" end="1:41.889" amll:empty-beat="1">泥</span><span begin="1:41.889" end="1:42.194" amll:empty-beat="1">水</span><span begin="1:42.194" end="1:42.261">を</span><span begin="1:42.261" end="1:42.566" amll:empty-beat="1">啜</span><span begin="1:42.566" end="1:42.706">っ</span><span begin="1:42.706" end="1:42.802">て</span><span begin="1:42.802" end="1:43.029">も</span> <span begin="1:43.029" end="1:43.415" amll:empty-beat="1">花</span><span begin="1:43.415" end="1:43.896">に</span><span begin="1:44.137" end="1:44.249">な</span><span begin="1:44.249" end="1:44.377">れ</span><span begin="1:44.377" end="1:44.505">な</span><span begin="1:44.505" end="1:44.899">い</span><span ttm:role="x-translation" xml:lang="zh-CN">即使啜饮泥水 也无法化作花朵 / Even drinking muddy water won&apos;t turn me into a flower</span></p><p begin="1:45.579" end="1:46.930" itunes:key="L21" ttm:agent="v1"><span begin="1:45.579" end="1:45.811" amll:empty-beat="1">思</span><span begin="1:45.811" end="1:46.060">い</span><span begin="1:46.060" end="1:46.278">通</span><span begin="1:46.278" end="1:46.495">り</span><span begin="1:46.495" end="1:46.642">じゃ</span><span begin="1:46.642" end="1:46.832">な</span><span begin="1:46.832" end="1:46.930">い</span><span ttm:role="x-translation" xml:lang="zh-CN">不能如愿 / Nothing goes the way I want it to</span></p><p begin="1:47.026" end="1:52.524" itunes:key="L22" ttm:agent="v1"><span begin="1:47.026" end="1:47.244" amll:empty-beat="1">夢</span><span begin="1:47.500" end="1:47.648">の</span><span begin="1:47.732" end="1:47.832">ま</span><span begin="1:47.963" end="1:48.063">た</span><span begin="1:48.208" end="1:48.308" amll:empty-beat="1">夢</span><span begin="1:48.699" end="1:48.880">の</span><span begin="1:48.930" end="1:49.173">な</span><span begin="1:49.173" end="1:49.468">か</span> <span begin="1:49.648" end="1:49.897">な</span><span begin="1:49.897" end="1:50.119">に</span><span begin="1:50.119" end="1:50.380">を</span><span begin="1:50.568" end="1:51.090" amll:empty-beat="1">啜</span><span begin="1:51.090" end="1:51.401">る？</span><span begin="1:51.562" end="1:52.270">「 」</span><span ttm:role="x-translation" xml:lang="zh-CN">在梦中之梦里 要写下什么？「 」 / Inside a dream, within a dream, what will you write? &quot; &quot;</span></p><p begin="1:52.524" end="1:54.401" itunes:key="L23" ttm:agent="v1"><span begin="1:52.524" end="1:52.780">ど</span><span begin="1:52.780" end="1:53.012">こ</span><span begin="1:53.012" end="1:53.370">に</span><span begin="1:53.733" end="1:53.970" amll:empty-beat="1">届</span><span begin="1:53.970" end="1:54.401">く？</span><span ttm:role="x-translation" xml:lang="zh-CN">要传到哪里去？ / Where will it reach?</span></p><p begin="1:54.670" end="1:58.289" itunes:key="L24" ttm:agent="v1"><span begin="1:54.670" end="1:54.870" amll:empty-beat="1">夢</span><span begin="1:55.165" end="1:55.265">は</span><span begin="1:55.404" end="1:55.504">ま</span><span begin="1:55.660" end="1:55.760">だ</span><span begin="1:55.882" end="1:56.361" amll:empty-beat="1">夢</span><span begin="1:56.361" end="1:56.620">の</span><span begin="1:56.620" end="1:56.848">ま</span><span begin="1:56.848" end="1:57.071">ま</span><span begin="1:57.251" end="1:57.805" amll:empty-beat="1">進</span><span begin="1:57.805" end="1:58.049">む</span><span ttm:role="x-translation" xml:lang="zh-CN">梦想仍以梦的形态前进 / The dream goes on, still only a dream</span></p><p begin="1:58.289" end="2:02.339" itunes:key="L25" ttm:agent="v1"><span begin="1:58.289" end="1:58.542">止</span><span begin="1:58.542" end="1:58.771">ま</span><span begin="1:58.771" end="1:59.256">ら</span><span begin="1:59.256" end="1:59.815">な</span><span begin="1:59.815" end="2:00.208">い</span><span begin="2:00.208" end="2:00.699" amll:empty-beat="1">者</span><span begin="2:00.699" end="2:01.190">は</span><span begin="2:01.390" end="2:01.668" amll:empty-beat="1">転</span><span begin="2:01.668" end="2:02.139">ぶ</span><span ttm:role="x-translation" xml:lang="zh-CN">不肯停下的人会跌倒 / If you keep moving, you&apos;ll stumble,</span></p><p begin="2:02.339" end="2:06.441" itunes:key="L26" ttm:agent="v1"><span begin="2:02.339" end="2:02.439">け</span><span begin="2:02.619" end="2:02.719">れ</span><span begin="2:02.856" end="2:02.956">ど</span><span begin="2:03.079" end="2:03.179">景</span><span begin="2:03.253" end="2:03.818" amll:empty-beat="1">色</span><span begin="2:03.818" end="2:04.059">は</span><span begin="2:04.059" end="2:04.299">変</span><span begin="2:04.299" end="2:04.539">わ</span><span begin="2:04.539" end="2:06.441">る</span><span ttm:role="x-translation" xml:lang="zh-CN">但景色在改变 / But the scenery will change</span></p><p begin="2:18.697" end="2:22.422" itunes:key="L27" ttm:agent="v1"><span begin="2:18.697" end="2:19.123" amll:empty-beat="1">今</span><span begin="2:19.123" end="2:19.542">更</span><span begin="2:19.542" end="2:19.646">わ</span><span begin="2:19.646" end="2:19.801">か</span><span begin="2:19.801" end="2:19.887">っ</span><span begin="2:19.887" end="2:20.396">た</span> <span begin="2:20.601" end="2:20.720">生</span><span begin="2:20.720" end="2:20.849">ま</span><span begin="2:20.849" end="2:21.059">れ</span><span begin="2:21.059" end="2:21.184">た</span><span begin="2:21.184" end="2:21.443">き</span><span begin="2:21.443" end="2:21.566">た</span><span begin="2:21.566" end="2:21.694">意</span><span begin="2:21.694" end="2:21.805">味</span><span begin="2:21.805" end="2:22.308">が</span><span ttm:role="x-translation" xml:lang="zh-CN">事到如今才明白 降生于世的意义 / Now I finally understand the meaning of being born</span></p><p begin="2:22.422" end="2:24.421" itunes:key="L28" ttm:agent="v1"><span begin="2:22.422" end="2:22.609">死</span><span begin="2:22.609" end="2:22.778">ね</span><span begin="2:22.778" end="2:22.990">な</span><span begin="2:22.990" end="2:23.128">い</span><span begin="2:23.128" end="2:23.361">理</span><span begin="2:23.361" end="2:23.738" amll:empty-beat="1">由</span><span begin="2:23.738" end="2:24.209">が</span><span ttm:role="x-translation" xml:lang="zh-CN">和无法死去的理由 / The reason I can&apos;t just die</span></p><p begin="2:24.421" end="2:28.030" itunes:key="L29" ttm:agent="v1"><span begin="2:24.421" end="2:24.699" amll:empty-beat="1">下</span><span begin="2:24.699" end="2:24.927">書</span><span begin="2:24.927" end="2:24.985">き</span><span begin="2:24.985" end="2:25.272">す</span><span begin="2:25.272" end="2:25.403">ら</span><span begin="2:25.403" end="2:25.538">も</span><span begin="2:25.538" end="2:25.661">無</span><span begin="2:25.661" end="2:25.939">い</span> <span begin="2:26.136" end="2:26.600" amll:empty-beat="1">何</span><span begin="2:26.600" end="2:26.823">か</span><span begin="2:26.823" end="2:26.965">が</span><span begin="2:26.965" end="2:27.212">見</span><span begin="2:27.212" end="2:27.335">た</span><span begin="2:27.335" end="2:27.445">い</span><span begin="2:27.445" end="2:27.583">ん</span><span begin="2:27.583" end="2:28.030">だ</span><span ttm:role="x-translation" xml:lang="zh-CN">只是想看见些 连草稿都没有的某物 / I want to see something with no draft, no outline at all</span></p><p begin="2:28.297" end="2:30.207" itunes:key="L30" ttm:agent="v1"><span begin="2:28.297" end="2:28.533" amll:empty-beat="1">思</span><span begin="2:28.533" end="2:28.778">う</span><span begin="2:28.778" end="2:28.902">ま</span><span begin="2:28.902" end="2:29.129">ま</span><span begin="2:29.129" end="2:29.224">描</span><span begin="2:29.224" end="2:29.370">き</span><span begin="2:29.370" end="2:29.443">出</span><span begin="2:29.443" end="2:29.859">そ</span><span begin="2:29.859" end="2:29.978">う</span><span ttm:role="x-translation" xml:lang="zh-CN">随心描绘吧 / So I&apos;ll draw it exactly as I feel</span></p><p begin="2:30.207" end="2:34.440" itunes:key="L31" ttm:agent="v1"><span begin="2:30.207" end="2:30.458" amll:empty-beat="1">後</span><span begin="2:30.458" end="2:30.671">書</span><span begin="2:30.671" end="2:30.807">き</span><span begin="2:30.807" end="2:31.023">で</span><span begin="2:31.023" end="2:31.172">あ</span><span begin="2:31.172" end="2:31.290">れ</span><span begin="2:31.290" end="2:31.408">こ</span><span begin="2:31.408" end="2:31.693">れ</span> <span begin="2:31.899" end="2:32.620" amll:empty-beat="1">語</span><span begin="2:32.620" end="2:32.860">れ</span><span begin="2:32.860" end="2:33.341">ば</span><span begin="2:33.341" end="2:33.785">い</span><span begin="2:33.785" end="2:34.440">い</span><span ttm:role="x-translation" xml:lang="zh-CN">待到后记再把种种说出来就好 / And save the explanations for the afterword</span></p><p begin="2:34.785" end="2:38.861" itunes:key="L32" ttm:agent="v1"><span begin="2:34.785" end="2:35.247" amll:empty-beat="1">僕</span><span begin="2:35.247" end="2:35.488">ら</span><span begin="2:35.488" end="2:35.553">は</span><span begin="2:35.553" end="2:35.681">識</span><span begin="2:35.681" end="2:35.969">っ</span><span begin="2:35.969" end="2:36.102">て</span><span begin="2:36.102" end="2:36.232">い</span><span begin="2:36.232" end="2:36.525">る</span> <span begin="2:36.587" end="2:36.928">世</span><span begin="2:36.928" end="2:37.422" amll:empty-beat="1">界</span><span begin="2:37.422" end="2:37.532">の</span><span begin="2:37.532" end="2:38.113" amll:empty-beat="1">歩</span><span begin="2:38.113" end="2:38.370">き</span><span begin="2:38.370" end="2:38.709" amll:empty-beat="1">方</span><span ttm:role="x-translation" xml:lang="zh-CN">我们知晓 世界的行走方式 / We already know our own way of walking the world</span></p><p begin="2:38.861" end="2:42.257" itunes:key="L33" ttm:agent="v1"><span begin="2:38.861" end="2:38.968">だ</span><span begin="2:38.968" end="2:39.097">か</span><span begin="2:39.097" end="2:39.780">ら</span><span begin="2:39.780" end="2:40.026">今</span><span begin="2:40.026" end="2:40.280">日</span><span begin="2:40.280" end="2:40.515">こ</span><span begin="2:40.515" end="2:40.776">こ</span><span begin="2:40.776" end="2:41.005">ま</span><span begin="2:41.005" end="2:41.720">で</span><span begin="2:41.720" end="2:41.809">来</span><span begin="2:41.809" end="2:41.935">た</span><span begin="2:41.935" end="2:42.257">ろ</span><span ttm:role="x-translation" xml:lang="zh-CN">所以才来到了今天这里 对吧？ / That&apos;s how we made it this far, isn&apos;t it?</span></p><p begin="2:42.451" end="2:46.510" itunes:key="L34" ttm:agent="v1"><span begin="2:42.451" end="2:42.927" amll:empty-beat="1">始</span><span begin="2:42.927" end="2:43.187">ま</span><span begin="2:43.187" end="2:43.278">り</span><span begin="2:43.278" end="2:43.569">の</span><span begin="2:43.569" end="2:43.882">日</span><span begin="2:43.882" end="2:44.126">の</span> <span begin="2:44.386" end="2:44.486">行</span><span begin="2:44.620" end="2:44.720">く</span><span begin="2:44.879" end="2:45.079" amll:empty-beat="1">宛</span><span begin="2:45.337" end="2:45.437">も</span><span begin="2:45.566" end="2:46.007">願</span><span begin="2:46.007" end="2:46.179">い</span><span begin="2:46.179" end="2:46.360">も</span><span ttm:role="x-translation" xml:lang="zh-CN">启程那天的 去向和心愿 / The hopes and destinations we had on the very first day</span></p><p begin="2:46.510" end="2:49.889" itunes:key="L35" ttm:agent="v1"><span begin="2:46.510" end="2:46.620">ど</span><span begin="2:46.620" end="2:46.751">れ</span><span begin="2:46.751" end="2:47.460">も</span><span begin="2:47.460" end="2:47.721">予</span><span begin="2:47.721" end="2:48.207" amll:empty-beat="1">定</span><span begin="2:48.207" end="2:48.395">と</span><span begin="2:48.395" end="2:49.035" amll:empty-beat="1">違</span><span begin="2:49.035" end="2:49.395">う</span><span begin="2:49.395" end="2:49.524">け</span><span begin="2:49.524" end="2:49.655">れ</span><span begin="2:49.655" end="2:49.889">ど</span><span ttm:role="x-translation" xml:lang="zh-CN">虽都与计划不同 / All turned out different from what we planned</span></p><p begin="2:50.103" end="2:57.098" itunes:key="L36" ttm:agent="v1"><span begin="2:50.103" end="2:50.606">ほ</span><span begin="2:50.606" end="2:51.028">ら、</span><span begin="2:51.318" end="2:51.814" amll:empty-beat="1">声</span><span begin="2:51.814" end="2:51.920">が</span><span begin="2:51.920" end="2:52.315">す</span><span begin="2:52.315" end="2:52.532">る</span><span begin="2:52.532" end="2:52.881">の</span><span ttm:role="x-translation" xml:lang="zh-CN">快听，有声音在说 / But listen—there&apos;s a voice saying</span></p><p begin="2:53.147" end="2:57.098" itunes:key="L37" ttm:agent="v1"><span begin="2:53.147" end="2:53.492">「そ</span><span begin="2:53.492" end="2:53.737">れ</span><span begin="2:53.737" end="2:53.972">で</span><span begin="2:53.972" end="2:54.172">も」</span><span begin="2:54.172" end="2:54.448">っ</span><span begin="2:54.448" end="2:57.098">て</span><span ttm:role="x-translation" xml:lang="zh-CN">“即便如此” / &quot;Even so...&quot;</span></p><p begin="2:57.568" end="3:03.802" itunes:key="L38" ttm:agent="v1"><span begin="2:57.568" end="2:57.812">あ</span><span begin="2:57.812" end="2:58.053">れ</span><span begin="2:58.053" end="2:58.288">か</span><span begin="2:58.288" end="2:58.789">ら</span><span begin="2:59.015" end="2:59.272">ま</span><span begin="2:59.272" end="2:59.722">だ</span> <span begin="2:59.980" end="3:00.213">終</span><span begin="3:00.213" end="3:00.480">わ</span><span begin="3:00.480" end="3:00.684">ら</span><span begin="3:00.684" end="3:00.921">な</span><span begin="3:00.921" end="3:01.165">い</span><span begin="3:01.165" end="3:01.683" amll:empty-beat="1">夢</span><span begin="3:01.683" end="3:01.873">の</span><span begin="3:01.873" end="3:02.098">途</span><span begin="3:02.098" end="3:03.802">中</span><span ttm:role="x-translation" xml:lang="zh-CN">自那以后 仍在未完结的梦的途中 / Since then, we&apos;re still inside a dream that hasn&apos;t ended</span></p><p begin="3:05.233" end="3:10.655" itunes:key="L39" ttm:agent="v1"><span begin="3:05.233" end="3:05.501">未</span><span begin="3:05.501" end="3:05.961" amll:empty-beat="1">来</span><span begin="3:05.961" end="3:06.479">の</span><span begin="3:06.658" end="3:06.938">日</span><span begin="3:06.938" end="3:07.369">の</span> <span begin="3:07.633" end="3:07.872">過</span><span begin="3:07.872" end="3:08.118">去</span><span begin="3:08.118" end="3:08.375">を</span><span begin="3:08.375" end="3:08.851" amll:empty-beat="1">今</span><span begin="3:08.851" end="3:09.070">変</span><span begin="3:09.070" end="3:09.219">え</span><span begin="3:09.219" end="3:09.356">て</span><span begin="3:09.356" end="3:09.496">み</span><span begin="3:09.496" end="3:09.823">せ</span><span begin="3:09.823" end="3:10.175">て</span><span ttm:role="x-translation" xml:lang="zh-CN">把未来之日的过去 现在就改变给你看 / I&apos;ll change the past of the future from right here, right now</span></p></div></body></tt>