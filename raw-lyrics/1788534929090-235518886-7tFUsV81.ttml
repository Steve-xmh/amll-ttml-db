<tt xmlns="http://www.w3.org/ns/ttml" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xmlns:amll="http://www.example.com/ns/amll"><head><metadata><ttm:agent type="person" xml:id="v1"/><ttm:agent type="other" xml:id="v2"/><amll:meta key="musicName" value="Look At The Sky (Live)"/><amll:meta key="artists" value="Porter Robinson"/><amll:meta key="album" value="Secret Sky 2021 (Live)"/><amll:meta key="ncmMusicId" value="1864859264"/><amll:meta key="ttmlAuthorGithub" value="235518886"/><amll:meta key="ttmlAuthorGithubLogin" value="chan-air"/></metadata></head><body dur="5:37.042"><div begin="1:07.957" end="5:37.042"><p begin="1:07.957" end="1:09.307" itunes:key="L0" ttm:agent="v2"><span begin="1:07.957" end="1:08.211">Is</span> <span begin="1:08.211" end="1:08.484">it</span> <span begin="1:08.484" end="1:09.307">fate</span><span ttm:role="x-translation" xml:lang="zh-CN">这是命运吗</span></p><p begin="1:11.861" end="1:15.253" itunes:key="L1" ttm:agent="v2"><span begin="1:11.861" end="1:12.095">If</span> <span begin="1:12.095" end="1:12.345">it’s</span> <span begin="1:12.345" end="1:12.594">not</span> <span begin="1:12.594" end="1:13.165">ea</span><span begin="1:13.165" end="1:13.426">sy</span> <span begin="1:13.426" end="1:13.678">it</span> <span begin="1:13.678" end="1:14.212">must</span> <span begin="1:14.212" end="1:14.735">not</span> <span begin="1:14.735" end="1:15.253">be</span><span ttm:role="x-translation" xml:lang="zh-CN">如果走投无路 那一定束手无策</span></p><p begin="1:16.287" end="1:17.852" itunes:key="L2" ttm:agent="v2"><span begin="1:16.287" end="1:16.528">At</span> <span begin="1:16.528" end="1:16.789">that</span> <span begin="1:16.789" end="1:17.589">a</span><span begin="1:17.589" end="1:17.852">ge</span><span ttm:role="x-translation" xml:lang="zh-CN">在那个年纪</span></p><p begin="1:19.928" end="1:23.619" itunes:key="L3" ttm:agent="v2"><span begin="1:19.928" end="1:20.183">I</span> <span begin="1:20.183" end="1:20.432">che</span><span begin="1:20.432" end="1:20.705">rished</span> <span begin="1:20.705" end="1:20.972">the</span> <span begin="1:20.972" end="1:21.515">flo</span><span begin="1:21.515" end="1:21.779">wers</span> <span begin="1:21.779" end="1:22.021">be</span><span begin="1:22.021" end="1:22.552">neath</span> <span begin="1:22.552" end="1:23.075">my</span> <span begin="1:23.075" end="1:23.619">feet</span><span ttm:role="x-translation" xml:lang="zh-CN">我曾珍惜脚下花朵</span></p><p begin="1:24.631" end="1:28.916" itunes:key="L4" ttm:agent="v2"><span begin="1:24.631" end="1:24.869">But</span> <span begin="1:24.869" end="1:25.427">then</span> <span begin="1:25.427" end="1:26.211">some</span><span begin="1:26.211" end="1:26.427">thing</span> <span begin="1:26.427" end="1:26.978">must</span> <span begin="1:26.978" end="1:27.480">have</span> <span begin="1:27.480" end="1:27.992">changed</span> <span begin="1:27.992" end="1:28.536">in</span> <span begin="1:28.536" end="1:28.916">me</span><span ttm:role="x-translation" xml:lang="zh-CN">而内心已百感交集</span></p><p begin="1:29.026" end="1:32.787" itunes:key="L5" ttm:agent="v2"><span begin="1:29.026" end="1:29.584">I</span> <span begin="1:29.584" end="1:30.100">used</span> <span begin="1:30.100" end="1:30.366">to</span> <span begin="1:30.366" end="1:30.942">feel</span> <span begin="1:30.942" end="1:31.417">so</span> <span begin="1:31.417" end="1:32.787">light</span><span ttm:role="x-translation" xml:lang="zh-CN">我曾感到如释重负</span></p><p begin="1:32.989" end="1:33.992" itunes:key="L6" ttm:agent="v2"><span begin="1:32.989" end="1:33.226">Now</span> <span begin="1:33.226" end="1:33.502">I’ll</span> <span begin="1:33.502" end="1:33.992">try</span><span ttm:role="x-translation" xml:lang="zh-CN">现在我会勇敢一试</span></p><p begin="1:36.624" end="1:39.266" itunes:key="L7" ttm:agent="v2"><span begin="1:36.624" end="1:36.887">I</span> <span begin="1:36.887" end="1:37.412">just</span> <span begin="1:37.412" end="1:38.466">want</span> <span begin="1:38.466" end="1:39.266">time</span><span ttm:role="x-translation" xml:lang="zh-CN">我只想分秒必争</span></p><p begin="1:42.108" end="1:43.710" itunes:key="L8" ttm:agent="v1"><span begin="1:42.108" end="1:42.929">Wait</span> <span begin="1:42.929" end="1:43.173">a</span><span begin="1:43.173" end="1:43.710">gain</span><span ttm:role="x-translation" xml:lang="zh-CN">再待花开</span></p><p begin="1:44.209" end="1:47.791" itunes:key="L9" ttm:agent="v1"><span begin="1:44.209" end="1:44.724">I</span> <span begin="1:44.724" end="1:45.230">will</span> <span begin="1:45.230" end="1:45.698">be</span> <span begin="1:45.698" end="1:46.241">much</span> <span begin="1:46.241" end="1:47.033">bet</span><span begin="1:47.033" end="1:47.279">ter</span> <span begin="1:47.279" end="1:47.791">then</span><span ttm:role="x-translation" xml:lang="zh-CN">我定会突破自我</span></p><p begin="1:48.401" end="1:51.454" itunes:key="L10" ttm:agent="v1"><span begin="1:48.401" end="1:49.156">Hol</span><span begin="1:49.156" end="1:49.391">ding</span> <span begin="1:49.391" end="1:50.273">on</span> <span begin="1:50.273" end="1:50.690">I</span> <span begin="1:50.690" end="1:51.454">said</span><span ttm:role="x-translation" xml:lang="zh-CN">坚持到底 我告诉自己</span></p><p begin="1:52.550" end="1:57.305" itunes:key="L11" ttm:agent="v1"><span begin="1:52.550" end="1:53.052">I</span> <span begin="1:53.052" end="1:53.583">will</span> <span begin="1:53.583" end="1:54.085">be</span> <span begin="1:54.085" end="1:54.630">much</span> <span begin="1:54.630" end="1:55.706">bet</span><span begin="1:55.706" end="1:56.758">ter</span> <span begin="1:56.758" end="1:57.305">then</span><span ttm:role="x-translation" xml:lang="zh-CN">我定会出类拔萃</span></p><p begin="1:59.900" end="2:03.598" itunes:key="L12" ttm:agent="v1"><span begin="1:59.900" end="2:00.170">Look</span> <span begin="2:00.170" end="2:00.427">at</span> <span begin="2:00.427" end="2:00.700">the</span> <span begin="2:00.700" end="2:01.280">sky</span> <span begin="2:01.280" end="2:02.010">I’m</span> <span begin="2:02.010" end="2:02.803">still</span> <span begin="2:02.803" end="2:03.598">here</span><span ttm:role="x-translation" xml:lang="zh-CN">仰望天空 我仍盈盈伫立</span></p><p begin="2:04.113" end="2:07.698" itunes:key="L13" ttm:agent="v1"><span begin="2:04.113" end="2:04.375">I’ll</span> <span begin="2:04.375" end="2:04.637">be</span> <span begin="2:04.637" end="2:04.897">a</span><span begin="2:04.897" end="2:06.170">live</span> <span begin="2:06.170" end="2:06.997">next</span> <span begin="2:06.997" end="2:07.698">year</span><span ttm:role="x-translation" xml:lang="zh-CN">再待花开 我光彩依旧 兴致盎然</span></p><p begin="2:08.230" end="2:12.641" itunes:key="L14" ttm:agent="v1"><span begin="2:08.230" end="2:08.432">I</span> <span begin="2:08.432" end="2:08.710">can</span> <span begin="2:08.710" end="2:09.245">make</span> <span begin="2:09.245" end="2:10.315">some</span><span begin="2:10.315" end="2:11.079">thing</span> <span begin="2:11.079" end="2:11.896">good</span> <span begin="2:12.132" end="2:12.641">oh</span><span ttm:role="x-translation" xml:lang="zh-CN">我会创造美好事物</span><span ttm:role="x-bg" begin="2:13.187" end="2:16.036"><span begin="2:13.187" end="2:14.231">(Some</span><span begin="2:14.231" end="2:15.247">thing</span> <span begin="2:15.247" end="2:16.036">good)</span><span ttm:role="x-translation" xml:lang="zh-CN">满怀憧憬</span></span></p><p begin="2:16.557" end="2:20.219" itunes:key="L15" ttm:agent="v1"><span begin="2:16.557" end="2:16.804">Look</span> <span begin="2:16.804" end="2:17.040">at</span> <span begin="2:17.040" end="2:17.324">the</span> <span begin="2:17.324" end="2:17.841">sky</span> <span begin="2:17.841" end="2:18.636">I’m</span> <span begin="2:18.636" end="2:19.440">still</span> <span begin="2:19.440" end="2:20.219">here</span><span ttm:role="x-translation" xml:lang="zh-CN">仰望天空 我仍盈盈伫立</span></p><p begin="2:20.724" end="2:24.215" itunes:key="L16" ttm:agent="v1"><span begin="2:20.724" end="2:20.991">I’ll</span> <span begin="2:20.991" end="2:21.254">be</span> <span begin="2:21.254" end="2:21.517">a</span><span begin="2:21.517" end="2:22.839">live</span> <span begin="2:22.839" end="2:23.900">next</span> <span begin="2:23.900" end="2:24.215">year</span><span ttm:role="x-translation" xml:lang="zh-CN">再待花开 我光彩依旧 兴致盎然</span></p><p begin="2:24.920" end="2:29.551" itunes:key="L17" ttm:agent="v1"><span begin="2:24.920" end="2:25.176">I</span> <span begin="2:25.176" end="2:25.416">can</span> <span begin="2:25.416" end="2:25.978">make</span> <span begin="2:25.978" end="2:27.011">some</span><span begin="2:27.011" end="2:27.773">thing</span> <span begin="2:27.773" end="2:28.586">good</span> <span begin="2:28.795" end="2:29.551">oh</span><span ttm:role="x-translation" xml:lang="zh-CN">我会创造美好事物</span><span ttm:role="x-bg" begin="2:29.841" end="2:32.514"><span begin="2:29.841" end="2:30.919">(Some</span><span begin="2:30.919" end="2:31.943">thing</span> <span begin="2:31.943" end="2:32.514">good)</span><span ttm:role="x-translation" xml:lang="zh-CN">满怀憧憬</span></span></p><p begin="2:33.555" end="2:35.034" itunes:key="L18" ttm:agent="v2"><span begin="2:33.555" end="2:33.799">Are</span> <span begin="2:33.799" end="2:34.046">you</span> <span begin="2:34.046" end="2:35.034">close</span><span ttm:role="x-translation" xml:lang="zh-CN">你会靠近吗</span></p><p begin="2:37.445" end="2:40.827" itunes:key="L19" ttm:agent="v2"><span begin="2:37.445" end="2:37.680">Shoul</span><span begin="2:37.680" end="2:37.933">dn’t</span> <span begin="2:37.933" end="2:38.196">it</span> <span begin="2:38.196" end="2:38.734">come</span> <span begin="2:38.734" end="2:39.003">to</span> <span begin="2:39.003" end="2:39.230">you</span> <span begin="2:39.230" end="2:39.788">na</span><span begin="2:39.788" end="2:40.299">tural</span><span begin="2:40.299" end="2:40.827">ly</span><span ttm:role="x-translation" xml:lang="zh-CN">这对你不是顺其自然的事吗</span></p><p begin="2:41.323" end="2:43.175" itunes:key="L20" ttm:agent="v2"><span begin="2:41.323" end="2:41.594">And</span> <span begin="2:41.594" end="2:41.834">e</span><span begin="2:41.834" end="2:42.105">very</span><span begin="2:42.105" end="2:42.374">one</span> <span begin="2:42.374" end="2:43.175">knows</span><span ttm:role="x-translation" xml:lang="zh-CN">世人皆知</span></p><p begin="2:45.534" end="2:49.173" itunes:key="L21" ttm:agent="v2"><span begin="2:45.534" end="2:45.795">You’re</span> <span begin="2:45.795" end="2:46.033">lo</span><span begin="2:46.033" end="2:46.292">sing</span> <span begin="2:46.292" end="2:46.563">your</span> <span begin="2:46.563" end="2:47.085">gift</span> <span begin="2:47.085" end="2:47.338">and</span> <span begin="2:47.338" end="2:47.613">it’s</span> <span begin="2:47.613" end="2:48.133">plain</span> <span begin="2:48.133" end="2:48.644">to</span> <span begin="2:48.644" end="2:49.173">see</span><span ttm:role="x-translation" xml:lang="zh-CN">显而易见的 你天赋渐失</span></p><p begin="2:50.220" end="2:54.410" itunes:key="L22" ttm:agent="v2"><span begin="2:50.220" end="2:50.458">But</span> <span begin="2:50.458" end="2:51.002">then</span> <span begin="2:51.002" end="2:51.793">some</span><span begin="2:51.793" end="2:52.042">thing</span> <span begin="2:52.042" end="2:52.547">must</span> <span begin="2:52.547" end="2:53.061">have</span> <span begin="2:53.061" end="2:53.618">changed</span> <span begin="2:53.618" end="2:54.143">in</span> <span begin="2:54.143" end="2:54.410">me</span><span ttm:role="x-translation" xml:lang="zh-CN">而我内心已百感交集</span></p><p begin="2:54.410" end="2:57.017" itunes:key="L23" ttm:agent="v2"><span begin="2:54.410" end="2:54.623">I</span> <span begin="2:54.623" end="2:55.195">don’t</span> <span begin="2:55.195" end="2:55.671">fear</span> <span begin="2:55.671" end="2:55.932">it</span> <span begin="2:55.932" end="2:56.195">a</span><span begin="2:56.195" end="2:56.460">ny</span><span begin="2:56.460" end="2:57.017">more</span><span ttm:role="x-translation" xml:lang="zh-CN">我不再恐惧</span></p><p begin="2:58.550" end="2:59.66