<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xmlns:amll="http://www.example.com/ns/amll" xmlns:itunes="http://itunes.apple.com/lyric-ttml-extensions" xml:lang="en" itunes:timing="Word"><head><metadata><ttm:agent type="person" xml:id="v1"><ttm:name type="full">Taylor Swift</ttm:name></ttm:agent><amll:meta key="ttmlAuthorGithubLogin" value="kid141252010"/><amll:meta key="ttmlAuthorGithubLogin" value="kid1412520"/><amll:meta key="ttmlAuthorGithub" value="250306205"/><amll:meta key="ttmlAuthorGithub" value="207428447"/><amll:meta key="musicName" value="This Is Why We Can’t Have Nice Things"/><amll:meta key="musicName" value="ディス・イズ・ホワイ・ウィ・キャント・ハヴ・ナイス・シングス"/><amll:meta key="artists" value="Taylor Swift"/><amll:meta key="artists" value="泰勒·斯威夫特"/><amll:meta key="artists" value="テイラー・スウィフト"/><amll:meta key="album" value="reputation"/><amll:meta key="album" value="reputation (Big Machine Radio Release Special)"/><amll:meta key="ncmMusicId" value="516819321"/><amll:meta key="ncmMusicId" value="1333126669"/><amll:meta key="qqMusicId" value="208426598"/><amll:meta key="qqMusicId" value="001oyJ924Qeqq8"/><amll:meta key="qqMusicId" value="318731497"/><amll:meta key="qqMusicId" value="0021Zv5q0OBUQ9"/><amll:meta key="spotifyId" value="07NxDD1iKCHbAldceD7QLP"/><amll:meta key="spotifyId" value="0UQt3V4blAIxgkW1a6zVOd"/><amll:meta key="appleMusicId" value="1440934423"/><amll:meta key="appleMusicId" value="1445766358"/><amll:meta key="isrc" value="USCJY1750014"/><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal"><songwriters><songwriter>Jack Antonoff</songwriter><songwriter>Taylor Swift</songwriter></songwriters><translations><translation xml:lang="zh-Hans" type="subtitle"><text for="L1">办个大派对实在太美好</text><text for="L2">从阳台跳进泳池</text><text for="L3">大家都在香槟的海洋里畅游</text><text for="L4">来到这里 所有规则都不存在</text><text for="L5">低音节奏震动吊灯</text><text for="L6">那一整年 我感觉自己像盖茨比</text><text for="L7">你为什么要破坏我的欢乐时光</text><text for="L8">我摇着头</text><text for="L9">锁上大门</text><text for="L10">我们因此无法拥有美好 亲爱的</text><text for="L11">因为你总是破坏它们</text><text for="L12">我不得不把它们带走</text><text for="L13">我们因此无法拥有美好 亲爱的</text><text for="L14">你以为我不会听到你说的关于我的那些话吗</text><text for="L15">我们因此无法拥有美好</text><text for="L16">再次成为朋友感觉很好</text><text for="L17">我在给你第二次机会</text><text for="L18">但你却在和我握手时背后捅了我一刀</text><text for="L19">正是这个问题</text><text for="L20">朋友不会试图欺骗你</text><text for="L21">也不会通过电话迷惑你</text><text for="L22">所以我拿起斧头砍掉了修好的围栏</text><text for="L23">但你最近失去的可不止我一个朋友</text><text for="L24">如果你不那么</text><text for="L25">阴险就好了</text><text for="L26">我们因此无法拥有美好 亲爱的</text><text for="L27">因为你总是破坏它们</text><text for="L28">我不得不把它们带走</text><text for="L29">我们因此无法拥有美好 亲爱的<span ttm:role="x-bg">美好 宝贝</span></text><text for="L30">你以为我不会听到你说的关于我的那些话吗</text><text for="L31">我们因此无法拥有</text><text for="L32">敬我真正的朋友</text><text for="L33">他们不在乎那些流言蜚语</text><text for="L34">敬我的宝贝</text><text for="L35">他不在乎别人怎么说我</text><text for="L36">敬我的妈妈</text><text for="L37">她不得不听这些闹剧</text><text for="L38">敬你</text><text for="L39">因为宽恕是一件美好的事</text><text for="L40">哈哈哈 我甚至无法直视着说</text><text for="L41">我们因此无法拥有美好 亲爱的<span ttm:role="x-bg">亲爱的</span></text><text for="L42">因为你总是破坏它们</text><text for="L43">我不得不把它们带走</text><text for="L44">我们因此无法拥有美好 亲爱的<span ttm:role="x-bg">啊哈 哦不 宝贝</span></text><text for="L45">你以为我不会听到你说的关于我的那些话吗</text><text for="L46">我们因此无法拥有美好 亲爱的<span ttm:role="x-bg">敬我真正的朋友</span></text><text for="L47">因为你总是破坏它们</text><text for="L48">我不得不把它们带走<span ttm:role="x-bg">敬我的宝贝</span></text><text for="L49">美好 亲爱的<span ttm:role="x-bg">他们不在乎那些流言蜚语</span></text><text for="L50">你以为我不会听到你说的关于我的那些话吗</text><text for="L51">我们因此无法拥有美好</text></translation></translations><audio lyricOffset="0.065" role="spatial"/></iTunesMetadata></metadata></head><body dur="03:25.182"><div begin="00:06.789" end="00:28.331" itunes:songPart="Verse"><p begin="00:06.789" end="00:09.407" ttm:agent="v1" itunes:key="L1"><span begin="00:06.789" end="00:06.943