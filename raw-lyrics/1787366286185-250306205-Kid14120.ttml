 key="appleMusicId" value="1440936036"/><amll:meta key="appleMusicId" value="1440936283"/><amll:meta key="appleMusicId" value="1445888403"/><amll:meta key="appleMusicId" value="1445882363"/><amll:meta key="appleMusicId" value="1440819526"/><amll:meta key="appleMusicId" value="1440825407"/><amll:meta key="appleMusicId" value="1445765915"/><amll:meta key="appleMusicId" value="1444778014"/><amll:meta key="isrc" value="USCJY1431379"/><amll:meta key="ttmlAuthorGithub" value="207428447"/><amll:meta key="ttmlAuthorGithub" value="250306205"/><amll:meta key="ttmlAuthorGithubLogin" value="kid1412520"/><amll:meta key="ttmlAuthorGithubLogin" value="kid141252010"/><iTunesMetadata><songwriters><songwriter>Max Martin</songwriter><songwriter>Shellback</songwriter><songwriter>Taylor Swift</songwriter></songwriters><translations><translation xml:lang="zh-Hans" type="subtitle"><text for="L1">他说 我们一起离开这个小镇</text><text for="L2">驱车离开城市喧嚣 远离人群</text><text for="L3">我想 现在连上天都帮不了我</text><text for="L4">没有什么是永恒的</text><text for="L5">但这段感情注定让我沉沦</text><text for="L6">他高大英俊 魅力无穷</text><text for="L7">他坏得彻底 却又如此迷人</text><text for="L8">我能在开始时就预见结局</text><text for="L9">我唯一的条件是</text><text for="L10">说你会记得我</text><text for="L11">伫立着 身穿漂亮衣裙</text><text for="L12">凝望落日的我 宝贝</text><text for="L13">红唇和玫瑰色的双颊</text><text for="L14">说你会再次见到我</text><text for="L15">哪怕只是在你</text><text for="L16">最狂野的梦境之中 啊 哈</text><text for="L17">最狂野的梦境之中 啊 哈</text><text for="L18">我说 没人需要知道我们做了什么</text><text for="L19">他的手缠绕在我的发间 他的衣服散落在我的房间里</text><text for="L20">他的声音听起来那么熟悉</text><text for="L21">没有什么是永恒</text><text for="L22">但现在一切都向好发展</text><text for="L23">他高大英俊 魅力无穷</text><text for="L24">他坏得彻底 却又如此迷人</text><text for="L25">我们最后一次亲吻时</text><text for="L26">我最后的请求是</text><text for="L27">说你会记得我</text><text for="L28">伫立着 身穿漂亮衣裙</text><text for="L29">凝望落日的我 宝贝</text><text for="L30">红唇和玫瑰色的双颊</text><text for="L31">说你会再次见到我</text><text for="L32">哪怕只是在你</text><text for="L33">最狂野的梦境之中 啊 哈<span ttm:role="x-bg" for="B1">哈 哈</span></text><text for="L34">最狂野的梦境之中 啊 哈</text><text for="L35">一切已成过往后 你会来看我</text><text for="L36">我们共度良宵 整夜缠绵</text><text for="L37">激情燃烧</text><text for="L38">总有一天 当你离开我时</text><text for="L39">我敢打赌这些回忆</text><text for="L40">会在你心头萦绕</text><text for="L41">一切已成过往后 你会来看我</text><text for="L42">我们共度良宵 整夜缠绵</text><text for="L43">激情燃烧<span ttm:role="x-bg">激情燃烧</span></text><text for="L44">总有一天 当你离开我时</text><text for="L45">我敢打赌这些回忆</text><text for="L46">会在你心头萦绕<span ttm:role="x-bg">会在你心头 在你心头萦绕</span></text><text for="L47">说你会记得我</text><text for="L48">伫立着 身穿漂亮衣裙</text><text for="L49">凝望落日的我 宝贝</text><text for="L50">红唇和玫瑰色的双颊</text><text for="L51">说你会再次见到我</text><text for="L52">哪怕只是假装而已</text><text for="L53">说你会记得我</text><text for="L54">伫立着 身穿漂亮衣裙</text><text for="L55">凝望落日的我 宝贝</text><text for="L56">红唇和玫瑰色的双颊</text><text for="L57">说你会再次见到我</text><text for="L58">哪怕只是在你<span ttm:role="x-bg">只是假装而已 只是假装而已</span></text><text for="L59">最狂野的梦境之中 啊 哈<span ttm:role="x-bg">啊</span></text><text for="L60">在你最狂野的梦境之中 啊 哈<span ttm:role="x-bg">哪怕只是在</span></text><text for="L61">在你最狂野的梦境之中 啊 哈</text><text for="L62">在你最狂野的梦境之中 啊 哈</text></translation></translations><audio lyricOffset="0.105" role="spatial"/></iTunesMetadata></metadata></head><body dur="03:33.899"><div begin="00:13.333" end="00:27.906" itunes:song-part="Verse"><p begin="00:13.333" end="00:16.327" ttm:agent="v1" itunes:key="L1"><span begin="00:13.333" end="00:13.508">He</span> <span begin="00:13.508" end="00:13.953">said,</span> <span begin="00:13.953" end="00:14.417">"Let</span><span begin="00:14.417" end="00:14.621">'s</span> <span begin="00:14.621" end="00:14.837">get</span> <span begin="00:14.837" end="00:15.099">out</span> <span begin="00:15.099" end="00:15.311">of</span> <span begin="00:15.311" end="00:15.690">this</span> <span begin="00:15.690" end="00:16.327">town</span></p><p begin="00:16.534" end="00:19.922" ttm:agent="v1" itunes:key="L2"><span begin="00:16.534" end="00:16.794">Drive</span> <span begin="00:16.794" end="00:17.027">