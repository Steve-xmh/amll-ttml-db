<tt xmlns="http://www.w3.org/ns/ttml" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xmlns:amll="http://www.example.com/ns/amll" itunes:timing="Word"><head><metadata><ttm:agent type="person" xml:id="v1"/><ttm:agent type="other" xml:id="v2"/><amll:meta key="musicName" value="La Perla"/><amll:meta key="artists" value="ROSALÍA"/><amll:meta key="artists" value="Yahritza Y Su Esencia"/><amll:meta key="album" value="LUX"/><amll:meta key="ncmMusicId" value="3315467929"/><amll:meta key="appleMusicId" value="1848167530"/><amll:meta key="ttmlAuthorGithubLogin" value="WTP016-CN"/></metadata></head><body dur="3:11.975"><div begin="4.354" end="3:11.975"><p begin="4.354" end="7.872" itunes:key="L1" ttm:agent="v1"><span begin="4.354" end="5.290">Hola,</span><span begin="6.589" end="7.106">ladrón</span><span begin="7.106" end="7.306">de</span><span begin="7.306" end="7.872">paz</span><span ttm:role="x-translation" xml:lang="zh-CN">你好 和平的窃贼</span></p><p begin="9.087" end="13.201" itunes:key="L2" ttm:agent="v1"><span begin="9.087" end="9.575">Campo</span><span begin="9.575" end="9.789">de</span><span begin="9.789" end="10.235">minas</span><span begin="10.235" end="10.681">para</span><span begin="10.681" end="10.997">mi</span><span begin="10.997" end="12.250">sensibili</span><span begin="12.250" end="13.201">dad</span><span ttm:role="x-translation" xml:lang="zh-CN">我敏感内心的一片雷区</span></p><p begin="14.152" end="17.893" itunes:key="L3" ttm:agent="v1"><span begin="14.152" end="15.267">Playboy,</span><span begin="16.484" end="16.686">un</span><span begin="16.686" end="17.893">campeón</span><span ttm:role="x-translation" xml:lang="zh-CN">花花公子 一位冠军</span></p><p begin="18.841" end="22.706" itunes:key="L4" ttm:agent="v1"><span begin="18.841" end="19.278">Gasta</span><span begin="19.278" end="19.417">el</span><span begin="19.417" end="19.977">dinero</span><span begin="19.977" end="20.193">que</span><span begin="20.193" end="20.577">tiene</span><span begin="20.577" end="20.725">y</span><span begin="20.725" end="21.292">también</span><span begin="21.292" end="21.766">el</span><span begin="21.766" end="22.060">que</span><span begin="22.060" end="22.706">no</span><span ttm:role="x-translation" xml:lang="zh-CN">他挥霍着自己的金钱 甚至没有得到的财富</span></p><p begin="24.290" end="26.520" itunes:key="L5" ttm:agent="v1"><span begin="24.290" end="24.860">Él</span><span begin="24.860" end="25.242">es</span><span begin="25.242" end="25.527">tan</span><span begin="25.527" end="26.520">encantador</span><span ttm:role="x-translation" xml:lang="zh-CN">他魅力四射</span></p><p begin="26.787" end="31.374" itunes:key="L6" ttm:agent="v1"><span begin="26.787" end="27.612">Estrella</span><span begin="27.612" end="27.858">de</span><span begin="27.858" end="28.110">la</span><span begin="28.110" end="29.000">sinrazón,</span><span begin="29.326" end="29.726">un</span><span begin="29.726" end="31.374">espejismo</span><span ttm:role="x-translation" xml:lang="zh-CN">一位失去理智的明星 如同海市蜃楼</span></p><p begin="31.516" end="36.291" itunes:key="L7" ttm:agent="v1"><span begin="31.516" end="32.090">Medalla</span><span begin="32.090" end="32.785">olímpica</span><span begin="32.785" end="32.969">de</span><span begin="32.969" end="33.321">oro</span><span begin="33.321" end="33.503">al</span><span begin="33.503" end="33.871">más</span><span begin="33.871" end="34.236">ca</span><span begin="34.236" end="36.291">brón</span><span ttm:role="x-translation" xml:lang="zh-CN">奥林匹克混蛋奖金牌得主</span></p><p begin="36.632" end="42.285" itunes:key="L8" ttm:agent="v1"><span begin="36.632" end="37.579">Tienes</span><span begin="37.579" end="37.963">el</span><span begin="37.963" end="38.832">podio</span><span begin="39.147" end="39.547">de</span><span begin="39.547" end="39.912">la</span><span begin="39.912" end="40.363">gran</span><span begin="40.363" end="41.365">desi</span><span begin="41.365" end="42.285">lusión</span><span ttm:role="x-translation" xml:lang="zh-CN">你登上了表彰失望的领奖台</span></p><p begin="43.899" end="46.440" itunes:key="L9" ttm:agent="v1"><span begin="43.899" end="44.427">La</span><span begin="44.427" end="44.811">de</span><span begin="44.811" end="45.211">cep</span><span begin="45.211" end="45.643">ción</span><span begin="45.643" end="46.043">lo</span><span begin="46.043" end="46.440">cal</span><span ttm:role="x-translation" xml:lang="zh-CN">本地的失望化身</span></p><p begin="46.440" end="48.909" itunes:key="L10" ttm:agent="v1"><span begin="46.440" end="47.264">Rompe</span><span begin="47.264" end="48.064">corazones</span><span begin="48.064" end="48.909">nacional</span><span ttm:role="x-translation" xml:lang="zh-CN">全国通杀的心碎客</span></p><p begin="48.909" end="51.384" itunes:key="L11" ttm:agent="v1"><span begin="48.909" end="49.320">Un</span><span begin="49.320" end="50.457">terrorista</span><span begin="50.457" end="51.384">emocional</span><span ttm:role="x-translation" xml:lang="zh-CN">一位情感的恐怖分子</span></p><p begin="51.384" end="53.824" itunes:key="L12" ttm:agent="v1"><span begin="51.384" end="51.658">El</span><span begin="51.658" end="52.092">mayor</span><span begin="52.092" end="52.967">desastre</span><span begin="52.967" end="53.824">mundial</span><span ttm:role="x-translation" xml:lang="zh-CN">全球最大的灾难</span></p><p begin="53.824" end="58.356" itunes:key="L13" ttm:agent="v1"><span begin="53.824" end="54.268">Es</span><span begin="54.268" end="55.037">una</span><span begin="55.037" end="55.842">perla,</span><span begin="56.285" end="57.085">nadie</span><span begin="57.085" end="57.469">se</span><span begin="57.469" end="58.356">fía</span><span ttm:role="x-translation" xml:lang="zh-CN">他是一颗珍珠 切不可相信他</span></p><p begin="58.680" end="1:04.263" itunes:key="L14" ttm:agent="v1"><span begin="58.680" end="59.173">Es</span><span begin="59.173" end="59.907">una</span><span begin="59.907" end="1:00.717">perla,</span><span begin="1:01.221" end="1:01.989">una</span><span begin="1:01.989" end="1:02.371">de</span><span begin="1:02.371" end="1:03.205">mucho</span><span begin="1:03.205" end="1:04.263">cuidao</span><span ttm:role="x-translation" xml:lang="zh-CN">他是一颗珍珠 得格外留神的那种</span></p><p begin="1:07.983" end="1:11.979" itunes:key="L15" ttm:agent="v2"><span begin="1:07.983" end="1:08.542">El</span><span begin="1:08.542" end="1:09.126">rey</span><span begin="1:09.932" end="1:10.163">de</span><span begin="1:10.163" end="1:10.460">la</span><span begin="1:10.460" end="1:10.791">13-</span><span begin="1:10.791" end="1:11.979">14</span><span ttm:role="x-translation" xml:lang="zh-CN">他是抄袭之王</span></p><p begin="1:12.981" end="1:17.099" itunes:key="L16" ttm:agent="v2"><span begin="1:12.981" end="1:13.316">No</span><span begin="1:13.316" end="1:14.218">sabe</span><span begin="1:14.218" end="1:14.549">lo</span><span begin="1:14.549" end="1:14.898">que</span><span begin="1:14.898" end="1:15.202">es</span><span begin="1:15.202" end="1:15.818">coti</span><span begin="1:15.818" end="1:17.099">zar</span><span ttm:role="x-translation" xml:lang="zh-CN">他根本不懂什么叫作责任</span></p><p begin="1:17.871" end="1:21.724" itunes:key="L17" ttm:agent="v2"><span begin="1:17.871" end="1:18.369">Él</span><span begin="1:18.369" end="1:18.964">es</span><span begin="1:19.877" end="1:20.066">el</span><span begin="1:20.066" end="1:20.546">centro</span><span begin="1:20.546" end="1:20.762">del</span><span begin="1:20.762" end="1:21.724">mundo</span><span ttm:role="x-translation" xml:lang="zh-CN">他是世界的中心</span></p><p begin="1:22.615" end="1:27.459" itunes:key="L18" ttm:agent="v2"><span begin="1:22.615" end="1:22.799">Y</span><span begin="1:22.799" end="1:22.996">ya</span><span begin="1:22.996" end="1:23.776">después,</span><span begin="1:23.776" end="1:24.192">¿lo</span><span begin="1:24.192" end="1:25.045">demás</span><span begin="1:25.045" end="1:25.477">qué</span><span begin="1:25.477" end="1:25.694">da</span><span begin="1:25.694" end="1:27.459">rá?</span><span ttm:role="x-translation" xml:lang="zh-CN">但无论如何 谁又在乎其他人呢</span></p><p begin="1:28.034" end="1:29.966" itunes:key="L19" ttm:agent="v2"><span begin="1:28.034" end="1:28.434">Por</span><span begin="1:28.434" end="1:28.647">fin</span><span begin="1:28.647" end="1:28.946">vas</span><span begin="1:28.946" end="1:29.138">a</span><span begin="1:29.138" end="1:29.966">terapia</span><span ttm:role="x-translation" xml:lang="zh-CN">你终于去接受治疗</span></p><p begin="1:29.966" end="1:32.464" itunes:key="L20" ttm:agent="v2"><span begin="1:29.966" end="1:30.267">Vas</span><span begin="1:30.267" end="1:30.367">al</span><span begin="1:30.367" end="1:31.115">psicólogo,</span><span begin="1:31.115" end="1:31.499">también</span><span begin="1:31.499" end="1:32.464">psiquiatra</span><span ttm:role="x-translation" xml:lang="zh-CN">去看看心理医生和精神科大夫</span></p><p begin="1:32.998" end="1:34.950" itunes:key="L21" ttm:agent="v2"><span begin="1:32.998" end="1:33.539">Pero</span><span begin="1:33.539" end="1:33.773">¿de</span><span begin="1:33.773" end="1:34.038">qué</span><span begin="1:34.038" end="1:34.206">te</span><span begin="1:34.206" end="1:34.950">sirve?</span><span ttm:role="x-translation" xml:lang="zh-CN">但这有什么用</span></p><p begin="1:34.950" end="1:37.503" itunes:key="L22" ttm:agent="v2"><span begin="1:34.950" end="1:35.398">Si</span><span begin="1:35.398" end="1:35.833">siempre</span><span begin="1:35.833" end="1:36.265">mientes</span><span begin="1:36.265" end="1:36.483">más</span><span begin="1:36.483" end="1:36.699">que</span><span begin="1:36.699" end="1:37.503">hablas</span><span ttm:role="x-translation" xml:lang="zh-CN">如果你撒谎比说话还多</span></p><p begin="1:37.503" end="1:39.960" itunes:key="L23" ttm:agent="v2"><span begin="1:37.503" end="1:37.708">Te</span><span begin="1:37.708" end="1:37.923">ha</span><span begin="1:37.923" end="1:39.960">rán</span><span ttm:role="x-translation" xml:lang="zh-CN">人们应当</span></p><p begin="1:40.304" end="1:45.693" itunes:key="L24" ttm:agent="v2"><span begin="1:40.304" end="1:40.723">Un</span><span begin="1:40.723" end="1:42.232">monumento</span><span begin="1:42.823" end="1:43.207">a</span><span begin="1:43.207" end="1:43.572">la</span><span begin="1:43.572" end="1:44.349">desho</span><span begin="1:44.618" end="1:45.027">nes</span><span begin="1:45.027" end="1:45.693">tidad</span><span ttm:role="x-translation" xml:lang="zh-CN">给你立一座虚伪的丰碑</span></p><p begin="1:47.436" end="1:49.723" itunes:key="L25" ttm:agent="v2"><span begin="1:47.436" end="1:48.068">No</span><span begin="1:48.068" end="1:48.468">me</span><span begin="1:48.468" end="1:48.866">das</span><span begin="1:48.866" end="1:49.723">pena</span><span ttm:role="x-translation" xml:lang="zh-CN">我并不为你感到抱歉</span></p><p begin="1:49.723" end="1:52.384" itunes:key="L26" ttm:agent="v2"><span begin="1:49.723" end="1:50.153">Quien</span><span begin="1:50.153" end="1:50.585">queda</span><span begin="1:50.585" end="1:51.169">contigo</span><span begin="1:51.169" end="1:51.401">se</span><span begin="1:51.401" end="1:52.384">drena</span><span ttm:role="x-translation" xml:lang="zh-CN">和你相处的人 最终都会被耗尽精力</span></p><p begin="1:52.517" end="1:54.607" itunes:key="L27" ttm:agent="v2"><span begin="1:52.517" end="1:52.917">Siempre</span><span begin="1:52.917" end="1:53.101">se</span><span begin="1:53.101" end="1:53.647">auto</span><span begin="1:53.647" end="1:54.607">invita</span><span ttm:role="x-translation" xml:lang="zh-CN">他总是不请自来</span></p><p begin="1:54.607" end="1:57.427" itunes:key="L28" ttm:agent="v2"><span begin="1:54.607" end="1:54.982">Si</span><span begin="1:54.982" end="1:55.398">puede,</span><span begin="1:55.398" end="1:55.697">vive</span><span begin="1:55.697" end="1:55.865">en</span><span begin="1:55.865" end="1:56.233">casa</span><span begin="1:56.233" end="1:57.427">ajena</span><span ttm:role="x-translation" xml:lang="zh-CN">能赖在别人家就赖着不走</span></p><p begin="1:57.427" end="1:59.562" itunes:key="L29" ttm:agent="v1"><span begin="1:57.427" end="1:57.909">Red</span><span begin="1:57.909" end="1:58.310">flag</span><span begin="1:58.310" end="1:59.562">andante</span><span ttm:role="x-translation" xml:lang="zh-CN">行走的危险信号</span></p><p begin="1:59.799" end="2:02.007" itunes:key="L30" ttm:agent="v1"><span begin="1:59.799" end="2:00.767">Tremendo</span><span begin="2:00.767" end="2:02.007">desastre</span><span ttm:role="x-translation" xml:lang="zh-CN">惊人的灾祸</span></p><p begin="2:02.202" end="2:04.176" itunes:key="L31" ttm:agent="v1"><span begin="2:02.202" end="2:02.805">Dirá</span><span begin="2:02.805" end="2:03.149">que</span><span begin="2:03.149" end="2:03.301">no</span><span begin="2:03.301" end="2:03.530">fue</span><span begin="2:03.530" end="2:04.176">él</span><span ttm:role="x-translation" xml:lang="zh-CN">他会说不是他</span></p><p begin="2:04.567" end="2:08.758" itunes:key="L32" ttm:agent="v1"><span begin="2:04.567" end="2:04.770">Que</span><span begin="2:04.770" end="2:05.061">fue</span><span begin="2:05.061" end="2:05.255">su</span><span begin="2:05.255" end="2:06.071">doppel</span><span begin="2:06.071" end="2:06.471">gän</span><span begin="2:06.471" end="2:08.758">ger</span><span ttm:role="x-translation" xml:lang="zh-CN">而是他的分身干的</span></p><p begin="2:12.379" end="2:14.157" itunes:key="L33" ttm:agent="v2"><span begin="2:12.379" end="2:12.742">Bueno,</span><span begin="2:12.742" end="2:12.872">es</span><span begin="2:12.872" end="2:13.147">que,</span><span begin="2:13.635" end="2:14.157">claro</span><span ttm:role="x-translation" xml:lang="zh-CN">好吧 是这样 当然</span></p><p begin="2:14.754" end="2:17.044" itunes:key="L34" ttm:agent="v2"><span begin="2:14.754" end="2:15.017">No</span><span begin="2:15.017" end="2:15.509">referirse</span><span begin="2:15.509" end="2:15.609">a</span><span begin="2:15.609" end="2:15.785">él</span><span begin="2:15.785" end="2:16.173">como</span><span begin="2:16.173" end="2:17.044">icono</span><span ttm:role="x-translation" xml:lang="zh-CN">若不称他为偶像</span></p><p begin="2:17.469" end="2:18.892" itunes:key="L35" ttm:agent="v2"><span begin="2:17.469" end="2:17.789">Sería</span><span begin="2:17.789" end="2:18.035">para</span><span begin="2:18.035" end="2:18.186">él</span><span begin="2:18.186" end="2:18.892">una</span><span ttm:role="x-translation" xml:lang="zh-CN">对他来说 就是一种</span></p><p begin="2:18.892" end="2:21.399" itunes:key="L36" ttm:agent="v2"><span begin="2:18.892" end="2:19.493">Narrativa</span><span begin="2:19.493" end="2:20.367">reduccionista,</span><span begin="2:20.367" end="2:20.577">¿me</span><span begin="2:20.577" end="2:21.399">entiendes?</span><span ttm:role="x-translation" xml:lang="zh-CN">过于简化的叙述 你明白吗</span></p><p begin="2:21.399" end="2:23.281" itunes:key="L37" ttm:agent="v1"><span begin="2:21.399" end="2:21.828">Nunca</span><span begin="2:21.828" end="2:22.028">le</span><span begin="2:22.028" end="2:22.578">prestes</span><span begin="2:22.578" end="2:23.281">na&apos;</span><span ttm:role="x-translation" xml:lang="zh-CN">永远不要借东西给他</span></p><p begin="2:23.796" end="2:25.652" itunes:key="L38" ttm:agent="v1"><span begin="2:23.796" end="2:24.124">No</span><span begin="2:24.124" end="2:24.336">lo</span><span begin="2:24.336" end="2:25.652">devolverá</span><span ttm:role="x-translation" xml:lang="zh-CN">他不会归还的</span></p><p begin="2:26.312" end="2:28.708" itunes:key="L39" ttm:agent="v1"><span begin="2:26.312" end="2:26.687">Ser</span><span begin="2:26.687" end="2:27.276">bala</span><span begin="2:27.276" end="2:28.708">perdida</span><span ttm:role="x-translation" xml:lang="zh-CN">做一个难以控制的人</span></p><p begin="2:28.708" end="2:30.826" itunes:key="L40" ttm:agent="v1"><span begin="2:28.708" end="2:28.922">Es</span><span begin="2:28.922" end="2:29.094">su</span><span begin="2:29.094" end="2:30.826">especialidad</span><span ttm:role="x-translation" xml:lang="zh-CN">是他的专长</span></p><p begin="2:31.495" end="2:33.043" itunes:key="L41" ttm:agent="v1"><span begin="2:31.495" end="2:31.854">La</span><span begin="2:31.854" end="2:33.043">lealtad</span><span ttm:role="x-translation" xml:lang="zh-CN">忠诚</span></p><p b