<tt xmlns="http://www.w3.org/ns/ttml" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xmlns:amll="http://www.example.com/ns/amll"><head><metadata><ttm:agent type="person" xml:id="v1"/><ttm:agent type="other" xml:id="v2"/><amll:meta key="musicName" value="ふたりごと"/><amll:meta key="artists" value="TRUE"/><amll:meta key="artists" value="茅原実里"/><amll:meta key="album" value="Sincerely (アーティスト盤)"/><amll:meta key="ncmMusicId" value="534542035"/></metadata></head><body dur="4:42.578"><div begin="23.714" end="4:42.578"><p begin="23.714" end="28.167" itunes:key="L1" ttm:agent="v1"><span begin="23.714" end="23.851">ふ</span><span begin="23.851" end="24.051">た</span><span begin="24.051" end="24.235">り</span><span begin="24.235" end="24.400">の</span><span begin="24.400" end="24.571">隙</span><span begin="24.571" end="25.124">間</span><span begin="25.124" end="25.471">で</span><span begin="25.471" end="25.783">交</span><span begin="25.783" end="25.971">わ</span><span begin="25.971" end="26.353">す</span><span begin="26.353" end="26.516">言</span><span begin="26.516" end="27.075">葉</span><span begin="27.075" end="28.167">は</span><span ttm:role="x-translation" xml:lang="zh-CN">你我二人之间互相交谈的话语</span></p><p begin="29.564" end="33.924" itunes:key="L2" ttm:agent="v1"><span begin="29.564" end="29.608">ど</span><span begin="29.608" end="29.784">れ</span><span begin="29.784" end="29.974">く</span><span begin="29.974" end="30.146">ら</span><span begin="30.146" end="30.302">い</span><span begin="30.302" end="30.717">の</span><span begin="30.717" end="30.887">意</span><span begin="30.887" end="31.229">味</span><span begin="31.229" end="31.501">を</span><span begin="31.501" end="31.733">持</span><span begin="31.733" end="32.044">て</span><span begin="32.044" end="32.257">る</span><span begin="32.257" end="32.612">の</span><span begin="32.612" end="32.796">だ</span><span begin="32.796" end="32.987">ろ</span><span begin="32.987" end="33.924">う</span><span ttm:role="x-translation" xml:lang="zh-CN">到底蕴含多少意义呢</span></p><p begin="34.092" end="39.137" itunes:key="L3" ttm:agent="v2"><span begin="34.092" end="34.238">書</span><span begin="34.238" end="34.416">き</span><span begin="34.416" end="34.666">並</span><span begin="34.666" end="34.973">べ</span><span begin="34.973" end="35.158">て</span><span begin="35.158" end="35.328">は</span><span begin="35.328" end="35.570">消</span><span begin="35.570" end="35.721">え</span><span begin="35.721" end="35.850">て</span><span begin="35.850" end="36.031">い</span><span begin="36.031" end="36.343">く</span><span begin="36.343" end="36.586">世</span><span begin="36.586" end="37.040">界</span><span begin="37.040" end="37.224">は</span><span begin="37.224" end="37.459">何</span><span begin="37.459" end="37.758">色</span><span begin="37.758" end="38.315">だ</span><span begin="38.315" end="38.511">ろ</span><span begin="38.511" end="39.137">う</span><span ttm:role="x-translation" xml:lang="zh-CN">罗列出来便消逝而去的世界是何种颜色呢</span></p><p begin="39.315" end="41.360" itunes:key="L4" ttm:agent="v2"><span begin="39.315" end="39.476">い</span><span begin="39.476" end="39.630">ま</span><span begin="39.630" end="39.774">ど</span><span begin="39.774" end="39.947">ん</span><span begin="39.947" end="40.120">な</span><span begin="40.120" end="40.347">言</span><span begin="40.347" end="40.708">葉</span><span begin="40.708" end="41.360">を</span><span ttm:role="x-translation" xml:lang="zh-CN">如今已何种的话语</span></p><p begin="41.379" end="42.628" itunes:key="L5" ttm:agent="v1"><span begin="41.379" end="41.538">う</span><span begin="41.538" end="41.724">た</span><span begin="41.724" end="42.628">を</span><span ttm:role="x-translation" xml:lang="zh-CN">歌声</span></p><p begin="42.777" end="45.447" itunes:key="L6" ttm:agent="v1"><span begin="42.777" end="42.942">届</span><span begin="42.942" end="43.493">け</span><span begin="43.493" end="43.708">に</span><span begin="43.708" end="43.994">行</span><span begin="43.994" end="44.193">こ</span><span begin="44.193" end="45.447">う</span><span ttm:role="x-translation" xml:lang="zh-CN">去传达给你</span></p><p begin="46.524" end="51.843" itunes:key="L7" ttm:agent="v2"><span begin="46.524" end="46.747">似</span><span begin="46.747" end="46.942">た</span><span begin="46.942" end="47.280">者</span><span begin="47.280" end="47.792">同</span><span begin="47.792" end="47.985">士</span><span begin="47.985" end="48.338">と</span><span begin="48.338" end="48.656">は</span><span begin="48.656" end="48.887">言</span><span begin="48.887" end="49.170">え</span><span begin="49.170" end="49.477">な</span><span begin="49.477" end="49.746">い</span><span begin="49.746" end="49.908">け</span><span begin="49.908" end="51.843">ど</span><span ttm:role="x-translation" xml:lang="zh-CN">虽无法说出是相似之人</span></p><p begin="52.257" end="56.765" itunes:key="L8" ttm:agent="v2"><span begin="52.257" end="52.458">与</span><span begin="52.458" end="52.843">え</span><span begin="52.843" end="52.991">る</span><span begin="52.991" end="53.144">こ</span><span begin="53.144" end="53.521">と</span><span begin="53.521" end="53.701">で</span><span begin="53.701" end="54.059">与</span><span begin="54.059" end="54.565">え</span><span begin="54.565" end="54.908">ら</span><span begin="54.908" end="55.116">れ</span><span begin="55.116" end="55.537">て</span><span begin="55.537" end="55.668">い</span><span begin="55.668" end="56.765">く</span><span ttm:role="x-translation" xml:lang="zh-CN">以给予 从而获得</span></p><p begin="56.906" end="1:01.904" itunes:key="L9" ttm:agent="v1"><span begin="56.906" end="57.083">今</span><span begin="57.083" end="57.264">日</span><span begin="57.264" end="57.442">は</span><span begin="57.442" end="57.632">い</span><span begin="57.632" end="57.820">つ</span><span begin="57.820" end="57.965">も</span><span begin="57.965" end="58.203">よ</span><span begin="58.203" end="58.331">り</span><span begin="58.331" end="58.706">空</span><span begin="58.706" end="58.869">が</span><span begin="58.869" end="59.444">青</span><span begin="59.444" end="59.773">く</span><span begin="59.773" end="1:00.032">て</span><span begin="1:00.032" end="1:00.604">明</span><span begin="1:00.604" end="1:00.799">る</span><span begin="1:00.799" end="1:01.107">い</span><span begin="1:01.107" end="1:01.336">か</span><span begin="1:01.336" end="1:01.904">ら</span><span ttm:role="x-translation" xml:lang="zh-CN">今日的天空比以往清澈明朗</span></p><p begin="1:02.110" end="1:04.124" itunes:key="L10" ttm:agent="v1"><span begin="1:02.110" end="1:02.263">も</span><span begin="1:02.263" end="1:02.419">う</span><span begin="1:02.419" end="1:02.766">少</span><span begin="1:02.766" end="1:03.156">し</span><span begin="1:03.156" end="1:03.561">君</span><span begin="1:03.561" end="1:04.124">と</span><span ttm:role="x-translation" xml:lang="zh-CN">再稍微的和你</span></p><p begin="1:04.230" end="1:08.121" itunes:key="L11" ttm:agent="v2"><span begin="1:04.230" end="1:04.632">君</span><span begin="1:04.632" end="1:05.647">と</span><span begin="1:05.647" end="1:06.410">話</span><span begin="1:06.410" end="1:06.551">を</span><span begin="1:06.551" end="1:06.930">し</span><span begin="1:06.930" end="1:07.078">よ</span><span begin="1:07.078" end="1:08.121">う</span><span ttm:role="x-translation" xml:lang="zh-CN">和你说说话吧</span><span ttm:role="x-bg" begin="1:05.642" end="1:08.158"><span begin="1:05.642" end="1:06.390">(話</span><span begin="1:06.390" end="1:06.532">を</span><span begin="1:06.532" end="1:06.908">し</span><span begin="1:06.908" end="1:07.050">よ</span><span begin="1:07.050" end="1:08.158">う)</span><span ttm:role="x-translation" xml:lang="zh-CN">说说话吧</span></span></p><p begin="1:08.544" end="1:11.598" itunes:key="L12" ttm:agent="v1"><span begin="1:08.544" end="1:08.691">突</span><span begin="1:08.691" end="1:08.853">き</span><span begin="1:08.853" end="1:08.970">は</span><span begin="1:08.970" end="1:09.163">な</span><span begin="1:09.163" end="1:09.357">す</span><span begin="1:09.357" end="1:09.555">ふ</span><span begin="1:09.555" end="1:09.730">り</span><span begin="1:09.730" end="1:09.924">し</span><span begin="1:09.924" end="1:10.066">て</span><span begin="1:10.066" end="1:10.253">抱</span><span begin="1:10.253" end="1:10.438">き</span><span begin="1:10.438" end="1:10.618">し</span><span begin="1:10.618" end="1:10.788">め</span><span begin="1:10.788" end="1:11.009">て</span><span begin="1:11.009" end="1:11.598">る</span><span ttm:role="x-translation" xml:lang="zh-CN">装作不情愿的样子与你相拥</span></p><p begin="1:11.378" end="1:14.413" itunes:key="L13" ttm:agent="v2"><span begin="1:11.378" end="1:11.531">気</span><span begin="1:11.531" end="1:11.687">に</span><span begin="1:11.687" end="1:11.886">し</span><span begin="1:11.886" end="1:12.063">な</span><span begin="1:12.063" end="1:12.241">い</span><span begin="1:12.241" end="1:12.403">ふ</span><span begin="1:12.403" end="1:12.604">り</span><span begin="1:12.604" end="1:12.804">し</span><span begin="1:12.804" end="1:12.971">て</span><span begin="1:12.971" end="1:13.145">見</span><span begin="1:13.145" end="1:13.580">守</span><span begin="1:13.580" end="1:13.705">っ</span><span begin="1:13.705" end="1:13.887">て</span><span begin="1:13.887" end="1:14.413">る</span><span ttm:role="x-translation" xml:lang="zh-CN">装作不在意的样子默默守护</span></p><p begin="1:14.583" end="1:18.681" itunes:key="L14" ttm:agent="v1"><span begin="1:14.583" end="1:14.733">と</span><span begin="1:14.733" end="1:14.913">ら</span><span begin="1:14.913" end="1:15.094">え</span><span begin="1:15.094" end="1:15.280">た</span><span begin="1:15.280" end="1:15.834">心</span><span begin="1:15.834" end="1:16.011">が</span><span begin="1:16.011" end="1:16.546">輝</span><span begin="1:16.546" end="1:16.737">い</span><span begin="1:16.737" end="1:17.074">て</span><span begin="1:17.074" end="1:17.289">い</span><span begin="1:17.289" end="1:18.681">る</span><span ttm:role="x-translation" xml:lang="zh-CN">获得的心 熠熠生辉</span></p><p begin="1:19.276" end="1:22.990" itunes:key="L15" ttm:agent="v1"><span begin="1:19.276" end="1:19.545">ふ</span><span begin="1:19.545" end="1:20.053">た</span><span begin="1:20.053" end="1:20.182">り</span><span begin="1:20.182" end="1:20.824">ご</span><span begin="1:20.824" end="1:22.990">と</span><span ttm:role="x-translation" xml:lang="zh-CN">你我二人</span></p><p begin="1:24.918" end="1:27.467" itunes:key="L16" ttm:agent="v2"><span begin="1:24.918" end="1:25.117">な</span><span begin="1:25.117" end="1:25.288">ん</span><span begin="1:25.288" end="1:25.676">と</span><span begin="1:25.676" end="1:25.842">な</span><span begin="1:25.842" end="1:27.467">く</span><span ttm:role="x-translation" xml:lang="zh-CN">总感觉</span></p><p begin="1:26.360" end="1:29.078" itunes:key="L17" ttm:agent="v1"><span begin="1:26.360" end="1:26.696">そ</span><span begin="1:26.696" end="1:26.866">ば</span><span begin="1:26.866" end="1:27.046">に</span><span begin="1:27.046" end="1:27.243">い</span><span begin="1:27.243" end="1:27.426">る</span><span begin="1:27.426" end="1:27.588">よ</span><span begin="1:27.588" end="1:27.794">う</span><span begin="1:27.794" end="1:29.078">で</span><span ttm:role="x-translation" xml:lang="zh-CN">近在咫尺</span></p><p begin="1:27.818" end="1:30.433" itunes:key="L18" ttm:agent="v2"><span begin="1:27.818" end="1:27.978">な</span><span begin="1:27.978" end="1:28.184">ん</span><span begin="1:28.184" end="1:28.502">と</span><span begin="1:28.502" end="1:28.692">な</span><span begin="1:28.692" end="1:30.433">く</span><span ttm:role="x-translation" xml:lang="zh-CN">总感觉</span></p><p begin="1:29.277" end="1:31.877" itunes:key="L19" ttm:agent="v1"><span begin="1:29.277" end="1:29.646">感</span><span begin="1:29.646" end="1:29.781">じ</span><span begin="1:29.781" end="1:29.924">あ</span><span begin="1:29.924" end="1:30.098">え</span><span begin="1:30.098" end="1:30.279">る</span><span begin="1:30.279" end="1:30.463">よ</span><span begin="1:30.463" end="1:30.657">う</span><span begin="1:30.657" end="1:31.877">で</span><span ttm:role="x-translation" xml:lang="zh-CN">心灵相通</span></p><p begin="1:30.652" end="1:33.240" itunes:key="L20" ttm:agent="v2"><