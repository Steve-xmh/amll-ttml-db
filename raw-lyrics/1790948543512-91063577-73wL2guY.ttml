<tt xmlns="http://www.w3.org/ns/ttml" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xmlns:amll="http://www.example.com/ns/amll"><head><metadata><ttm:agent type="person" xml:id="v1"/><amll:meta key="musicName" value="If You&apos;ve Got a Minute, Baby"/><amll:meta key="artists" value="Freddie and the Dreamers"/><amll:meta key="album" value="Greatest Hits"/><amll:meta key="isrc" value="GBAYE6600085"/><amll:meta key="isrc" value="USESK1320481"/><amll:meta key="isrc" value="USESK1315359"/><amll:meta key="ncmMusicId" value="22559170"/><amll:meta key="ncmMusicId" value="22244963"/><amll:meta key="ncmMusicId" value="22518272"/><amll:meta key="ncmMusicId" value="22518088"/><amll:meta key="spotifyId" value="4lRMxZJn0oZXqN08atAuyM"/><amll:meta key="spotifyId" value="7rGJDcfwk8PMPTgoygGFie"/><amll:meta key="spotifyId" value="2hFO8Rov5WJ7mrtcM6o7of"/><amll:meta key="spotifyId" value="2fS7YgsTptMYCUWncGfmi3"/><amll:meta key="spotifyId" value="70gWHQazSR5feZLBjAqp5u"/><amll:meta key="appleMusicId" value="1449259130"/><amll:meta key="ttmlAuthorGithub" value="91063577"/><amll:meta key="ttmlAuthorGithubLogin" value="IzumiiKonata"/><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal"><songwriters><songwriter>Freddie Garrity</songwriter></songwriters></iTunesMetadata></metadata></head><body dur="1:46.906"><div begin="15.502" end="1:46.906"><p begin="15.502" end="19.156" itunes:key="L1" ttm:agent="v1"><span begin="15.502" end="15.676">If</span> <span begin="15.676" end="15.931">you&apos;ve</span> <span begin="15.931" end="16.065">got</span> <span begin="16.065" end="16.282">a</span> <span begin="16.282" end="16.654">minute,</span> <span begin="16.654" end="17.875">baby,</span> <span begin="17.875" end="18.092">call</span> <span begin="18.092" end="18.601">on</span> <span begin="18.601" end="19.156">me</span><span ttm:role="x-translation" xml:lang="zh-Hans">如果你有一分钟，宝贝，来找我吧</span></p><p begin="19.351" end="22.937" itunes:key="L2" ttm:agent="v1"><span begin="19.351" end="19.538">I&apos;ll</span> <span begin="19.538" end="19.753">be</span> <span begin="19.753" end="20.522">waiting</span> <span begin="20.522" end="21.319">here</span> <span begin="21.657" end="22.937">patiently</span><span ttm:role="x-translation" xml:lang="zh-Hans">我会在这里耐心等待</span></p><p begin="23.151" end="26.992" itunes:key="L3" ttm:agent="v1"><span begin="23.151" end="23.321">If</span> <span begin="23.321" end="23.551">you&apos;ve</span> <span begin="23.551" end="23.679">got</span> <span begin="23.679" end="23.923">a</span> <span begin="23.923" end="24.341">minute,</span> <span begin="24.341" end="25.546">baby,</span> <span begin="25.546" end="25.746">come</span> <span begin="25.746" end="26.263">on</span> <span begin="26.263" end="26.992">down</span><span ttm:role="x-translation" xml:lang="zh-Hans">如果你有一分钟，宝贝，过来吧</span></p><p begin="27.219" end="30.621" itunes:key="L4" ttm:agent="v1"><span begin="27.219" end="27.396">You&apos;ll</span> <span begin="27.396" end="27.913">find</span> <span begin="27.913" end="28.154">me</span> <span begin="28.154" end="29.098">hanging</span> <span begin="29.098" end="30.621">around</span><span ttm:role="x-translation" xml:lang="zh-Hans">你会发现我就在这附近晃悠</span></p><p begin="30.959" end="34.370" itunes:key="L5" ttm:agent="v1"><span begin="30.959" end="31.186">I&apos;m</span> <span begin="31.186" end="31.561">doing</span> <span begin="31.561" end="32.057">nothin&apos;,</span> <span begin="32.057" end="32.834">baby,</span> <span begin="32.834" end="33.122">&apos;cept</span> <span begin="33.122" end="33.632">thinking</span> <span begin="33.632" end="33.876">of</span> <span begin="33.876" end="34.370">you</span><span ttm:role="x-translation" xml:lang="zh-Hans">我什么都没做，宝贝，只是在想你</span></p><p begin="34.784" end="38.111" itunes:key="L6" ttm:agent="v1"><span begin="34.784" end="34.996">And</span> <span begin="34.996" end="35.260">with</span> <span begin="35.260" end="35.668">you</span> <span begin="35.668" end="36.319">here,</span> <span begin="36.712" end="36.929">I&apos;d</span> <span begin="36.929" end="37.167">know</span> <span begin="37.167" end="37.421">what</span> <span begin="37.421" end="37.664">to</span> <span begin="37.664" end="38.111">do</span><span ttm:role="x-translation" xml:lang="zh-Hans">有你在这里，我就知道该做什么</span></p><p begin="38.538" end="42.128" itunes:key="L7" ttm:agent="v1"><span begin="38.538" end="38.784">So</span> <span begin="38.784" end="38.937">come</span> <span begin="38.937" end="39.233">on</span> <span begin="39.233" end="39.429">to</span> <span begin="39.429" end="39.641">me,</span> <span begin="39.641" end="40.487">baby,</span> <span begin="40.487" end="40.734">take</span> <span begin="40.734" end="40.982">up</span> <span begin="40.982" end="41.421">my</span> <span begin="41.421" end="42.128">time</span><span ttm:role="x-translation" xml:lang="zh-Hans">所以来我这里吧，宝贝，占用我一点时间</span></p><p begin="42.393" end="45.682" itunes:key="L8" ttm:agent="v1"><span begin="42.393" end="42.622">If</span> <span begin="42.622" end="43.077">you</span> <span begin="43.077" end="43.327">come</span> <span begin="43.327" end="43.781">down,</span> <span begin="43.781" end="44.048">I&apos;ll</span> <span begin="44.048" end="44.274">make</span> <span begin="44.274" end="44.525">you</span> <span begin="44.525" end="45.682">mine</span><span ttm:role="x-translation" xml:lang="zh-Hans">如果你来了，我会让你属于我</span></p><p begin="46.358" end="49.247" itunes:key="L9" ttm:agent="v1"><span begin="46.358" end="46.613">There</span> <span begin="46.613" end="46.838">is</span> <span begin="46.838" end="47.303">nothing</span> <span begin="47.303" end="47.574">I</span> <span begin="47.574" end="47.801">would</span> <span begin="47.801" end="48.223">rather</span> <span begin="48.223" end="49.247">do</span><span ttm:role="x-translation" xml:lang="zh-Hans">没有什么事是我更想做的</span></p><p begin="49.933" end="53.162" itunes:key="L10" ttm:agent="v1"><span begin="49.933" end="50.148">Than</span> <span begin="50.148" end="50.417">spend</span> <span begin="50.417" end="50.670">each</span> <span begin="50.670" end="51.148">lonely</span> <span begin="51.148" end="51.858">minute</span> <span begin="51.858" end="52.139">with</span> <span begin="52.139" end="53.162">you</span><span ttm:role="x-translation" xml:lang="zh-Hans">除了和你一起度过每一个孤单的时刻</span></p><p begin="53.693" end="57.330" itunes:key="L11" ttm:agent="v1"><span begin="53.693" end="53.951">With</span> <span begin="53.951" end="54.499">you</span> <span begin="54.499" end="54.711">in</span> <span begin="54.711" end="54.968">my</span> <span begin="54.968" end="55.654">arms,</span> <span begin="55.654" end="56.225">I</span> <span begin="56.225" end="57.330">know</span><span ttm:role="x-translation" xml:lang="zh-Hans">当你在我怀里，我知道</span></p><p begin="57.603" end="1:00.681" itunes:key="L12" ttm:agent="v1"><span begin="57.603" end="57.841">I&apos;d</span> <span begin="57.841" end="58.319">never</span> <span begin="58.319" end="58.542">want</span> <span begin="58.542" end="58.819">to</span> <span begin="58.819" end="59.116">let</span> <span begin="59.116" end="59.618">you</span> <span begin="59.618" end="1:00.681">go</span><span ttm:role="x-translation" xml:lang="zh-Hans">我永远不想让你离开</span></p><p begin="1:01.223" end="1:04.925" itunes:key="L13" ttm:agent="v1"><span begin="1:01.223" end="1:01.417">If</span> <span begin="1:01.417" end="1:01.658">you&apos;ve</span> <span begin="1:01.658" end="1:01.805">got</span> <span begin="1:01.805" end="1:02.028">a</span> <span begin="1:02.028" end="1:02.385">minute,</span> <span begin="1:02.385" end="1:03.576">baby,</span> <span begin="1:03.576" end="1:03.830">make</span> <span begin="1:03.830" end="1:04.091">me</span> <span begin="1:04.091" end="1:04.410">feel</span> <span begin="1:04.410" end="1:04.925">good</span><span ttm:role="x-translation" xml:lang="zh-Hans">如果你有一分钟，宝贝，让我感到快乐</span></p><p begin="1:05.257" end="1:08.611" itunes:key="L14" ttm:agent="v1"><span begin="1:05.257" end="1:05.511">You</span> <span begin="1:05.511" end="1:05.764">know</span> <span begin="1:05.764" end="1:06.009">I</span> <span begin="1:06.009" end="1:06.296">can&apos;t</span> <span begin="1:06.296" end="1:07.183">help</span> <span begin="1:07.183" end="1:07.437">this</span> <span begin="1:07.437" end="1:07.909">feeling</span> <span begin="1:07.909" end="1:08.119">of</span> <span begin="1:08.119" end="1:08.611">love</span><span ttm:role="x-translation" xml:lang="zh-Hans">你知道我无法抑制这份爱意</span></p><p begin="1:08.817" end="1:12.626" itunes:key="L15" ttm:agent="v1"><span begin="1:08.817" end="1:09.061">If</span> <span begin="1:09.061" end="1:09.320">you&apos;ve</span> <span begin="1:09.320" end="1:09.493">got</span> <span begin="1:09.493" end="1:09.661">a</span> <span begin="1:09.661" end="1:10.037">minute,</span> <span begin="1:10.037" end="1:11.189">baby,</span> <span begin="1:11.189" end="1:11.469">come</span> <span begin="1:11.469" end="1:11.954">on</span> <span begin="1:11.954" end="1:12.626">down</span><span ttm:role="x-translation" xml:lang="zh-Hans">如果你有一分钟，宝贝，过来吧</span></p><p begin="1:12.929" end="1:16.352" itunes:key="L16" ttm:agent="v1"><span begin="1:12.929" end="1:13.160">You&apos;ll</span> <span begin="1:13.160" end="1:13.636">find</span> <span begin="1:13.636" end="1:13.867">me</span> <span begin="1:13.867" end="1:14.756">hanging</span> <span begin="1:14.756" end="1:16.352">around</span><span ttm:role="x-translation" xml:lang="zh-Hans">你会发现我就在这附近晃悠</span></p><p begin="1:31.777" end="1:35.479" itunes:key="L17" ttm:agent="v1"><span begin="1:31.777" end="1:31.971">If</span> <span begin="1:31.971" end="1:32.212">you&apos;ve</span> <span begin="1:32.212" end="1:32.343">got</span> <span begin="1:32.343" end="1:32.582">a</span> <span begin="1:32.582" end="1:32.939">minute,</span> <span begin="1:32.939" end="1:34.116">baby,</span> <span begin="1:34.116" end="1:34.384">call</span> <span begin="1:34.384" end="1:34.936">on</span> <span begin="1:34.936" end="1:35.479">me</span><span ttm:role="x-translation" xml:lang="zh-Hans">如果你有一分钟，宝贝，来找我吧</span></p><p begin="1:35.604" end="1:39.041" itunes:key="L18" ttm:agent="v1"><span begin="1:35.604" end="1:35.836">I&apos;ll</span> <span begin="1:35.836" end="1:36.093">be</span> <span begin="1:36.093" end="1:36.800">waiting</span> <span begin="1:36.800" end="1:37.535">here</span> <span begin="1:37.984" end="1:39.041">patiently</span><span ttm:role="x-translation" xml:lang="zh-Hans">我会在这里耐心等待</span></p><p begin="1:39.351" end="1:43.180" itunes:key="L19" ttm:agent="v1"><span begin="1:39.351" end="1:39.615">If</span> <span begin="1:39.615" end="1:39.874">you&apos;ve</span> <span begin="1:39.874" end="1:40.013">got</span> <span begin="1:40.013" end="1:40.215">a</span> <span begin="1:40.215" end="1:40.591">minute,</span> <span begin="1:40.591" end="1:41.743">baby,</span> <span begin="1:41.743" end="1:42.023">come</span> <span begin="1:42.023" end="1:42.508">on</span> <span begin="1:42.508" end="1:43.180">down</span><span ttm:role="x-translation" xml:lang="zh-Hans">如果你有一分钟，宝贝，过来吧</span></p><p begin="1:43.481" end="1:46.906" itunes:key="L20" ttm:agent="v1"><span begin="1:43.481" end="1:43.714">You&apos;ll</span> <span begin="1:43.714" end="1:44.179">find</span> <span begin="1:44.179" end="1:44.421">me</span> <span begin="1:44.421" end="1:45.310">hanging</span> <span begin="1:45.310" end="1:46.906">around</span><span ttm:role="x-translation" xml:lang="zh-Hans">你会发现我就在这附近晃悠</span></p></div></body></tt>