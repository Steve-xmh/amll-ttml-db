<tt xmlns="http://www.w3.org/ns/ttml" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xmlns:amll="http://www.example.com/ns/amll"><head><metadata><ttm:agent type="person" xml:id="v1"/><ttm:agent type="person" xml:id="v2"/><amll:meta key="musicName" value="Nether"/><amll:meta key="artists" value="АкваМайн"/><amll:meta key="album" value="Nether"/><amll:meta key="isrc" value="FRX762330155"/><amll:meta key="spotifyId" value="4Muvxf5DXOFVHxfZhh0Rxh"/><amll:meta key="appleMusicId" value="6771831761"/><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal"><songwriters><songwriter>Балясников Александр Дмитриевич</songwriter></songwriters></iTunesMetadata></metadata></head><body dur="1:52.577"><div begin="0.000" end="1:52.577"><p begin="0.000" end="0.441" itunes:key="L1" ttm:agent="v1"><span begin="0.000" end="0.441">Незер</span><span ttm:role="x-translation" xml:lang="zh-Hans">Nether</span></p><p begin="1.616" end="2.005" itunes:key="L2" ttm:agent="v1"><span begin="1.616" end="2.005">Незер</span><span ttm:role="x-translation" xml:lang="zh-Hans">Nether</span></p><p begin="3.295" end="3.778" itunes:key="L3" ttm:agent="v1"><span begin="3.295" end="3.778">Незер</span><span ttm:role="x-translation" xml:lang="zh-Hans">Nether</span></p><p begin="4.967" end="5.328" itunes:key="L4" ttm:agent="v1"><span begin="4.967" end="5.328">Незер</span><span ttm:role="x-translation" xml:lang="zh-Hans">Nether</span></p><p begin="5.787" end="6.585" itunes:key="L5" ttm:agent="v1"><span begin="5.787" end="6.209">Незер,</span> <span begin="6.209" end="6.585">Незер</span><span ttm:role="x-translation" xml:lang="zh-Hans">Nether, Nether</span></p><p begin="6.614" end="7.632" itunes:key="L6" ttm:agent="v1"><span begin="6.614" end="6.946">Незер</span> <span begin="6.946" end="7.163">на</span> <span begin="7.163" end="7.632">мне</span><span ttm:role="x-translation" xml:lang="zh-Hans">Nether&apos;s on me</span></p><p begin="7.660" end="9.497" itunes:key="L7" ttm:agent="v1"><span begin="7.660" end="7.872">По</span><span begin="7.872" end="8.258">пробуй</span> <span begin="8.258" end="8.498">тронь</span> <span begin="8.498" end="8.903">меня,</span> <span begin="8.903" end="9.310">бы</span><span begin="9.310" end="9.497">дло</span><span ttm:role="x-translation" xml:lang="zh-Hans">Try to touch me, you cattle</span></p><p begin="9.553" end="10.969" itunes:key="L8" ttm:agent="v1"><span begin="9.553" end="9.769">О</span><span begin="9.769" end="9.932">кей,</span> <span begin="9.932" end="10.314">Незер</span> <span begin="10.314" end="10.474">во</span> <span begin="10.474" end="10.969">мне</span><span ttm:role="x-translation" xml:lang="zh-Hans">Okay, the Nether&apos;s in me</span></p><p begin="10.995" end="13.091" itunes:key="L9" ttm:agent="v1"><span begin="10.995" end="11.095">Я</span> <span begin="11.095" end="11.428">столь</span><span begin="11.428" end="11.520">ко</span> <span begin="11.520" end="11.978">лавы</span> <span begin="11.978" end="12.210">не</span> <span begin="12.210" end="12.670">ви</span><span begin="12.670" end="13.091">дывал</span><span ttm:role="x-translation" xml:lang="zh-Hans">I&apos;ve never seen so much lava</span></p><p begin="13.091" end="14.356" itunes:key="L10" ttm:agent="v1"><span begin="13.091" end="13.206">И</span> <span begin="13.206" end="13.697">незер</span> <span begin="13.697" end="13.875">на</span> <span begin="13.875" end="14.356">мне</span><span ttm:role="x-translation" xml:lang="zh-Hans">And nether&apos;s on me</span></p><p begin="14.356" end="16.200" itunes:key="L11" ttm:agent="v1"><span begin="14.356" end="14.538">По</span><span begin="14.538" end="14.941">пробуй</span> <span begin="14.941" end="15.107">тронь</span> <span begin="15.107" end="15.544">меня,</span> <span begin="15.544" end="15.974">бы</span><span begin="15.974" end="16.200">дло</span><span ttm:role="x-translation" xml:lang="zh-Hans">Try to touch me, you cattle</span></p><p begin="16.200" end="17.674" itunes:key="L12" ttm:agent="v1"><span begin="16.200" end="16.426">О</span><span begin="16.426" end="16.534">кей,</span> <span begin="16.534" end="16.997">Незер</span> <span begin="16.997" end="17.233">во</span> <span begin="17.233" end="17.674">мне</span><span ttm:role="x-translation" xml:lang="zh-Hans">Okay, the Nether&apos;s in me</span></p><p begin="17.674" end="19.989" itunes:key="L13" ttm:agent="v1"><span begin="17.674" end="17.763">Я</span> <span begin="17.763" end="18.108">столь</span><span begin="18.108" end="18.224">ко</span> <span begin="18.224" end="18.630">лавы</span> <span begin="18.630" end="18.829">не</span> <span begin="18.829" end="19.332">ви</span><span begin="19.332" end="19.989">дывал</span><span ttm:role="x-translation" xml:lang="zh-Hans">I&apos;ve never seen so much lava</span></p><p begin="20.374" end="23.321" itunes:key="L14" ttm:agent="v1"><span begin="20.374" end="20.664">Иду</span> <span begin="20.664" end="20.773">в</span> <span begin="20.773" end="21.209">незе</span><span begin="21.209" end="21.554">рите,</span> <span begin="21.554" end="21.929">Yellow</span> <span begin="21.929" end="22.416">Fire</span> <span begin="22.416" end="22.579">на</span> <span begin="22.579" end="22.902">ре</span><span begin="22.902" end="23.321">пите</span><span ttm:role="x-translation" xml:lang="zh-Hans">I&apos;m going in netherite, Yellow Fire&apos;s on repeat</span></p><p begin="23.717" end="26.643" itunes:key="L15" ttm:agent="v1"><span begin="23.717" end="24.056">Прошлый</span> <span begin="24.056" end="24.363">час</span> <span begin="24.363" end="24.512">я</span> <span begin="24.512" end="24.942">видел</span> <span begin="24.942" end="25.073">не</span><span begin="25.073" end="25.290">зе</span><span begin="25.290" end="25.595">рит</span> <span begin="25.595" end="25.665">и</span> <span begin="25.665" end="26.125">лаву —</span> <span begin="26.125" end="26.643">читер!</span><span ttm:role="x-translation" xml:lang="zh-Hans">Last hour I saw netherite and lava — cheater!</span></p><p begin="27.058" end="29.986" itunes:key="L16" ttm:agent="v1"><span begin="27.058" end="27.377">Иду</span> <span begin="27.377" end="27.445">в</span> <span begin="27.445" end="27.888">незе</span><span begin="27.888" end="28.260">рите,</span> <span begin="28.260" end="28.601">Yellow</span> <span begin="28.601" end="29.141">Fire</span> <span begin="29.141" end="29.357">на</span> <span begin="29.357" end="29.573">ре</span><span begin="29.573" end="29.986">пите</span><span ttm:role="x-translation" xml:lang="zh-Hans">I&apos;m going in netherite, Yellow Fire&apos;s on repeat</span></p><p begin="30.338" end="32.819" itunes:key="L17" ttm:agent="v1"><span begin="30.338" end="30.698">Прошлый</span> <span begin="30.698" end="31.012">час</span> <span begin="31.012" end="31.168">я</span> <span begin="31.168" end="31.533">видел</span> <span begin="31.533" end="31.742">не</span><span begin="31.742" end="32.001">зе</span><span begin="32.001" end="32.266">рит</span> <span begin="32.266" end="32.338">и</span> <span begin="32.338" end="32.628">ла</span><span begin="32.628" end="32.819">ву</span><span ttm:role="x-translation" xml:lang="zh-Hans">Last hour I saw netherite and lava</span></p><p begin="32.819" end="36.197" itunes:key="L18" ttm:agent="v1"><span begin="32.819" end="33.103">Где-</span><span begin="33.103" end="33.308">то</span> <span begin="33.308" end="33.514">там</span> <span begin="33.514" end="33.599">я</span> <span begin="33.599" end="33.809">слы</span><span begin="33.809" end="34.083">шал</span> <span begin="34.083" end="34.303">ба</span><span begin="34.303" end="34.522">ны —</span> <span begin="34.522" end="34.661">не</span><span begin="34.661" end="34.935">зе</span><span begin="34.935" end="35.161">рит</span> <span begin="35.161" end="35.379">ко</span><span begin="35.379" end="35.650">пали</span> <span begin="35.650" end="35.963">стра</span><span begin="35.963" end="36.197">нно</span><span ttm:role="x-translation" xml:lang="zh-Hans">Somewhere out there I heard bans — they weirdly dug netherite</span></p><p begin="36.200" end="39.552" itunes:key="L19" ttm:agent="v1"><span begin="36.200" end="36.438">Каж</span><span begin="36.438" end="36.614">дый</span> <span begin="36.614" end="36.854">час</span> <span begin="36.854" end="36.940">ви</span><span begin="36.940" end="37.264">жу</span> <span begin="37.264" end="37.422">о</span><span begin="37.422" end="37.641">бла</span><span begin="37.641" end="37.880">вы —</span> <span begin="37.880" end="38.113">каж</span><span begin="38.113" end="38.202">дый</span> <span begin="38.202" end="38.487">хо</span><span begin="38.487" end="38.680">чет</span> <span begin="38.680" end="38.935">быть</span> <span begin="38.935" end="39.140">top</span> <span begin="39.140" end="39.303">o</span><span begin="39.303" end="39.552">ne-ом</span><span ttm:role="x-translation" xml:lang="zh-Hans">Every hour I see raids — everybody wants to be top one</span></p><p begin="39.552" end="42.692" itunes:key="L20" ttm:agent="v1"><span begin="39.552" end="39.767">Каж</span><span begin="39.767" end="39.982">дый</span> <span begin="39.982" end="40.214">топ —</span> <span begin="40.214" end="40.446">это</span> <span begin="40.446" end="41.092">выдумка,</span> <span begin="41.092" end="41.405">ведь</span> <span begin="41.405" end="41.586">там</span> <span begin="41.586" end="42.001">нету</span> <span begin="42.001" end="42.692">меня</span><span ttm:role="x-translation" xml:lang="zh-Hans">Every top is a fiction, because I&apos;m not there</span></p><p begin="42.893" end="45.920" itunes:key="L21" ttm:agent="v1"><span begin="42.893" end="43.074">И</span><span begin="43.074" end="43.281">ду</span> <span begin="43.281" end="43.802">трейдиться</span> <span begin="43.802" end="43.942">с</span> <span begin="43.942" end="44.469">пиглином,</span> <span begin="44.469" end="44.638">на</span> <span begin="44.638" end="44.864">мне</span> <span begin="44.864" end="45.366">незер</span> <span begin="45.366" end="45.920">броня</span><span ttm:role="x-translation" xml:lang="zh-Hans">I go trade with a piglin, Nether armor&apos;s on me</span><span ttm:role="x-bg" begin="45.920" end="46.581"><span begin="45.920" end="46.182">(Ха-</span><span begin="46.182" end="46.581">ха!)</span><span ttm:role="x-translation" xml:lang="zh-Hans">Haha!</span></span></p><p begin="46.581" end="47.482" itunes:key="L22" ttm:agent="v1"><span begin="46.581" end="46.975">Незер</span> <span begin="46.975" end="47.146">на</span> <span begin="47.146" end="47.482">мне</span><span ttm:role="x-translation" xml:lang="zh-Hans">Nether&apos;s on me</span></p><p begin="47.664" end="49.562" itunes:key="L23" ttm:agent="v1"><span begin="47.664" end="47.857">По</span><span begin="47.857" end="48.258">пробуй</span> <span begin="48.258" end="48.457">тронь</span> <span begin="48.457" end="48.889">меня,</span> <span begin="48.889" end="49.321">бы</span><span begin="49.321" end="49.562">дло</span><span ttm:role="x-translation" xml:lang="zh-Hans">Try to touch me, you cattle</span></p><p begin="49.562" end="50.812" itunes:key="L24" ttm:agent="v1"><span begin="49.562" end="49.773">О</span><span begin="49.773" end="49.923">кей,</span> <span begin="49.923" end="50.253">Незер</span> <span begin="50.253" end="50.555">во</span> <span begin="50.555" end="50.812">мне</span><span ttm:role="x-translation" xml:lang="zh-Hans">Okay, the Nether&apos;s in me</span></p><p begin="51.008" end="53.093" itunes:key="L25" ttm:agent="v1"><span begin="51.008" end="51.100">Я</span> <span begin="51.100" end="51.393">столь</span><span begin="51.393" end="51.510">ко</span> <span begin="51.510" end="51.934">лавы</span> <span begin="51.934" end="52.132">не</span> <span begin="52.132" end="52.676">ви</span><span begin="52.676" end="53.093">дывал</span><span ttm:role="x-translation" xml:lang="zh-Hans">I&apos;ve never seen so much lava</span></p><p begin="53.093" end="54.158" itunes:key="L26" ttm:agent="v1"><span begin="53.093" end="53.202">И</span> <span begin="53.202" end="53.686">незер</span> <span begin="53.686" end="53.865">на</span> <span begin="53.865" end="54.158">мне</span><span ttm:role="x-translation" xml:lang="zh-Hans">And nether&apos;s on me</span></p><p begin="54.349" end="56.221" itunes:key="L27" ttm:agent="v1"><span begin="54.349" end="54.538">По</span><span begin="54.538" end="54.940">пробуй</span> <span begin="54.940" end="55.158">тронь</span> <span begin="55.158" end="55.552">меня,</span> <span begin="55.552" end="55.981">бы</span><span begin="55.981" end="56.221">дло</span><span ttm:role="x-translation" xml:lang="zh-Hans">Try to touch me, you cattle</span></p><p begin="56.221" end="57.485" itunes:key="L28" ttm:agent="v1"><span begin="56.221" end="56.429">О</span><span begin="56.429" end="56.553">кей,</span> <span begin="56.553" end="57.009">Незер</span> <span begin="57.009" end="57.206">во</span> <span begin="57.206" end="57.485">мне</span><span ttm:role="x-translation" xml:lang="zh-Hans">Okay, the Nether&apos;s in me</span></p><p begin="57.691" end="59.787" itunes:key="L29" ttm:agent="v1"><span begin="57.691" end="57.779">Я</span> <span begin="57.779" end="58.118">столь</span><span begin="58.118" end="58.206">ко</span> <span begin="58.206" end="58.612">лавы</span> <span begin="58.612" end="58.820">не</span> <span begin="58.820" end="59.356">ви</span><span begin="59.356" end="59.787">дывал</span><span ttm:role="x-translation" xml:lang="zh-Hans">I&apos;ve never seen so much lava</span></p><p begin="59.787" end="1:01.135" itunes:key="L30" ttm:agent="v2"><span begin="59.787" end="59.880">Ты</span> <span begin="59.880" end="1:00.408">слышишь</span> <span begin="1:00.408" end="1:00.666">этот</span> <span begin="1:00.666" end="1:01.135">звук?</span><span ttm:role="x-translation" xml:lang="zh-Hans">Do you hear this sound?</span></p><p begin="1:01.135" end="1:02.801" itunes:key="L31" ttm:agent="v1"><span begin="1:01.135" end="1:01.587">Ха,</span> <span begin="1:01.587" end="1:02.044">нико</span><span begin="1:02.044" end="1:02.274">го</span> <span begin="1:02.274" end="1:02.464">во</span><span begin="1:02.464" end="1:02.801">круг</span><span ttm:role="x-translation" xml:lang="zh-Hans">Hah, nobody around</span></p><p begin="1:02.875" end="1:06.053" itunes:key="L32" ttm:agent="v1"><span begin="1:02.875" end="1:03.103">Я</span> <span begin="1:03.103" end="1:03.304">как</span> <span begin="1:03.304" end="1:03.637">пиглин —</span> <span begin="1:03.637" end="1:03.996">нужно</span> <span begin="1:03.996" end="1:04.564">золо</span><span begin="1:04.564" end="1:04.794">то,</span> <span begin="1:04.971" end="1:05.151">у</span> <span begin="1:05.151" end="1:05.576">меня</span> <span begin="1:05.576" end="1:06.053">недуг</span><span ttm:role="x-translation" xml:lang="zh-Hans">I&apos;m like a piglin — I need gold, I have an affliction</span></p><p begin="1:06.148" end="1:09.154" itunes:key="L33" ttm:agent="v1"><span begin="1:06.148" end="1:06.384">Я</span> <span begin="1:06.384" end="1:06.804">хочу</span> <span begin="1:06.804" end="1:06.953">быть</span> <span begin="1:06.953" end="1:07.060">в</span> <span begin="1:07.060" end="1:07.450">незе</span><span begin="1:07.450" end="1:07.822">рите,</span> <span begin="1:07.822" end="1:08.302">прямо</span> <span begin="1:08.302" end="1:08.591">как</span> <span begin="1:08.591" end="1:08.667">и</span> <span begin="1:08.667" end="1:08.869">мой</span> <span begin="1:08.869" end="1:09.154">друг</span><span ttm:role="x-translation" xml:lang="zh-Hans">I want to be in netherite, just like my friend</span></p><p begin="1:09.552" end="1:12.522" itunes:key="L34" ttm:agent="v1"><span begin="1:09.552" end="1:09.719">Я</span> <span begin="1:09.719" end="1:10.131">хочу</span> <span begin="1:10.131" end="1:10.296">быть</span> <span begin="1:10.296" end="1:10.370">в</span> <span begin="1:10.370" end="1:10.786">незе</span><span begin="1:10.786" end="1:11.171">рите,</span> <span begin="1:11.171" end="1:11.357">я</span> <span begin="1:11.357" end="1:11.952">лутаю</span> <span begin="1:11.952" end="1:12.522">сундук</span><span ttm:role="x-translation" xml:lang="zh-Hans">I want to be in netherite — I&apos;m looting a chest</span></p><p begin="1:12.866" end="1:15.874" itunes:key="L35" ttm:agent="v1"><span begin="1:12.866" end="1:13.283">Вижу</span> <span begin="1:13.283" end="1:13.951">басти</span><span begin="1:13.951" end="1:14.313">он —</span> <span begin="1:14.313" end="1:14.789">беру</span> <span begin="1:14.789" end="1:15.387">страй</span><span begin="1:15.387" end="1:15.874">дера</span><span ttm:role="x-translation" xml:lang="zh-Hans">I see a bastion — I take a strider</span></p><p begin="1:16.245" end="1:19.226" itunes:key="L36" ttm:agent="v1"><span begin="1:16.245" end="1:16.620">Вижу</span> <span begin="1:16.620" end="1:17.063">гас</span><span begin="1:17.063" end="1:17.277">та,</span> <span begin="1:17.277" end="1:17.646">он</span> <span begin="1:17.646" end="1:18.217">метает</span> <span begin="1:18.217" end="1:18.942">фае</span><span begin="1:18.942" end="1:19.226">ры</span><span ttm:role="x-translation" xml:lang="zh-Hans">I see a ghast — it throws fireballs</span></p><p begin="1:19.554" end="1:22.562" itunes:key="L37" ttm:agent="v1"><span begin="1:19.554" end="1:19.957">Вижу</span> <span begin="1:19.957" end="1:20.395">dus</span><span begin="1:20.395" end="1:20.447">t,</span> <span begin="1:20.447" end="1:20.598">и</span> <span begin="1:20.598" end="1:20.973">он</span> <span begin="1:20.973" end="1:21.514">меня</span> <span begin="1:21.514" end="1:22.254">ма</span><span begin="1:22.254" end="1:22.562">нит</span><span ttm:role="x-translation" xml:lang="zh-Hans">I see dust, and it attracts me</span></p><p begin="1:22.887" end="1:25.911" itunes:key="L38" ttm:agent="v1"><span begin="1:22.887" end="1:23.066">Он</span> <span begin="1:23.066" end="1:23.315">си</span><span begin="1:23.315" end="1:23.855">яет,</span> <span begin="1:23.855" end="1:24.572">словно</span> <span begin="1:24.572" end="1:24.946">он</span> <span begin="1:24.946" end="1:25.595">ка</span><span begin="1:25.595" end="1:25.911">мень</span><span ttm:role="x-translation" xml:lang="zh-Hans">It shines like it&apos;s a stone</span></p><p begin="1:26.207" end="1:27.497" itunes:key="L39" ttm:agent="v1"><span begin="1:26.207" end="1:26.602">Эй,</span> <span begin="1:26.602" end="1:27.015">незер</span> <span begin="1:27.015" end="1:27.220">на</span> <span begin="1:27.220" end="1:27.497">мне</span><span ttm:role="x-translation" xml:lang="zh-Hans">Hey, nether&apos;s on me</span></p><p begin="1:27.682" end="1:29.502" itunes:key="L40" ttm:agent="v1"><span begin="1:27.682" end="1:27.876">По</span><span begin="1:27.876" end="1:28.293">пробуй</span> <span begin="1:28.293" end="1:28.516">тронь</span> <span begin="1:28.516" end="1:28.865">меня,</span> <span begin="1:28.865" end="1:29.310">бы</span><span begin="1:29.310" end="1:29.502">дло</span><span ttm:role="x-translation" xml:lang="zh-Hans">Try to touch me, you cattle</span></p><p begin="1:29.578" end="1:30.812" itunes:key="L41" ttm:agent="v1"><span begin="1:29.578" end="1:29.776">О</span><span begin="1:29.776" end="1:29.928">кей,</span> <span begin="1:29.928" end="1:30.307">Незер</span> <span begin="1:30.307" end="1:30.550">во</span> <span begin="1:30.550" end="1:30.812">мне</span><span ttm:role="x-translation" xml:lang="zh-Hans">Okay, the Nether&apos;s in me</span></p><p begin="1:31.009" end="1:33.098" itunes:key="L42" ttm:agent="v1"><span begin="1:31.009" end="1:31.084">Я</span> <span begin="1:31.084" end="1:31.430">столь</span><span begin="1:31.430" end="1:31.526">ко</span> <span begin="1:31.526" end="1:32.024">лавы</span> <span begin="1:32.024" end="1:32.202">не</span> <span begin="1:32.202" end="1:32.676">ви</span><span begin="1:32.676" end="1:33.098">дывал</span><span ttm:role="x-translation" xml:lang="zh-Hans">I&apos;ve never seen so much lava</span></p><p begin="1:33.098" end="1:34.159" itunes:key="L43" ttm:agent="v1"><span begin="1:33.098" end="1:33.189">И</span> <span begin="1:33.189" end="1:33.704">незер</span> <span begin="1:33.704" end="1:33.919">на</span> <span begin="1:33.919" end="1:34.159">мне</span><span ttm:role="x-translation" xml:lang="zh-Hans">And nether&apos;s on me</span></p><p begin="1:34.356" end="1:36.230" itunes:key="L44" ttm:agent="v1"><span begin="1:34.356" end="1:34.566">По</span><span begin="1:34.566" end="1:34.949">пробуй</span> <span begin="1:34.949" end="1:35.137">тронь</span> <span begin="1:35.137" end="1:35.548">меня,</span> <span begin="1:35.548" end="1:35.996">бы</span><span begin="1:35.996" end="1:36.230">дло</span><span ttm:role="x-translation" xml:lang="zh-Hans">Try to touch me, you cattle</span></p><p begin="1:36.230" end="1:37.584" itunes:key="L45" ttm:agent="v1"><span begin="1:36.230" end="1:36.440">О</span><span begin="1:36.440" end="1:36.613">кей,</span> <span begin="1:36.613" end="1:36.979">Незер</span> <span begin="1:36.979" end="1:37.250">во</span> <span begin="1:37.250" end="1:37.584">мне</span><span ttm:role="x-translation" xml:lang="zh-Hans">Okay, the Nether&apos;s in me</span></p><p begin="1:37.682" end="1:39.819" itunes:key="L46" ttm:agent="v1"><span begin="1:37.682" end="1:37.768">Я</span> <span begin="1:37.768" end="1:38.110">столь</span><span begin="1:38.110" end="1:38.222">ко</span> <span begin="1:38.222" end="1:38.674">лавы</span> <span begin="1:38.674" end="1:38.851">не</span> <span begin="1:38.851" end="1:39.357">ви</span><span begin="1:39.357" end="1:39.819">дывал</span><span ttm:role="x-translation" xml:lang="zh-Hans">I&apos;ve never seen so much lava</span></p><p begin="1:39.995" end="1:40.914" itunes:key="L47" ttm:agent="v1"><span begin="1:39.995" end="1:40.385">Незер</span> <span begin="1:40.385" end="1:40.606">на</span> <span begin="1:40.606" end="1:40.914">мне</span><span ttm:role="x-translation" xml:lang="zh-Hans">Nether&apos;s on me</span></p><p begin="1:41.007" end="1:42.893" itunes:key="L48" ttm:agent="v1"><span begin="1