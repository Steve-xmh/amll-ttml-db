<tt xmlns="http://www.w3.org/ns/ttml" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xmlns:amll="http://www.example.com/ns/amll" itunes:timing="Word" xml:lang="en"><head><metadata><ttm:agent type="person" xml:id="v1"/><amll:meta key="musicName" value="Abracadabra (Apple Music Live)"/><amll:meta key="artists" value="Lady Gaga"/><amll:meta key="artists" value="レディー・ガガ"/><amll:meta key="album" value="Apple Music Live: MAYHEM Requiem"/><amll:meta key="isrc" value="USUM72603829"/><amll:meta key="appleMusicId" value="6768201780"/><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal"><songwriters><songwriter>Andrew Watt</songwriter><songwriter>Henry Russell Walter</songwriter><songwriter>John McGeoch</songwriter><songwriter>Lady Gaga</songwriter><songwriter>Pete Edward Clarke</songwriter><songwriter>Steven Severin</songwriter><songwriter>Susan Janet Ballion</songwriter></songwriters></iTunesMetadata></metadata></head><body dur="3:56.363"><div begin="10.827" end="30.448" itunes:songPart="Verse"><p begin="10.827" end="15.123" itunes:key="L1" ttm:agent="v1"><span begin="10.827" end="11.080">Pay</span> <span begin="11.080" end="11.240">the</span> <span begin="11.240" end="12.654">toll</span> <span begin="13.088" end="13.379">to</span> <span begin="13.379" end="13.528">the</span> <span begin="13.528" end="15.123">angels</span><span ttm:role="x-translation" xml:lang="zh-Hans">向天使付出代价</span></p><p begin="15.350" end="20.432" itunes:key="L2" ttm:agent="v1"><span begin="15.350" end="15.910">Drawing</span> <span begin="15.910" end="17.497">circles</span> <span begin="17.979" end="18.217">in</span> <span begin="18.217" end="18.579">the</span> <span begin="18.579" end="20.432">clouds</span><span ttm:role="x-translation" xml:lang="zh-Hans">在云端画圈圈</span></p><p begin="20.992" end="25.822" itunes:key="L3" ttm:agent="v1"><span begin="20.992" end="21.195">You</span> <span begin="21.195" end="21.491">gotta</span> <span begin="21.491" end="21.768">keep</span> <span begin="21.768" end="22.022">your</span> <span begin="22.022" end="23.715">mind</span> <span begin="23.715" end="23.971">on</span> <span begin="23.971" end="24.115">the</span> <span begin="24.115" end="25.822">distance</span><span ttm:role="x-translation" xml:lang="zh-Hans">你要凝神目视远方</span></p><p begin="26.048" end="30.448" itunes:key="L4" ttm:agent="v1"><span begin="26.048" end="26.451">When</span> <span begin="26.451" end="26.718">the</span> <span begin="26.718" end="27.851">devil</span> <span begin="27.851" end="28.280">turns</span> <span begin="28.280" end="30.448">around</span><span ttm:role="x-translation" xml:lang="zh-Hans">当恶魔转过身</span></p></div><div begin="30.897" end="52.556" itunes:songPart="PreChorus"><p begin="30.897" end="36.310" itunes:key="L5" ttm:agent="v1"><span begin="30.897" end="31.457">Why</span> <span begin="31.457" end="31.777">don&apos;t</span> <span begin="31.777" end="32.150">you</span> <span begin="32.150" end="32.790">hold</span> <span begin="32.790" end="33.443">me</span> <span begin="33.443" end="34.070">in</span> <span begin="34.070" end="34.430">your</span> <span begin="34.430" end="34.926">heart</span> <span begin="34.926" end="35.494">to</span><span begin="35.613" end="36.310">night</span><span ttm:role="x-translation" xml:lang="zh-Hans">今夜何不将我装进你心里</span></p><p begin="36.310" end="41.926" itunes:key="L6" ttm:agent="v1"><span begin="36.310" end="36.624">In</span> <span begin="36.624" end="36.944">the</span> <span begin="36.944" end="38.235">magic</span> <span begin="38.235" end="39.198">of</span> <span begin="39.198" end="39.528">the</span> <span begin="39.528" end="40.104">dark</span> <span begin="40.104" end="40.718">moon</span><span begin="40.718" end="41.926">light</span><span ttm:role="x-translation" xml:lang="zh-Hans">在昏暗月光的魔力下</span></p><p begin="42.333" end="49.180" itunes:key="L7" ttm:agent="v1"><span begin="42.333" end="43.103">Save</span> <span begin="43.103" end="43.743">me</span> <span begin="43.743" end="44.463">from</span> <span begin="44.773" end="45.106">this</span> <span begin="45.106" end="45.997">empty</span> <span begin="45.997" end="49.180">fight</span><span ttm:role="x-translation" xml:lang="zh-Hans">带我逃离这虚无的斗争</span></p><p begin="49.556" end="52.556" itunes:key="L8" ttm:agent="v1"><span begin="49.556" end="49.895">In</span> <span begin="49.895" end="50.215">the</span> <span begin="50.215" end="50.655">game</span> <span begin="50.655" end="51.202">of</span> <span begin="51.202" end="52.556">life</span><span ttm:role="x-translation" xml:lang="zh-Hans">在人生游戏中</span></p></div><div begin="54.686" end="1:14.149" itunes:songPart="PreChorus"><p begin="54.686" end="59.416" itunes:key="L9" ttm:agent="v1"><span begin="54.686" end="55.094">Like</span> <span begin="55.094" end="55.377">a</span> <span begin="55.377" end="56.374">poem</span> <span begin="56.374" end="57.270">said</span> <span begin="57.270" end="57.550">by</span> <span begin="57.550" end="57.884">a</span> <span begin="57.884" end="58.497">lady</span> <span begin="58.497" end="58.817">in</span> <span begin="58.817" end="59.416">red</span><span ttm:role="x-translation" xml:lang="zh-Hans">如同红衣女郎吟诵的诗句</span></p><p begin="59.416" end="1:04.216" itunes:key="L10" ttm:agent="v1"><span begin="59.416" end="59.744">You</span> <span begin="59.744" end="1:00.064">hear</span> <span begin="1:00.064" end="1:00.427">the</span> <span begin="1:00.427" end="1:01.024">last</span> <span begin="1:01.024" end="1:01.614">few</span> <span begin="1:01.614" end="1:02.067">words</span> <span begin="1:02.067" end="1:02.371">of</span> <span begin="1:02.371" end="1:02.720">your</span> <span begin="1:02.720" end="1:04.216">life</span><span ttm:role="x-translation" xml:lang="zh-Hans">你听见生命最后的几个字</span></p><p begin="1:04.830" end="1:09.553" itunes:key="L11" ttm:agent="v1"><span begin="1:04.830" end="1:05.158">With</span> <span begin="1:05.158" end="1:05.424">a</span> <span begin="1:05.424" end="1:06.371">haunting</span> <span begin="1:06.371" end="1:07.318">dance,</span> <span begin="1:07.318" end="1:07.624">now</span> <span begin="1:07.624" end="1:07.904">you&apos;re</span> <span begin="1:07.904" end="1:08.280">both</span> <span begin="1:08.280" end="1:08.531">in</span> <span begin="1:08.531" end="1:08.811">a</span> <span begin="1:08.811" end="1:09.553">trance</span><span ttm:role="x-translation" xml:lang="zh-Hans">伴着魅影之舞 你们双双陷入恍惚</span></p><p begin="1:09.553" end="1:14.149" itunes:key="L12" ttm:agent="v1"><span begin="1:09.553" end="1:09.830">It&apos;s</span> <span begin="1:09.830" end="1:10.097">time</span> <span begin="1:10.097" end="1:10.417">to</span> <span begin="1:10.417" end="1:10.990">cast</span> <span begin="1:10.990" end="1:11.510">your</span> <span begin="1:11.510" end="1:11.977">spell</span> <span begin="1:11.977" end="1:12.420">on</span> <span begin="1:12.420" end="1:12.804">the</span> <span begin="1:12.804" end="1:14.149">night</span><span ttm:role="x-translation" xml:lang="zh-Hans">现在快对夜晚施下魔咒</span></p></div><div begin="1:15.243" end="1:37.923" itunes:songPart="Chorus"><p begin="1:15.243" end="1:19.536" itunes:key="L13" ttm:agent="v1"><span begin="1:15.243" end="1:15.953">Abra</span><span begin="1:15.953" end="1:16.273">ca</span><span begin="1:16.273" end="1:16.956">da</span><span begin="1:16.956" end="1:17.287">bra,</span> <span begin="1:17.287" end="1:17.833">amor-</span><span begin="1:17.833" end="1:18.129">oo-</span><span begin="1:18.129" end="1:18.780">na-</span><span begin="1:18.780" end="1:19.536">na</span><span ttm:role="x-translation" xml:lang="zh-Hans">咒语响起 阿莫尔 呜呐呐</span></p><p begin="1:19.736" end="1:24.912" itunes:key="L14" ttm:agent="v1"><span begin="1:19.736" end="1:20.354">Abra</span><span begin="1:20.354" end="1:20.650">ca</span><span begin="1:20.650" end="1:21.237">da</span><span begin="1:21.237" end="1:22.184">bra,</span> <span begin="1:22.184" end="1:22.770">morta-</span><span begin="1:22.770" end="1:23.066">oo-</span><span begin="1:23.066" end="1:24.912">gaga</span><span ttm:role="x-translation" xml:lang="zh-Hans">咒语响起 莫尔塔 呜嘎嘎</span></p><p begin="1:25.245" end="1:29.427" itunes:key="L15" ttm:agent="v1"><span begin="1:25.245" end="1:25.909">Abra</span><span begin="1:25.909" end="1:26.189">ca</span><span begin="1:26.189" end="1:26.869">da</span><span begin="1:26.869" end="1:27.189">bra,</span> <span begin="1:27.189" end="1:27.722">abra-</span><span begin="1:27.722" end="1:28.029">oo-</span><span begin="1:28.029" end="1:28.645">na-</span><span begin="1:28.645" end="1:29.427">na</span><span ttm:role="x-translation" xml:lang="zh-Hans">咒语响起 阿布拉 呜呐呐</span></p><p begin="1:29.527" end="1:32.293" itunes:key="L16" ttm:agent="v1"><span begin="1:29.527" end="1:29.788">In</span> <span begin="1:29.788" end="1:30.161">her</span> <span begin="1:30.161" end="1:30.735">tongue,</span> <span begin="1:30.735" end="1:31.151">she</span> <span begin="1:31.151" end="1:32.293">said</span><span ttm:role="x-translation" xml:lang="zh-Hans">她口中喃喃念道</span></p><p begin="1:32.640" end="1:37.923" itunes:key="L17" ttm:agent="v1"><span begin="1:32.640" end="1:33.280">Death</span> <span begin="1:33.280" end="1:33.840">or</span> <span begin="1:33.840" end="1:34.480">love</span> <span begin="1:34.480" end="1:34.842">to</span><span begin="1:34.842" end="1:37.923">night</span><span ttm:role="x-translation" xml:lang="zh-Hans">今夜要么灭亡 要么去爱</span></p></div><div begin="1:48.946" end="1:52.843" itunes:songPart="Chorus"><p begin="1:48.946" end="1:52.843" itunes:key="L18" ttm:agent="v1"><span begin="1:48.946" end="1:49.390">Abra</span><span begin="1:49.390" end="1:49.563">ca</span><span begin="1:49.563" end="1:49.816">da</span><span begin="1:49.816" end="1:50.083">bra,</span> <span begin="1:50.083" end="1:50.523">abra</span><span begin="1:50.523" end="1:50.776">ca</span><span begin="1:50.776" end="1:51.643">da</span><span begin="1:51.643" end="1:52.843">bra</span><span ttm:role="x-translation" xml:lang="zh-Hans">咒语响起 咒语响起</span></p></div><div begin="1:52.506" end="2:07.305" itunes:songPart="Verse"><p begin="1:52.506" end="1:55.913" itunes:key="L19" ttm:agent="v1"><span begin="1:52.506" end="1:52.858">Choose</span> <span begin="1:52.858" end="1:53.004">the</span> <span begin="1:53.004" end="1:54.063">road</span> <span begin="1:54.234" end="1:54.364">on</span> <span begin="1:54.364" end="1:54.524">the</span> <span begin="1:54.524" end="1:54.724">west</span> <span begin="1:54.724" end="1:55.913">side</span><span ttm:role="x-translation" xml:lang="zh-Hans">选择朝西的道路</span></p><p begin="1:55.960" end="1:59.702" itunes:key="L20" ttm:agent="v1"><span begin="1:55.960" end="1:56.176">As</span> <span begin="1:56.176" end="1:56.322">the</span> <span begin="1:56.322" end="1:56.549">dust</span> <span begin="1:56.549" end="1:57.560">flies,</span> <span begin="1:57.749" end="1:57.962">watch</span> <span begin="1:57.962" end="1:58.216">it</span> <span begin="1:58.216" end="1:59.702">burn</span><span ttm:role="x-translation" xml:lang="zh-Hans">看尘土飞扬 烈火焚烧</span></p><p begin="2:00.036" end="2:03.236" itunes:key="L21" ttm:agent="v1"><span begin="2:00.036" end="2:00.324">Don&apos;t</span> <span begin="2:00.324" end="2:00.618">waste</span> <span begin="2:00.618" end="2:01.444">time</span> <span begin="2:01.444" end="2:01.764">on</span> <span begin="2:01.764" end="2:01.911">a</span> <span begin="2:01.911" end="2:03.236">feeling</span><span ttm:role="x-translation" xml:lang="zh-Hans">别把时光浪费在某种感受</span></p><p begin="2:03.422" end="2:07.305" itunes:key="L22" ttm:agent="v1"><span begin="2:03.422" end="2:03.632">Use</span> <span begin="2:03.632" end="2:03.819">your</span> <span begin="2:03.819" end="2:05.046">passion,</span> <span begin="2:05.246" end="2:05.486">no</span> <span begin="2:05.486" end="2:05.691">re</span><span begin="2:05.691" end="2:07.305">turn</span><span ttm:role="x-translation" xml:lang="zh-Hans">热情奔赴 没有回头路</span></p></div><div begin="2:07.612" end="2:22.139" itunes:songPart="PreChorus"><p begin="2:07.612" end="2:10.692" itunes:key="L23" ttm:agent="v1"><span begin="2:07.612" end="2:08.159">Hold</span> <span begin="2:08.159" end="2:08.612">me</span> <span begin="2:08.612" end="2:08.999">in</span> <span begin="2:08.999" end="2:09.239">your</span> <span begin="2:09.239" end="2:09.639">heart</span> <span begin="2:09.639" end="2:10.172">to</span><span begin="2:10.172" end="2:10.692">night</span><span ttm:role="x-translation" xml:lang="zh-Hans">今夜将我装进你心里</span></p><p begin="2:10.692" end="2:14.681" itunes:key="L24" ttm:agent="v1"><span begin="2:10.692" end="2:10.964">In</span> <span begin="2:10.964" end="2:11.233">the</span> <span begin="2:11.233" end="2:12.100">magic</span> <span begin="2:12.100" end="2:12.766">of</span> <span begin="2:12.766" end="2:13.020">the</span> <span begin="2:13.020" end="2:13.433">dark</span> <span begin="2:13.433" end="2:13.842">moon</span><span begin="2:13.842" end="2:14.681">light</span><span ttm:role="x-translation" xml:lang="zh-Hans">在昏暗月光的魔力下</span></p><p begin="2:15.108" end="2:19.817" itunes:key="L25" ttm:agent="v1"><span begin="2:15.108" end="2:15.594">Save</span> <span begin="2:15.594" end="2:16.034">me</span> <span begin="2:16.034" end="2:16.541">from</span> <span begin="2:16.541" end="2:16.847">this</span> <span begin="2:16.847" end="2:17.594">empty</span> <span begin="2:17.594" end="2:19.817">fight</span><span ttm:role="x-translation" xml:lang="zh-Hans">带我逃离这虚无的斗争</span></p><p begin="2:20.190" end="2:22.139" itunes:key="L26" ttm:agent="v1"><span begin="2:20.190" end="2:20.486">In</span> <span begin="2:20.486" end="2:20.726">the</span> <span begin="2:20.726" end="2:21.046">game</span> <span begin="2:21.046" end="2:21.459">of</span> <span begin="2:21.459" end="2:22.139">life</span><span ttm:role="x-translation" xml:lang="zh-Hans">在人生游戏中</span></p></div><div begin="2:22.139" end="2:36.411" itunes:songPart="PreChorus"><p begin="2:22.139" end="2:25.686" itunes:key="L27" ttm:agent="v1"><span begin="2:22.