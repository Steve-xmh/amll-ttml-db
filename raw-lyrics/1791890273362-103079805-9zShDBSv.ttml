<tt xmlns="http://www.w3.org/ns/ttml" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xmlns:amll="http://www.example.com/ns/amll"><head><metadata><ttm:agent type="person" xml:id="v1"/><amll:meta key="musicName" value="The Promised Land (feat. LynH)"/><amll:meta key="musicName" value="The Promised Land"/><amll:meta key="musicName" value="音游《Rotaeno》第一章曲目"/><amll:meta key="artists" value="Iris"/><amll:meta key="artists" value="LynH"/><amll:meta key="album" value="The Promised Land (feat. LynH)"/><amll:meta key="ncmMusicId" value="2676006857"/><amll:meta key="qqMusicId" value="004HVY1I2XhHD3"/><amll:meta key="ttmlAuthorGithub" value="103079805"/><amll:meta key="ttmlAuthorGithubLogin" value="hanyu200"/><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal"><songwriters><songwriter>Iris</songwriter></songwriters></iTunesMetadata></metadata></head><body dur="1:25.722"><div begin="4.668" end="1:25.722"><p begin="4.668" end="8.412" itunes:key="L1" ttm:agent="v1"><span begin="4.668" end="5.087">Far</span> <span begin="5.087" end="5.733">beyond</span> <span begin="5.733" end="6.159">my</span> <span begin="6.159" end="8.412">dreams</span><span ttm:role="x-translation" xml:lang="zh-Hans">在遥梦之外</span></p><p begin="9.536" end="13.983" itunes:key="L2" ttm:agent="v1"><span begin="9.536" end="9.787">A</span> <span begin="9.787" end="10.212">home</span> <span begin="10.212" end="10.686">for</span> <span begin="10.686" end="11.317">you</span> <span begin="11.317" end="11.935">and</span> <span begin="11.935" end="13.983">me</span><span ttm:role="x-translation" xml:lang="zh-Hans">是你我的归宿</span></p><p begin="18.327" end="22.345" itunes:key="L3" ttm:agent="v1"><span begin="18.327" end="18.858">See</span> <span begin="18.858" end="19.038">the</span> <span begin="19.038" end="19.471">sun</span> <span begin="19.471" end="22.345">arise</span><span ttm:role="x-translation" xml:lang="zh-Hans">看着太阳升起</span></p><p begin="25.678" end="29.358" itunes:key="L4" ttm:agent="v1"><span begin="25.678" end="25.804">On</span> <span begin="25.804" end="26.054">our</span> <span begin="26.054" end="27.348">promised</span> <span begin="27.348" end="29.358">land</span><span ttm:role="x-translation" xml:lang="zh-Hans">在这片应许之地</span></p><p begin="58.584" end="1:01.439" itunes:key="L5" ttm:agent="v1"><span begin="58.584" end="59.063">Far</span> <span begin="59.063" end="59.654">beyond</span> <span begin="59.654" end="1:00.129">my</span> <span begin="1:00.129" end="1:01.439">dreams</span><span ttm:role="x-translation" xml:lang="zh-Hans">在遥梦之外</span></p><p begin="1:01.587" end="1:05.056" itunes:key="L6" ttm:agent="v1"><span begin="1:01.587" end="1:01.832">This</span> <span begin="1:01.832" end="1:02.056">is</span> <span begin="1:02.056" end="1:02.487">home</span> <span begin="1:02.487" end="1:02.696">for</span> <span begin="1:02.696" end="1:03.122">you</span> <span begin="1:03.122" end="1:03.562">and</span> <span begin="1:03.562" end="1:05.056">me</span><span ttm:role="x-translation" xml:lang="zh-Hans">是你我的归宿</span></p><p begin="1:05.492" end="1:08.192" itunes:key="L7" ttm:agent="v1"><span begin="1:05.492" end="1:06.156">Heaven&apos;s</span> <span begin="1:06.156" end="1:06.556">will</span> <span begin="1:06.556" end="1:06.982">on</span> <span begin="1:06.982" end="1:08.192">earth</span><span ttm:role="x-translation" xml:lang="zh-Hans">天意将降临</span></p><p begin="1:08.492" end="1:12.020" itunes:key="L8" ttm:agent="v1"><span begin="1:08.492" end="1:08.942">For</span> <span begin="1:08.942" end="1:09.352">all</span> <span begin="1:09.352" end="1:12.020">eternity</span><span ttm:role="x-translation" xml:lang="zh-Hans">直至永恒</span></p><p begin="1:12.356" end="1:15.007" itunes:key="L9" ttm:agent="v1"><span begin="1:12.356" end="1:12.776">Lift</span> <span begin="1:12.776" end="1:12.972">your</span> <span begin="1:12.972" end="1:13.416">eyes</span> <span begin="1:13.416" end="1:13.852">on</span> <span begin="1:13.852" end="1:15.007">high</span><span ttm:role="x-translation" xml:lang="zh-Hans">抬起双眼</span></p><p begin="1:15.347" end="1:18.857" itunes:key="L10" ttm:agent="v1"><span begin="1:15.347" end="1:15.547">To</span> <span begin="1:15.547" end="1:15.781">the</span> <span begin="1:15.781" end="1:16.456">mountains</span> <span begin="1:16.456" end="1:16.842">where</span> <span begin="1:16.842" end="1:17.151">we</span> <span begin="1:17.151" end="1:18.857">stand</span><span ttm:role="x-translation" xml:lang="zh-Hans">看向脚下的山脉</span></p><p begin="1:19.212" end="1:22.017" itunes:key="L11" ttm:agent="v1"><span begin="1:19.212" end="1:19.606">See</span> <span begin="1:19.606" end="1:19.787">the</span> <span begin="1:19.787" end="1:20.272">sun</span> <span begin="1:20.272" end="1:22.017">arise</span><span ttm:role="x-translation" xml:lang="zh-Hans">看着太阳升起</span></p><p begin="1:22.176" end="1:25.722" itunes:key="L12" ttm:agent="v1"><span begin="1:22.176" end="1:22.537">On</span> <span begin="1:22.537" end="1:23.052">skies</span> <span begin="1:23.052" end="1:23.272">of</span> <span begin="1:23.272" end="1:24.092">promised</span> <span begin="1:24.092" end="1:25.722">land</span><span ttm:role="x-translation" xml:lang="zh-Hans">在这片应许之地</span></p></div></body></tt>