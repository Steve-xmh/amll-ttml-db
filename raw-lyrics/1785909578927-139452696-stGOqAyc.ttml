<tt xmlns="http://www.w3.org/ns/ttml" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xmlns:amll="http://www.example.com/ns/amll"><head><metadata><ttm:agent type="person" xml:id="v1"/><amll:meta key="musicName" value="4nim0sity"/><amll:meta key="musicName" value="99.999999999%"/><amll:meta key="artists" value="イチ"/><amll:meta key="album" value="4nim0sity [99.999999999%]"/><amll:meta key="ncmMusicId" value="2151515528"/><amll:meta key="qqMusicId" value="0020mVAS0bw0Ti"/><amll:meta key="spotifyId" value="2u2kyKAf9mpQegLo9IedWA"/><amll:meta key="appleMusicId" value="1744110377"/><amll:meta key="ttmlAuthorGithub" value="139452696"/><amll:meta key="ttmlAuthorGithubLogin" value="tfan114"/><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal"><transliterations><transliteration><text for="L5"><span begin="31.687" end="31.797">ku chi</span><span begin="31.797" end="31.797">o</span><span begin="31.797" end="32.121">hi ra</span><span begin="32.121" end="32.121">ke</span><span begin="32.121" end="32.476">ba</span><span begin="32.476" end="32.649">hi ga</span><span begin="32.649" end="32.878">mi</span><span begin="32.878" end="33.182">da</span><span begin="33.182" end="33.524">to</span><span begin="33.524" end="33.919">i</span><span begin="33.919" end="34.226">wa</span><span begin="34.226" end="34.519">re</span></text></transliteration></transliterations><songwriters><songwriter>イチ</songwriter></songwriters></iTunesMetadata></metadata></head><body dur="3:31.555"><div begin="4.914" end="3:31.555"><p begin="4.914" end="7.862" itunes:key="L1" ttm:agent="v1"><span begin="4.914" end="5.068">個々</span><span begin="5.068" end="5.242">の</span><span begin="5.242" end="5.412">生</span><span begin="5.412" end="5.574">ま</span><span begin="5.574" end="5.795">れ</span><span begin="5.795" end="6.222">は</span><span begin="6.222" end="6.576">星</span><span begin="6.576" end="6.781">が</span><span begin="6.781" end="6.972">あ</span><span begin="6.972" end="7.133">る</span><span begin="7.133" end="7.255">よ</span><span begin="7.255" end="7.471">う</span><span begin="7.471" end="7.862">で</span><span ttm:role="x-translation" xml:lang="zh-Hans">每个人出生都伴随有星辰</span><span ttm:role="x-roman">koko no umare wa hoshi ga aru you de</span></p><p begin="8.190" end="11.751" itunes:key="L2" ttm:agent="v1"><span begin="8.190" end="8.328">ま</span><span begin="8.328" end="8.517">わ</span><span begin="8.517" end="8.682">り</span><span begin="8.682" end="8.895">を</span><span begin="8.895" end="9.047">見</span><span begin="9.047" end="9.336">れ</span><span begin="9.336" end="9.543">ば</span><span begin="9.543" end="9.748">皆</span><span begin="9.748" end="9.992">と</span><span begin="9.992" end="10.396">違</span><span begin="10.396" end="10.770">い</span><span begin="10.770" end="11.185">ま</span><span begin="11.185" end="11.507">し</span><span begin="11.507" end="11.751">た</span><span ttm:role="x-translation" xml:lang="zh-Hans">环顾四周，我与众不同</span><span ttm:role="x-roman">mawari o mireba mina to chigaimashita</span></p><p begin="12.033" end="15.084" itunes:key="L3" ttm:agent="v1"><span begin="12.033" end="12.165">媚</span><span begin="12.165" end="12.329">び</span><span begin="12.329" end="12.521">へ</span><span begin="12.521" end="12.711">つ</span><span begin="12.711" end="12.879">ら</span><span begin="12.879" end="13.089">う</span><span begin="13.089" end="13.307">笑</span><span begin="13.307" end="13.514">い</span><span begin="13.514" end="13.726">方</span><span begin="13.726" end="13.922">ど</span><span begin="13.922" end="14.142">う</span><span begin="14.142" end="14.542">で</span><span begin="14.542" end="14.779">す</span><span begin="14.779" end="15.084">か？</span><span ttm:role="x-translation" xml:lang="zh-Hans">谄媚的笑法怎么样？</span><span ttm:role="x-roman">kobihetsurau waraikata dou desu ka?</span></p><p begin="15.479" end="18.205" itunes:key="L4" ttm:agent="v1"><span begin="15.479" end="15.651">嫌</span><span begin="15.651" end="15.826">わ</span><span begin="15.826" end="16.016">れ</span><span begin="16.016" end="16.201">る</span><span begin="16.201" end="16.407">音</span><span begin="16.407" end="16.648">が</span><span begin="16.648" end="17.057">苦</span><span begin="17.057" end="17.417">手</span><span begin="17.417" end="17.603">で</span><span begin="17.603" end="17.928">し</span><span begin="17.928" end="18.205">た</span><span ttm:role="x-translation" xml:lang="zh-Hans">我不擅长表示讨厌</span><span ttm:role="x-roman">kirawareru oto ga nigate deshita</span></p><p begin="31.687" end="34.519" itunes:key="L5" ttm:agent="v1"><span begin="31.687" end="31.797">口</span><span begin="31.797" end="31.797">を</span><span begin="31.797" end="32.121">開</span><span begin="32.121" end="32.121">け</span><span begin="32.121" end="32.476">ば</span><span begin="32.476" end="32.649">僻</span><span begin="32.649" end="32.878">み</span><span begin="32.878" end="33.182">だ</span><span begin="33.182" end="33.524">と</span><span begin="33.524" end="33.919">言</span><span begin="33.919" end="34.226">わ</span><span begin="34.226" end="34.519">れ</span><span ttm:role="x-translation" xml:lang="zh-Hans">如果开口，你就会被说成是偏见</span></p><p begin="34.896" end="37.957" itunes:key="L6" ttm:agent="v1"><span begin="34.896" end="34.896">涙</span><span begin="34.896" end="35.158">流</span><span begin="35.158" end="35.328">せ</span><span begin="35.328" end="35.684">ば</span><span begin="35.684" end="35.851">嫉</span><span begin="35.851" end="36.067">み</span><span begin="36.067" end="36.280">と</span><span begin="36.280" end="36.488">言</span><span begin="36.488" end="36.904">わ</span><span begin="36.904" end="37.122">れ</span><span begin="37.122" end="37.344">ま</span><span begin="37.344" end="37.566">し</span><span begin="37.566" end="37.957">た</span><span ttm:role="x-translation" xml:lang="zh-Hans">如果流泪，你就会被说成是嫉妒</span><span ttm:role="x-roman">namida nagaseba sonemi to iwaremashita</span></p><p begin="38.544" end="41.743" itunes:key="L7" ttm:agent="v1"><span begin="38.544" end="38.716">誤</span><span begin="38.716" end="38.900">魔</span><span begin="38.900" end="39.147">化</span><span begin="39.147" end="39.365">す</span><span begin="39.365" end="39.554">の</span><span begin="39.554" end="39.754">が</span><span begin="39.754" end="40.002">上</span><span begin="40.002" end="40.234">手</span><span begin="40.234" end="40.463">で</span><span begin="40.463" end="40.717">だ</span><span begin="40.717" end="40.910">め</span><span begin="40.910" end="41.107">で</span><span begin="41.107" end="41.437">す</span><span begin="41.437" end="41.743">か？</span><span ttm:role="x-translation" xml:lang="zh-Hans">我擅长欺骗不行吗</span><span ttm:role="x-roman">gomakasu no ga jouzu de dame desu ka?</span></p><p begin="42.191" end="45.118" itunes:key="L8" ttm:agent="v1"><span begin="42.191" end="42.393">か</span><span begin="42.393" end="42.565">ま</span><span begin="42.565" end="42.742">う</span><span begin="42.742" end="42.942">ふ</span><span begin="42.942" end="43.136">り</span> <span begin="43.136" end="43.336">ど</span><span begin="43.336" end="43.525">う</span><span begin="43.525" end="43.749">で</span><span begin="43.749" end="43.920">も</span><span begin="43.920" end="44.109">い</span><span begin="44.109" end="44.277">い</span><span begin="44.277" end="44.500">く</span><span begin="44.500" end="44.691">せ</span><span begin="44.691" end="45.118">に</span><span ttm:role="x-translation" xml:lang="zh-Hans">装模做样 明明无所谓</span><span ttm:role="x-roman">kamau furi dou demo ii kuse ni</span></p><p begin="46.005" end="51.561" itunes:key="L9" ttm:agent="v1"><span begin="46.005" end="46.163">く</span><span begin="46.163" end="46.336">せ</span><span begin="46.336" end="46.882">に</span> <span begin="47.686" end="47.823">く</span><span begin="47.823" end="47.994">せ</span><span begin="47.994" end="48.153">に</span> <span begin="49.364" end="49.482">ど</span><span begin="49.482" end="49.682">う</span><span begin="49.682" end="49.802">せ</span><span begin="49.802" end="50.187">偽</span><span begin="50.187" end="50.359">善</span><span begin="50.359" end="50.578">の</span><span begin="50.578" end="50.819">く</span><span begin="50.819" end="51.201">せ</span><span begin="51.201" end="51.561">に</span><span ttm:role="x-translation" xml:lang="zh-Hans">反正已经伪善成性了</span><span ttm:role="x-roman">kuse ni kuse ni douse gizen no kuse ni</span></p><p begin="52.765" end="57.870" itunes:key="L10" ttm:agent="v1"><span begin="52.765" end="52.884">こ</span><span begin="52.884" end="52.884">う</span><span begin="52.884" end="53.201">も</span> <span begin="54.324" end="54.443">こ</span><span begin="54.443" end="54.587">う</span><span begin="54.587" end="54.587">も</span> <span begin="56.123" end="56.260">揺</span><span begin="56.260" end="56.409">ら</span><span begin="56.409" end="56.409">い</span><span begin="56.409" end="56.978">で</span><span begin="56.978" end="57.331">し</span><span begin="57.331" end="57.563">ま</span><span begin="57.563" end="57.870">う</span><span ttm:role="x-translation" xml:lang="zh-Hans">就这样也是会动摇啊</span><span ttm:role="x-roman">kou mo kou mo yuraide shimau</span></p><p begin="1:11.501" end="1:14.138" itunes:key="L11" ttm:agent="v1"><span begin="1:11.501" end="1:11.644">憎</span><span begin="1:11.644" end="1:11.827">し</span><span begin="1:11.827" end="1:11.990">み</span><span begin="1:11.990" end="1:12.162">さ</span><span begin="1:12.162" end="1:12.646">ん、</span><span begin="1:12.646" end="1:12.859">ま</span><span begin="1:12.859" end="1:13.071">た</span><span begin="1:13.071" end="1:13.239">よ</span><span begin="1:13.239" end="1:13.448">ろ</span><span begin="1:13.448" end="1:13.645">し</span><span begin="1:13.645" end="1:13.858">く</span><span begin="1:13.858" end="1:14.138">ね</span><span ttm:role="x-translation" xml:lang="zh-Hans">憎恨先生，还请多多关照</span><span ttm:role="x-roman">nikushimi-san, mata yoroshiku ne</span></p><p begin="1:14.553" end="1:18.367" itunes:key="L12" ttm:agent="v1"><span begin="1:14.553" end="1:14.662">誰</span><span begin="1:14.662" end="1:14.782">も</span> <span begin="1:14.782" end="1:15.408">誰</span><span begin="1:15.408" end="1:15.623">か</span><span begin="1:15.623" end="1:15.748">ら</span><span begin="1:15.748" end="1:15.748">も</span><span begin="1:15.748" end="1:16.143">愛</span><span begin="1:16.143" end="1:16.305">さ</span><span begin="1:16.305" end="1:16.576">れ</span><span begin="1:16.576" end="1:16.795">な</span><span begin="1:16.795" end="1:17.338">く</span><span begin="1:17.338" end="1:17.517">て</span><span begin="1:17.517" end="1:17.733">い</span><span begin="1:17.733" end="1:17.939">い</span><span begin="1:17.939" end="1:18.367">ね</span><span ttm:role="x-translation" xml:lang="zh-Hans">任何人 不被任何人爱着也好了</span><span ttm:role="x-roman">dare mo dare kara mo aisarenakute ii ne</span></p><p begin="1:18.629" end="1:21.089" itunes:key="L13" ttm:agent="v1"><span begin="1:18.629" end="1:18.629">ノ</span><span begin="1:18.629" end="1:18.852">ド</span><span begin="1:18.852" end="1:19.107">の</span><span begin="1:19.107" end="1:19.485">果</span><span begin="1:19.485" end="1:19.655">て</span><span begin="1:19.655" end="1:19.875">に</span><span begin="1:19.875" end="1:20.065">の</span><span begin="1:20.065" end="1:20.273">さ</span><span begin="1:20.273" end="1:20.609">ば</span><span begin="1:20.609" end="1:21.089">る</span><span ttm:role="x-translation" xml:lang="zh-Hans">在喉咙的尽头蔓延</span><span ttm:role="x-roman">nodo no hate ni nosabaru</span></p><p begin="1:21.236" end="1:24.666" itunes:key="L14" ttm:agent="v1"><span begin="1:21.236" end="1:21.435">濁</span><span begin="1:21.435" end="1:21.435">り</span><span begin="1:21.435" end="1:22.004">の</span><span begin="1:22.004" end="1:22.375">な</span><span begin="1:22.375" end="1:22.718">い</span><span begin="1:22.718" end="1:23.092">澄</span><span begin="1:23.092" end="1:23.299">ん</span><span begin="1:23.299" end="1:23.676">だ</span><span begin="1:23.676" end="1:24.053">ド</span><span begin="1:24.053" end="1:24.166">ロ</span><span begin="1:24.166" end="1:24.317">ド</span><span begin="1:24.317" end="1:24.516">ロ</span><span begin="1:24.516" end="1:24.666">に</span><span ttm:role="x-translation" xml:lang="zh-Hans">在没有浑浊的清澈的泥泞中</span><span ttm:role="x-roman">nigori no nai sunda dorodoro ni</span></p><p begin="1:24.666" end="1:27.423" itunes:key="L15" ttm:agent="v1"><span begin="1:24.666" end="1:24.963">塗</span><span begin="1:24.963" end="1:25.311">れ</span><span begin="1:25.311" end="1:25.465">て</span><span begin="1:25.465" end="1:25.783">い</span><span begin="1:25.783" end="1:26.279">る</span><span begin="1:26.279" end="1:26.739">100</span><span begin="1:26.739" end="1:27.085">の</span><span begin="1:27.085" end="1:27.423">中</span><span ttm:role="x-translation" xml:lang="zh-Hans">在被涂上颜色的&quot;100&quot;之中</span><span ttm:role="x-roman">mamirete iru hyaku no naka</span></p><p begin="1:27.753" end="1:31.553" itunes:key="L16" ttm:agent="v1"><span begin="1:27.753" end="1:27.942">さ</span><span begin="1:27.942" end="1:27.942">も</span><span begin="1:27.942" end="1:28.745">し</span><span begin="1:28.745" end="1:28.911">い</span><span begin="1:28.911" end="1:29.026">幸</span><span begin="1:29.026" end="1:29.294">せ</span><span begin="1:29.294" end="1:29.499">が</span><span begin="1:29.499" end="1:29.743">今</span><span begin="1:29.743" end="1:29.961">を</span><span begin="1:29.961" end="1:30.180">壊</span><span begin="1:30.180" end="1:30.390">さ</span><span begin="1:30.390" end="1:30.603">ぬ</span><span begin="1:30.603" end="1:30.807">よ</span><span begin="1:30.807" end="1:31.175">う</span><span begin="1:31.175" end="1:31.553">に</span><span ttm:role="x-translation" xml:lang="zh-Hans">为了不让寂寞的幸福破坏现在</span><span ttm:role="x-roman">samoshii shiawase ga ima o kowasanu you ni</span></p><p begin="1:31.867" end="1:34.019" itunes:key="L17" ttm:agent="v1"><span begin="1:31.867" end="1:32.064">余</span><span begin="1:32.064" end="1:32.210">り</span><span begin="1:32.210" end="1:32.721">の</span><span begin="1:32.721" end="1:32.939">1</span><span begin="1:32.939" end="1:33.172">を</span><span begin="1:33.172" end="1:33.630">殺</span><span begin="1:33.630" end="1:34.019">す</span><span ttm:role="x-translation" xml:lang="zh-Hans">杀了剩下的一个</span><span ttm:role="x-roman">amari no ichi o korosu</span></p><p begin="1:34.019" end="1:38.180" itunes:key="L18" ttm:agent="v1"><span begin="1:34.019" end="1:34.512">罪</span><span begin="1:34.512" end="1:34.658">で</span><span begin="1:34.658" end="1:34.875">も</span><span begin="1:34.875" end="1:35.271">い</span><span begin="1:35.271" end="1:35.666">い</span><span begin="1:35.666" end="1:36.025">よ</span> <span begin="1:36.025" end="1:36.468">じ</span><span begin="1:36.468" end="1:36.705">ゃ</span><span begin="1:36.705" end="1:37.047">あ</span><span begin="1:37.047" end="1:37.357">ね</span><span begin="1:37.357" end="1:37.542">さ</span><span begin="1:37.542" end="1:37.724">よ</span><span begin="1:37.724" end="1:37.956">な</span><span begin="1:37.956" end="1:38.180">ら</span><span ttm:role="x-translation" xml:lang="zh-Hans">就算是罪过也无所谓 再见</span><span ttm:role="x-roman">tsumi demo ii yo jaa ne sayonara</span></p><p begin="1:51.559" end="1:54.932" itunes:key="L19" ttm:agent="v1"><span begin="1:51.559" end="1:51.693">も</span><span begin="1:51.693" end="1:51.866">し</span><span begin="1:51.866" end="1:52.141">も</span><span begin="1:52.141" end="1:52.386">世</span><span begin="1:52.386" end="1:52.623">界</span><span begin="1:52.623" end="1:52.848">が</span><span begin="1:52.848" end="1:53.052">思</span><span begin="1:53.052" end="1:53.312">う</span><span begin="1:53.312" end="1:53.786">ま</span><span begin="1:53.786" end="1:53.967">ま</span><span begin="1:53.967" end="1:54.116">だ</span><span begin="1:54.116" end="1:54.339">と</span><span begin="1:54.339" end="1:54.571">し</span><span begin="1:54.571" end="1:54.932">て</span><span ttm:role="x-translation" xml:lang="zh-Hans">如果世界能随心所欲</span><span ttm:role="x-roman">moshimo sekai ga omou mama da to shite</span></p><p begin="1:55.480" end="1:58.507" itunes:key="L20" ttm:agent="v1"><span begin="1:55.480" end="1:55.650">自</span><span begin="1:55.650" end="1:55.828">分</span><span begin="1:55.828" end="1:56.012">以</span><span begin="1:56.012" end="1:56.217">外</span><span begin="1:56.217" end="1:56.524">も</span><span begin="1:56.524" end="1:57.002">不</span><span begin="1:57.002" end="1:57.191">幸</span><span begin="1:57.191" end="1:57.369">で</span><span begin="1:57.369" end="1:57.553">あ</span><span begin="1:57.553" end="1:57.746">れ</span><span begin="1:57.746" end="1:57.941">ば</span><span begin="1:57.941" end="1:58.236">い</span><span begin="1:58.236" end="1:58.507">い</span><span ttm:role="x-translation" xml:lang="zh-Hans">除了我都不幸好了</span><span ttm:role="x-roman">jibun igai mo fukou de areba ii</span></p><p begin="1:58.729" end="2:01.246" itunes:key="L21" ttm:agent="v1"><span begin="1:58.729" end="1:58.858">皆</span><span begin="1:58.858" end="1:58.858">独</span><span begin="1:58.858" end="1:59.196">り</span><span begin="1:59.196" end="1:59.422">で</span><span begin="1:59.422" end="1:59.640">同</span><span begin="1:59.640" end="1:59.847">じ</span><span begin="1:59.847" end="2:00.044">で</span><span begin="2:00.044" end="2:00.265">あ</span><span begin="2:00.265" end="2:00.435">る</span><span begin="2:00.435" end="2:00.653">の</span><span begin="2:00.653" end="2:00.856">な</span><span begin="2:00.856" end="2:01.246">ら</span><span ttm:role="x-translation" xml:lang="zh-Hans">如果每个人都一样的话</span><span ttm:role="x-roman">mina hitori de onaji de aru no nara</span></p><p begin="2:01.528" end="2:04.454" itunes:key="L22" ttm:agent="v1"><span begin="2:01.528" end="2:01.922">き</span><span begin="2:01.922" end="2:02.319">っ</span><span begin="2:02.319" end="2:02.515">と</span><span begin="2:02.515" end="2:02.727">私</span><span begin="2:02.727" end="2:03.063">だ</span><span begin="2:03.063" end="2:03.611">け</span><span begin="2:03.611" end="2:04.064">幸</span><span begin="2:04.064" end="2:04.454">せ</span><span ttm:role="x-translation" xml:lang="zh-Hans">一定只有我幸福</span><span ttm:role="x-roman">kitto watashi dake shiawase</span></p><p begin="2:04.454" end="2:07.365" itunes:key="L23" ttm:agent="v1"><span begin="2:04.454" end="2:04.712">孤</span><span begin="2:04.851" end="2:05.051">独</span><span begin="2:05.051" end="2:05.288">の</span><span begin="2:05.288" end="2:05.554">な</span><span begin="2:05.554" end="2:06.451">い</span><span begin="2:06.451" end="2:06.755">世</span><span begin="2:06.755" end="2:07.039">界</span><span begin="2:07.039" end="2:07.365">で</span><span ttm:role="x-translation" xml:lang="zh-Hans">在没有孤独的世界</span><span ttm:role="x-roman">kodoku no nai sekai de</span></p><p begin="2:08.114" end="2:10.771" itunes:key="L24" ttm:agent="v1"><span begin="2:08.114" end="2:08.414">思</span><span begin="2:08.414" end="2:08.716">い</span><span begin="2:08.716" end="2:09.053">や</span><span begin="2:09.053" end="2:09.352">り</span><span begin="2:09.352" end="2:09.659">に</span><span begin="2:09.659" end="2:09.948">包</span><span begin="2:09.948" end="2:10.493">ま</span><span begin="2:10.493" end="2:10.771">れ</span><span ttm:role="x-translation" xml:lang="zh-Hans">被同情心包围着</span><span ttm:role="x-roman">omoiyari ni tsutsumare</span></p><p begin="2:11.255" end="2:16.583" itunes:key="L25" ttm:agent="v1"><span begin="2:11.255" end="2:11.527">減</span><span begin="2:11.527" end="2:11.769">る</span><span begin="2:11.769" end="2:12.046">事</span><span begin="2:12.046" end="2:12.436">な</span><span begin="2:12.436" end="2:12.672">い</span><span begin="2:12.672" end="2:12.949">幸</span><span begin="2:12.949" end="2:13.221">せ</span><span begin="2:13.221" end="2:13.498">が</span><span begin="2:13.498" end="2:13.823">欲</span><span begin="2:13.823" end="2:14.783">し</span><span begin="2:14.783" end="2:16.583">い</span><span ttm:role="x-translation" xml:lang="zh-Hans">想要取之不竭的幸福</span><span ttm:role="x-roman">heru koto nai shiawase ga hoshii</span></p><p begin="2:17.220" end="2:17.732" itunes:key="L26" ttm:agent="v1"><span begin="2:17.220" end="2:17.452">来</span><span begin="2:17.452" end="2:17.452">