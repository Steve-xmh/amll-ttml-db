<tt xmlns="http://www.w3.org/ns/ttml" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xmlns:amll="http://www.example.com/ns/amll"><head><metadata><ttm:agent type="person" xml:id="v1"/><amll:meta key="musicName" value="そういうことになっている"/><amll:meta key="artists" value="めらみぽっぷ"/><amll:meta key="artists" value="RD-Sounds"/><amll:meta key="artists" value="凋叶棕"/><amll:meta key="album" value="契"/><amll:meta key="ncmMusicId" value="3383661748"/><amll:meta key="qqMusicId" value="004dqBcC2lhYKS"/><amll:meta key="ttmlAuthorGithub" value="52458173"/><amll:meta key="ttmlAuthorGithubLogin" value="NereaFantasia"/></metadata></head><body dur="5:11.098"><div begin="36.127" end="5:11.098"><p begin="36.127" end="37.685" itunes:key="L0" ttm:agent="v1"><span begin="36.127" end="36.438">意</span><span begin="36.438" end="36.637">味</span><span begin="36.637" end="36.858">な</span><span begin="36.858" end="37.077">し</span><span begin="37.077" end="37.287">の</span><span begin="37.287" end="37.417">視</span><span begin="37.417" end="37.685">線</span><span ttm:role="x-translation" xml:lang="zh-Hans">毫无意义的视线</span><span ttm:role="x-roman">imi nashi no shisen</span></p><p begin="38.001" end="39.510" itunes:key="L1" ttm:agent="v1"><span begin="38.001" end="38.173">な</span><span begin="38.173" end="38.380">に</span><span begin="38.380" end="38.589">げ</span><span begin="38.589" end="38.826">な</span><span begin="38.826" end="39.044">い</span><span begin="39.044" end="39.322">笑</span><span begin="39.322" end="39.510">顔</span><span ttm:role="x-translation" xml:lang="zh-Hans">漫不经心的笑容</span><span ttm:role="x-roman">nanigenai egao</span></p><p begin="39.608" end="41.373" itunes:key="L2" ttm:agent="v1"><span begin="39.608" end="39.902">た</span><span begin="39.902" end="40.082">た</span><span begin="40.082" end="40.326">け</span><span begin="40.326" end="40.566">る</span><span begin="40.566" end="40.859">軽</span><span begin="40.859" end="41.373">口</span><span ttm:role="x-translation" xml:lang="zh-Hans">随口甩出的玩笑话</span><span ttm:role="x-roman">tatakeru karukuchi</span></p><p begin="41.735" end="43.445" itunes:key="L3" ttm:agent="v1"><span begin="41.735" end="42.013">い</span><span begin="42.013" end="42.246">き</span><span begin="42.246" end="42.493">お</span><span begin="42.493" end="42.726">い</span><span begin="42.726" end="42.959">の</span><span begin="42.959" end="43.300">権</span><span begin="43.300" end="43.445">化</span><span ttm:role="x-translation" xml:lang="zh-Hans">气势的化身</span><span ttm:role="x-roman">ikioi no gonge</span></p><p begin="43.706" end="45.395" itunes:key="L4" ttm:agent="v1"><span begin="43.706" end="43.940">ぶ</span><span begin="43.940" end="44.173">つ</span><span begin="44.173" end="44.401">け</span><span begin="44.401" end="44.666">ら</span><span begin="44.666" end="44.913">れ</span><span begin="44.913" end="45.227">挑</span><span begin="45.227" end="45.395">戦</span><span ttm:role="x-translation" xml:lang="zh-Hans">劈头砸来的挑战</span><span ttm:role="x-roman">butsukerare chousen</span></p><p begin="45.478" end="47.166" itunes:key="L5" ttm:agent="v1"><span begin="45.478" end="45.731">た</span><span begin="45.731" end="45.983">た</span><span begin="45.983" end="46.182">か</span><span begin="46.182" end="46.448">え</span><span begin="46.448" end="46.695">る</span><span begin="46.695" end="46.981">意</span><span begin="46.981" end="47.166">見</span><span ttm:role="x-translation" xml:lang="zh-Hans">针锋相对的意见</span><span ttm:role="x-roman">tatakaeru iken</span></p><p begin="47.584" end="49.213" itunes:key="L6" ttm:agent="v1"><span begin="47.584" end="47.836">手</span><span begin="47.836" end="48.083">の</span><span begin="48.083" end="48.335">込</span><span begin="48.335" end="48.549">ん</span><span begin="48.549" end="48.801">だ</span><span begin="48.801" end="48.980">論</span><span begin="48.980" end="49.213">駁</span><span ttm:role="x-translation" xml:lang="zh-Hans">精心构筑的反驳</span><span ttm:role="x-roman">te no konda ronbaku</span></p><p begin="49.464" end="51.238" itunes:key="L7" ttm:agent="v1"><span begin="49.464" end="49.769">手</span><span begin="49.769" end="49.983">が</span><span begin="49.983" end="50.235">出</span><span begin="50.235" end="50.487">る</span><span begin="50.487" end="50.734">が</span><span begin="50.734" end="51.093">早</span><span begin="51.093" end="51.238">い</span><span ttm:role="x-translation" xml:lang="zh-Hans">——然而动手比动嘴更快</span><span ttm:role="x-roman">te ga deru ga hayai</span></p><p begin="51.462" end="53.192" itunes:key="L8" ttm:agent="v1"><span begin="51.462" end="51.727">こ</span><span begin="51.727" end="51.991">う</span><span begin="51.991" end="52.256">な</span><span begin="52.256" end="52.507">っ</span><span begin="52.507" end="52.623">た</span><span begin="52.623" end="52.776">ら</span><span begin="52.776" end="53.009">い</span><span begin="53.009" end="53.108">つ</span><span begin="53.108" end="53.192">も</span><span ttm:role="x-translation" xml:lang="zh-Hans">每到这种时候就老样子</span><span ttm:role="x-roman">kou nattara itsumo</span></p><p begin="53.437" end="55.150" itunes:key="L9" ttm:agent="v1"><span begin="53.437" end="53.701">ま</span><span begin="53.701" end="53.935">る</span><span begin="53.935" end="54.199">で</span><span begin="54.199" end="54.428">気</span><span begin="54.428" end="54.661">が</span><span begin="54.661" end="54.845">利</span><span begin="54.845" end="54.980">か</span><span begin="54.980" end="55.083">な</span><span begin="55.083" end="55.150">い</span><span ttm:role="x-translation" xml:lang="zh-Hans">完全不懂察言观色</span><span ttm:role="x-roman">marude ki ga kikanai</span></p><p begin="55.384" end="56.985" itunes:key="L10" ttm:agent="v1"><span begin="55.384" end="55.649">ま</span><span begin="55.649" end="55.878">っ</span><span begin="55.878" end="56.111">す</span><span begin="56.111" end="56.425">ぐ</span><span begin="56.425" end="56.671">火</span><span begin="56.671" end="56.887">力</span><span begin="56.887" end="56.985">で</span><span ttm:role="x-translation" xml:lang="zh-Hans">一味靠火力硬上</span><span ttm:role="x-roman">massugu karyoku de</span></p><p begin="57.343" end="58.955" itunes:key="L11" ttm:agent="v1"><span begin="57.343" end="57.600">と</span><span begin="57.600" end="57.840">に</span><span begin="57.840" end="58.084">か</span><span begin="58.084" end="58.307">く</span><span begin="58.307" end="58.516">速</span><span begin="58.516" end="58.804">度</span><span begin="58.804" end="58.955">で</span><span ttm:role="x-translation" xml:lang="zh-Hans">总之用速度说话</span><span ttm:role="x-roman">tonikaku sokudo de</span></p><p begin="59.278" end="1:01.028" itunes:key="L12" ttm:agent="v1"><span begin="59.278" end="59.523">ま</span><span begin="59.523" end="59.780">あ</span><span begin="59.780" end="59.893">負</span><span begin="59.893" end="1:00.012">け</span><span begin="1:00.012" end="1:00.300">な</span><span begin="1:00.300" end="1:00.478">い</span><span begin="1:00.478" end="1:00.701">け</span><span begin="1:00.701" end="1:00.832">ど</span><span begin="1:00.832" end="1:01.028">ね</span><span ttm:role="x-translation" xml:lang="zh-Hans">嘛，反正我也不会输就是了</span><span ttm:role="x-roman">maa makenai kedo ne</span></p><p begin="1:01.260" end="1:02.931" itunes:key="L13" ttm:agent="v1"><span begin="1:01.260" end="1:01.487">つ</span><span begin="1:01.487" end="1:01.697">い</span><span begin="1:01.697" end="1:01.954">で</span><span begin="1:01.954" end="1:02.194">に</span><span begin="1:02.194" end="1:02.452">決</span><span begin="1:02.452" end="1:02.644">め</span><span begin="1:02.644" end="1:02.761">ち</span><span begin="1:02.761" end="1:02.844">ゃ</span><span begin="1:02.844" end="1:02.931">え</span><span ttm:role="x-translation" xml:lang="zh-Hans">顺便把事情了结掉吧</span><span ttm:role="x-roman">tsuide ni kimechae</span></p><p begin="1:03.205" end="1:04.815" itunes:key="L14" ttm:agent="v1"><span begin="1:03.205" end="1:03.681">今</span><span begin="1:03.681" end="1:03.907">夜</span><span begin="1:03.907" end="1:04.130">の</span><span begin="1:04.130" end="1:04.388">い</span><span begin="1:04.388" end="1:04.615">ろ</span><span begin="1:04.615" end="1:04.715">い</span><span begin="1:04.715" end="1:04.815">ろ</span><span ttm:role="x-translation" xml:lang="zh-Hans">今晚的种种——</span><span ttm:role="x-roman">kon&apos;ya no iroiro</span></p><p begin="1:05.112" end="1:06.835" itunes:key="L15" ttm:agent="v1"><span begin="1:05.112" end="1:05.387">い</span><span begin="1:05.387" end="1:05.640">ろ</span><span begin="1:05.640" end="1:05.868">い</span><span begin="1:05.868" end="1:06.094">ろ</span><span begin="1:06.094" end="1:06.208">っ</span><span begin="1:06.208" end="1:06.310">て</span><span begin="1:06.310" end="1:06.426">な</span><span begin="1:06.426" end="1:06.605">ん</span><span begin="1:06.605" end="1:06.797">だ</span><span begin="1:06.797" end="1:06.835">ろ</span><span ttm:role="x-translation" xml:lang="zh-Hans">……种种是指什么呢</span><span ttm:role="x-roman">iroiro tte nandaro</span></p><p begin="1:07.070" end="1:08.318" itunes:key="L16" ttm:agent="v1"><span begin="1:07.070" end="1:07.545">曖</span><span begin="1:07.545" end="1:08.112">昧</span><span begin="1:08.112" end="1:08.452">で</span><span ttm:role="x-translation" xml:lang="zh-Hans">暧昧的</span><span ttm:role="x-roman">aimai de</span></p><p begin="1:08.318" end="1:09.753" itunes:key="L17" ttm:agent="v1"><span begin="1:08.318" end="1:08.515">い</span><span begin="1:08.807" end="1:09.043">い</span><span begin="1:09.043" end="1:09.280">加</span><span begin="1:09.280" end="1:09.516">減</span><span begin="1:09.516" end="1:09.753">な</span><span ttm:role="x-translation" xml:lang="zh-Hans">敷衍的</span><span ttm:role="x-roman">iikagen na</span></p><p begin="1:10.131" end="1:11.139" itunes:key="L18" ttm:agent="v1"><span begin="1:10.131" end="1:10.383">幻</span><span begin="1:10.383" end="1:10.635">想</span><span begin="1:10.635" end="1:10.887">な</span><span begin="1:10.887" end="1:11.139">ら</span><span ttm:role="x-translation" xml:lang="zh-Hans">如果只是幻想</span><span ttm:role="x-roman">gensou nara</span></p><p begin="1:11.739" end="1:13.627" itunes:key="L19" ttm:agent="v1"><span begin="1:11.739" end="1:12.044">き</span><span begin="1:12.044" end="1:12.331">ま</span><span begin="1:12.331" end="1:12.631">り</span><span begin="1:12.631" end="1:13.004">ご</span><span begin="1:13.004" end="1:13.272">と</span><span begin="1:13.272" end="1:13.627">で</span><span ttm:role="x-translation" xml:lang="zh-Hans">就不靠什么规矩</span><span ttm:role="x-roman">kimarigoto de</span></p><p begin="1:13.731" end="1:14.920" itunes:key="L20" ttm:agent="v1"><span begin="1:13.731" end="1:13.969">た</span><span begin="1:13.969" end="1:14.207">よ</span><span begin="1:14.207" end="1:14.444">ら</span><span begin="1:14.444" end="1:14.682">な</span><span begin="1:14.682" end="1:14.920">い</span><span ttm:role="x-translation" xml:lang="zh-Hans">也不去依赖</span><span ttm:role="x-roman">tayoranai</span></p><p begin="1:15.074" end="1:22.854" itunes:key="L21" ttm:agent="v1"><span begin="1:15.074" end="1:15.346">そ</span><span begin="1:15.346" end="1:15.685">れ</span><span begin="1:15.685" end="1:15.951">で</span><span begin="1:15.951" end="1:16.305">も</span><span begin="1:16.305" end="1:16.678">す</span><span begin="1:16.678" end="1:16.945">こ</span><span begin="1:16.945" end="1:17.285">し</span><span begin="1:17.285" end="1:17.605">ず</span><span begin="1:17.605" end="1:17.871">つ</span><span begin="1:17.871" end="1:18.079">当</span><span begin="1:18.079" end="1:18.418">た</span><span begin="1:18.418" end="1:18.988">り</span><span begin="1:18.988" end="1:19.463">前</span><span begin="1:19.463" end="1:20.006">を</span><span begin="1:20.006" end="1:20.224">積</span><span begin="1:20.224" end="1:20.456">み</span><span begin="1:20.456" end="1:20.788">上</span><span begin="1:20.788" end="1:21.150">げ</span><span begin="1:21.150" end="1:21.383">て</span><span begin="1:21.383" end="1:21.695">い</span><span begin="1:21.695" end="1:22.854">く</span><span ttm:role="x-translation" xml:lang="zh-Hans">即便如此，还是一点一点地积累着理所当然</span><span ttm:role="x-roman">soredemo sukoshi zutsu atarimae o tsumiageteyuku</span></p><p begin="1:23.624" end="1:26.242" itunes:key="L22" ttm:agent="v1"><span begin="1:23.624" end="1:23.823">そ</span><span begin="1:23.823" end="1:24.021">れ</span><span begin="1:24.021" end="1:24.273">は</span><span begin="1:24.273" end="1:24.652">き</span><span begin="1:24.652" end="1:24.856">っ</span><span begin="1:24.856" end="1:26.242">と</span><span ttm:role="x-translation" xml:lang="zh-Hans">那一定是</span><span ttm:role="x-roman">sore wa kitto</span></p><p begin="1:26.574" end="1:30.331" itunes:key="L23" ttm:agent="v1"><span begin="1:26.574" end="1:27.175">不</span><span begin="1:27.175" end="1:27.529">思</span><span begin="1:27.529" end="1:27.796">議</span><span begin="1:27.796" end="1:28.237">で</span><span begin="1:28.237" end="1:28.630">も</span><span begin="1:28.630" end="1:28.916">な</span><span begin="1:28.916" end="1:30.331">い</span><span ttm:role="x-translation" xml:lang="zh-Hans">并不不可思议的</span><span ttm:role="x-roman">fushigi demo nai</span></p><p begin="1:30.658" end="1:33.860" itunes:key="L24" ttm:agent="v1"><span begin="1:30.658" end="1:31.015">何</span><span begin="1:31.015" end="1:31.349">も</span><span begin="1:31.349" end="1:31.601">変</span><span begin="1:31.601" end="1:31.941">わ</span><span begin="1:31.941" end="1:32.328">ら</span><span begin="1:32.328" end="1:32.561">な</span><span begin="1:32.561" end="1:33.860">い</span><span ttm:role="x-translation" xml:lang="zh-Hans">什么都没有改变的</span><span ttm:role="x-roman">nani mo kawaranai</span></p><p begin="1:34.071" end="1:39.680" itunes:key="L25" ttm:agent="v1"><span begin="1:34.071" end="1:34.430">い</span><span begin="1:34.430" end="1:34.711">つ</span><span begin="1:34.711" end="1:35.104">も</span><span begin="1:35.104" end="1:35.477">通</span><span begin="1:35.477" end="1:35.724">り</span><span begin="1:35.724" end="1:36.272">の</span><span begin="1:36.272" end="1:36.456">あ</span><span begin="1:36.456" end="1:36.689">り</span><span begin="1:36.689" end="1:37.358">ふ</span><span begin="1:37.358" end="1:37.591">れ</span><span begin="1:37.591" end="1:38.013">た</span><span begin="1:38.013" end="1:38.594">景</span><span begin="1:38.594" end="1:38.988">色</span><span begin="1:38.988" end="1:39.375">の</span><span begin="1:39.375" end="1:39.680">中</span><span ttm:role="x-translation" xml:lang="zh-Hans">一如往常的、平凡至极的景色之中</span><span ttm:role="x-roman">itsumo doori no arifureta keshiki no naka</span></p><p begin="1:40.137" end="1:45.922" itunes:key="L26" ttm:agent="v1"><span begin="1:40.137" end="1:40.337">で</span><span begin="1:40.337" end="1:40.604">も</span><span begin="1:40.604" end="1:42.285">ね</span><span begin="1:42.285" end="1:42.727">不</span><span begin="1:42.727" end="1:43.115">思</span><span begin="1:43.115" end="1:43.455">議</span><span begin="1:43.455" end="1:43.829">な</span><span begin="1:43.829" end="1:44.235">も</span><span begin="1:44.235" end="1:44.570">の</span><span begin="1:44.570" end="1:45.922">ね</span><span ttm:role="x-translation" xml:lang="zh-Hans">但是呢，说来也奇妙</span><span ttm:role="x-roman">demo ne fushigi na mono ne</span></p><p begin="1:46.118" end="1:49.402" itunes:key="L27" ttm:agent="v1"><span begin="1:46.118" end="1:46.333">振</span><span begin="1:46.333" end="1:46.619">り</span><span begin="1:46.619" end="1:46.997">返</span><span begin="1:46.997" end="1:47.200">っ</span><span begin="1:47.200" end="1:47.555">て</span><span begin="1:47.555" end="1:47.909">み</span><span begin="1:47.909" end="1:48.161">れ</span><span begin="1:48.161" end="1:49.402">ば</span><span ttm:role="x-translation" xml:lang="zh-Hans">回头看看的话</span><span ttm:role="x-roman">furikaette mireba</span></p><p begin="1:49.589" end="1:57.933" itunes:key="L28" ttm:agent="v1"><span begin="1:49.589" end="1:49.997">い</span><span begin="1:49.997" end="1:50.282">つ</span><span begin="1:50.282" end="1:50.709">の</span><span begin="1:50.709" end="1:51.082">間</span><span begin="1:51.082" end="1:51.329">に</span><span begin="1:51.329" end="1:51.825">か</span><span begin="1:51.825" end="1:52.043">ちょ</span><span begin="1:52.043" end="1:52.310">っ</span><span begin="1:52.310" end="1:53.027">と</span><span begin="1:53.027" end="1:53.245">だ</span><span begin="1:53.245" end="1:53.619">け</span><span begin="1:53.619" end="1:54.220">狭</span><span begin="1:54.220" end="1:54.714">く</span><span begin="1:54.714" end="1:55.045">な</span><span begin="1:55.045" end="1:55.223">っ</span><span begin="1:55.223" end="1:55.790">た…</span><span begin="1:55.790" end="1:55.950">か</span><span begin="1:55.950" end="1:56.237">も</span><span begin="1:56.237" end="1:57.933">ね。</span><span ttm:role="x-translation" xml:lang="zh-Hans">不知不觉间，距离似乎稍微变近了一些……也许吧。</span><span ttm:role="x-roman">itsu no ma ni ka chotto dake semaku natta... kamo ne.</span></p><p begin="1:58.901" end="2:02.946" itunes:key="L29" ttm:agent="v1"><span begin="1:58.901" end="1:59.115">何</span><span begin="1:59.115" end="1:59.604">も</span><span begin="1:59.604" end="2:00.012">約</span><span begin="2:00.012" end="2:00.519">束</span><span begin="2:00.519" end="2:00.847">す</span><span begin="2:00.847" end="2:01.223">る</span><span begin="2:01.223" end="2:01.456">こ</span><span begin="2:01.456" end="2:01.690">と</span><span begin="2:01.690" end="2:01.937">な</span><span begin="2:01.937" end="2:02.152">ん</span><span begin="2:02.152" end="2:02.304">て</span><span begin="2:02.304" end="2:02.519">な</span><span begin="2:02.519" end="2:02.946">い</span><span ttm:role="x-translation" xml:lang="zh-Hans">没有任何需要约定的事</span><span ttm:role="x-roman">nani mo yakusoku suru koto nante nai</span></p><p begin="2:04.005" end="2:06.948" itunes:key="L30" ttm:agent="v1"><span begin="2:04.005" end="2:04.277">ひ</span><span begin="2:04.277" end="2:04.490">と</span><span begin="2:04.490" end="2:04.750">こ</span><span begin="2:04.750" end="2:04.975">と</span><span begin="2:04.975" end="2:05.397">だ</span><span begin="2:05.397" end="2:05.624">っ</span><span begin="2:05.624" end="2:05.930">て</span><span begin="2:05.930" end="2:06.177">必</span><span begin="2:06.177" end="2:06.410">要</span><span begin="2:06.410" end="2:06.785">な</span><span begin="2:06.785" end="2:06.948">い</span><span ttm:role="x-translation" xml:lang="zh-Hans">一句话都不必多说</span><span ttm:role="x-roman">hitokoto datte hitsuyou nai</span></p><p begin="2:07.180" end="2:11.273" itunes:key="L31" ttm:agent="v1"><span begin="2:07.180" end="2:07.427">あ</span><span begin="2:07.427" end="2:07.558">ん</span><span begin="2:07.558" end="2:07.669">た</span><span begin="2:07.669" end="2:07.936">は</span><span begin="2:07.936" end="2:08.172">ま</span><span begin="2:08.172" end="2:08.402">た</span><span begin="2:08.402" end="2:08.862">明</span><span begin="2:08.862" end="2:09.202">日</span><span begin="2:09.202" end="2:09.576">も</span><span begin="2:09.576" end="2:09.770">や</span><span begin="2:09.770" end="2:09.875">っ</span><span begin="2:09.875" end="2:10.370">て</span><span begin="2:10.370" end="2:10.603">く</span><span begin="2:10.603" end="2:11.273">る</span><span ttm:role="x-translation" xml:lang="zh-Hans">你明天又会照常跑来的</span><span ttm:role="x-roman">anta wa mata ashita mo yattekuru</span></p><p begin="2:11.611" end="2:14.646" itunes:key="L32" ttm:agent="v1"><span begin="2:11.611" end="2:11.863">そ</span><span begin="2:11.863" end="2:12.095">う</span><span begin="2:12.095" end="2:12.362">い</span><span begin="2:12.362" end="2:12.595">う</span><span begin="2:12.595" end="2:12.937">こ</span><span begin="2:12.937" end="2:13.308">と</span><span begin="2:13.308" end="2:13.574">に</span><span begin="2:13.574" end="2:13.861">な</span><span begin="2:13.861" end="2:14.015">っ</span><span begin="2:14.015" end="2:14.268">て</span><span begin="2:14.268" end="2:14.413">い</span><span begin="2:14.413" end="2:14.646">る</span><span ttm:role="x-translation" xml:lang="zh-Hans">就是这么回事</span><span ttm:role="x-roman">sou iu koto ni natte iru</span></p><p begin="2:14.787" end="2:15.450" itunes:key="L33" ttm:agent="v1"><span begin="2:14.787" end="2:15.039">そ</span><span begin="2:15.039" end="2:15.150">う</span><span begin="2:15.150" end="2:15.258">で</span><span begin="2:15.258" end="2:15.354">しょ</span><span begin="2:15.354" end="2:15.450">う？</span><span ttm:role="x-translation" xml:lang="zh-Hans">——对吧？</span><span ttm:role="x-roman">sou deshou?</span></p><p begin="2:33.314" end="2:34.817" itunes:key="L34" ttm:agent="v1"><span begin="2:33.314" end="2:33.478">い</span><span begin="2:33.478" end="2:33.658">つ</span><span begin="2:33.658" end="2:33.857">か</span><span begin="2:33.857" end="2:34.055">ら</span><span begin="2:34.055" end="2:34.220">こ</span><span begin="2:34.220" end="2:34.385">う</span><span begin="2:34.385" end="2:34.478">し</span><span begin="2:34.478" end="2:34.817">て</span><span ttm:role="x-translation" xml:lang="zh-Hans">从何时起就这样了</span><span ttm:role="x-roman">itsu kara kou shite</span></p><p begin="2:34.821" end="2:36.619" itunes:key="L35" ttm:agent="v1"><span begin="2:34.821" end="2:35.077">い</span><span begin="2:35.077" end="2:35.272">つ</span><span begin="2:35.272" end="2:35.510">ま</span><span begin="2:35.510" end="2:35.756">で</span><span begin="2:35.756" end="2:35.989">こ</span><span begin="2:35.989" end="2:36.223">う</span><span begin="2:36.223" end="2:36.368">し</span><span begin="2:36.368" end="2:36.619">て</span><span ttm:role="x-translation" xml:lang="zh-Hans">又要这样到何时</span><span ttm:role="x-roman">itsu made kou shite</span></p><p begin="2:36.787" end="2:38.506" itunes:key="L36" ttm:agent="v1"><span begin="2:36.787" end="2:36.859">そ</span><span begin="2:36.859" end="2:37.313">ん</span><span begin="2:37.313" end="2:37.512">な</span><span begin="2:37.512" end="2:37.745">の</span><span begin="2:37.745" end="2:37.963">ど</span><span begin="2:37.963" end="2:38.195">う</span><span begin="2:38.195" end="2:38.375">し</span><span begin="2:38.375" end="2:38.506">て</span><span ttm:role="x-translation" xml:lang="zh-Hans">这种事为什么——</span><span ttm:role="x-roman">sonna no doushite</span></p><p begin="2:38.731" end="2:40.263" itunes:key="L37" ttm:agent="v1"><span begin="2:38.731" end="2:39.019">問</span><span begin="2:39.019" end="2:39.218">え</span><span begin="2:39.218" end="2:39.417">な</span><span begin="2:39.417" end="2:39.717">い</span><span begin="2:39.717" end="2:39.951">関</span><span begin="2:39.951" end="2:40.263">係</span><span ttm:role="x-translation" xml:lang="zh-Hans">是无法开口去问的关系</span><span ttm:role="x-roman">toenai kankei</span></p><p begin="2:40.606" end="2:42.571" itunes:key="L38" ttm:agent="v1"><span begin="2:40.606" end="2:40.873">勝</span><span begin="2:40.873" end="2:41.315">利</span><span begin="2:41.315" end="2:41.586">者</span> <span begin="2:41.586" end="2:41.867">負</span><span begin="2:41.867" end="2:42.099">け</span><span begin="2:42.099" end="2:42.571">犬</span><span ttm:role="x-translation" xml:lang="zh-Hans">胜者与败犬</span><span ttm:role="x-roman">shourisha makeinu</span></p><p begin="2:42.574" end="2:44.343" itunes:key="L39" ttm:agent="v1"><span begin="2:42.574" end="2:43.112">休</span><span begin="2:43.112" end="2:43.306">ま</span><span begin="2:43.306" end="2:43.524">せ</span><span begin="2:43.524" end="2:43.790">休</span><span begin="2:43.790" end="2:44.023">ま</span><span begin="2:44.023" end="2:44.135">さ</span><span begin="2:44.135" end="2:44.343">れ</span><span ttm:role="x-translation" xml:lang="zh-Hans">让人歇、被人拦</span><span ttm:role="x-roman">yasumase yasumasare</span></p><p begin="2:44.820" end="2:46.352" itunes:key="L40" ttm:agent="v1"><span begin="2:44.820" end="2:45.213">夜</span><span begin="2:45.213" end="2:45.480">を</span><span begin="2:45.480" end="2:45.698">駆</span><span begin="2:45.698" end="2:45.930">け</span><span begin="2:45.930" end="2:46.130">た</span><span begin="2:46.130" end="2:46.255">な</span><span begin="2:46.255" end="2:46.352">ら</span><span ttm:role="x-translation" xml:lang="zh-Hans">若奔驰过夜晚的话</span><span ttm:role="x-roman">yoru o kaketanara</span></p><p begin="2:46.688" end="2:48.254" itunes:key="L41" ttm:agent="v1"><span begin="2:46.688" end="2:46.921">ま</span><span begin="2:46.921" end="2:47.192">た</span><span begin="2:47.192" end="2:47.424">日</span><span begin="2:47.424" end="2:47.576">だ</span><span begin="2:47.576" end="2:47.658">っ</span><span begin="2:47.658" end="2:47.856">て</span><span begin="2:47.856" end="2:48.088">昇</span><span begin="2:48.088" end="2:48.254">る</span><span ttm:role="x-translation" xml:lang="zh-Hans">太阳也自然会再升起</span><span ttm:role="x-roman">mata hi datte noboru</span></p><p begin="2:48.510" end="2:50.085" itunes:key="L42" ttm:agent="v1"><span begin="2:48.510" end="2:48.883">意</span><span begin="2:48.883" end="2:49.048">味</span><span begin="2:49.048" end="2:49.246">な</span><span begin="2:49.246" end="2:49.426">し</span><span begin="2:49.426" end="2:49.678">の</span><span begin="2:49.678" end="2:49.893">視</span><span begin="2:49.893" end="2:50.085">線</span><span ttm:role="x-translation" xml:lang="zh-Hans">毫无意义的视线</span><span ttm:role="x-roman">imi nashi no shisen</span></p><p begin="2:50.363" end="2:52.103" itunes:key="L43" ttm:agent="v1"><span begin="2:50.363" end="2:50.649">な</span><span begin="2:50.649" end="2:50.867">に</span><span begin="2:50.867" end="2:51.133">げ</span><span begin="2:51.133" end="2:51.347">な</span><span begin="2:51.347" end="2:51.619">い</span><span begin="2:51.619" end="2:51.813">笑</span><span begin="2:51.813" end="2:52.103">顔</span><span ttm:role="x-translation" xml:lang="zh-Hans">漫不经心的笑容</span><span ttm:role="x-roman">nanigenai egao</span></p><p begin="2:52.332" end="2:53.908" itunes:key="L44" ttm:agent="v1"><span begin="2:52.332" end="2:52.584">た</span><span begin="2:52.584" end="2:52.778">た</span><span begin="2:52.778" end="2:53.030">け</span><span begin="2:53.030" end="2:53.335">る</span><span begin="2:53.335" end="2:53.515">軽</span><span begin="2:53.515" end="2:53.908">口</span><span ttm:role="x-translation" xml:lang="zh-Hans">随口甩出的玩笑话</span><span ttm:role="x-roman">tatakeru karukuchi</span></p><p begin="2:54.201" end="2:56.029" itunes:key="L45" ttm:agent="v1"><span begin="2:54.201" end="2:54.560">い</span><span begin="2:54.560" end="2:54.773">き</span><span begin="2:54.773" end="2:55.006">お</span><span begin="2:55.006" end="2:55.257">い</span><span begin="2:55.257" end="2:55.543">の</span><span begin="2:55.543" end="2:55.844">権</span><span begin="2:55.844" end="2:56.029">化</span><span ttm:role="x-translation" xml:lang="zh-Hans">气势的化身</span><span ttm:role="x-roman">ikioi no gonge</span></p><p begin="2:56.248" end="2:58.003" itunes:key="L46" ttm:agent="v1"><span begin="2:56.248" end="2:56.514">ぶ</span><span begin="2:56.514" end="2:56.747">つ</span><span begin="2:56.747" end="2:56.999">け</span><span begin="2:56.999" end="2:57.213">ら</span><span begin="2:57.213" end="2:57.431">れ</span><span begin="2:57.431" end="2:57.697">挑</span><span begin="2:57.697" end="2:58.003">戦</span><span ttm:role="x-translation" xml:lang="zh-Hans">劈头砸来的挑战</span><span ttm:role="x-roman">butsukerare chousen</span></p><p begin="2:58.273" end="2:59.980" itunes:key="L47" ttm:agent="v1"><span begin="2:58.273" end="2:58.544">た</span><span begin="2:58.544" end="2:58.724">た</span><span begin="2:58.724" end="2:58.938">か</span><span begin="2:58.938" end="2:59.155">え</span><span begin="2:59.155" end="2:59.408">る</span><span begin="2:59.408" end="2:59.674">意</span><span begin="2:59.674" end="2:59.980">見</span><span ttm:role="x-translation" xml:lang="zh-Hans">针锋相对的意见</span><span ttm:role="x-roman">tatakaeru iken</span></p><p begin="3:00.168" end="3:02.601" itunes:key="L48" ttm:agent="v1"><span begin="3:00.168" end="3:00.440">手</span><span begin="3:00.440" end="3:00.672">の</span><span begin="3:00.672" end="3:00.886">込</span><span begin="3:00.886" end="3:01.172">ん</span><span begin="3:01.172" end="3:01.390">だ</span><span begin="3:01.390" end="3:01.705">論</span><span begin="3:01.705" end="3:02.078">駁</span> <span begin="3:02.078" end="3:02.224">の</span><span begin="3:02.224" end="3:02.354">前</span><span begin="3:02.354" end="3:02.601">に</span><span ttm:role="x-translation" xml:lang="zh-Hans">精心构筑的反驳——之前</span><span ttm:role="x-roman">te no konda ronbaku no mae ni</span></p><p begin="3:02.601" end="3:19.987" itunes:key="L49" ttm:agent="v1"><span begin="3:02.601" end="3:02.853">今</span><span begin="3:02.853" end="3:03.081">度</span><span begin="3:03.081" end="3:03.333">は</span><span begin="3:03.333" end="3:03.551">わ</span><span begin="3:03.551" end="3:03.682">た</span><span begin="3:03.682" end="3:04.016">し</span><span begin="3:04.016" end="3:04.302">が</span><span begin="3:04.302" end="3:04.608">手</span><span begin="3:04.608" end="3:05.029">を</span><span begin="3:05.029" end="3:05.262">出</span><span begin="3:05.262" end="3:07.502">す！</span><span ttm:role="x-translation" xml:lang="zh-Hans">这次轮到我先出手了！</span><span ttm:role="x-roman">kondo wa watashi ga te o dasu!</span></p><p begin="3:19.987" end="3:21.848" itunes:key="L50" ttm:agent="v1"><span begin="3:19.987" end="3:20.554">大</span><span begin="3:20.554" end="3:20.875">切</span><span begin="3:20.875" end="3:21.213">な</span><span begin="3:21.213" end="3:21.568">も</span><span begin="3:21.568" end="3:21.766">の</span><span begin="3:21.766" end="3:21.848">は</span><span ttm:role="x-translation" xml:lang="zh-Hans">重要的东西</span><span ttm:role="x-roman">taisetsu na mono wa</span></p><p begin="3:22.255" end="3:23.755" itunes:key="L51" ttm:agent="v1"><span begin="3:22.255" end="3:22.609">言</span><span begin="3:22.609" end="3:22.862">葉</span><span begin="3:22.862" end="3:23.095">じゃ</span><span begin="3:23.095" end="3:23.327">な</span><span begin="3:23.327" end="3:23.526">く</span><span begin="3:23.526" end="3:23.755">て</span><span ttm:role="x-translation" xml:lang="zh-Hans">不是言语</span><span ttm:role="x-roman">kotoba ja nakute</span></p><p begin="3:24.141" end="3:25.527" itunes:key="L52" ttm:agent="v1"><span begin="3:24.141" end="3:24.462">言</span><span begin="3:24.462" end="3:25.145">葉</span><span begin="3:25.145" end="3:25.465">よ</span><span begin="3:25.465" end="3:25.527">り</span><span ttm:role="x-translation" xml:lang="zh-Hans">而是比言语</span><span ttm:role="x-roman">kotoba yori</span></p><p begin="3:25.745" end="3:27.742" itunes:key="L53" ttm:agent="v1"><span begin="3:25.745" end="3:26.133">不</span><span begin="3:26.133" end="3:26.455">確</span><span begin="3:26.455" end="3:26.705">か</span><span begin="3:26.705" end="3:26.938">な</span><span begin="3:26.938" end="3:27.243">も</span><span begin="3:27.243" end="3:27.457">の</span><span begin="3:27.457" end="3:27.742">で</span><span ttm:role="x-translation" xml:lang="zh-Hans">更不确定的什么</span><span ttm:role="x-roman">futashika na mono de</span></p><p begin="3:28.089" end="3:31.783" itunes:key="L54" ttm:agent="v1"><span begin="3:28.089" end="3:28.410">代</span><span begin="3:28.410" end="3:28.681">わ</span><span begin="3:28.681" end="3:29.049">り</span><span begin="3:29.049" end="3:29.389">に</span><span begin="3:29.389" end="3:29.655">置</span><span begin="3:29.655" end="3:29.975">き</span><span begin="3:29.975" end="3:30.295">置</span><span begin="3:30.295" end="3:30.460">い</span><span begin="3:30.460" end="3:30.659">て</span><span begin="3:30.659" end="3:31.013">か</span><span begin="3:31.013" end="3:31.394">れ</span><span begin="3:31.394" end="3:31.605">て</span><span begin="3:31.605" end="3:31.783">く</span><span ttm:role="x-translation" xml:lang="zh-Hans">被一件件留置在此、取而代之的</span><span ttm:role="x-roman">kawari ni okioite kareteku</span></p><p begin="3:32.067" end="3:35.524" itunes:key="L55" ttm:agent="v1"><span begin="3:32.067" end="3:32.580">幻</span><span begin="3:32.580" end="3:33.787">想</span><span begin="3:33.787" end="3:34.074">の</span><span begin="3:34.074" end="3:34.321">お</span><span begin="3:34.321" end="3:34.452">も</span><span begin="3:34.452" end="3:35.524">さ</span><span ttm:role="x-translation" xml:lang="zh-Hans">是幻想的重量</span><span ttm:role="x-roman">gensou no omosa</span></p><p begin="3:36.409" end="3:38.943" itunes:key="L56" ttm:agent="v1"><span begin="3:36.409" end="3:37.033">空</span><span begin="3:37.033" end="3:37.224">の</span><span begin="3:37.224" end="3:37.479">む</span><span begin="3:37.479" end="3:37.757">こ</span><span begin="3:37.757" end="3:38.943">う</span><span ttm:role="x-translation" xml:lang="zh-Hans">天空的那一边</span><span ttm:role="x-roman">sora no mukou</span></p><p begin="3:39.137" end="3:42.740" itunes:key="L57" ttm:agent="v1"><span begin="3:39.137" end="3:39.457">不</span><span begin="3:39.457" end="3:40.000">思</span><span begin="3:40.000" end="3:40.479">議</span><span begin="3:40.479" end="3:40.732">で</span><span begin="3:40.732" end="3:41.052">も</span><span begin="3:41.052" end="3:41.333">な</span><span begin="3:41.333" end="3:42.740">い</span><span ttm:role="x-translation" xml:lang="zh-Hans">并不不可思议</span><span ttm:role="x-roman">fushigi demo nai</span></p><p begin="3:43.068" end="3:46.256" itunes:key="L58" ttm:agent="v1"><span begin="3:43.068" end="3:43.321">影</span><span begin="3:43.321" end="3:43.679">ひ</span><span begin="3:43.679" end="3:44.048">と</span><span begin="3:44.048" end="3:44.280">つ</span><span begin="3:44.280" end="3:44.601">も</span><span begin="3:44.601" end="3:44.993">な</span><span begin="3:44.993" end="3:46.256">い</span><span ttm:role="x-translation" xml:lang="zh-Hans">连一道影子都没有的</span><span ttm:role="x-roman">kage hitotsu mo nai</span></p><p begin="3:46.474" end="3:52.155" itunes:key="L59" ttm:agent="v1"><span begin="3:46.474" end="3:46.739">き</span><span begin="3:46.739" end="3:46.881">っ</span><span begin="3:46.881" end="3:47.202">と</span><span begin="3:47.202" end="3:47.560">退</span><span begin="3:47.560" end="3:47.929">屈</span><span begin="3:47.929" end="3:48.704">で</span><span begin="3:48.704" end="3:49.013">ず</span><span begin="3:49.013" end="3:49.179">っ</span><span begin="3:49.179" end="3:49.902">と</span><span begin="3:49.902" end="3:50.149">静</span><span begin="3:50.149" end="3:50.523">か</span><span begin="3:50.523" end="3:50.876">な</span><span begin="3:50.876" end="3:51.128">毎</span><span begin="3:51.128" end="3:52.155">日</span><span ttm:role="x-translation" xml:lang="zh-Hans">一定是无聊的、一直安静的每一天</span><span ttm:role="x-roman">kitto taikutsu de zutto shizuka na mainichi</span></p><p begin="3:52.200" end="3:58.369" itunes:key="L60" ttm:agent="v1"><span begin="3:52.200" end="3:52.857">で</span><span begin="3:52.857" end="3:53.070">も</span><span begin="3:53.070" end="3:54.801">ね</span><span begin="3:54.801" end="3:55.246">不</span><span begin="3:55.246" end="3:55.635">思</span><span begin="3:55.635" end="3:55.935">議</span><span begin="3:55.935" end="3:56.342">な</span><span begin="3:56.342" end="3:56.715">も</span><span begin="3:56.715" end="3:56.968">の</span><span begin="3:56.968" end="3:58.369">ね</span><span ttm:role="x-translation" xml:lang="zh-Hans">但是呢，说来也奇妙</span><span ttm:role="x-roman">demo ne fushigi na mono ne</span></p><p begin="3:58.717" end="4:01.973" itunes:key="L61" ttm:agent="v1"><span begin="3:58.717" end="3:58.994">思</span><span begin="3:58.994" end="3:59.358">い</span><span begin="3:59.358" end="3:59.668">返</span><span begin="3:59.668" end="3:59.882">し</span><span begin="3:59.882" end="4:00.214">て</span><span begin="4:00.214" end="4:00.622">み</span><span begin="4:00.622" end="4:00.838">れ</span><span begin="4:00.838" end="4:01.973">ば</span><span ttm:role="x-translation" xml:lang="zh-Hans">仔细回想的话</span><span ttm:role="x-roman">omoikaeshite mireba</span></p><p begin="4:02.196" end="4:11.540" itunes:key="L62" ttm:agent="v1"><span begin="4:02.196" end="4:02.498">い</span><span begin="4:02.498" end="4:02.764">つ</span><span begin="4:02.764" end="4:03.156">の</span><span begin="4:03.156" end="4:03.564">間</span><span begin="4:03.564" end="4:03.797">に</span><span begin="4:03.797" end="4:04.311">か</span><span begin="4:04.311" end="4:04.524">ちょ</span><span begin="4:04.524" end="4:04.777">っ</span><span begin="4:04.777" end="4:05.494">と</span><span begin="4:05.494" end="4:05.765">さ</span><span begin="4:05.765" end="4:06.222">わ</span><span begin="4:06.222" end="4:06.473">が</span><span begin="4:06.473" end="4:06.740">し</span><span begin="4:06.740" end="4:07.113">く</span><span begin="4:07.113" end="4:07.504">な</span><span begin="4:07.504" end="4:07.715">っ</span><span begin="4:07.715" end="4:08.224">た…</span><span begin="4:08.224" end="4:08.529">か</span><span begin="4:08.529" end="4:08.708">も</span><span begin="4:08.708" end="4:11.540">ね。</span><span ttm:role="x-translation" xml:lang="zh-Hans">不知不觉间，似乎稍微变得喧闹了一些……也许吧。</span><span ttm:role="x-roman">itsu no ma ni ka chotto sawagashiku natta... kamo ne.</span></p><p begin="4:23.561" end="4:27.687" itunes:key="L63" ttm:agent="v1"><span begin="4:23.561" end="4:23.808">何</span><span begin="4:23.808" end="4:24.060">も</span><span begin="4:24.060" end="4:24.292">約</span><span begin="4:24.292" end="4:24.771">束</span><span begin="4:24.771" end="4:25.285">す</span><span begin="4:25.285" end="4:25.621">る</span><span begin="4:25.621" end="4:25.995">こ</span><span begin="4:25.995" end="4:26.261">と</span><span begin="4:26.261" end="4:26.494">な</span><span begin="4:26.494" end="4:26.746">ん</span><span begin="4:26.746" end="4:26.940">て</span><span begin="4:26.940" end="4:27.071">な</span><span begin="4:27.071" end="4:27.687">い</span><span ttm:role="x-translation" xml:lang="zh-Hans">没有任何需要约定的事</span><span ttm:role="x-roman">nani mo yakusoku suru koto nante nai</span></p><p begin="4:28.189" end="4:31.093" itunes:key="L64" ttm:agent="v1"><span begin="4:28.189" end="4:28.441">契</span><span begin="4:28.441" end="4:28.674">り</span><span begin="4:28.674" end="4:28.921">を</span><span begin="4:28.921" end="4:29.939">結</span><span begin="4:29.939" end="4:30.191">ぶ</span><span begin="4:30.191" end="4:30.404">こ</span><span begin="4:30.404" end="4:30.637">と</span><span begin="4:30.637" end="4:30.870">も</span><span begin="4:30.870" end="4:30.981">な</span><span begin="4:30.981" end="4:31.093">い</span><span ttm:role="x-translation" xml:lang="zh-Hans">也不必立下什么誓约</span><span ttm:role="x-roman">chigiri o musubu koto mo nai</span></p><p begin="4:31.373" end="4:35.509" itunes:key="L65" ttm:agent="v1"><span begin="4:31.373" end="4:31.664">な</span><span begin="4:31.664" end="4:31.803">ぜ</span><span begin="4:31.803" end="4:31.878">っ</span><span begin="4:31.878" end="4:32.110">て</span><span begin="4:32.110" end="4:32.358">そ</span><span begin="4:32.358" end="4:32.629">ん</span><span begin="4:32.629" end="4:32.862">な</span><span begin="4:32.862" end="4:33.095">の</span><span begin="4:33.095" end="4:33.366">ぜ</span><span begin="4:33.366" end="4:33.512">ん</span><span begin="4:33.512" end="4:33.793">ぜ</span><span begin="4:33.793" end="4:34.065">ん</span><span begin="4:34.065" end="4:34.297">意</span><span begin="4:34.297" end="4:34.530">味</span><span begin="4:34.530" end="4:34.709">が</span><span begin="4:34.709" end="4:34.835">な</span><span begin="4:34.835" end="4:35.509">い</span><span ttm:role="x-translation" xml:lang="zh-Hans">因为那种东西完全没有意义</span><span ttm:role="x-roman">naze tte sonna no zenzen imi ga nai</span></p><p begin="4:35.999" end="4:39.138" itunes:key="L66" ttm:agent="v1"><span begin="4:35.999" end="4:36.246">い</span><span begin="4:36.246" end="4:36.483">つ</span><span begin="4:36.483" end="4:36.750">の</span><span begin="4:36.750" end="4:36.983">間</span><span begin="4:36.983" end="4:37.322">に</span><span begin="4:37.322" end="4:37.657">や</span><span begin="4:37.657" end="4:37.909">ら</span><span begin="4:37.909" end="4:38.110">関</span><span begin="4:38.110" end="4:38.465">係</span><span begin="4:38.465" end="4:38.732">な</span><span begin="4:38.732" end="4:39.138">い</span><span ttm:role="x-translation" xml:lang="zh-Hans">不知不觉间已经无所谓了</span><span ttm:role="x-roman">itsu no ma ni yara kankei nai</span></p><p begin="4:39.180" end="4:39.868" itunes:key="L67" ttm:agent="v1"><span begin="4:39.180" end="4:39.412">だ</span><span begin="4:39.412" end="4:39.543">か</span><span begin="4:39.543" end="4:39.670">ら</span><span begin="4:39.670" end="4:39.868">ね</span><span ttm:role="x-translation" xml:lang="zh-Hans">所以呢</span><span ttm:role="x-roman">dakara ne</span></p><p begin="4:39.989" end="4:43.311" itunes:key="L68" ttm:agent="v1"><span begin="4:39.989" end="4:40.208">い</span><span begin="4:40.208" end="4:40.441">つ</span><span begin="4:40.441" end="4:40.620">も</span><span begin="4:40.620" end="4:40.887">の</span><span begin="4:40.887" end="4:41.224">よ</span><span begin="4:41.224" end="4:41.600">う</span><span begin="4:41.600" end="4:41.866">に</span><span begin="4:41.866" end="4:42.031">邪</span><span begin="4:42.031" end="4:42.332">魔</span><span begin="4:42.332" end="4:42.545">さ</span><span begin="4:42.545" end="4:42.710">れ</span><span begin="4:42.710" end="4:43.311">て</span><span ttm:role="x-translation" xml:lang="zh-Hans">一如既往地被捣乱</span><span ttm:role="x-roman">itsumo no you ni jama sarete</span></p><p begin="4:43.702" end="4:46.564" itunes:key="L69" ttm:agent="v1"><span begin="4:43.702" end="4:44.007">い</span><span begin="4:44.007" end="4:44.274">つ</span><span begin="4:44.274" end="4:44.491">も</span><span begin="4:44.491" end="4:44.739">の</span><span begin="4:44.739" end="4:45.078">よ</span><span begin="4:45.078" end="4:45.432">う</span><span begin="4:45.432" end="4:45.684">に</span><span begin="4:45.684" end="4:46.092">喧</span><span begin="4:46.092" end="4:46.344">嘩</span><span begin="4:46.344" end="4:46.489">し</span><span begin="4:46.489" end="4:46.564">て</span><span ttm:role="x-translation" xml:lang="zh-Hans">一如既往地吵架</span><span ttm:role="x-roman">itsumo no you ni kenka shite</span></p><p begin="4:46.851" end="4:50.996" itunes:key="L70" ttm:agent="v1"><span begin="4:46.851" end="4:47.103">そ</span><span begin="4:47.103" end="4:47.268">れ</span><span begin="4:47.268" end="4:47.359">で</span><span begin="4:47.359" end="4:47.627">も</span><span begin="4:47.627" end="4:47.913">い</span><span begin="4:47.913" end="4:48.165">つ</span><span begin="4:48.165" end="4:48.397">も</span><span begin="4:48.397" end="4:48.630">の</span><span begin="4:48.630" end="4:48.950">よ</span><span begin="4:48.950" end="4:49.338">う</span><span begin="4:49.338" end="4:49.571">に</span><span begin="4:49.571" end="4:49.871">や</span><span begin="4:49.871" end="4:50.032">っ</span><span begin="4:50.032" end="4:50.284">て</span><span begin="4:50.284" end="4:50.409">く</span><span begin="4:50.409" end="4:50.996">る</span><span ttm:role="x-translation" xml:lang="zh-Hans">即便如此还是一如既往地找上门来</span><span ttm:role="x-roman">soredemo itsumo no you ni yattekuru</span></p><p begin="4:51.470" end="4:54.458" itunes:key="L71" ttm:agent="v1"><span begin="4:51.470" end="4:51.741">そ</span><span begin="4:51.741" end="4:52.008">う</span><span begin="4:52.008" end="4:52.240">い</span><span begin="4:52.240" end="4:52.507">う</span><span begin="4:52.507" end="4:52.866">こ</span><span begin="4:52.866" end="4:53.254">と</span><span begin="4:53.254" end="4:53.506">に</span><span begin="4:53.506" end="4:53.815">な</span><span begin="4:53.815" end="4:53.981">っ</span><span begin="4:53.981" end="4:54.199">て</span><span begin="4:54.199" end="4:54.330">い</span><span begin="4:54.330" end="4:54.458">る</span><span ttm:role="x-translation" xml:lang="zh-Hans">就是这么回事</span><span ttm:role="x-roman">sou iu koto ni natte iru</span></p><p begin="4:54.640" end="4:55.220" itunes:key="L72" ttm:agent="v1"><span begin="4:54.640" end="4:54.888">そ</span><span begin="4:54.888" end="4:55.018">う</span><span begin="4:55.018" end="4:55.110">で</span><span begin="4:55.110" end="4:55.208">しょ</span><span begin="4:55.208" end="4:55.220">う？</span><span ttm:role="x-translation" xml:lang="zh-Hans">——对吧？</span><span ttm:role="x-roman">sou deshou?</span></p><p begin="4:55.528" end="4:58.640" itunes:key="L73" ttm:agent="v1"><span begin="4:55.528" end="4:55.815">た</span><span begin="4:55.815" end="4:56.079">と</span><span begin="4:56.079" end="4:56.339">え</span><span begin="4:56.339" end="4:56.864">明</span><span begin="4:56.864" end="4:57.254">日</span><span begin="4:57.254" end="4:57.519">が</span><span begin="4:57.519" end="4:57.945">最</span><span begin="4:57.945" end="4:58.223">後</span><span begin="4:58.223" end="4:58.344">で</span><span begin="4:58.344" end="4:58.640">も</span><span ttm:role="x-translation" xml:lang="zh-Hans">哪怕明天就是最后一天</span><span ttm:role="x-roman">tatoe ashita ga saigo demo</span></p><p begin="4:59.503" end="5:02.312" itunes:key="L74" ttm:agent="v1"><span begin="4:59.503" end="4:59.960">今</span><span begin="4:59.960" end="5:00.449">生</span><span begin="5:00.449" end="5:00.991">の</span><span begin="5:00.991" end="5:01.462">別</span><span begin="5:01.462" end="5:01.727">れ</span><span begin="5:01.727" end="5:01.924">の</span><span begin="5:01.924" end="5:02.140">日</span><span begin="5:02.140" end="5:02.261">で</span><span begin="5:02.261" end="5:02.312">も</span><span ttm:role="x-translation" xml:lang="zh-Hans">哪怕是今生诀别之日</span><span ttm:role="x-roman">konjou no wakare no hi demo</span></p><p begin="5:02.500" end="5:06.698" itunes:key="L75" ttm:agent="v1"><span begin="5:02.500" end="5:02.567">あ</span><span begin="5:02.567" end="5:02.913">ん</span><span begin="5:02.913" end="5:03.033">た</span><span begin="5:03.033" end="5:03.348">は</span><span begin="5:03.348" end="5:03.868">何</span><span begin="5:03.868" end="5:04.114">も</span><span begin="5:04.114" end="5:04.361">気</span><span begin="5:04.361" end="5:04.675">に</span><span begin="5:04.675" end="5:05.065">せ</span><span begin="5:05.065" end="5:05.348">ず</span><span begin="5:05.348" end="5:05.594">や</span><span begin="5:05.594" end="5:05.841">っ</span><span begin="5:05.841" end="5:06.043">て</span><span begin="5:06.043" end="5:06.159">く</span><span begin="5:06.159" end="5:06.698">る</span><span ttm:role="x-translation" xml:lang="zh-Hans">你也会什么都不在意地跑来</span><span ttm:role="x-roman">anta wa nani mo ki ni sezu yattekuru</span></p><p begin="5:07.301" end="5:10.264" itunes:key="L76" ttm:agent="v1"><span begin="5:07.301" end="5:07.535">そ</span><span begin="5:07.535" end="5:07.781">う</span><span begin="5:07.781" end="5:08.014">い</span><span begin="5:08.014" end="5:08.279">う</span><span begin="5:08.279" end="5:08.590">こ</span><span begin="5:08.590" end="5:09.015">と</span><span begin="5:09.015" end="5:09.292">に</span><span begin="5:09.292" end="5:09.526">な</span><span begin="5:09.526" end="5:09.759">っ</span><span begin="5:09.759" end="5:09.974">て</span><span begin="5:09.974" end="5:10.091">い</span><span begin="5:10.091" end="5:10.264">る</span><span ttm:role="x-translation" xml:lang="zh-Hans">就是这么回事</span><span ttm:role="x-roman">sou iu koto ni natte iru</span></p><p begin="5:10.436" end="5:11.098" itunes:key="L77" ttm:agent="v1"><span begin="5:10.436" end="5:10.503">そ</span><span begin="5:10.503" end="5:10.656">う</span><span begin="5:10.656" end="5:10.777">で</span><span begin="5:10.777" end="5:10.862">し</span><span begin="5:10.862" end="5:10.947">ょ</span><span begin="5:10.981" end="5:11.098">う？</span><span ttm:role="x-translation" xml:lang="zh-Hans">——对吧？</span><span ttm:role="x-roman">sou deshou?</span></p></div></body></tt>