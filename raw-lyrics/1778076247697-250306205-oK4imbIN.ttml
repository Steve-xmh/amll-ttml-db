286" end="1:09.448">you</span> <span begin="1:09.448" end="1:09.738">un</span><span begin="1:09.738" end="1:09.915">der</span><span begin="1:09.915" end="1:10.478">stand?</span><span ttm:role="x-translation" xml:lang="zh-Hans">你懂吗</span></p></div><div begin="1:10.328" end="1:25.043" itunes:songPart="Verse"><p begin="1:10.328" end="1:14.584" itunes:key="L19" ttm:agent="v3"><span begin="1:10.328" end="1:10.890">Sev</span><span begin="1:10.890" end="1:11.076">en-</span><span begin="1:11.076" end="1:11.521">foot</span> <span begin="1:11.521" end="1:12.179">frame,</span> <span begin="1:12.465" end="1:13.250">rats</span> <span begin="1:13.250" end="1:13.762">along</span> <span begin="1:13.762" end="1:14.094">his</span> <span begin="1:14.094" end="1:14.405">ba</span><span begin="1:14.405" end="1:14.584">ck</span><span ttm:role="x-translation" xml:lang="zh-Hans">身高七尺 背上爬老鼠</span></p><p begin="1:14.598" end="1:19.148" itunes:key="L20" ttm:agent="v3"><span begin="1:14.598" end="1:14.955">When</span> <span begin="1:14.955" end="1:15.246">he</span> <span begin="1:15.246" end="1:15.817">calls</span> <span begin="1:15.817" end="1:16.379">your</span> <span begin="1:16.379" end="1:16.936">name,</span> <span begin="1:16.984" end="1:17.264">it</span> <span begin="1:17.264" end="1:17.830">all</span> <span begin="1:17.830" end="1:18.368">fades</span> <span begin="1:18.368" end="1:18.694">to</span> <span begin="1:18.694" end="1:19.148">black</span><span ttm:role="x-translation" xml:lang="zh-Hans">他若唤你名字 万物隐进黑暗</span></p><p begin="1:19.253" end="1:25.043" itunes:key="L21" ttm:agent="v3"><span begin="1:19.253" end="1:19.605">Yeah,</span> <span begin="1:19.605" end="1:19.908">he</span> <span begin="1:19.908" end="1:20.445">sees</span> <span begin="1:20.445" end="1:21.063">your</span> <span begin="1:21.063" end="1:21.694">dreams</span> <span begin="1:21.694" end="1:21.961">and</span> <span begin="1:21.961" end="1:22.576">feasts</span> <span begin="1:22.576" end="1:23.067">on</span> <span be