333281936"/><amll:meta key="qqMusicId" value="000B4g5f4YbV45"/><amll:meta key="qqMusicId" value="339537295"/><amll:meta key="spotifyId" value="52xJxFP6TqMuO4Yt0eOkMz"/><amll:meta key="spotifyId" value="3fYwdlIVtJlYJTvHYrt7ev"/><amll:meta key="appleMusicId" value="1594677760"/><amll:meta key="appleMusicId" value="1605202548"/><amll:meta key="ttmlAuthorGithub" value="136059186"/><amll:meta key="ttmlAuthorGithub" value="250306205"/><amll:meta key="ttmlAuthorGithubLogin" value="MiaowCham"/><amll:meta key="ttmlAuthorGithubLogin" value="kid141252010"/><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal"><songwriters><songwriter>Lin-Manuel Miranda</songwriter></songwriters></iTunesMetadata></metadata></head><body dur="3:25.987"><div begin="1.152" end="10.254" itunes:songPart="Intro"><p begin="1.152" end="5.552" itunes:key="L1" ttm:agent="v1"><span begin="1.152" end="1.528">We</span> <span begin="1.528" end="1.794">don&apos;t</span> <span begin="1.794" end="2.138">talk</span> <span begin="2.138" end="2.256">a</span><span begin="2.256" end="2.728">bout</span> <span begin="2.728" end="3.236">Bru</span><span begin="3.236" end="3.738">no,</span> <span begin="3.845" end="4.394">no,</span> <span begin="4.394" end="4.998">no,</span> <span begin="4.998" end="5.552">no</span><span ttm:role="x-translation" xml:lang="zh-Hans">我们不提布鲁诺 不 不 不</span></p><p begin="5.838" end="10.254" itunes:key="L2" ttm:agent="v1"><span begin="5.838" end="6.214">We</span> <span begin="6.214" end="6.480">don&apos;t</span> <span begin="6.480" end="6.763">talk</span> <span begin="6.763" end="6.886">a</span><span begin="6.886" end="7.379">bout</span> <span begin="7.379" end="7.874">Bru</span><span begin="7.874" end="9.149">no,</span> <span begin="9.686" end="10.254">but</span><span ttm:role="x-translation" xml:lang="zh-Hans">我们不提布鲁诺 可是</span></p></div><div begin="10.522" end="43.125" itunes:songPart="Verse"><p begin="10.522" end="13.518" itunes:key="L3" ttm:agent="v1"><span begin="10.522" end="10.716">It</span> <span begin="10.716" end="10.908">was</span> <span begin="10.908" end="11.193">my</span> <span begin="11.193" end="11.436">wed</span><span begin="11.436" end="11.759">ding</span> <span begin="11.759" end="12.645">day</span><span ttm:role="x-translation" xml:lang="zh-Hans">那天是我结婚的日子</span><span ttm:role="x-bg" begin="11.724" end="13.518"><span begin="11.724" end="11.894">(It</span> <span begin="11.894" end="12.059">was</span> <span begin="12.059" end="12.314">our</span> <span begin="12.314" end="12.544">wed</span><span begin="12.544" end="12.851">ding</span> <span begin="12.851" end="13.518">day)</span><span ttm:role="x-translation" xml:lang="zh-Hans">那天是我们结婚的日子</span></span></p><p begin="12.791" end="19.911" itunes:key="L4" ttm:agent="v1"><span begin="12.791" end="13.036">We</span> <span begin="13.036" end="13.236">were</span> <span begin="13.236" end="13.341">get</span><span begin="13.341" end="13.482">ting</span> <span begin="13.482" end="14.109">ready</span> <span begin="14.109" end="14.318">and</span> <span begin="14.318" end="14.627">there</span> <span begin="14.627" end="14.959">was</span><span begin="14.959" end="15.291">n&apos;t</span> <span begin="15.291" end="15.573">a</span> <span begin="15.573" end="16.132">cloud</span> <span begin="16.132" end="16.411">in</span> <span begin="16.411" end="16.718">the</span> <span begin="16.718" end="17.585">sky</span><span ttm:role="x-translation" xml:lang="zh-Hans">我们在做准备 天空万里无云</span><span ttm:role="x-bg" begin="16.943" end="19.911"><span begin="16.943" end="17.272">(No</span> <span begin="17.272" end="17.629">clouds</span> <span begin="17.629" end="17.880">al</span><span begin="17.880" end="18.508">lowed</span> <span begin="18.508" end="18.803">in</span> <span begin="18.803" end="19.112">the</span> <span begin="19.112" end="19.911">sky)</span><span ttm:role="x-translation" xml:lang="zh-Hans">天空不许有一朵云</span></span></p><p begin="19.257" end="24.640" itunes:key="L5" ttm:agent="v1"><span begin="19.257" end="19.886">Bruno</span> <span begin="19.886" end="20.179">walks</span> <span begin="20.179" end="20.806">in</span> <span begin="20.806" end="21.085">with</span> <span begin="21.085" end="21.337">a</span> <span begin="21.337" end="21.660">mis</span><span begin="21.660" end="22.091">chie</span><span begin="22.091" end="22.523">vous</span> <span begin="22.523" end="23.116">grin</span><span ttm:role="x-translation" xml:lang="zh-Hans">布鲁诺坏笑着走了进来</span><span ttm:role="x-bg" begin="23.119" end="24.640"><span begin="23.119" end="23.714">(Thun</span><span begin="23.714" end="24.640">der)</span><span ttm:role="x-translation" xml:lang="zh-Hans">雷声隆隆</span></span></p><p begin="24.262" end="29.397" itunes:key="L6" ttm:agent="v1"><span begin="24.262" end="24.496">You</span> <span begin="24.496" end="24.802">telling</span> <span begin="24.802" end="25.101">this</span> <span begin="25.101" end="25.400">sto</span><span begin="25.400" end="25.599">ry</span> <span begin="25.599" end="25.844">or</span> <span begin="25.844" end="26.018">am</span> <span begin="26.018" end="26.530">I?</span><span ttm:role="x-translation" xml:lang="zh-Hans">你讲还是我讲</span><span ttm:role="x-bg" begin="26.615" end="29.397"><span begin="26.615" end="26.903">(I&apos;m</span> <span begin="26.903" end="27.063">sor</span><span begin="27.063" end="27.181">ry,</span> <span begin="27.181" end="27.315">mi</span> <span begin="27.315" end="27.674">vida,</span> <span begin="27.674" end="27.869">go</span> <span begin="27.869" end="29.397">on)</span><span ttm:role="x-translation" xml:lang="zh-Hans">抱歉 亲爱的 请继续</span></span></p><p begin="28.487" end="34.116" itunes:key="L7" ttm:agent="v1"><span begin="28.487" end="28.900">Bru</span><span begin="28.900" end="29.266">no</span> <span begin="29.266" end="29.596">says,</span> <span begin="29.596" end="29.849">&quot;It</span> <span begin="29.849" end="30.315">looks</span> <span begin="30.315" end="30.688">like</span> <span begin="30.688" end="31.564">rain&quot;</span><span ttm:role="x-translation" xml:lang="zh-Hans">布鲁诺说 看来要下雨</span><span ttm:role="x-bg" begin="31.391" end="34.116"><span begin="31.391" end="31.665">(Why</span> <span begin="31.665" end="31.797">did</span> <span begin="31.797" end="32.096">he</span> <span begin="32.096" end="32.439">tell</span> <span begin="32.439" end="34.116">us?)</span><span ttm:role="x-translation" xml:lang="zh-Hans">他为何说出来</span></span></p><p begin="32.977" end="38.719" itunes:key="L8" ttm:agent="v1"><span begin="32.977" end="33.350">In</span> <span begin="33.350" end="33.564">do</span><span begin="33.564" end="33.884">ing</span> <span begin="33.884" end="34.242">so,</span> <span begin="34.242" end="34.472">he</span> <span begin="34.472" end="34.950">floods</span> <span begin="34.950" end="35.390">my</span> <span begin="35.390" end="36.245">brain</span><span ttm:role="x-translation" xml:lang="zh-Hans">那样做让我心绪难宁</span><span ttm:role="x-bg" begin="35.712" end="38.719"><span begin="35.712" end="36.212">(Abuela,</span> <span begin="36.212" end="36.340">get</span> <span begin="36.340" end="36.491">the</span> <span begin="36.491" end="36.773">um</span><span begin="36.773" end="37.067">brel</span><span begin="37.067" end="38.719">las)</span><span ttm:role="x-translation" xml:lang="zh-Hans">奶奶 请把雨伞拿出来</span></span></p><p begin="37.894" end="43.125" itunes:key="L9" ttm:agent="v1"><span begin="37.894" end="38.190">Mar</span><span begin="38.190" end="38.585">ried</span> <span begin="38.585" end="38.834">in</span> <span begin="38.834" end="39.101">a</span> <span begin="39.101" end="39.652">hur</span><span begin="39.652" end="40.020">ri</span><span begin="40.020" end="40.888">cane</span><span ttm:role="x-translation" xml:lang="zh-Hans">在狂风骤雨的天气结婚</span><span ttm:role="x-bg" begin="40.662" end="43.125"><span begin="40.662" end="40.799">(What</span> <span begin="40.799" end="40.922">a</span> <span begin="40.922" end="41.202">joy</span><span begin="41.202" end="41.482">ous</span> <span begin="41.482" end="41.774">day,</span> <span begin="41.774" end="42.140">but</span> <span begin="42.140" end="42.609">any</span><span begin="42.609" end="43.125">way)</span><span ttm:role="x-translation" xml:lang="zh-Hans">多么欢乐的一天 可不管怎样</span></span></p></div><div begin="43.125" end="51.533" itunes:songPart="Bridge"><p begin="43.125" end="47.605" itunes:key="L10" ttm:agent="v1000"><span begin="43.125" end="43.524">We</span> <span begin="43.524" end="43.793">don&apos;t</span> <span begin="43.793" end="44.044">talk</span> <span begin="44.044" end="44.166">a</span><span begin="44.166" end="44.653">bout</span> <span begin="44.653" end="45.253">Bru</span><span begin="45.253" end="45.640">no,</span> <span begin="45.791" end="46.434">no,</span> <span begin="46.434" end="47.018">no,</span> <span begin="47.018" end="47.605">no</span><span ttm:role="x-translation" xml:lang="zh-Hans">我们不提布鲁诺 不 不 不</span></p><p begin="47.798" end="51.533" itunes:key="L11" ttm:agent="v1000"><span begin="47.798" end="48.143">We</span> <span begin="48.143" end="48.450">don&apos;t</span> <span begin="48.450" end="48.704">talk</span> <span begin="48.704" end="48.826">a</span><span begin="48.826" end="49.316">bout</span> <span begin="49.316" end="49.923">Bru</span><span begin="49.923" end="51.533">no</span><span ttm:role="x-translation" xml:lang="zh-Hans">我们不提布鲁诺</span></p></div><div begin="51.331" end="1:10.478" itunes:songPart="Verse"><p begin="51.331" end="54.202" itunes:key="L12" ttm:agent="v2"><span begin="51.331" end="51.594">Hey,</span> <span begin="51.964" end="52.124">grew</span> <span begin="52.124" end="52.259">to</span> <span begin="52.259" end="52.432">live</span> <span begin="52.432" end="52.543">in</span> <span begin="52.543" end="52.807">fear</span> <span begin="52.807" end="52.907">of</span> <span begin="52.907" end="53.115">Bruno</span> <span begin="53.115" end="53.263">stut</span><span begin="53.263" end="53.374">ter</span><span begin="53.374" end="53.485">ing</span> <span begin="53.485" end="53.621">or</span> <span begin="53.621" end="53.879">stum</span><span begin="53.879" end="54.202">bling</span><span ttm:role="x-translation" xml:lang="zh-Hans">嘿 从小就害怕布鲁诺开口讲话</span></p><p begin="54.290" end="56.515" itunes:key="L13" ttm:agent="v2"><span begin="54.290" end="54.453">I</span> <span begin="54.453" end="54.610">can</span> <span begin="54.610" end="54.766">al</span><span begin="54.766" end="54.900">ways</span> <span begin="54.900" end="55.020">hear</span> <span begin="55.020" end="55.107">him</span> <span begin="55.107" end="55.277">sort</span> <span begin="55.277" end="55.440">of</span> <span begin="55.440" end="55.559">mut</span><span begin="55.559" end="55.708">ter</span><span begin="55.708" end="55.871">ing</span> <span begin="55.871" end="56.017">and</span> <span begin="56.017" end="56.277">mum</span><span begin="56.277" end="56.515">bling</span><span ttm:role="x-translation" xml:lang="zh-Hans">我总是能听到他喃喃自语</span></p><p begin="56.601" end="1:01.162" itunes:key="L14" ttm:agent="v2"><span begin="56.601" end="56.752">I</span> <span begin="56.752" end="56.959">as</span><span begin="56.959" end="57.132">soc</span><span begin="57.132" end="57.391">iate</span> <span begin="57.391" end="57.486">him</span> <span begin="57.486" end="57.605">with</span> <span begin="57.605" end="57.708">the</span> <span begin="57.708" end="58.077">sound</span> <span begin="58.077" end="58.373">of</span> <span begin="58.373" end="58.652">fal</span><span begin="58.652" end="58.858">ling</span> <span begin="58.858" end="59.429">sand</span><span ttm:role="x-translation" xml:lang="zh-Hans">想起他 我就想到沙子滑落的声音</span><span ttm:role="x-bg" begin="59.527" end="1:01.141"><span begin="59.527" end="1:00.002">(Ch-</span><span begin="1:00.101" end="1:00.625">ch-</span><span begin="1:00.688" end="1:01.141">ch)</span><span ttm:role="x-translation" xml:lang="zh-Hans">沙 沙 沙</span></span></p><p begin="1:01.271" end="1:03.601" itunes:key="L15" ttm:agent="v2"><span begin="1:01.271" end="1:01.462">It&apos;s</span> <span begin="1