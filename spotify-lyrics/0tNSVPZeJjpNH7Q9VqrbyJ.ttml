<tt xmlns="http://www.w3.org/ns/ttml" xmlns:amll="http://www.example.com/ns/amll" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" itunes:timing="Word" xml:lang="ja"><head><metadata><ttm:agent type="person" xml:id="v1"/><amll:meta key="musicName" value="雑踏、僕らの街"/><amll:meta key="musicName" value="熙熙攘攘、我们的城市"/><amll:meta key="musicName" value="TV动画 Girls Band Cry op"/><amll:meta key="musicName" value="熙熙攘攘我们的城市"/><amll:meta key="musicName" value="《哭泣少女乐队》TV动画片头曲"/><amll:meta key="musicName" value="Wrong World"/><amll:meta key="artists" value="トゲナシトゲアリ"/><amll:meta key="artists" value="TOGENASHI TOGEARI"/><amll:meta key="artists" value="无刺有刺"/><amll:meta key="album" value="雑踏、僕らの街"/><amll:meta key="album" value="Wrong World - Single"/><amll:meta key="album" value="雑踏、僕らの街 - Single"/><amll:meta key="ncmMusicId" value="2142857204"/><amll:meta key="qqMusicId" value="0021mFT32j45p6"/><amll:meta key="qqMusicId" value="481819484"/><amll:meta key="spotifyId" value="0tNSVPZeJjpNH7Q9VqrbyJ"/><amll:meta key="appleMusicId" value="1737842246"/><amll:meta key="isrc" value="JPPO02400704"/><amll:meta key="Arranger" value="大濱健悟"/><amll:meta key="Arranger" value="Kenji Tamai"/><amll:meta key="Bass" value="Shuri"/><amll:meta key="Conductor" value="Koki Magatani"/><amll:meta key="Drums" value="Mirei"/><amll:meta key="Guitar" value="Yuri"/><amll:meta key="Guitar" value="Yukio Nagoshi"/><amll:meta key="Keyboards" value="Natsu"/><amll:meta key="Mastering Engineer" value="Yuji Chinone"/><amll:meta key="Mixing Engineer" value="Kenichi &apos;NK-1&apos; Nakamura"/><amll:meta key="Music Director" value="Koki Magatani"/><amll:meta key="Performer" value="Kenji Tamai"/><amll:meta key="Producer" value="Kenji Tamai"/><amll:meta key="Recording Engineer" value="Masaki Mori"/><amll:meta key="Synthesizer Programming" value="大濱健悟"/><amll:meta key="Vocals" value="RiNa"/><amll:meta key="ttmlAuthorGithub" value="68000793"/><amll:meta key="ttmlAuthorGithubLogin" value="ranhengzhang"/><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal"><translations><translation type="subtitle" xml:lang="en"><text for="L1">The unfinished heartbeat veils the night</text><text for="L2">Before it all shatters, wrapping us tight</text><text for="L3">That hand — frail and unsure is just fine</text><text for="L4">This hand, after all, is yours and mine</text><text for="L5">Nothing ever stays the same — reach out your hand</text><text for="L6">Amid the crowd, I wept in silence</text><text for="L7">Footprints fade a voice in the morning&apos;s quiet</text><text for="L8">Never withering through endless days</text><text for="L9">The rotten city&apos;s mudwater runs cold</text><text for="L10">In a world that never changes</text><text for="L11">Still we scrape through another day</text><text for="L12">Pointless, yet what can we do anyway</text><text for="L13">We&apos;ve already started walking on</text><text for="L14">Unbelievable, like goddamn fools</text><text for="L15">This hopeless city of ours</text><text for="L16">Even so, I saw it clear with these eyes</text><text for="L17">Felt it real with these hands — hey, look, look</text><text for="L18">There you go again, spouting like a fool</text><text for="L19">Lighting up the impenetrable dark</text><text for="L20">It&apos;s no dream — even if the city&apos;s already wrecked</text><text for="L21">Giving up won&apos;t change a damn thing — ah, not yet, not yet, not yet</text><text for="L22">The unfinished heartbeat veils the night</text><text for="L23">Before it all shatters, wrapping us tight</text><text for="L24">That hand — frail and unsure is just fine</text><text for="L25">This hand, after all, is yours and mine</text><text for="L26">Nothing ever stays the same — reach out your hand</text><text for="L27">In eternity, a warmth to keep from losing my way</text><text for="L28">Scattering, never reaching your shallow heart</text><text for="L29">Just as you imagined? No way that&apos;s true</text><text for="L30">Just run away, right? Don&apos;t say it so lightly</text><text for="L31">Through the world same as always</text><text for="L32">We keep dashing on today</text><text for="L33">If you slip and fall, I&apos;ll pull you up</text><text for="L34">That gleam of blue shining inside the gray sky</text><text for="L35">Unbelievable, like goddamn fools</text><text for="L36">This hopeless city of ours</text><text for="L37">Even so, I saw it clear with these eyes</text><text for="L38">Felt it real with these hands — hey, look, look</text><text for="L39">There you go again, spouting like a fool</text><text for="L40">Lighting up the impenetrable dark</text><text for="L41">It&apos;s no dream — even if the city&apos;s already wrecked</text><text for="L42">Giving up won&apos;t change a damn thing — ah, not yet, not yet, not yet</text><text for="L43">The unfinished heartbeat veils the night</text><text for="L44">Before it all shatters, wrapping us tight</text><text for="L45">That hand — frail and unsure is just fine</text><text for="L46">This hand, after all, is yours and mine</text><text for="L47">Nothing ever stays the same — reach out your hand</text><text for="L48">Everything rests on you, and on me</text></translation><translation type="subtitle" xml:lang="zh-Hans"><text for="L1">未竟的心愿 覆盖了整片夜空</text><text for="L2">化作齑粉之前 将我重重包裹</text><text for="L3">这只手 哪怕不可靠也没关系</text><text for="L4">毕竟 这是你自己的手</text><text for="L5">唯一不变的就是变化 伸出你的手吧</text><text for="L6">人来人往中 静静地哭出了声</text><text for="L7">今天早上 又有谁的声音消失在足迹中</text><text for="L8">历经悠久岁月 不见枯败</text><text for="L9">腐败的街道 泥水寒冷刺骨</text><text for="L10">这世界 一成不变</text><text for="L11">今天也要 努力过活</text><text for="L12">虽然无趣 亦无可奈何</text><text for="L13">我们已经开始向前迈进</text><text for="L14">难以置信 又愚不可及</text><text for="L15">我们的街道 无可救药</text><text for="L16">即便如此 也要亲眼见证</text><text for="L17">来吧 来吧 亲手去触碰感受</text><text for="L18">看你又说大话 不是天真就是傻</text><text for="L19">深不可测的黑暗也想照亮</text><text for="L20">这不是梦 反正街道已经完蛋</text><text for="L21">自暴自弃也没好处 还不到放弃的时候</text><text for="L22">未竟的心愿 覆盖了整片夜空</text><text for="L23">化作齑粉之前 将我重重包裹</text><text for="L24">这只手 哪怕不可靠也没关系</text><text for="L25">毕竟 这是你自己的手</text><text for="L26">唯一不变的就是变化 伸出你的手吧</text><text for="L27">永恒之中 一份不致迷失的温热</text><text for="L28">飘向浅薄的你 未曾抵达便散落殆尽</text><text for="L29">如你所料？ 怎么可能</text><text for="L30">逃跑就完事了？ 别说得那么轻巧</text><text for="L31">一如既往的世界</text><text for="L32">今天也要 奋力奔跑</text><text for="L33">若你失足滑落 就由我来抓住</text><text for="L34">灰色天空里 那一抹闪耀的蓝</text><text for="L35">难以置信 又愚不可及</text><text for="L36">我们的街道 无可救药</text><text for="L37">即便如此 也要亲眼见证</text><text for="L38">来吧 来吧 亲手去触碰感受</text><text for="L39">看你又说大话 不是天真就是傻</text><text for="L40">深不可测的黑暗也想照亮</text><text for="L41">这不是梦 反正街道已经完蛋</text><text for="L42">自暴自弃也没好处 还不到放弃的时候</text><text for="L43">未竟的心愿 覆盖了整片夜空</text><text for="L44">化作齑粉之前 将我重重包裹</text><text for="L45">这只手 哪怕不可靠也没关系</text><text for="L46">毕竟 这是你自己的手</text><text for="L47">唯一不变的就是变化 伸出你的手吧</text><text for="L48">万事皆由你 也皆由我</text></translation></translations><songwriters><songwriter>大濱健悟</songwriter></songwriters><transliterations><transliteration xml:lang="ja-Latn"><text for="L1"><span begin="0.500" end="0.760" xmlns="http://www.w3.org/ns/ttml">ya</span> <span begin="0.760" end="0.920" xmlns="http://www.w3.org/ns/ttml">ri</span> <span begin="0.920" end="1.310" xmlns="http://www.w3.org/ns/ttml">no ko</span> <span begin="1.310" end="1.400" xmlns="http://www.w3.org/ns/ttml">shi</span> <span begin="1.400" end="1.570" xmlns="http://www.w3.org/ns/ttml">ta</span> <span begin="1.570" end="1.650" xmlns="http://www.w3.org/ns/ttml">ko</span> <span begin="1.650" end="1.890" xmlns="http://www.w3.org/ns/ttml">do u</span> <span begin="1.890" end="1.930" xmlns="http://www.w3.org/ns/ttml">ga</span> <span begin="1.930" end="2.120" xmlns="http://www.w3.org/ns/ttml">ko</span> <span begin="2.120" end="2.230" xmlns="http://www.w3.org/ns/ttml">no</span> <span begin="2.230" end="2.420" xmlns="http